{
  "mcpServers": {
    "gsc": {
      "command": "uvx",
      "args": [
        "mcp-search-console"
      ],
      "env": {
        "GSC_CREDENTIALS_PATH": "${GSC_CREDENTIALS_PATH:-}",
        "GSC_OAUTH_CLIENT_SECRETS_FILE": "${GSC_OAUTH_CLIENT_SECRETS_FILE:-}",
        "GSC_DATA_STATE": "all"
      }
    },
    "geo-optimizer": {
      "command": "uvx",
      "args": [
        "--from",
        "geo-optimizer-skill[mcp]",
        "--with",
        "mcp<2",
        "geo-mcp"
      ]
    }
  }
}
