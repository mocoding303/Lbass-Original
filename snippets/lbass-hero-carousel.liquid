    {%- if hc_total > 1 -%}
    <button type="button" class="lbhs-arrow lbhs-prev" data-lbhs-step="-1" aria-label="السابق · Previous" aria-controls="lbhs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
