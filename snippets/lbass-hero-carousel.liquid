    <div class="lbhs-dots" role="group" aria-label="Slides">
      {%- for i in (1..hc_total) -%}
      <button type="button" class="lbhs-dot" data-lbhs-go="{{ forloop.index0 }}" aria-label="{{ forloop.index }} / {{ hc_total }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</div>

{%- if hc_total > 1 -%}
<script>
(function(){
  var root = document.getElementById('lbhs');
  if(!root) return;
  var track = root.querySelector('.lbhs-track');
  var vp = root.querySelector('.lbhs-viewport');
  var slides = Array.prototype.slice.call(track.children);
  var tabs = Array.prototype.slice.call(root.querySelectorAll('.lbhs-tab'));
  var dots = Array.prototype.slice.call(root.querySelectorAll('.lbhs-dot'));
  var n = slides.length;
  if(n < 2) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var DUR = 5000, timer = 0;
  var auto = !reduce, cur = -1, holds = {}, loaded = {0: true}, dragX = 0, dragging = false, sx = null, sy = 0, justDragged = 0;
  var rtl = (getComputedStyle(track).direction === 'rtl');

  function publish(name, data){
    try{ if(window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') Shopify.analytics.publish(name, data); }catch(e){}
  }
  function load(i){
    if(i < 0 || i >= n || loaded[i]) return;
    loaded[i] = true;
    Array.prototype.forEach.call(slides[i].querySelectorAll('[data-src]'), function(el){ el.src = el.getAttribute('data-src'); el.removeAttribute('data-src'); });
    Array.prototype.forEach.call(slides[i].querySelectorAll('[data-srcset]'), function(el){ el.srcset = el.getAttribute('data-srcset'); el.removeAttribute('data-srcset'); });
  }
  function place(px){
    var base = (rtl ? 1 : -1) * cur * 100;
    track.style.transform = px ? 'translate3d(calc(' + base + '% + ' + px + 'px),0,0)' : 'translate3d(' + base + '%,0,0)';
  }
  /* one timer, restarted on every slide change — so a click or swipe never
     stops the rotation, it just gives the chosen slide a full 5 s */
  function schedule(){
    if(timer){ clearTimeout(timer); timer = 0; }
    if(!auto || Object.keys(holds).length) return;
    timer = setTimeout(function(){ timer = 0; go(cur + 1, 'auto'); }, DUR);
  }
  function hold(k, v){
    var had = !!holds[k];
    if(v) holds[k] = 1; else delete holds[k];
    root.classList.toggle('is-hold', Object.keys(holds).length > 0);
    if(had !== !!v) schedule();
  }
  function go(i, how){
    i = ((i % n) + n) % n;
    if(i === cur) { place(0); schedule(); return; }
    cur = i;
    load(i); load(i + 1);
    place(0);
    for(var k = 0; k < n; k++){
      var on = k === i;
      slides[k].setAttribute('aria-hidden', on ? 'false' : 'true');
      slides[k].inert = !on;
      if(tabs[k]){ tabs[k].setAttribute('aria-selected', on ? 'true' : 'false'); tabs[k].tabIndex = on ? 0 : -1; }
      if(dots[k]){ if(on) dots[k].setAttribute('aria-current', 'true'); else dots[k].removeAttribute('aria-current'); }
    }
    root.setAttribute('data-lbhs-cur', String(i));
    root.setAttribute('data-lbhs-tone', slides[i].getAttribute('data-tone') || 'light');
    if(how) publish('lbass_hero_slide', {slide: i, label: tabs[i] ? tabs[i].getAttribute('data-cro-label') : String(i), how: how});
    schedule();
  }

  root.addEventListener('click', function(e){
    if(Date.now() - justDragged < 350){ e.preventDefault(); e.stopPropagation(); return; }
    var g = e.target.closest('[data-lbhs-go]');
    if(g && root.contains(g)){ go(+g.getAttribute('data-lbhs-go'), 'user'); return; }
    var st = e.target.closest('[data-lbhs-step]');
    if(st){ go(cur + (+st.getAttribute('data-lbhs-step')), 'user'); }
  }, true);
  root.addEventListener('keydown', function(e){
    var t = e.target;
    if(t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    var step = 0;
    if(e.key === 'ArrowRight') step = rtl ? -1 : 1;
    else if(e.key === 'ArrowLeft') step = rtl ? 1 : -1;
    else if(e.key === 'Home'){ e.preventDefault(); go(0, 'user'); if(tabs[0]) tabs[0].focus(); return; }
    else if(e.key === 'End'){ e.preventDefault(); go(n - 1, 'user'); if(tabs[n - 1]) tabs[n - 1].focus(); return; }
    if(!step) return;
    e.preventDefault();
    go(cur + step, 'user');
    if(t && t.classList && t.classList.contains('lbhs-tab') && tabs[cur]) tabs[cur].focus();
  });

  /* swipe that follows the finger; vertical scrolling stays native (touch-action: pan-y) */
  vp.addEventListener('pointerdown', function(e){
    if(e.pointerType === 'mouse') return;
    sx = e.clientX; sy = e.clientY; dragX = 0; dragging = false;
  }, {passive: true});
  vp.addEventListener('pointermove', function(e){
    if(sx === null) return;
    var mx = e.clientX - sx, my = e.clientY - sy;
    if(!dragging){
      if(Math.abs(mx) > 10 && Math.abs(mx) > Math.abs(my) * 1.2){ dragging = true; track.classList.add('is-drag'); hold('drag', 1); }
      else if(Math.abs(my) > 10){ sx = null; return; }
    }
    if(dragging){
      var atEdge = (cur === 0 && (rtl ? mx < 0 : mx > 0)) || (cur === n - 1 && (rtl ? mx > 0 : mx < 0));
      dragX = atEdge ? mx * 0.35 : mx;
      place(dragX);
    }
  }, {passive: true});
  function endDrag(){
    if(sx === null && !dragging) return;
    sx = null;
    if(!dragging) return;
    dragging = false;
    hold('drag', 0);
    track.classList.remove('is-drag');
    justDragged = Date.now();
    var thr = Math.min(90, vp.clientWidth * 0.18);
    if(Math.abs(dragX) > thr){
      var forward = rtl ? dragX > 0 : dragX < 0;
      go(cur + (forward ? 1 : -1), 'user');
    } else {
      place(0);
    }
  }
  vp.addEventListener('pointerup', endDrag, {passive: true});
  vp.addEventListener('pointercancel', endDrag, {passive: true});

  /* no pause on hover (owner request). Keyboard focus still pauses it, so a
     keyboard user is never moved away from the slide they are reading. */
  root.addEventListener('focusin', function(e){
    var kb = false;
    try{ kb = e.target.matches(':focus-visible'); }catch(err){}
    if(kb) hold('focus', 1);
  });
  root.addEventListener('focusout', function(e){ if(!root.contains(e.relatedTarget)) hold('focus', 0); });
  document.addEventListener('visibilitychange', function(){ hold('hidden', document.hidden); });
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){ hold('off', !es[0].isIntersecting); }, {threshold: 0.3}).observe(root);
  }

  var start = 0;
  /* deep links: /#fragrances opens the perfume slide, /#k-beauty the K-beauty one (and stays there) */
  var hashMap = {fragrances: 'fragrances', parfums: 'fragrances', 'k-beauty': 'cosmetics', kbeauty: 'cosmetics', cosmetics: 'cosmetics', beauty: 'cosmetics'};
  var hashKey = hashMap[(location.hash || '').replace('#', '').toLowerCase()];
  if(hashKey){ tabs.forEach(function(t, i){ if(t.getAttribute('data-cro-label') === hashKey){ start = i; auto = false; } }); }
  go(start);
  if(auto) root.classList.add('is-auto');
  var later = function(){ setTimeout(function(){ for(var k = 1; k < n; k++) load(k); }, 1200); };
  if(document.readyState === 'complete') later(); else window.addEventListener('load', later);
})();
</script>
{%- endif -%}
