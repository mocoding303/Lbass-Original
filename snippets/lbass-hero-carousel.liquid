      {%- assign hc_i = hc_bi -%}{%- if hc_show_beauty -%}{%- assign hc_i = hc_bi | plus: 1 -%}{%- endif -%}
      {%- for k in hc_keys -%}
        {%- assign hc_h = k | split: '|' | last -%}{%- assign s = shop.metaobjects.lbass_hero_slide[hc_h] -%}
        {%- assign hc_tone = s.tone.value | default: 'dark' -%}
        <div class="lbhs-slide" id="lbhsSlide{{ hc_i }}" data-tone="{{ hc_tone }}" role="tabpanel" aria-roledescription="slide" aria-labelledby="lbhsTab{{ hc_i }}" aria-hidden="true" inert>
          <section class="lbcs lbcs--{{ hc_tone }}">
            {%- if s.image.value != blank -%}
            <picture class="lbcs-media">
              {%- if s.image_mobile.value != blank -%}<source media="(max-width: 767px)" data-srcset="{{ s.image_mobile.value | image_url: width: 1080 }}">{%- endif -%}
