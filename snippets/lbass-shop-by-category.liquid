{%- comment -%}
  ═══ LBASS — SHOP BY CATEGORY (2026-09-26) ═══
  Compact strip directly under the hero carousel: a second, one-tap way to
  pick a department without waiting for the carousel.
    Clothing     → /collections/all (clothing only — perfume is filtered out
                   of that page by templates/collection.liquid)
    Sneakers     → /collections/صبابط            (2026-09-30, replaced Fragrances)
    Jackets      → /collections/جاكيطات-و-معاطف  (2026-09-30, replaced Cosmetics)
    Accessories  → /collections/إكسسوارات
  2026-09-30 clothing-first homepage (strategic assessment approved by the owner):
  fragrance moved to its own best-sellers row lower down (lbass-home-fragrances),
  K-beauty is menu-only. Fragrance has ONE tile here (owner, 2026-09-30, third
  version): a normal category tile «عطور · Fragrances» in the same dark style as
  the clothing tiles, full width (a 5th half-width tile would sit alone on its own
  row), linking to /collections/fragrances with the in-stock count. Art: the three
  real bottles (Club de Nuit, Khamrah, Rose 01) in cream arches, the look of the
  perfume page hero; the bottle photos are on white, so they are multiplied into
  the arches instead of being cut out. «كمّل اللوك» is NOT used here: the owner
  keeps that wording for the moment someone buys clothing (the cart drawer). Sneakers/jackets counts are in-stock pieces (first 50 of
  each collection, plenty at today's sizes); they hide when nothing is in stock.
  Every link carries data-cro-event="home_category_click" (label = department)
  so the split between clothing and perfume interest is measurable.
  Images are existing theme assets, resized by the CDN, lazy-loaded.
  Ordered by snippets/lbass-home-density.liquid (main > .lbcat{order:0}).
{%- endcomment -%}
{%- liquid
  assign cat_frag = collections['fragrances']
  assign cat_frag_n = cat_frag.products_count | default: 0 | plus: 0
  assign cat_frag_av = cat_frag.products | where: 'available', true | size
  assign cat_bt = collections['cosmetics']
  assign cat_bt_n = cat_bt.products_count | default: 0 | plus: 0
  assign cat_cloth_n = collections.all.products_count | default: 0 | plus: 0 | minus: cat_frag_n | minus: cat_bt_n | at_least: 0
  assign cat_acc = collections['إكسسوارات']
  assign cat_acc_n = cat_acc.products_count | default: 0 | plus: 0
  # 2026-09-30 clothing-first homepage: the fragrance and K-beauty tiles are replaced by
  # sneakers and jackets (fragrance has its own row lower down; K-beauty is menu-only).
  assign cat_sn = collections['صبابط']
  assign cat_sn_n = cat_sn.products | where: 'available', true | size
  assign cat_jk = collections['جاكيطات-و-معاطف']
  assign cat_jk_n = cat_jk.products | where: 'available', true | size
  # 2026-09-30 (merged with the homepage redesign): the clothing tiles show each
  # department's first IN-STOCK product photo instead of the editorial
  # cat-*-ed.webp images, which show no piece in stock (CLAUDE.md: imagery must be
  # real). The Clothing tile skips the hero's piece (hero_id) so the first two
  # screens never show the same photo twice. No photo, no image: the tile keeps
  # its dark background.
  assign cat_cloth_img = nil
  for p in collections['audited-drop-p001-p012'].products
    if p.available == false or p.id == hero_id
      continue
    endif
    assign p_type = p.type | downcase
    if p_type == 'fragrance' or p_type == 'cosmetics'
      continue
    endif
    if p.featured_image
      assign cat_cloth_img = p.featured_image
      break
    endif
  endfor
  assign cat_sn_img = cat_sn.products | where: 'available', true | map: 'featured_image' | compact | first
  assign cat_jk_img = cat_jk.products | where: 'available', true | map: 'featured_image' | compact | first
  assign cat_acc_img = cat_acc.products | where: 'available', true | map: 'featured_image' | compact | first
-%}
<section class="lbcat" aria-labelledby="lbcat-h">
  <style>
    .lbcat{padding:18px var(--pad,20px) 6px;background:#FFFFFF}
    .lbcat-in{max-width:var(--max,1100px);margin:0 auto}
    .lbcat-h{display:flex;align-items:baseline;gap:10px;margin:0 0 12px;font-size:15px;font-weight:900;color:#0B0B0C}
    .lbcat-h span{font-family:var(--lb-latin,'Epilogue',system-ui,sans-serif);font-size:10.5px;font-weight:700;letter-spacing:.26em;text-transform:uppercase;color:#6B6B6E;direction:ltr}
    .lbcat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .lbcat-tile{position:relative;display:block;overflow:hidden;isolation:isolate;aspect-ratio:16/9;border-radius:12px;background:#15100B;
      color:#FFFFFF;text-decoration:none;box-shadow:0 1px 0 rgba(11,11,12,.06)}
    .lbcat-tile img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
    .lbcat-tile::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,rgba(8,6,4,.78) 0%,rgba(8,6,4,.25) 55%,rgba(8,6,4,0) 100%)}
    a.lbcat-tile:hover img{transform:scale(1.05)}
    a.lbcat-tile:focus-visible{outline:3px solid #BF2E15;outline-offset:2px}
    .lbcat-txt{position:absolute;inset-inline:12px;bottom:10px;display:flex;flex-direction:column;gap:1px}
    .lbcat-txt b{font-size:15px;font-weight:900;line-height:1.3}
    .lbcat-txt small{font-family:var(--lb-latin,'Epilogue',system-ui,sans-serif);font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;opacity:.85;direction:ltr;text-align:right}
    .lbcat-go{position:absolute;top:10px;inset-inline-end:10px;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;
      background:rgba(255,255,255,.18);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);font-size:14px}
    /* fragrance tile (2026-09-30): full width but never taller than the clothing tiles (~125px at 1024px) */
    .lbcat-grid .lbcat-tile--wide{grid-column:1/-1;aspect-ratio:auto;height:clamp(118px,12.2vw,150px)} /* beats the phone rule .lbcat-tile{aspect-ratio:16/10} below */
    .lbcat-tile--frag{background:radial-gradient(55% 120% at 26% 72%,rgba(214,164,86,.42) 0%,rgba(214,164,86,.10) 55%,transparent 80%),
      linear-gradient(160deg,#1C150E 0%,#100C08 60%,#150F0A 100%)}
    .lbcat-tile--frag::after{background:linear-gradient(270deg,rgba(8,6,4,.55) 0%,rgba(8,6,4,0) 55%)}
    .lbcat-arches{position:absolute;inset-block:12% 9%;inset-inline-end:12%;z-index:-1;display:flex;align-items:flex-end;gap:clamp(6px,1.1vw,14px)}
    .lbcat-arch{position:relative;isolation:isolate;height:84%;aspect-ratio:5/8;overflow:hidden;border-radius:999px 999px 6px 6px;
      border:1px solid rgba(233,196,128,.55);background:linear-gradient(180deg,#FFFDF8 0%,#F7EEDD 58%,#EAD8B6 100%);
      box-shadow:0 10px 24px rgba(0,0,0,.45);transition:transform .35s ease}
    .lbcat-arch--mid{height:100%}
    .lbcat-tile--frag .lbcat-arch img{position:absolute;inset:16% 12% 6%;z-index:0;width:76%;height:78%;
      object-fit:contain;object-position:50% 100%;mix-blend-mode:multiply;transition:none}
    a.lbcat-tile--frag:hover img{transform:none}
    a.lbcat-tile--frag:hover .lbcat-arch{transform:translateY(-3px)}
    .lbcat-tile--beauty{background:linear-gradient(150deg,#FCF8F4 0%,#F4E6DE 60%,#ECD8CD 100%);color:#241915}
    .lbcat-tile--beauty img{inset:5% 0 22%;width:100%;height:73%;object-fit:contain}
    .lbcat-tile--beauty::after{background:linear-gradient(0deg,rgba(252,248,244,.95) 0%,rgba(252,248,244,.6) 30%,rgba(252,248,244,0) 60%)}
    .lbcat-tile--beauty .lbcat-go{background:rgba(36,25,21,.08)}
    a.lbcat-tile--beauty:focus-visible{outline-color:#8E403A}
    .lbcat-tile--soon{background:linear-gradient(140deg,#F3E4DD 0%,#E9D3C8 55%,#DDBFB2 100%);color:#3A2A24;cursor:default}
    .lbcat-tile--soon::after{background:none}
    .lbcat-pill{position:absolute;top:10px;inset-inline-end:10px;padding:4px 9px;border-radius:999px;background:#FFFFFF;color:#3A2A24;
      font-size:11px;font-weight:900}
    @media(max-width:767px){
      .lbcat{padding:14px 16px 4px}
      .lbcat-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
      .lbcat-tile{aspect-ratio:16/10;border-radius:10px}
      .lbcat-txt{inset-inline:10px;bottom:8px}
      .lbcat-txt b{font-size:14px}
      .lbcat-txt small{font-size:9.5px;letter-spacing:.1em}
      .lbcat-go{width:24px;height:24px;font-size:12px}
    }
    @media(prefers-reduced-motion:reduce){ .lbcat-tile img,.lbcat-arch{transition:none} }
  </style>
  <div class="lbcat-in">
    <h2 class="lbcat-h" id="lbcat-h">تسوق حسب القسم <span>Shop by category</span></h2>
    <div class="lbcat-grid">
      <a class="lbcat-tile" href="{{ routes.all_products_collection_url }}" data-cro-event="home_category_click" data-cro-label="clothing">
        {%- if cat_cloth_img -%}<img src="{{ cat_cloth_img | image_url: width: 640 }}" alt="" width="640" height="800" loading="lazy" decoding="async">{%- endif -%}
        <span class="lbcat-go" aria-hidden="true">←</span>
        <span class="lbcat-txt"><b>حوايج</b><small>Clothing{% if cat_cloth_n > 0 %} · {{ cat_cloth_n }}{% endif %}</small></span>
      </a>
      {%- if cat_sn_n > 0 -%}
      <a class="lbcat-tile" href="{{ cat_sn.url }}" data-cro-event="home_category_click" data-cro-label="sneakers">
        {%- if cat_sn_img -%}<img src="{{ cat_sn_img | image_url: width: 640 }}" alt="" width="640" height="800" loading="lazy" decoding="async">{%- endif -%}
        <span class="lbcat-go" aria-hidden="true">←</span>
        <span class="lbcat-txt"><b>صبابط</b><small>Sneakers · {{ cat_sn_n }}</small></span>
      </a>
      {%- endif -%}
      {%- if cat_jk_n > 0 -%}
      <a class="lbcat-tile" href="{{ cat_jk.url }}" data-cro-event="home_category_click" data-cro-label="jackets">
        {%- if cat_jk_img -%}<img src="{{ cat_jk_img | image_url: width: 640 }}" alt="" width="640" height="800" loading="lazy" decoding="async">{%- endif -%}
        <span class="lbcat-go" aria-hidden="true">←</span>
        <span class="lbcat-txt"><b>جاكيطات</b><small>Jackets · {{ cat_jk_n }}</small></span>
      </a>
      {%- endif -%}
      {%- if cat_acc_n > 0 -%}
      <a class="lbcat-tile" href="{{ cat_acc.url }}" data-cro-event="home_category_click" data-cro-label="accessories">
        {%- if cat_acc_img -%}<img src="{{ cat_acc_img | image_url: width: 640 }}" alt="" width="640" height="800" loading="lazy" decoding="async">{%- endif -%}
        <span class="lbcat-go" aria-hidden="true">←</span>
        <span class="lbcat-txt"><b>إكسسوارات</b><small>Accessories · {{ cat_acc_n }}</small></span>
      </a>
      {%- endif -%}
      {%- if cat_frag_av > 0 -%}
      <a class="lbcat-tile lbcat-tile--wide lbcat-tile--frag" href="{{ cat_frag.url }}" data-cro-event="home_category_click" data-cro-label="fragrances">
        <span class="lbcat-arches" aria-hidden="true">
          <span class="lbcat-arch"><img src="{{ 'lbass-frag-cdn.webp' | asset_url }}" alt="" width="427" height="637" loading="lazy" decoding="async"></span>
          <span class="lbcat-arch lbcat-arch--mid"><img src="{{ 'lbass-frag-khamrah.webp' | asset_url }}" alt="" width="446" height="561" loading="lazy" decoding="async"></span>
          <span class="lbcat-arch"><img src="{{ 'lbass-frag-rose.webp' | asset_url }}" alt="" width="492" height="720" loading="lazy" decoding="async"></span>
        </span>
        <span class="lbcat-go" aria-hidden="true">←</span>
        <span class="lbcat-txt"><b>عطور</b><small>Fragrances · {{ cat_frag_av }}</small></span>
      </a>
      {%- endif -%}
    </div>
  </div>
</section>
