{%- comment -%} 2026-10-11 SPEED 3: the homepage's main <style> block, moved here VERBATIM from templates/index.liquid (which renders it at the same spot) because that template had reached Shopify's 256 KB file limit, where larger uploads are silently dropped. Pure CSS, no Liquid; the page output is unchanged. {%- endcomment -%}
<style>
/* ════════════════ TOKENS ════════════════ */
:root{
  --ink:#0A0A0B; --ink2:#121214; --ink3:#1A1A1E; --line:#26262B; --line2:#34343B;
  --gold:#C89A0E; --gold2:#E0B52A; --gold-dim:rgba(200,154,14,.14); --gold-br:rgba(200,154,14,.35);
  --sand:#EDE4D3; --sand2:#E2D5BC; --clay:#B4502A; --clay2:#D4683E;
  --green:#1FA855; --green2:#27C063;
  --txt:#D8D4CC; --txt2:#97928A; --txt3:#5E5A55; --cream:#F4EFE6;
  --ar:'Tajawal',sans-serif; --lt:'Space Grotesk',sans-serif;
  --r-sm:10px; --r-md:16px; --r-lg:24px;
  --tr:.28s cubic-bezier(.4,0,.2,1);
  --pad:clamp(18px,5vw,64px);
  --max:1500px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
/* `clip` prevents horizontal bleed without creating a scroll container that breaks the sticky hero. */
html{scroll-behavior:smooth;overflow-x:clip}
body{background:var(--ink);color:var(--txt);font-family:var(--ar);font-size:16px;line-height:1.7;overflow-x:clip;max-width:100%}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer;font-size:inherit}
input,select{font-family:inherit}
::selection{background:var(--gold);color:var(--ink)}
.ltr{direction:ltr;unicode-bidi:embed}
.num{font-family:var(--lt);direction:ltr;unicode-bidi:embed}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:4px}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

/* ════════════════ STAR MOTIF ════════════════ */
.star8{display:inline-block;width:1em;aspect-ratio:1;vertical-align:-0.12em}
.star8 svg{width:100%;height:100%;display:block}
.hero-star-bg{aspect-ratio:1}
.pviz-star{aspect-ratio:1}
.nl-star{aspect-ratio:1}

/* ════════════════ ANNOUNCE BAR ════════════════ */
.announce{background:var(--gold);color:var(--ink);font-weight:800;font-size:13px;overflow:hidden;white-space:nowrap;position:relative;z-index:60}
.announce-track{display:inline-flex;gap:0;padding:9px 0;animation:annMarquee 42s linear infinite;will-change:transform}
.announce span{display:inline-flex;align-items:center;gap:10px;padding:0 28px}
.announce b{font-weight:900}
@keyframes annMarquee{to{transform:translateX(50%)}}

/* ════════════════ NAV ════════════════ */
.lb-bar{position:sticky;top:0;z-index:56;background:rgba(200,154,14,.13);border-bottom:1px solid rgba(200,154,14,.22);backdrop-filter:blur(8px);overflow:hidden;height:36px;display:flex;align-items:center}
.lb-bar-track{display:flex;align-items:center;gap:0;white-space:nowrap;animation:lbMarquee 50s linear infinite}
.lb-bar-item{display:inline-flex;align-items:center;gap:7px;padding:0 32px;font-size:12.5px;font-weight:800;color:var(--gold2);letter-spacing:.03em}
.lb-bar-sep{color:rgba(200,154,14,.5);font-size:10px}
@keyframes lbMarquee{0%{transform:translateX(0)}100%{transform:translateX(50%)}}
@media(max-width:480px){.lb-bar-item{padding:0 20px;font-size:11.5px}}
@media(prefers-reduced-motion:reduce){.lb-bar-track{animation:none}}
.nav{position:sticky;top:36px;z-index:55;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px var(--pad);background:rgba(9,9,10,.94);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px;flex-shrink:0}
.brand-logo{display:block;width:clamp(154px,15vw,196px);height:auto;transition:transform .35s ease,filter .35s ease}
.brand-monogram{display:none;width:38px;height:38px;transition:transform .35s ease,filter .35s ease}
.brand:hover .brand-logo,.brand:hover .brand-monogram{transform:translateY(-1px);filter:drop-shadow(0 0 10px rgba(200,154,14,.22))}
.nav-links{display:flex;gap:6px;align-items:center}
.nav-a{padding:9px 15px;border-radius:50px;font-weight:700;font-size:14.5px;color:var(--txt);transition:var(--tr)}
.nav-a:hover{color:var(--cream);background:var(--ink3)}
.nav-a.hot{color:var(--clay2)}
.nav-acts{display:flex;align-items:center;gap:8px}
.icon-b{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);transition:var(--tr);position:relative;font-size:18px}
.icon-b:hover{border-color:var(--gold-br);background:var(--gold-dim)}
.icon-b .bub{position:absolute;top:-4px;left:-4px;min-width:19px;height:19px;border-radius:10px;background:var(--gold);color:var(--ink);font-size:11px;font-weight:900;display:flex;align-items:center;justify-content:center;padding:0 5px;font-family:var(--lt)}
.nav-wa{display:inline-flex;align-items:center;gap:9px;background:var(--green);color:#fff;font-weight:800;font-size:14px;padding:11px 22px;border-radius:50px;transition:var(--tr)}
.nav-wa:hover{background:var(--green2);transform:translateY(-1px)}
.burger{display:none;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);flex-direction:column;align-items:center;justify-content:center;gap:5px}
.burger i{display:block;width:18px;height:2px;background:var(--cream);border-radius:2px;transition:var(--tr)}
@media(max-width:1020px){.nav-links{display:none}.nav-wa{display:none}.burger{display:flex}}
@media(max-width:560px){
  .nav{padding:12px 16px;gap:10px}
  .brand{gap:8px}
      .brand-logo{width:154px}
  .nav-acts{gap:6px}
  .icon-b{width:40px;height:40px;font-size:16px}
  #wishBtn{display:none}
}
@media(max-width:340px){.brand-logo{display:none}.brand-monogram{display:block}.icon-b{width:38px;height:38px}}

/* mobile menu */
.mmenu{position:fixed;inset:0;z-index:90;background:var(--ink);transform:translateY(-100%);transition:transform .45s cubic-bezier(.7,0,.3,1);display:flex;flex-direction:column;padding:max(20px,env(safe-area-inset-top)) 24px 32px}
.mmenu.open{transform:translateY(0)}
.mmenu-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8vh}
.mmenu-x{width:46px;height:46px;border-radius:50%;border:1px solid var(--line2);font-size:18px;display:flex;align-items:center;justify-content:center}
.mmenu-a{display:flex;align-items:baseline;justify-content:space-between;padding:17px 4px;border-bottom:1px solid var(--line);font-size:clamp(26px,7vw,38px);font-weight:900;color:var(--cream)}
.mmenu-a small{font-family:var(--lt);font-size:12px;color:var(--txt3);letter-spacing:.2em}
.mmenu-foot{margin-top:auto;display:flex;flex-direction:column;gap:12px}
.mmenu-wa{display:flex;align-items:center;justify-content:center;gap:10px;background:var(--green);color:#fff;font-weight:800;padding:17px;border-radius:var(--r-md);font-size:16px}
.mmenu-note{text-align:center;font-size:12.5px;color:var(--txt2)}

/* ════════════════ HERO ════════════════ */
.hero{position:relative;height:175svh;min-height:0;background:var(--ink)}
/* The tighter track keeps the film immersive without leaving a black tail. */
.hero-sticky{position:sticky;top:0;height:100svh;display:grid;align-items:end;overflow:hidden;isolation:isolate;background:var(--ink)}
.hero-media{position:absolute;inset:0;z-index:-2}
.hero-frames{position:absolute;inset:-24px -14px;z-index:0;transform:translate3d(0,0,0) scale(1.045);transform-origin:center center;will-change:transform}
.hero-poster,.hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;backface-visibility:hidden;transform:none}
.hero-poster{image-orientation:from-image}
.hero-poster{z-index:0}
.hero-video{z-index:1;opacity:0;will-change:opacity}
.hero-video.is-ready{opacity:1}
.hero-sticky::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(10,10,11,.46) 0%,rgba(10,10,11,.12) 38%,rgba(10,10,11,.52) 72%,rgba(10,10,11,.78) 100%)}
.hero-star-bg{position:absolute;top:8%;left:-6%;width:min(46vw,520px);opacity:.07;color:var(--gold);z-index:-1;animation:slowspin 90s linear infinite}
@keyframes slowspin{to{transform:rotate(360deg)}}
.hero-in{position:relative;z-index:1;padding:0 var(--pad) clamp(36px,7vh,84px);max-width:1500px;width:100%;margin:0 auto;will-change:transform,opacity}
.hero-scroll{position:absolute;z-index:2;left:clamp(12px,2.2vw,32px);top:50%;display:flex;align-items:center;gap:10px;writing-mode:vertical-rl;color:rgba(244,239,230,.72);font-family:var(--lt);font-size:9px;font-weight:700;letter-spacing:.28em;pointer-events:none;will-change:opacity}
.hero-scroll i{display:block;width:1px;height:48px;background:linear-gradient(180deg,var(--gold2),rgba(242,208,96,.12))}
.hero-kicker{display:inline-flex;align-items:center;gap:10px;background:rgba(10,10,11,.55);border:1px solid var(--gold-br);color:var(--gold2);font-weight:800;font-size:13px;padding:8px 18px;border-radius:50px;backdrop-filter:blur(8px);margin-bottom:22px}
.hero-h{font-size:clamp(42px,9vw,118px);line-height:1.02;font-weight:900;color:var(--cream);margin-bottom:10px}
.hero-h .ln{display:block;overflow:hidden}
.hero-h .ln>span{display:inline-block;will-change:transform}
.hero-h em{font-style:normal;color:var(--gold)}
.hero-lt{font-family:var(--lt);font-weight:700;letter-spacing:.3em;font-size:clamp(11px,1.4vw,15px);color:var(--txt);text-transform:uppercase;direction:ltr;text-align:right;margin-bottom:26px;opacity:.9}
.hero-sub{max-width:560px;font-size:clamp(15px,1.8vw,18.5px);color:var(--txt);margin-bottom:30px}
.hero-sub strong{color:var(--gold2)}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:34px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:800;font-size:15.5px;padding:17px 38px;border-radius:50px;transition:var(--tr);position:relative;overflow:hidden}
.btn-gold{background:var(--gold);color:var(--ink)}
.btn-gold:hover{background:var(--gold2);transform:translateY(-2px);box-shadow:0 14px 40px rgba(200,154,14,.3)}
.btn-line{border:1px solid rgba(244,239,230,.35);color:var(--cream);backdrop-filter:blur(6px)}
.btn-line:hover{border-color:var(--cream);background:rgba(244,239,230,.08)}
.btn-wa{background:var(--green);color:#fff}
.btn-wa:hover{background:var(--green2)}
.hero-proof{display:flex;gap:0;flex-wrap:wrap;border-top:1px solid rgba(244,239,230,.16)}
.hp-item{padding:18px clamp(16px,3vw,40px) 0;border-left:1px solid rgba(244,239,230,.14)}
.hp-item:last-child{border-left:none}
.hp-item:first-child{padding-right:0}
.hp-num{font-family:var(--lt);font-weight:700;font-size:clamp(22px,3vw,32px);color:var(--cream);direction:ltr;text-align:right}
.hp-num b{color:var(--gold)}
.hp-lbl{font-size:12.5px;color:var(--txt2);font-weight:700}
@media(max-width:640px){
  .hero{height:175svh;min-height:0}
  .hero-proof{display:grid;grid-template-columns:1fr 1fr;gap:0}
  .hp-item{padding:14px 14px 0;border-left:none!important}
  .hero-ctas .btn{flex:1;min-width:150px;padding:16px 18px}
}
@media(min-width:768px){.hero{height:195vh}}
@media(prefers-reduced-motion:reduce){
  /* Reduced motion keeps the accessible poster and removes video seeking. */
  .hero{height:100svh}
  .hero-sticky{position:relative;top:auto}
  .hero-frames{transform:none!important}
  .hero-video{display:none!important}
  .hero-poster{opacity:1!important}
  .hero-in{transform:none!important;opacity:1!important}
  .hero-scroll{display:none}
}

/* ════════════════ MARQUEE ════════════════ */
.mq{border-block:1px solid var(--line);background:var(--ink2);overflow:hidden;white-space:nowrap;padding:15px 0}
.mq-track{display:inline-flex;animation:annMarquee 52s linear infinite}
.mq span{display:inline-flex;align-items:center;gap:14px;padding:0 30px;font-family:var(--lt);font-weight:500;letter-spacing:.12em;font-size:13.5px;color:var(--txt2);direction:ltr}
.mq .s{color:var(--gold)}

/* ════════════════ SECTION SHELL ════════════════ */
.sec{padding:clamp(64px,10vw,120px) var(--pad)}
.sec-in{max-width:1500px;margin:0 auto}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:clamp(28px,5vw,52px);flex-wrap:wrap}
.kick{display:flex;align-items:center;gap:10px;color:var(--gold);font-weight:800;font-size:13.5px;letter-spacing:.06em;margin-bottom:12px}
.kick::before{content:"";width:26px;height:1px;background:var(--gold)}
.h2{font-size:clamp(30px,5.4vw,58px);line-height:1.12;font-weight:900;color:var(--cream)}
.h2 em{font-style:normal;color:var(--gold)}
.sec-sub{margin-top:12px;color:var(--txt2);max-width:520px;font-size:15.5px}
.see-all{font-family:var(--lt);font-weight:700;font-size:13px;letter-spacing:.18em;color:var(--cream);display:inline-flex;align-items:center;gap:10px;padding-bottom:6px;border-bottom:1px solid var(--line2);transition:var(--tr);direction:ltr}
.see-all:hover{color:var(--gold);border-color:var(--gold)}
/* reveals: hidden only when JS confirms it'll animate (html.anim). IntersectionObserver adds .in.
   No-JS users and the watchdog keep everything visible — content can never get stuck hidden. */
html.anim .rev{opacity:0;transform:translateY(32px);transition:opacity .8s cubic-bezier(.4,0,.2,1),transform .8s cubic-bezier(.4,0,.2,1)}
html.anim .rev.in{opacity:1;transform:none}
.hero-h .ln>span{transition:transform .9s cubic-bezier(.5,0,.2,1)}
html.anim .hero-h .ln>span{transform:translateY(110%)}
html.anim .hero-h.in .ln>span{transform:translateY(0)}
html.anim .hero-h.in .ln:nth-child(2)>span{transition-delay:.12s}

/* ════════════════ THE DROP RAIL ════════════════ */
.drop-rail{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 4px 22px;scrollbar-width:none;cursor:grab;direction:ltr;scroll-padding-inline:4px}
.drop-rail::-webkit-scrollbar{display:none}
.drop-card{flex:0 0 clamp(238px,24vw,310px);scroll-snap-align:start;direction:rtl}

/* ════════════════ PRODUCT CARD ════════════════ */
.pcard{position:relative;border-radius:var(--r-md);overflow:hidden;background:var(--ink2);border:1px solid var(--line);transition:transform var(--tr),border-color var(--tr),box-shadow var(--tr);display:flex;flex-direction:column}
#dropRail .pcard,#pgrid .pcard{display:flex!important;visibility:visible;opacity:1}
.pcard:hover{transform:translateY(-6px);border-color:var(--gold-br);box-shadow:0 24px 60px rgba(0,0,0,.5)}
.pviz{position:relative;aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;overflow:hidden}
.pviz img{width:100%;height:100%;object-fit:cover;display:block}
.drop-card .pviz{background:linear-gradient(145deg,#171719,#0d0d0e)}
.drop-card .pviz img{object-position:center center;transform:none}
.drop-card .pinfo-brand,.drop-card .pname{direction:ltr;unicode-bidi:isolate;text-align:left}
.drop-card .pname{min-height:42px;-webkit-line-clamp:2;line-height:1.32}
.drop-card .prow,.drop-card .psizes,.drop-card .pmeta-row{direction:ltr}
.drop-card .pdelivery{text-align:right}
.pviz-bg{position:absolute;inset:0}
.pviz-star{position:absolute;width:150%;opacity:.06;color:#fff;transition:transform .8s ease}
.pcard:hover .pviz-star{transform:rotate(22deg) scale(1.06)}
.pviz-ico{font-size:clamp(54px,7vw,84px);filter:drop-shadow(0 16px 30px rgba(0,0,0,.45));transition:transform .5s cubic-bezier(.2,.9,.24,1);z-index:1}
.pcard:hover .pviz-ico{transform:scale(1.12) rotate(-4deg)}
.pviz-brand{position:absolute;bottom:12px;inset-inline:0;text-align:center;font-family:var(--lt);font-weight:700;font-size:11px;letter-spacing:.34em;color:rgba(244,239,230,.65);text-transform:uppercase;direction:ltr}
.pbadges{position:absolute;top:12px;right:12px;display:flex;flex-direction:column;gap:6px;z-index:2}
.pb{font-size:10.5px;font-weight:900;padding:5px 11px;border-radius:30px;width:fit-content}
.pb-new{background:rgba(200,154,14,.92);color:var(--ink)}
.pb-best{background:rgba(180,80,42,.92);color:#fff}
.pb-drop{background:rgba(244,239,230,.92);color:var(--ink)}
.pb-grade{background:rgba(10,10,11,.72);color:var(--cream);border:1px solid rgba(244,239,230,.2)}
.pwish{position:absolute;top:12px;left:12px;z-index:2;width:38px;height:38px;border-radius:50%;background:rgba(10,10,11,.82);display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--cream);transition:var(--tr)}
.pwish:hover{background:var(--clay);transform:scale(1.08)}
.pwish.on{background:var(--clay);color:#fff}
.pquick{position:absolute;inset-inline:12px;bottom:12px;z-index:2;display:flex;gap:8px;opacity:0;transform:translateY(10px);transition:var(--tr)}
.pcard:hover .pquick{opacity:1;transform:translateY(0)}
.pquick button{flex:1;padding:12px;border-radius:var(--r-sm);font-weight:800;font-size:13px}
.pq-cart{background:rgba(244,239,230,.94);color:var(--ink)}
.pq-cart:hover{background:var(--gold)}
.pq-view{background:rgba(10,10,11,.7);color:var(--cream);border:1px solid rgba(244,239,230,.25)}
.pinfo{padding:15px 16px 17px}
.pinfo-brand{font-family:var(--lt);font-size:10.5px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase;direction:ltr;text-align:right}
.pname{font-size:15.5px;font-weight:800;color:var(--cream);margin:3px 0 8px;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.prow{display:flex;align-items:center;justify-content:space-between;gap:10px}
.pprice{font-family:var(--lt);font-weight:700;font-size:17px;color:var(--gold);direction:ltr}
.pold{font-family:var(--lt);font-size:12.5px;color:var(--txt3);text-decoration:line-through;direction:ltr}
/* Monetary saving on the two Liquid-rendered homepage rails. Clay rather than
   gold: gold is the PRICE colour on this page, and the saving must not compete
   with the number the customer pays. */
.psaving{margin:3px 0 0;font-family:var(--lt);font-size:12px;font-weight:900;color:var(--clay);direction:rtl;text-align:start;letter-spacing:.01em}
.psaving [dir=ltr]{font-variant-numeric:tabular-nums}
/* The "Real" rail has no .psave slot, so the percentage needs its own chip. */
.real-off{font-family:var(--lt);font-size:11px;font-weight:900;color:var(--clay);direction:ltr;
  padding:2px 7px;border-radius:30px;border:1px solid var(--clay);font-variant-numeric:tabular-nums}
.psave{font-size:11px;font-weight:900;color:var(--clay2);direction:ltr}
.psizes{display:flex;gap:5px;margin-top:10px;flex-wrap:wrap}
.psz{font-family:var(--lt);font-size:10.5px;font-weight:500;color:var(--txt2);border:1px solid var(--line);border-radius:6px;padding:2px 7px;direction:ltr}
/* ════════════════ GRID + FILTERS ════════════════ */
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}
@media(max-width:640px){.pgrid{grid-template-columns:1fr 1fr;gap:10px}.pinfo{padding:11px 12px 13px}.pname{font-size:13.5px}
  /* mobile: no hover — tap card opens PDP; show one compact add button */
  .pquick{opacity:1;transform:none;gap:0;inset-inline:auto;left:10px;bottom:10px}
  .pquick .pq-view{display:none}
  .pquick .pq-cart{flex:none;width:42px;height:42px;padding:0;border-radius:50%;font-size:22px;line-height:1;display:flex;align-items:center;justify-content:center;font-weight:700;box-shadow:0 6px 18px rgba(0,0,0,.45)}
  .pquick .pq-cart .lbl{display:none}
  .pcard{cursor:pointer}
}
.fbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:26px}
.fpill{padding:10px 20px;border-radius:50px;border:1px solid var(--line2);font-weight:700;font-size:13.5px;color:var(--txt);transition:var(--tr)}
.fpill:hover{border-color:var(--gold-br);color:var(--cream)}
.fpill.on{background:var(--gold);color:var(--ink);border-color:var(--gold)}
.fsort{margin-right:auto;background:var(--ink2);border:1px solid var(--line2);color:var(--txt);border-radius:50px;padding:10px 18px;font-weight:700;font-size:13.5px;appearance:none;cursor:pointer}

.fcount{font-size:13px;color:var(--txt3);font-weight:700}
@media(max-width:640px){.fbar{overflow-x:auto;flex-wrap:nowrap;padding-bottom:8px;scrollbar-width:none}.fbar::-webkit-scrollbar{display:none}.fsort{margin-right:0}}

/* ════════════════ REAL SHOPIFY PRODUCT GRID ════════════════ */
.real-products{position:relative}
.real-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.real-card{display:flex!important;visibility:visible!important;opacity:1!important;flex-direction:column;overflow:hidden;border-radius:var(--r-md);border:1px solid var(--line);background:var(--ink2);color:inherit;text-decoration:none;transition:transform var(--tr),border-color var(--tr),box-shadow var(--tr)}
.real-card:hover{transform:translateY(-5px);border-color:var(--gold-br);box-shadow:0 24px 60px rgba(0,0,0,.5)}
.real-media{position:relative;aspect-ratio:4/5;background:#101113;overflow:hidden;margin:0}
.real-media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .75s cubic-bezier(.2,.7,.2,1)}
.real-card:hover .real-media img{transform:scale(1.045)}
.real-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--gold);font-family:var(--lt);font-weight:800;letter-spacing:.18em;text-align:center;text-transform:uppercase;padding:20px}
.real-badge{position:absolute;top:12px;right:12px;border:1px solid rgba(244,239,230,.24);border-radius:999px;background:rgba(10,10,11,.72);color:var(--cream);font-size:11px;font-weight:900;padding:6px 10px}
.real-info{padding:14px 15px 16px}
.real-vendor{font-family:var(--lt);font-size:10.5px;font-weight:800;letter-spacing:.2em;color:var(--gold);text-transform:uppercase;direction:ltr;text-align:right;margin:0 0 5px}
.real-title{font-size:15.5px;line-height:1.35;font-weight:900;color:var(--cream);margin:0 0 10px;min-height:42px}
.real-row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.real-price{font-family:var(--lt);font-size:17px;font-weight:900;color:var(--gold);direction:ltr;white-space:nowrap}
.real-size{font-family:var(--lt);font-size:11px;font-weight:700;color:var(--txt2);border:1px solid var(--line);border-radius:7px;padding:3px 7px;direction:ltr;max-width:52%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.real-empty-state{grid-column:1/-1;border:1px solid var(--line);border-radius:var(--r-md);padding:26px;background:var(--ink2);color:var(--txt2)}
.real-empty-state h3{color:var(--cream);font-size:20px;margin:0 0 8px}
@media(max-width:640px){
  .real-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .real-info{padding:11px 12px 13px}
  .real-title{font-size:13.5px;min-height:38px}
  .real-price{font-size:15px}
  .real-size{max-width:58%;font-size:10px}
}

/* ════════════════ CATEGORY MOSAIC ════════════════ */
/* ════════════════ Editorial Category Mosaic (v2) ════════════════ */
.cats{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:minmax(210px,24vh);gap:14px;max-width:var(--max);margin:0 auto}
.cat{position:relative;border-radius:var(--r-md);overflow:hidden;border:1px solid var(--line);display:flex;flex-direction:column;justify-content:flex-end;padding:22px;isolation:isolate;text-decoration:none;color:inherit;transition:border-color .35s ease,box-shadow .35s ease,transform .35s ease;min-height:180px}
.cat:hover,.cat:focus-visible{border-color:var(--gold-br);box-shadow:0 24px 60px -16px rgba(0,0,0,.55);transform:translateY(-3px)}
.cat:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.cat-bg{position:absolute;inset:0;z-index:-2;background-size:cover;background-position:center;background-repeat:no-repeat;transition:transform .9s cubic-bezier(.2,.7,.2,1);will-change:transform}
.cat:hover .cat-bg{transform:scale(1.04) translateY(-6px)}
.cat::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(10,10,11,.15) 0%,rgba(10,10,11,.55) 55%,rgba(10,10,11,.92) 100%);transition:opacity .3s ease}
.cat:hover::before{opacity:.95}
.cat::after{content:"";position:absolute;left:22px;right:22px;bottom:0;height:2px;background:linear-gradient(90deg,var(--gold) 0%,var(--gold2) 50%,transparent 100%);opacity:0;transform:translateY(2px);transition:opacity .35s ease,transform .35s ease}
.cat:hover::after,.cat:focus-visible::after{opacity:1;transform:translateY(0)}
.cat-idx{position:absolute;top:18px;right:18px;font-family:var(--lt);font-size:11px;font-weight:700;letter-spacing:.25em;color:var(--gold2);direction:ltr;opacity:.85}
.cat-t{font-weight:900;font-size:clamp(20px,2.4vw,28px);color:var(--cream);line-height:1.15;margin:0 0 6px;letter-spacing:-.01em}
.cat-c{font-family:var(--lt);font-size:11.5px;color:var(--gold2);letter-spacing:.18em;direction:ltr;text-align:right;font-weight:700;margin:0 0 4px;text-transform:uppercase}
.cat-d{font-size:13.5px;color:var(--txt);font-weight:600;margin:6px 0 0;line-height:1.5;max-width:36ch;display:none}
.cat.big .cat-d,.cat.wide .cat-d{display:block}
.cat-cta{display:inline-flex;align-items:center;gap:6px;margin-top:12px;font-family:var(--ar);font-size:13.5px;font-weight:800;color:var(--cream);opacity:0;transform:translateY(8px);transition:opacity .3s ease,transform .3s ease}
.cat:hover .cat-cta,.cat:focus-visible .cat-cta{opacity:1;transform:translateY(0)}
.cat.big{grid-column:span 3;grid-row:span 2}
.cat.wide{grid-column:span 3}
.cat:not(.big):not(.wide){grid-column:span 2}
@media(max-width:900px){
  /* horizontal swipe carousel — show full + peek of next */
  .cats{display:flex;grid-template-columns:none;grid-auto-rows:auto;gap:14px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;padding:0 20px 14px;margin:0 -20px;scrollbar-width:none}
  .cats::-webkit-scrollbar{display:none}
  .cat{flex:0 0 78%;min-height:0;aspect-ratio:4/5;scroll-snap-align:start;padding:18px;grid-column:auto !important;grid-row:auto !important;min-height:380px}
  .cat-cta{opacity:1;transform:none} /* always visible on touch */
  .cat-d{display:block;font-size:13px}
  .cat:hover{transform:none} /* avoid lift on touch */
  .cat:active .cat-bg{transform:scale(1.02)} /* tap feedback */
}
@media(prefers-reduced-motion:reduce){
  .cat,.cat *,.cat::before,.cat::after,.cat-bg{transition:none !important;animation:none !important;transform:none !important}
  .cat-cta{opacity:1;transform:none}
}

/* ════════════════ STORY (sand block) ════════════════ */
.story{background:var(--sand);color:var(--ink)}
.story .sec-in{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(28px,6vw,80px);align-items:center}
.story-kick{color:var(--clay);font-weight:800;font-size:13.5px;display:flex;align-items:center;gap:10px;margin-bottom:14px}
.story-kick::before{content:"";width:26px;height:1px;background:var(--clay)}
.story-h{font-size:clamp(30px,4.8vw,54px);font-weight:900;line-height:1.14;color:#161310;margin-bottom:20px}
.story-h em{font-style:normal;color:var(--clay)}
.story-p{font-size:clamp(15px,1.8vw,18px);color:#3E3830;margin-bottom:14px;max-width:560px}
.story-p strong{color:#161310}
.story-stats{display:flex;gap:34px;margin-top:30px;flex-wrap:wrap}
.ss-num{font-family:var(--lt);font-weight:700;font-size:clamp(28px,3.4vw,42px);color:#161310;direction:ltr;text-align:right}
.ss-num b{color:var(--clay)}
.ss-lbl{font-size:13px;font-weight:700;color:#6B6354}
.story-visual{position:relative;border-radius:var(--r-lg);overflow:hidden;aspect-ratio:4/5;border:1px solid rgba(22,19,16,.12)}
.story-visual img{width:100%;height:100%;object-fit:cover}
.story-tag{position:absolute;bottom:18px;right:18px;background:rgba(22,19,16,.85);color:var(--sand);font-weight:800;font-size:13px;padding:10px 18px;border-radius:50px;backdrop-filter:blur(6px)}
@media(max-width:900px){.story .sec-in{grid-template-columns:1fr}.story-visual{aspect-ratio:16/10;order:-1}}

/* ════════════════ EDITORIAL ════════════════ */
.edit{display:grid;grid-template-columns:1fr 1fr;min-height:72svh}
.edit-img{position:relative;overflow:hidden;min-height:380px}
.edit-img img{position:absolute;inset:0;width:100%;height:110%;object-fit:cover;object-position:center 22%;will-change:transform}
.edit-txt{display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,6vw,90px);background:var(--ink2);border-block:1px solid var(--line)}
.edit-h{font-size:clamp(30px,4.4vw,52px);font-weight:900;line-height:1.14;color:var(--cream);margin-bottom:18px}
.edit-h em{font-style:normal;color:var(--gold)}
.edit-p{color:var(--txt2);font-size:16px;max-width:480px;margin-bottom:28px}
.edit-list{display:flex;flex-direction:column;gap:13px;margin-bottom:32px}
.edit-li{display:flex;align-items:center;gap:13px;font-weight:700;color:var(--txt)}
.edit-li i{width:30px;height:30px;border-radius:50%;background:var(--gold-dim);border:1px solid var(--gold-br);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:13px;color:var(--gold);flex-shrink:0}
@media(max-width:900px){.edit{grid-template-columns:1fr}}

/* ════════════════ LOOKBOOK ════════════════ */
.look{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.look-it{position:relative;border-radius:var(--r-md);overflow:hidden;aspect-ratio:3/4;border:1px solid var(--line);isolation:isolate}
.look-it img,.look-it .lk-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s ease}
.look-it:hover img,.look-it:hover .lk-bg{transform:scale(1.07)}
.look-it::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(10,10,11,.75))}
.look-cap{position:absolute;bottom:14px;inset-inline:16px;z-index:1;font-weight:800;font-size:14px;color:var(--cream)}
.look-cap small{display:block;font-family:var(--lt);font-weight:500;font-size:10.5px;letter-spacing:.2em;color:var(--txt2);direction:ltr;text-align:right}
.look-it:nth-child(2),.look-it:nth-child(4){transform:translateY(26px)}
@media(max-width:900px){.look{grid-template-columns:1fr 1fr}.look-it:nth-child(2),.look-it:nth-child(4){transform:none}}

/* ════════════════ REVIEWS ════════════════ */
.revs{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.rev-card{background:var(--ink2);border:1px solid var(--line);border-radius:var(--r-md);padding:26px;display:flex;flex-direction:column;gap:14px;transition:var(--tr)}
.rev-card:hover{border-color:var(--gold-br);transform:translateY(-4px)}
.rev-stars{color:var(--gold);letter-spacing:3px;font-size:14px}
.rev-bought{font-family:var(--lt);font-size:11px;letter-spacing:.1em;color:var(--txt3);direction:ltr;text-align:right}
.rev-txt{font-size:15px;color:var(--txt);line-height:1.85}
.rev-who{display:flex;align-items:center;gap:12px;margin-top:auto}
.rev-av{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--cream);font-size:14px;flex-shrink:0}
.rev-name{font-weight:800;color:var(--cream);font-size:14px}
.rev-city{font-size:12px;color:var(--txt3)}
.rev-ver{font-size:11px;color:var(--green2);font-weight:800}
@media(max-width:900px){.revs{grid-template-columns:1fr;gap:12px}}

/* ════════════════ SOCIAL ════════════════ */
.social-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.sg-it{position:relative;aspect-ratio:1;border-radius:var(--r-sm);overflow:hidden;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:34px;isolation:isolate;transition:var(--tr)}
.sg-it:hover{transform:scale(1.04);border-color:var(--gold-br)}
.sg-it .hov{position:absolute;inset:0;background:rgba(10,10,11,.72);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:var(--cream);opacity:0;transition:var(--tr)}
.sg-it:hover .hov{opacity:1}
@media(max-width:760px){.social-grid{grid-template-columns:repeat(3,1fr)}}

/* ════════════════ NEWSLETTER ════════════════ */
.nl{background:linear-gradient(140deg,var(--ink2),var(--ink3));border-block:1px solid var(--line)}
.nl-in{max-width:760px;margin:0 auto;text-align:center}
.nl-star{width:54px;height:54px;color:var(--gold);margin:0 auto 18px;animation:slowspin 40s linear infinite}
.nl-h{font-size:clamp(26px,4.4vw,44px);font-weight:900;color:var(--cream);margin-bottom:12px}
.nl-p{color:var(--txt2);margin-bottom:28px;font-size:15.5px}
.nl-form{display:flex;gap:10px;max-width:520px;margin:0 auto 14px}
.nl-input{flex:1;background:var(--ink);border:1px solid var(--line2);border-radius:50px;padding:16px 24px;color:var(--cream);font-size:15px;min-width:0}
.nl-input::placeholder{color:var(--txt3)}
.nl-input:focus{outline:none;border-color:var(--gold)}
.nl-btn{background:var(--gold);color:var(--ink);font-weight:900;padding:16px 30px;border-radius:50px;transition:var(--tr);flex-shrink:0}
.nl-btn:hover{background:var(--gold2)}
.nl-note{font-size:12.5px;color:var(--txt3)}
@media(max-width:560px){.nl-form{flex-direction:column}.nl-btn{padding:16px}}

/* ════════════════ FOOTER ════════════════ */
.foot{border-top:1px solid var(--line);padding:clamp(48px,7vw,80px) var(--pad) 0}
.foot-in{max-width:1500px;margin:0 auto}
.foot-grid{display:grid;grid-template-columns:1.4fr repeat(4,minmax(0,1fr));gap:clamp(28px,4vw,60px);padding-bottom:48px}
.foot-desc{color:var(--txt2);font-size:14.5px;max-width:340px;margin:16px 0 22px}
.foot-soc{display:flex;gap:10px}
.fs-b{width:44px;height:44px;border-radius:50%;border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;font-size:17px;transition:var(--tr)}
.foot-brand{min-height:44px}
.fs-b img{width:30px;height:30px;display:block;border-radius:50%}
.fs-b:hover{border-color:var(--gold);background:var(--gold-dim)}
.fcol-t{font-family:var(--lt);font-size:11.5px;font-weight:700;letter-spacing:.26em;color:var(--txt3);text-transform:uppercase;margin-bottom:18px;direction:ltr;text-align:right}
.fcol a{display:flex;align-items:center;min-height:44px;padding:0;color:var(--txt2);font-weight:600;font-size:14.5px;transition:var(--tr)}
.fcol a:hover{color:var(--gold2);transform:translateX(-4px)}
.foot-bot{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:22px 0;border-top:1px solid var(--line);font-size:13px;color:var(--txt3)}
.foot-pay{display:flex;align-items:center;gap:8px;font-weight:800}
.foot-pay .tag{border:1px solid var(--line2);border-radius:8px;padding:5px 12px;font-size:11.5px;color:var(--txt2)}
.foot-pay .tag.g{border-color:var(--green);color:var(--green2)}
.giant{overflow:hidden;padding:10px 0 0}
.giant span{display:block;font-family:var(--lt);font-weight:700;font-size:clamp(64px,14vw,210px);line-height:.94;letter-spacing:.02em;color:transparent;-webkit-text-stroke:1px var(--line2);text-align:center;direction:ltr;user-select:none;transition:color .6s ease}
.giant:hover span{color:var(--gold-dim)}
@media(max-width:900px){.foot-grid{grid-template-columns:1fr 1fr}}

/* ════════════════ OVERLAYS: CART / SEARCH / PDP ════════════════ */
.scrim{position:fixed;inset:0;background:rgba(5,5,6,.66);backdrop-filter:blur(4px);z-index:95;opacity:0;pointer-events:none;transition:opacity .3s}
.scrim.show{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;bottom:0;left:0;width:min(440px,100vw);background:var(--ink2);border-right:1px solid var(--line);z-index:96;transform:translateX(-102%);transition:transform .42s cubic-bezier(.7,0,.3,1);display:flex;flex-direction:column}
.drawer.open{transform:translateX(0)}
.dr-head{display:flex;align-items:center;justify-content:space-between;padding:20px 22px;border-bottom:1px solid var(--line)}
.dr-title{font-weight:900;font-size:19px;color:var(--cream)}
.dr-title small{color:var(--txt3);font-weight:700;font-size:13px}
.dr-x{width:40px;height:40px;border-radius:50%;border:1px solid var(--line2);display:flex;align-items:center;justify-content:center}
.ship-bar{padding:14px 22px;border-bottom:1px solid var(--line);font-size:13px;font-weight:700;color:var(--txt)}
.ship-track{height:5px;background:var(--ink);border-radius:4px;margin-top:9px;overflow:hidden}
.ship-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--gold2));border-radius:4px;transition:width .5s ease}
.dr-body{flex:1;overflow-y:auto;padding:16px 18px;display:flex;flex-direction:column;gap:10px}
.cart-empty{margin:auto;text-align:center;padding:30px}
.cart-empty .big{font-size:54px;opacity:.3;margin-bottom:14px}
.ci{display:flex;gap:13px;background:var(--ink3);border:1px solid var(--line);border-radius:var(--r-sm);padding:12px}
.ci-viz{width:74px;height:86px;border-radius:9px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:36px;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.06)}
.ci-viz small{position:absolute;bottom:4px;inset-inline:0;text-align:center;font-family:var(--lt);font-size:7.5px;font-weight:700;letter-spacing:.16em;color:rgba(244,239,230,.7);text-transform:uppercase}
.ci-main{flex:1;min-width:0}
.ci-name{font-weight:800;font-size:14px;color:var(--cream);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ci-meta{font-size:11.5px;color:var(--txt3);font-weight:700;margin:2px 0 8px}
.ci-row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.qty{display:flex;align-items:center;gap:10px;direction:ltr}
.qty button{width:27px;height:27px;border-radius:50%;border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;font-size:15px;transition:var(--tr)}
.qty button:hover{background:var(--gold);color:var(--ink);border-color:var(--gold)}
.qty b{font-family:var(--lt);font-size:14px;min-width:16px;text-align:center}
.ci-price{font-family:var(--lt);font-weight:700;color:var(--gold);direction:ltr;font-size:15px}
.ci-rm{font-size:11px;color:var(--txt3);margin-top:6px}
.ci-rm:hover{color:var(--clay2)}
.dr-promo{display:flex;gap:8px;padding:0 18px 12px}
.dr-promo input{flex:1;background:var(--ink);border:1px solid var(--line2);border-radius:var(--r-sm);padding:12px 16px;color:var(--cream);font-size:13.5px;min-width:0}
.dr-promo button{background:var(--ink3);border:1px solid var(--line2);border-radius:var(--r-sm);padding:12px 18px;font-weight:800;font-size:13px}
.dr-foot{border-top:1px solid var(--line);padding:18px 22px calc(18px + env(safe-area-inset-bottom))}
.dr-total{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.dr-total b{font-family:var(--lt);font-size:24px;color:var(--cream);direction:ltr}
.dr-cod{font-size:12px;color:var(--txt2);text-align:center;margin-top:10px;font-weight:700}
.dr-wa{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:var(--green);color:#fff;font-weight:900;font-size:15.5px;padding:17px;border-radius:var(--r-sm);transition:var(--tr)}
.dr-wa:hover{background:var(--green2)}

/* search overlay */
.search-ov{position:fixed;inset:0;z-index:96;background:rgba(10,10,11,.92);backdrop-filter:blur(14px);display:flex;flex-direction:column;align-items:center;padding:12vh var(--pad) 40px;opacity:0;pointer-events:none;transition:opacity .3s}
.search-ov.show{opacity:1;pointer-events:auto}
.search-box{width:min(680px,100%);display:flex;align-items:center;gap:14px;border-bottom:2px solid var(--line2);padding-bottom:14px}
.search-box input{flex:1;background:none;border:none;color:var(--cream);font-size:clamp(20px,3.6vw,30px);font-weight:800;outline:none;font-family:var(--ar)}
.search-box input::placeholder{color:var(--txt3)}
.search-res{width:min(680px,100%);margin-top:24px;display:flex;flex-direction:column;gap:8px;overflow-y:auto}
.sr-it{display:flex;align-items:center;gap:14px;background:var(--ink2);border:1px solid var(--line);border-radius:var(--r-sm);padding:12px 16px;transition:var(--tr);text-align:right;width:100%}
.sr-it:hover{border-color:var(--gold-br)}
.sr-ico{font-size:26px}
.sr-name{font-weight:800;color:var(--cream);font-size:14.5px;flex:1}
.sr-price{font-family:var(--lt);color:var(--gold);font-weight:700;direction:ltr}

/* PDP overlay */
.pdp{position:fixed;inset:0;z-index:97;background:var(--ink);transform:translateY(102%);transition:transform .5s cubic-bezier(.7,0,.3,1);overflow-y:auto;overscroll-behavior:contain}
.pdp.open{transform:translateY(0)}
.pdp-bar{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:14px var(--pad);background:rgba(10,10,11,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.pdp-back{display:inline-flex;align-items:center;gap:9px;font-weight:800;font-size:14px;color:var(--txt)}
.pdp-back:hover{color:var(--cream)}
.pdp-in{max-width:1280px;margin:0 auto;padding:clamp(20px,4vw,48px) var(--pad) 140px;display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(24px,5vw,72px);align-items:start}
.pdp-gal{position:relative;align-self:start}
.pdp-main-viz{position:relative;aspect-ratio:4/5;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--line);display:flex;align-items:center;justify-content:center}
.pdp-main-viz .pviz-ico{font-size:clamp(90px,12vw,150px)}
.pdp-nav{position:absolute;top:50%;z-index:3;width:54px;height:54px;border-radius:50%;border:1px solid rgba(244,239,230,.34);background:linear-gradient(180deg,rgba(31,31,34,.92),rgba(10,10,11,.82));color:var(--cream);display:flex;align-items:center;justify-content:center;font-size:0;line-height:1;cursor:pointer;transform:translateY(-50%);transition:background .18s,border-color .18s,box-shadow .18s,transform .18s;box-shadow:0 14px 32px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.08);backdrop-filter:blur(10px);touch-action:manipulation;direction:ltr;unicode-bidi:isolate}
.pdp-nav::before{content:"";width:13px;height:13px;border-top:3px solid currentColor;border-right:3px solid currentColor;display:block}
.pdp-nav::after{content:"";position:absolute;inset:-10px;border-radius:50%}
.pdp-nav.prev{left:18px}
.pdp-nav.next{right:18px}
.pdp-nav.prev::before{transform:rotate(225deg)}
.pdp-nav.next::before{transform:rotate(45deg)}
.pdp-nav:hover,.pdp-nav:focus-visible{background:linear-gradient(180deg,var(--gold2),var(--gold));border-color:var(--gold);color:var(--ink);box-shadow:0 18px 42px rgba(200,154,14,.24),0 12px 28px rgba(0,0,0,.36);transform:translateY(-50%) scale(1.05);outline:none}
.pdp-nav:active{transform:translateY(-50%) scale(.96)}
.pdp-count{position:absolute;right:14px;bottom:14px;z-index:3;border:1px solid rgba(244,239,230,.26);border-radius:999px;background:rgba(10,10,11,.72);color:var(--cream);font-family:var(--lt);font-size:12px;font-weight:800;direction:ltr;padding:6px 11px}
.pdp-thumbs{display:flex;gap:10px;margin-top:12px}
.pdp-th{width:72px;height:84px;border-radius:10px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:26px;transition:var(--tr)}
.pdp-th.on,.pdp-th:hover{border-color:var(--gold)}
.pdp-brand{font-family:var(--lt);font-size:12px;font-weight:700;letter-spacing:.3em;color:var(--gold);text-transform:uppercase;direction:ltr;text-align:right}
.pdp-name{font-size:clamp(26px,3.6vw,40px);font-weight:900;color:var(--cream);line-height:1.18;margin:8px 0 14px}
.pdp-meta{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.pdp-grade{font-size:12px;font-weight:900;padding:7px 14px;border-radius:30px;background:var(--gold-dim);border:1px solid var(--gold-br);color:var(--gold2)}
.pdp-stock{font-size:12.5px;font-weight:800;color:var(--clay2)}
.pdp-prices{display:flex;align-items:baseline;gap:14px;margin-bottom:22px}
.pdp-price{font-family:var(--lt);font-weight:700;font-size:clamp(28px,4vw,40px);color:var(--gold);direction:ltr}
.pdp-old{font-family:var(--lt);font-size:17px;color:var(--txt3);text-decoration:line-through;direction:ltr}
.pdp-save{background:var(--clay);color:#fff;font-weight:900;font-size:12px;padding:5px 12px;border-radius:30px;direction:ltr}
.pdp-lbl{font-weight:800;font-size:13.5px;color:var(--txt2);margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.pdp-lbl button{font-size:12px;color:var(--gold);font-weight:700;text-decoration:underline}
.pdp-sizes{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:24px}
.sz{min-width:52px;padding:12px 16px;border-radius:var(--r-sm);border:1px solid var(--line2);font-family:var(--lt);font-weight:700;font-size:14px;transition:var(--tr);direction:ltr}
.sz:hover{border-color:var(--cream)}
.sz.on{background:var(--cream);color:var(--ink);border-color:var(--cream)}
.pdp-ctas{display:flex;gap:11px;margin-bottom:14px}
.pdp-cart{flex:1;padding:17px;border-radius:var(--r-sm);background:var(--cream);color:var(--ink);font-weight:900;font-size:15.5px;transition:var(--tr)}
.pdp-cart:hover{background:var(--gold)}
.pdp-wa{flex:1;display:flex;align-items:center;justify-content:center;gap:9px;padding:17px;border-radius:var(--r-sm);background:var(--green);color:#fff;font-weight:900;font-size:15.5px;transition:var(--tr)}
.pdp-wa:hover{background:var(--green2)}
.pdp-trust{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px}
.pt-chip{font-size:12px;font-weight:800;color:var(--txt2);border:1px solid var(--line);border-radius:30px;padding:7px 14px}
.acc{border-top:1px solid var(--line)}
.acc summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;padding:17px 2px;font-weight:800;font-size:15px;color:var(--cream)}
.acc summary::-webkit-details-marker{display:none}
.acc summary::after{content:"+";font-family:var(--lt);color:var(--gold);font-size:20px;transition:transform .25s}
.acc[open] summary::after{content:"−"}
.acc-body{padding:0 2px 18px;color:var(--txt2);font-size:14.5px;line-height:1.9}
.acc-body table{width:100%;border-collapse:collapse;font-size:13.5px}
.acc-body td{padding:8px 4px;border-bottom:1px solid var(--line)}
.acc-body td:last-child{font-family:var(--lt);direction:ltr;text-align:left;color:var(--txt)}
.pdp-rel{grid-column:1/-1;margin-top:30px}
.pdp-rel-h{font-weight:900;font-size:22px;color:var(--cream);margin-bottom:18px}
.pdp-sticky{position:fixed;bottom:0;inset-inline:0;z-index:98;display:none;gap:10px;align-items:center;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:rgba(10,10,11,.96);border-top:1px solid var(--line);transition:transform .35s cubic-bezier(.7,0,.3,1)}
.pdp-sticky.tuck{transform:translateY(130%)}
.pdp-sticky .info{flex:1;min-width:0}
.pdp-sticky .nm{font-weight:800;font-size:13px;color:var(--cream);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pdp-sticky .pr{font-family:var(--lt);font-weight:700;color:var(--gold);font-size:15px;direction:ltr;text-align:right}
.pdp-sticky button{padding:14px 22px;border-radius:var(--r-sm);font-weight:900;font-size:14px;flex-shrink:0}
@media(max-width:900px){
  .pdp-in{grid-template-columns:1fr;padding-bottom:170px}
  .pdp-gal{position:static}
  .pdp.open ~ nav{display:none}
  body.pdp-open .pdp-sticky{display:flex}
}

/* toast */
.toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(14px);background:var(--ink3);border:1px solid var(--gold-br);color:var(--cream);padding:13px 26px;border-radius:50px;font-weight:700;font-size:14px;z-index:120;opacity:0;pointer-events:none;transition:all .3s;white-space:nowrap;box-shadow:0 14px 44px rgba(0,0,0,.55)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* wa float */
.waf{position:fixed;bottom:24px;right:24px;z-index:80;width:56px;height:56px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;box-shadow:0 10px 34px rgba(0,0,0,.45);transition:var(--tr)}
.waf:hover{transform:scale(1.1);background:var(--green2)}
.waf svg{width:27px;height:27px;fill:#fff}
@media(max-width:640px){.waf{bottom:18px;right:16px;width:52px;height:52px}}

/* ════════════════ ENHANCEMENTS ════════════════ */
/* preloader */
.preload{position:fixed;inset:0;z-index:200;background:var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;transition:opacity .7s ease,visibility .7s}
.preload.done{opacity:0;visibility:hidden}
.preload-star{width:72px;height:72px;color:var(--gold)}
.preload-star svg{width:100%;height:100%;display:block;animation:plspin 2.4s cubic-bezier(.6,0,.3,1) infinite}
@keyframes plspin{0%{transform:rotate(0) scale(.85);opacity:.5}50%{transform:rotate(180deg) scale(1);opacity:1}100%{transform:rotate(360deg) scale(.85);opacity:.5}}
.preload-word{font-family:var(--lt);font-weight:700;letter-spacing:.5em;font-size:13px;color:var(--txt2);padding-right:.5em;direction:ltr;overflow:hidden;white-space:nowrap}
.preload-bar{width:120px;height:2px;background:var(--line2);border-radius:2px;overflow:hidden}
.preload-bar i{display:block;height:100%;width:0;background:var(--gold);transition:width .3s ease}

/* hero webgl canvas */
#heroFx{position:absolute;inset:0;z-index:2;pointer-events:none;mix-blend-mode:screen;opacity:.9}

/* custom cursor (desktop fine-pointer only) */
.cursor,.cursor-dot{position:fixed;top:0;left:0;z-index:300;pointer-events:none;border-radius:50%;mix-blend-mode:difference;will-change:transform;translate:-50% -50%}
.cursor{width:34px;height:34px;border:1.5px solid #fff;transition:width .25s,height .25s,background .25s,opacity .25s;opacity:0}
.cursor-dot{width:5px;height:5px;background:#fff;opacity:0}
.cursor.hover{width:58px;height:58px;background:rgba(255,255,255,.12);border-color:transparent}
.cursor.down{width:26px;height:26px}
@media(hover:hover)and(pointer:fine){body.cursor-on{cursor:none}body.cursor-on a,body.cursor-on button,body.cursor-on .pcard{cursor:none}.cursor.on,.cursor-dot.on{opacity:1}}
@media(hover:none),(pointer:coarse){.cursor,.cursor-dot{display:none}}

/* image clip reveal */
html.anim .clip-rev{clip-path:inset(0 0 100% 0)}
.clip-rev{clip-path:inset(0 0 0 0);transition:clip-path 1.1s cubic-bezier(.7,0,.2,1)}
html.anim .clip-rev.in{clip-path:inset(0 0 0 0)}

/* magnetic wrap keeps layout while inner moves */
.mag{display:inline-flex;will-change:transform}
.tilt{transform-style:preserve-3d;will-change:transform}
.tilt .pviz-ico,.tilt .pviz-brand{transform:translateZ(28px)}

/* CTA sheen */
.btn-gold,.pdp-cart,.pq-cart{position:relative;overflow:hidden}
.btn-gold::after,.pdp-cart::after,.pq-cart::after{content:"";position:absolute;top:0;left:-120%;width:55%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.5),transparent);transform:skewX(-18deg);transition:left .6s ease;pointer-events:none}
.btn-gold:hover::after,.pdp-cart:hover::after,.pq-cart:hover::after{left:170%}

/* scroll progress */
.sprog{position:fixed;top:0;left:0;height:3px;width:100%;transform:scaleX(0);transform-origin:0 50%;background:linear-gradient(90deg,var(--gold),var(--gold2));z-index:65;pointer-events:none}
[dir="rtl"] .sprog{transform-origin:100% 50%}

/* ════════════════ PDP v2 ════════════════ */
.pdp-crumb{grid-column:1/-1;display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;font-weight:700;color:var(--txt3);margin-bottom:4px;direction:rtl}
.pdp-crumb button{color:var(--txt2);font-weight:700}
.pdp-crumb button:hover{color:var(--gold)}
.pdp-crumb .sep{opacity:.5}
.pdp-crumb .cur{color:var(--txt)}
/* gallery: real-photo zoom + honest "more photos on WhatsApp" */
.pdp-main-viz.zoomable{cursor:zoom-in}
.pdp-thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:8px;margin-top:12px}
.pdp-thumb{padding:0;background:var(--ink2);border:2px solid var(--line);border-radius:var(--r-sm);overflow:hidden;cursor:pointer;aspect-ratio:4/5;transition:border-color .15s,transform .15s}
.pdp-thumb:hover{border-color:var(--gold2);transform:translateY(-2px)}
.pdp-thumb.on{border-color:var(--gold)}
.pdp-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.pdp-gal-note{display:flex;align-items:center;gap:10px;margin-top:12px;padding:11px 14px;border:1px dashed var(--line2);border-radius:var(--r-sm);font-size:13px;font-weight:700;color:var(--txt2);background:var(--ink2)}
.pdp-gal-note a{color:var(--green2);text-decoration:underline;white-space:nowrap}
.pdp-meas-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(72px,1fr));gap:8px;margin:18px 0 6px}
.pdp-meas-strip .m{background:var(--ink2);border:1px solid var(--line);border-radius:var(--r-sm);padding:9px 8px;text-align:center}
.pdp-meas-strip .m .k{font-size:10.5px;font-weight:700;color:var(--txt3)}
.pdp-meas-strip .m .v{font-family:var(--lt);font-size:14px;font-weight:700;color:var(--cream);direction:ltr}
/* fit guidance */
.pdp-fit{display:flex;align-items:flex-start;gap:10px;background:var(--gold-dim);border:1px solid var(--gold-br);border-radius:var(--r-sm);padding:12px 14px;margin-bottom:18px;font-size:13.5px;color:var(--txt);line-height:1.6}
.pdp-fit b{color:var(--gold2)}
/* size required error */
.pdp-sizes.err .sz{border-color:var(--clay2)}
.pdp-size-err{color:var(--clay2);font-weight:800;font-size:13px;margin:-14px 0 18px;display:none}
.pdp-size-err.show{display:block}
.sz[aria-pressed="true"]{background:var(--cream);color:var(--ink);border-color:var(--cream)}
.sz[disabled]{opacity:.32;text-decoration:line-through;cursor:not-allowed}
/* cart button states */
.pdp-cart.ok{background:var(--green);color:#fff}
.pdp-cart[disabled]{opacity:.7;cursor:default}
/* zoom lightbox */
.zoomlb{position:fixed;inset:0;z-index:120;background:rgba(5,5,6,.94);display:none;align-items:center;justify-content:center;padding:20px}
.zoomlb.show{display:flex}
.zoomlb img{max-width:100%;max-height:100%;border-radius:var(--r-md)}
.zoomlb .x{position:absolute;top:18px;right:18px;width:46px;height:46px;border-radius:50%;border:1px solid var(--line2);color:var(--cream);font-size:20px;display:flex;align-items:center;justify-content:center;background:rgba(10,10,11,.6)}

/* CRO trust and resale clarity layer */
.lb-answer{max-width:var(--max);margin:26px auto 0;padding:0 20px}
.lb-answer p{margin:0;padding:14px 18px;border:1px solid var(--gold-br,rgba(200,154,14,.3));border-radius:var(--r-sm,12px);background:rgba(200,154,14,.05);color:var(--txt);font-size:13.5px;font-weight:700;line-height:1.85}
.lb-answer strong{color:var(--gold2)}
.lb-answer span{display:block;margin-top:4px;color:var(--txt3);font-size:11.5px;font-weight:700}
.trust-strip{max-width:var(--max);margin:24px auto 10px;padding:0 20px;display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.trust-card{background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.018));border:1px solid var(--line);border-radius:var(--r-sm);padding:14px 12px;min-height:88px;display:flex;flex-direction:column;justify-content:center;gap:5px;box-shadow:0 12px 34px rgba(0,0,0,.18)}
.trust-card b{color:var(--cream);font-size:14px}.trust-card span{color:var(--txt3);font-size:12px;font-weight:700;line-height:1.55}
.intent-moments{max-width:var(--max);margin:22px auto 0;padding:0 20px 10px}
.intent-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.intent-card{border:1px solid var(--line);border-radius:var(--r-sm);background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.015));padding:16px;min-height:178px;display:flex;flex-direction:column;gap:9px}
.intent-card i{font-style:normal;font-family:var(--lt);font-size:11px;font-weight:700;letter-spacing:.18em;color:var(--gold);direction:ltr;text-transform:uppercase}
.intent-card b{color:var(--cream);font-size:17px;line-height:1.3}
.intent-card p{color:var(--txt2);font-size:13px;font-weight:700;line-height:1.7;margin:0}
.intent-card a{margin-top:auto;display:inline-flex;width:max-content;border-bottom:1px solid var(--line2);color:var(--gold2);font-weight:900;font-size:12.5px;padding-bottom:3px}
@media(max-width:860px){.intent-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.intent-grid{grid-template-columns:1fr}.intent-card{min-height:auto}}
.value-reminder{padding:clamp(30px,5vw,52px) var(--pad);border-block:1px solid var(--line);background:linear-gradient(90deg,rgba(200,154,14,.12),rgba(31,168,85,.06),rgba(244,239,230,.025))}
.value-reminder.alt{background:linear-gradient(90deg,rgba(244,239,230,.04),rgba(180,80,42,.09),rgba(200,154,14,.08))}
.value-reminder.dark{background:linear-gradient(90deg,rgba(10,10,11,.86),rgba(22,22,25,.98),rgba(200,154,14,.08))}
.value-in{max-width:1500px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center}
.value-k{font-family:var(--lt);font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--gold2);direction:ltr;text-transform:uppercase;margin-bottom:6px}
.value-title{font-size:clamp(23px,3.4vw,38px);line-height:1.14;font-weight:900;color:var(--cream)}
.value-title em{font-style:normal;color:var(--gold)}
.value-copy{color:var(--txt2);font-weight:700;max-width:640px;margin-top:8px}
.value-points{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.value-points span{border:1px solid var(--line2);border-radius:999px;padding:9px 13px;background:rgba(255,255,255,.045);color:var(--txt);font-size:12px;font-weight:900;white-space:nowrap}
.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.proof-card{background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.02));border:1px solid var(--line);border-radius:var(--r-sm);padding:18px;min-height:156px;display:flex;flex-direction:column;justify-content:space-between}
.proof-card i{font-style:normal;font-family:var(--lt);font-size:12px;font-weight:700;letter-spacing:.18em;color:var(--gold);direction:ltr}
.proof-card b{display:block;color:var(--cream);font-size:18px;line-height:1.25;margin:14px 0 8px}
.proof-card span{display:block;color:var(--txt2);font-size:13px;font-weight:700;line-height:1.65}
.home-faq{background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(200,154,14,.055));border-top:1px solid var(--line)}
.home-faq-list{max-width:980px;margin:0 auto;display:grid;gap:10px}
.home-faq details{border:1px solid var(--line);border-radius:var(--r-sm);background:rgba(255,255,255,.035);overflow:hidden}
.home-faq summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 18px;color:var(--cream);font-weight:900}
.home-faq summary::-webkit-details-marker{display:none}
.home-faq summary::after{content:"+";font-family:var(--lt);color:var(--gold);font-size:22px}
.home-faq details[open] summary::after{content:"-"}
.home-faq p{padding:0 18px 18px;color:var(--txt2);font-weight:700;line-height:1.8}
.home-faq b{color:var(--cream)}
.faq-cta{text-align:center;margin-top:28px}
.faq-cta p{padding:0;color:var(--txt2);font-weight:800;margin-bottom:12px}
.faq-also{max-width:980px;margin:22px auto 0;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;color:var(--txt2);font-size:13px;font-weight:800}
.faq-also a{display:inline-block;padding:7px 13px;border:1px solid var(--line);border-radius:30px;color:var(--cream);text-decoration:none}
.faq-also a:hover{border-color:var(--gold)}
.proof-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.ps-card{background:linear-gradient(135deg,rgba(200,154,14,.10),rgba(255,255,255,.03));border:1px solid var(--gold-br);border-radius:var(--r-sm);padding:20px 16px;text-align:center}
.ps-num{display:block;font-family:var(--lt);font-size:clamp(28px,3.5vw,40px);font-weight:700;color:var(--gold);direction:ltr}
.ps-lbl{display:block;font-size:12.5px;font-weight:800;color:var(--txt2);margin-top:4px}
.shop-by{padding-block:clamp(36px,5vw,64px)}
/* lb-origin: Germany → Marrakech → Morocco trust section */
.lb-origin{background:var(--ink3);padding-block:clamp(56px,8vw,96px)}
.lb-origin .sec-in{display:flex;flex-direction:column;gap:32px;max-width:900px}
.lbo-trust-intro{max-width:720px}
.lbo-journey{display:flex;flex-direction:column;gap:4px;margin:4px 0}
.lbo-step{display:flex;align-items:center;gap:16px;padding:14px 20px;border:1px solid var(--gold-br,rgba(200,154,14,.22));border-radius:14px;background:rgba(200,154,14,.05)}
.lbo-step-icon{font-size:28px;flex:none;width:44px;text-align:center}
