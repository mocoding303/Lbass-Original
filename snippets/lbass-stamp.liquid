{% comment %}
  LBASS ORIGINAL — "1/1 STAMP" design system.
  Art direction: bone ground · ink type · one red · zero radius.
  Signature element: the 1/1 die-cut stamp (.psave / .lb-stamp).

  Loaded LAST (after existing theme CSS) so it overrides without editing
  any Liquid logic, section, cart or checkout markup. Purely additive.
  Surface 1 of 3: PRODUCT CARD.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Alexandria:wght@700;900&family=Epilogue:wght@400;500;600;700&display=swap">

<style>
/* ══════════════ TOKENS ══════════════ */
html:root{
  /* ground + ink */
  --lb-bone:#FFFFFF;
  --lb-bone-2:#F4F2ED;      /* recessed panel */
  --lb-ink:#0B0B0C;
  --lb-ink-2:#3A3A3C;       /* secondary text — 9.4:1 on bone */
  --lb-ink-3:#6B6B6E;       /* tertiary — 4.8:1 on bone, AA */
  --lb-rule:#0B0B0C;        /* hairlines are ink, not grey */
  --lb-rule-soft:rgba(11,11,12,.14);
  /* the one accent */
  --lb-red:#BF2E15;         /* 5.1:1 on bone · 5.8:1 white-on — AA */
  --lb-red-deep:#8F1F0D;
  /* type */
  --lb-display:'Anton',Impact,sans-serif;
  --lb-arabic:'Alexandria','Tajawal',system-ui,sans-serif;
  --lb-body:'Epilogue',system-ui,sans-serif;
  /* form */
  --lb-r:0px;
  --lb-ease:cubic-bezier(.2,.9,.24,1);   /* custom snap — not stock material */
  --lb-fast:160ms;
  --lb-med:240ms;

  /* ── LEGACY TOKEN INVERSION ──
     The old world was dark: --ink* were backgrounds, --cream/--txt* were light
     text. Flipping the ground would leave every legacy rule invisible
     (bone text on bone). Rather than chase hundreds of selectors, we invert the
     inherited variables once — the whole cascade follows. Roles swap cleanly
     because --ink and --cream were already each other's opposite. */
  --ink:#FFFFFF;            /* was bg-dark   → now ground */
  --ink2:#F4F2ED;           /* was card-dark → now recessed panel */
  --ink3:#EAE7E0;
  --cream:#0B0B0C;          /* was text-light → now ink text */
  --txt:#1A1A1C;            /* body text on bone — 15.8:1 */
  --txt2:#3A3A3C;           /* secondary — 9.4:1 */
  --txt3:#6B6B6E;           /* tertiary — 4.8:1, AA */
  --line:rgba(11,11,12,.16);
  --line2:rgba(11,11,12,.26);
  --gold:#BF2E15;           /* single accent is now red */
  --gold2:#8F1F0D;          /* deeper red for text-on-bone contrast */
  --gold-br:rgba(191,46,21,.42);
  --gold-dim:rgba(191,46,21,.08);
  --green:#1F7A44;          /* success stays semantic, darkened for bone */
  --green2:#186236;
  --sand:#F4F2ED;
  --sand2:#EAE7E0;
  /* hard edges + custom easing replace the inherited soft/stock values */
  --r-lg:0px; --r-md:0px; --r-sm:0px;
  --tr:240ms cubic-bezier(.2,.9,.24,1);
}

/* [hidden] must win over the theme's display rules (cart badge showed "0") */
[hidden]{ display:none!important; }
/* gold wordmark → ink on bone ground */
.brand-logo,.brand-monogram,.foot-logo{ filter:brightness(0); }

/* ══════════════ SHELL — bone ground ══════════════ */
body{
  background:var(--lb-bone)!important;
  color:var(--lb-ink)!important;
  font-family:var(--lb-body)!important;
}
h1,h2,h3{ color:var(--lb-ink)!important;font-family:var(--lb-arabic)!important;font-weight:900!important;text-wrap:balance; }
h1{ font-size:clamp(30px,7vw,58px)!important;line-height:1.08!important;letter-spacing:-.01em; }
p,li,span,div{ color:inherit; }
a{ color:var(--lb-ink); }
.wrap{ background:transparent; }
.top{
  background:var(--lb-bone)!important;
  border-bottom:1px solid var(--lb-rule)!important;
  backdrop-filter:none!important;
}
.foot{
  background:var(--lb-bone-2)!important;
  border-top:1px solid var(--lb-rule)!important;
  color:var(--lb-ink-2)!important;
}
.foot a{ color:inherit;text-decoration:none; }
.foot a:hover{ color:var(--lb-red)!important; }
.crumb{ color:var(--lb-ink-3)!important;font-family:var(--lb-body)!important;font-size:12px; }
.crumb a{ color:var(--lb-ink-2)!important; }
.lb-cartbtn{ border:1px solid var(--lb-ink)!important;background:transparent!important;color:var(--lb-ink)!important;border-radius:0!important; }
.lb-cartbtn .lb-bub{ background:var(--lb-red)!important;color:#fff!important;border-radius:0!important; }
/* category nav strip */
.lb-catnav{ background:var(--lb-bone)!important;border-bottom:1px solid var(--lb-rule)!important; }
.lb-catnav a{
  border:1px solid var(--lb-rule-soft)!important;border-radius:0!important;
  color:var(--lb-ink-2)!important;font-family:var(--lb-arabic)!important;font-weight:700!important;
}
.lb-catnav a:hover{ border-color:var(--lb-ink)!important;color:var(--lb-ink)!important; }
.lb-catnav a.on{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border-color:var(--lb-ink)!important; }
.lb-catnav-vault{ border-color:var(--lb-red)!important;color:var(--lb-red)!important; }
/* generic chips + buttons on bone */
.chip{ border:1px solid var(--lb-rule-soft)!important;border-radius:0!important;color:var(--lb-ink-2)!important;background:transparent!important;font-family:var(--lb-arabic)!important; }
.btn{ border-radius:0!important;font-family:var(--lb-arabic)!important;font-weight:900!important; }
.btn-c{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border:1px solid var(--lb-ink)!important; }
.btn-g{ background:var(--lb-red)!important;color:#fff!important;border:1px solid var(--lb-red)!important; }
.coll-trust{ background:transparent!important;border:1px solid var(--lb-rule)!important;border-radius:0!important; }
.ct-pill{ background:transparent!important;border:1px solid var(--lb-rule-soft)!important;border-radius:0!important;color:var(--lb-ink-2)!important;font-family:var(--lb-arabic)!important; }
/* dark inline-styled panels inherited from the old world → bone */
.wrap section[style*="var(--ink2)"],
.wrap div[style*="var(--ink2)"]{ background:var(--lb-bone-2)!important;border-color:var(--lb-rule-soft)!important;color:var(--lb-ink-2)!important; }

/* ══════════════ CARD — all three variants unified ══════════════ */
.lbqa-wrap,
.real-grid > a.real-card,
.grid > .lbqa-wrap{ min-width:0; }

.pcard,
.real-card,
.grid .card{
  position:relative;
  display:flex;
  flex-direction:column;
  overflow:visible;                     /* stamp may bleed past edge */
  border:1px solid var(--lb-rule)!important;
  border-radius:var(--lb-r)!important;
  background:var(--lb-bone)!important;
  color:var(--lb-ink)!important;
  box-shadow:none!important;
  transform:none!important;
  transition:box-shadow var(--lb-med) var(--lb-ease),
             transform var(--lb-med) var(--lb-ease)!important;
  text-decoration:none;
}
/* hard offset shadow on hover — print/sticker feel, not glow */
@media (hover:hover){
  .pcard:hover,
  .real-card:hover,
  .grid .card:hover{
    transform:translate(-3px,-3px)!important;
    box-shadow:6px 6px 0 0 var(--lb-ink)!important;
    border-color:var(--lb-ink)!important;
  }
}
.pcard:focus-visible,
.real-card:focus-visible,
.grid .card:focus-visible{
  outline:3px solid var(--lb-red)!important;
  outline-offset:3px!important;
}

/* image well */
.pcard .pviz,
.real-card .real-media,
.grid .card .card-img{
  position:relative;
  aspect-ratio:4/5;
  overflow:hidden;
  border-radius:0!important;
  border-bottom:1px solid var(--lb-rule);
  background:var(--lb-bone-2)!important;
}
.pcard .pviz img,
.real-card .real-media img,
.grid .card .card-img img{
  width:100%;height:100%;
  object-fit:cover;
  display:block;
  transform:none!important;
  transition:transform 500ms var(--lb-ease)!important;
}
@media (hover:hover){
  .pcard:hover .pviz img,
  .real-card:hover .real-media img,
  .grid .card:hover .card-img img{ transform:scale(1.04)!important; }
}

/* ── SIGNATURE: the 1/1 die-cut stamp ──
   A rotated red label riding the lower-left edge of the image well, like a
   lot number stapled to a garment. It encodes the actual inventory fact:
   one of one. Snaps square on hover. */
.lb-stamp,
.pcard .psave{
  position:absolute;
  z-index:3;
  bottom:10px;
  inset-inline-start:10px;
  display:inline-flex;align-items:center;justify-content:center;
  min-width:54px;height:34px;
  padding:0 11px;
  border:1px solid var(--lb-ink)!important;
  border-radius:0!important;
  background:var(--lb-red)!important;
  color:var(--lb-bone)!important;
  font-family:var(--lb-display)!important;
  font-size:19px!important;font-weight:400!important;line-height:1!important;
  letter-spacing:.03em;
  direction:ltr;
  transform:rotate(-6deg);
  transform-origin:center;
  transition:transform var(--lb-fast) var(--lb-ease);
  white-space:nowrap;
  pointer-events:none;
}
/* .psave already renders inside .prow, so it stays in flow — same stamp, inline */
.pcard .psave{ position:static;transform:rotate(-6deg);align-self:center;flex:none; }
.lb-stamp--sold{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;font-size:15px!important; }
@media (hover:hover){
  .grid .card:hover .lb-stamp,
  .pcard:hover .psave{ transform:rotate(0deg) scale(1.05); }
}

/* condition / new badges — quiet, ink outline on bone */
.pcard .pbadges{ position:absolute;z-index:3;top:8px;inset-inline-end:8px;display:flex;flex-direction:column;gap:5px;align-items:flex-end; }
.pcard .pb{
  border:1px solid var(--lb-ink)!important;
  border-radius:0!important;
  background:var(--lb-bone)!important;
  color:var(--lb-ink)!important;
  font-family:var(--lb-arabic);
  font-size:10.5px;font-weight:700;
  padding:4px 7px;
  letter-spacing:0;
}
.pcard .pb-new{ background:var(--lb-ink)!important;color:var(--lb-bone)!important; }

/* info block */
.pcard .pinfo,
.real-card .real-info,
.grid .card .card-body{ padding:13px 13px 15px!important;background:var(--lb-bone)!important;display:flex;flex-direction:column;gap:7px; }

.pcard .pinfo-brand,
.real-card .real-vendor,
.grid .card .card-vendor{
  margin:0!important;
  font-family:var(--lb-display)!important;
  font-size:11px!important;
  font-weight:400!important;
  letter-spacing:.13em!important;
  text-transform:uppercase;
  color:var(--lb-red)!important;
  direction:ltr;
  text-align:start;
}
.pcard .pname,
.real-card .real-title,
.grid .card .card-title{
  margin:0!important;
  font-family:var(--lb-arabic)!important;
  font-size:14.5px!important;
  font-weight:700!important;
  line-height:1.4!important;
  color:var(--lb-ink)!important;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:2.8em;
}
.pcard .prow,
.real-card .real-row{ display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin:0!important; }
.pcard .pprice,
.real-card .real-price,
.grid .card .card-price{
  font-family:var(--lb-display)!important;
  font-size:22px!important;
  font-weight:400!important;
  letter-spacing:.01em;
  color:var(--lb-ink)!important;
  direction:ltr;
  font-variant-numeric:tabular-nums;
  margin:0!important;
}
.pcard .pold{ color:var(--lb-ink-3)!important;text-decoration:line-through;font-size:12px;font-family:var(--lb-body)!important; }

/* size chips + meta — spec-sheet tone */
.pcard .psizes,.grid .card .chip-sz{ display:flex;flex-wrap:wrap;gap:4px;margin:0!important; }
.pcard .psz,
.real-card .real-size,
.grid .card .chip-sz{
  border:1px solid var(--lb-rule-soft)!important;
  border-radius:0!important;
  background:transparent!important;
  color:var(--lb-ink-2)!important;
  font-family:var(--lb-body)!important;
  font-size:11px!important;font-weight:600!important;
  padding:3px 7px!important;
  letter-spacing:.01em;
}
.pcard .pmeta-row{
  display:flex;flex-wrap:wrap;gap:0;margin:0!important;
  font-family:var(--lb-body);font-size:10.5px;font-weight:600;
  color:var(--lb-ink-3)!important;letter-spacing:.04em;text-transform:uppercase;
}
.pcard .pmeta-row span{ position:relative;padding-inline-end:8px;margin-inline-end:8px; }
.pcard .pmeta-row span:not(:last-child)::after{
  content:"";position:absolute;inset-inline-end:0;top:50%;transform:translateY(-50%);
  width:1px;height:9px;background:var(--lb-rule-soft);
}
.pcard .pdelivery{
  margin:0!important;font-family:var(--lb-body);font-size:11px;font-weight:600;
  color:var(--lb-ink-3)!important;
}
.pcard .pviz-brand{ color:var(--lb-ink-3)!important;font-family:var(--lb-display);letter-spacing:.1em; }

/* condition chip on collection cards */
.grid .card .chip-cond{
  border:1px solid var(--lb-rule-soft)!important;border-radius:0!important;
  background:transparent!important;color:var(--lb-ink-2)!important;
  font-family:var(--lb-arabic)!important;font-size:10.5px!important;font-weight:700!important;
}
.grid .card .chip-sold{
  border:1px solid var(--lb-ink)!important;border-radius:0!important;
  background:var(--lb-ink)!important;color:var(--lb-bone)!important;
  font-family:var(--lb-arabic)!important;font-size:10.5px!important;font-weight:700!important;
}

/* ── quick-add: ink slab, red on press ── */
.lbqa-btn{
  width:100%;
  margin-top:0!important;
  min-height:46px!important;
  padding:11px 14px!important;
  border:1px solid var(--lb-ink)!important;
  border-top:none!important;
  border-radius:0!important;
  background:var(--lb-ink)!important;
  color:var(--lb-bone)!important;
  font-family:var(--lb-arabic)!important;
  font-size:13.5px!important;
  font-weight:900!important;
  letter-spacing:.01em;
  gap:0!important;
  cursor:pointer;
  transition:background var(--lb-fast) var(--lb-ease),color var(--lb-fast) var(--lb-ease)!important;
}
.lbqa-btn .lbqa-en{
  font-family:var(--lb-display)!important;
  font-size:8.5px!important;letter-spacing:.24em!important;
  opacity:.62;font-weight:400!important;
}
@media (hover:hover){ .lbqa-btn:hover{ background:var(--lb-red)!important;color:#fff!important; } }
.lbqa-btn:active{ background:var(--lb-red-deep)!important; }
.lbqa-btn:focus-visible{ outline:3px solid var(--lb-red)!important;outline-offset:2px!important; }
.lbqa-btn.lbqa-sold{
  background:var(--lb-bone-2)!important;color:var(--lb-ink-3)!important;
  border-color:var(--lb-rule-soft)!important;cursor:not-allowed;
}
.lbqa-btn.busy{ opacity:.72; }
.lbqa-btn.done{ background:var(--lb-red)!important;color:#fff!important; }

/* sold-out cards recede but stay legible */
.lb-sold .pcard,.lb-sold .card,.grid > .lb-sold{ opacity:1!important; }
.lb-sold .card-img,.lb-sold .pviz{ filter:grayscale(1) contrast(.96); }

/* ══════════════ motion respect ══════════════ */
@media (prefers-reduced-motion:reduce){
  .pcard,.real-card,.grid .card,
  .lb-stamp,.pcard .psave,.real-card .real-badge,
  .pcard .pviz img,.real-card .real-media img,.grid .card .card-img img,
  .lbqa-btn{ transition:none!important; }
  .pcard:hover,.real-card:hover,.grid .card:hover{ transform:none!important; }
  .pcard:hover .pviz img,.real-card:hover .real-media img,.grid .card:hover .card-img img{ transform:none!important; }
}

/* ══════════════ mobile-first sizing ══════════════ */
@media (max-width:640px){
  .pcard .pname,.real-card .real-title,.grid .card .card-title{ font-size:13.5px!important; }
  .pcard .pprice,.real-card .real-price,.grid .card .card-price{ font-size:19px!important; }
  .lbqa-btn{ min-height:48px!important; }   /* ≥44px tap target */
  .lb-stamp,.pcard .psave{ min-width:48px;height:30px;font-size:17px!important; }
}
/* ══════════════ PDP + HOMEPAGE — hardcoded-dark neutralisation ══════════════
   Some panels paint dark hex/gradients directly (not via tokens), so the
   inverted ground left ink text on a dark slab. These map them onto the
   white world. Structure, copy and behaviour are untouched. */
.pdp-buy-panel{
  background:var(--lb-bone)!important;
  border:1px solid var(--lb-rule)!important;
  border-radius:0!important;
  box-shadow:none!important;
}
.pdp-main-viz,.pdp-thumb{ background:var(--lb-bone-2)!important;border-radius:0!important;border-color:var(--lb-rule-soft)!important; }
.pdp-nav{
  background:var(--lb-bone)!important;border:1px solid var(--lb-ink)!important;
  color:var(--lb-ink)!important;border-radius:0!important;
}
.pdp-count{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border:none!important;border-radius:0!important;font-family:var(--lb-display);letter-spacing:.08em; }
/* faint white tints were invisible on a light ground → ink-tinted panels */
.pdp-mini,.pdp-why,.pdp-selected,.pdp-trio-card,.acc,.pdp-help-row>*{
  background:var(--lb-bone-2)!important;
  border:1px solid var(--lb-rule-soft)!important;
  border-radius:0!important;
}
.pdp-name{ font-family:var(--lb-display)!important;color:var(--lb-ink)!important;letter-spacing:-.01em; }
.pdp-brand{ color:var(--lb-red)!important;font-family:var(--lb-display)!important;letter-spacing:.14em!important; }
.pdp-price{ font-family:var(--lb-display)!important;color:var(--lb-ink)!important;font-variant-numeric:tabular-nums; }
.pdp-grade,.pdp-fit{ background:var(--lb-bone-2)!important;color:var(--lb-ink-2)!important;border:1px solid var(--lb-rule-soft)!important;border-radius:0!important; }
.pdp-stock{ color:var(--lb-red)!important;font-weight:900; }
.pdp-emo-line{ color:var(--lb-ink-2)!important; }
.pdp-cart,#pdpAdd{
  background:var(--lb-ink)!important;color:var(--lb-bone)!important;
  border:1px solid var(--lb-ink)!important;border-radius:0!important;
  font-family:var(--lb-arabic)!important;font-weight:900!important;
}
.pdp-cart:hover:not(:disabled),#pdpAdd:hover:not(:disabled){ background:var(--lb-red)!important;border-color:var(--lb-red)!important; }
#pdpAdd:disabled,#pdpAdd:disabled:hover,.pdp-sticky button:disabled,.pdp-sticky button:disabled:hover{
  background:#D8D2C7!important;border-color:#C2BAAD!important;color:#6B665E!important;
  opacity:1!important;box-shadow:none!important;cursor:not-allowed!important;
}
.pdp-cart:focus-visible,#pdpAdd:focus-visible,.pdp-sticky button:focus-visible,.pdp-sticky a:focus-visible{
  outline:3px solid var(--lb-red)!important;outline-offset:3px!important;
}
.pdp-wa,.dr-wa{ background:var(--lb-bone)!important;color:var(--lb-ink)!important;border:1px solid var(--lb-ink)!important;border-radius:0!important; }
.pdp-sticky{ background:var(--lb-bone)!important;border-top:1px solid var(--lb-rule)!important; }
.pdp-buy-note span{ background:transparent!important;border:1px solid var(--lb-rule-soft)!important;color:var(--lb-ink-2)!important;border-radius:0!important; }
.sz{ background:var(--lb-bone)!important;border:1px solid var(--lb-rule)!important;color:var(--lb-ink)!important;border-radius:0!important;min-height:44px; }
.sz.on,.sz[aria-pressed="true"]{ background:var(--lb-ink)!important;color:var(--lb-bone)!important; }
/* express COD block */
.pdp-express{ background:var(--lb-bone-2)!important;border:1px solid var(--lb-ink)!important;border-radius:0!important; }
.pdp-express summary{ color:var(--lb-ink)!important;font-family:var(--lb-arabic)!important; }
.pdpx-in{ background:var(--lb-bone)!important;color:var(--lb-ink)!important;border:1px solid var(--lb-rule)!important;border-radius:0!important; }
.pdpx-btn{ background:var(--lb-red)!important;color:#fff!important;border-radius:0!important;font-family:var(--lb-arabic)!important; }
.pdpx-note{ color:var(--lb-ink-3)!important; }
/* Judge.me review block (Codex shipped it dark) */
.lbass-reviews{ background:var(--lb-bone)!important;border:1px solid var(--lb-rule)!important;border-radius:0!important; }
.lbass-reviews #judgeme_product_reviews,.lbass-reviews .jm-no-reviews-state,.lbass-reviews .jm-review-item{
  background:var(--lb-bone-2)!important;border-color:var(--lb-rule-soft)!important;border-radius:0!important;
}
.lbass-reviews,.lbass-reviews__title,.lbass-reviews__subtitle,.lbass-reviews .jm-text,
.lbass-reviews .jm-review-content__body,.lbass-reviews .jm-reviewer-info__name{ color:var(--lb-ink)!important; }
.lbass-reviews__guide,.lbass-reviews__trust,.lbass-reviews .jm-no-reviews-state__text{ color:var(--lb-ink-2)!important; }
.lbass-reviews__eyebrow{ color:var(--lb-red)!important;font-family:var(--lb-display)!important; }
.lbass-reviews__topics span{ background:transparent!important;border:1px solid var(--lb-rule-soft)!important;color:var(--lb-ink-2)!important;border-radius:0!important; }
.lbass-reviews [data-testid="write-review-button"]{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border:1px solid var(--lb-ink)!important;border-radius:0!important; }
.jdgm-write-review-modal__content{ background:var(--lb-bone)!important;color:var(--lb-ink)!important; }
.jdgm-write-review-modal__title,.jdgm-write-review-modal__field-label{ color:var(--lb-ink)!important; }
.jdgm-write-review-modal__field-input{ background:var(--lb-bone)!important;color:var(--lb-ink)!important;border:1px solid var(--lb-rule)!important;border-radius:0!important; }

/* ── HOMEPAGE ── */
.nav,.ann{ background:var(--lb-bone)!important;border-bottom:1px solid var(--lb-rule)!important;backdrop-filter:none!important; }
.ann{ background:var(--lb-ink)!important;color:var(--lb-bone)!important; }
.ann *{ color:var(--lb-bone)!important; }
.nav-a,.icon-b{ color:var(--lb-ink)!important; }
.icon-b{ border:1px solid var(--lb-ink)!important;border-radius:0!important;background:transparent!important; }
.nav-wa{ background:var(--lb-red)!important;color:#fff!important;border-radius:0!important;font-family:var(--lb-arabic)!important; }
.burger i{ background:var(--lb-ink)!important; }
.hero{ background:var(--lb-bone)!important; }
.hero-h{ color:var(--lb-ink)!important;font-family:var(--lb-arabic)!important;font-weight:900!important; }
.hero-h em{ color:var(--lb-red)!important;font-style:normal; }
.hero-lt{ color:var(--lb-ink-2)!important;font-family:var(--lb-display)!important; }
.hero-kicker{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border-radius:0!important;border:none!important;font-family:var(--lb-arabic)!important; }
.sec,.sec-in,.value-reminder,.home-faq,.grade-legend-bg,.vault-section{ background:var(--lb-bone)!important; }
.kick{ color:var(--lb-red)!important;font-family:var(--lb-display)!important;letter-spacing:.16em!important; }
.h2{ color:var(--lb-ink)!important;font-family:var(--lb-arabic)!important;font-weight:900!important; }
.h2 em{ color:var(--lb-red)!important;font-style:normal; }
.sec-sub,.value-copy,.foot-desc{ color:var(--lb-ink-2)!important; }
.see-all{ color:var(--lb-ink)!important;border-bottom:2px solid var(--lb-red)!important; }
.trust-card,.intent-card,.grade-card,.proof-card,.inspect-card,.tp-card,.sell-card,.value-points span,.mini-card{
  background:var(--lb-bone-2)!important;border:1px solid var(--lb-rule-soft)!important;border-radius:0!important;color:var(--lb-ink-2)!important;
}
.trust-card b,.intent-card b,.grade-card b,.inspect-card b,.tp-card b,.proof-card b{ color:var(--lb-ink)!important; }
.intent-card i{ color:var(--lb-red)!important;font-family:var(--lb-display)!important; }
.home-faq details{ background:var(--lb-bone-2)!important;border:1px solid var(--lb-rule-soft)!important;border-radius:0!important; }
.home-faq summary{ color:var(--lb-ink)!important;font-family:var(--lb-arabic)!important; }
.home-faq details p{ color:var(--lb-ink-2)!important; }
.lb-answer p{ background:var(--lb-bone-2)!important;border:1px solid var(--lb-ink)!important;border-radius:0!important;color:var(--lb-ink-2)!important; }
.lb-answer strong{ color:var(--lb-red)!important; }
.vault-card{ border:1px solid var(--lb-ink)!important;border-radius:0!important;background:var(--lb-bone-2)!important; }
.vault-card b{ color:var(--lb-bone)!important; }
.vlt-cta{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border:1px solid var(--lb-ink)!important;border-radius:0!important; }
.btn-gold,.look-all-btn{ background:var(--lb-red)!important;color:#fff!important;border:1px solid var(--lb-red)!important;border-radius:0!important;font-family:var(--lb-arabic)!important; }
.mmenu{ background:var(--lb-bone)!important;border-inline-start:1px solid var(--lb-rule)!important; }
.mmenu-a{ color:var(--lb-ink)!important;border-bottom:1px solid var(--lb-rule-soft)!important; }
.marq,.mq-track,.giant{ color:var(--lb-ink)!important;opacity:.06; }
.foot-in,.foot-grid{ background:transparent!important; }
.fs-b{ border:1px solid var(--lb-ink)!important;border-radius:0!important;color:var(--lb-ink)!important; }
.nl-btn{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border-radius:0!important; }
.nl-in{ background:var(--lb-bone)!important;color:var(--lb-ink)!important;border:1px solid var(--lb-rule)!important;border-radius:0!important; }
/* cart drawer on white */
.lbdr{ background:var(--lb-bone)!important;border-inline-end:1px solid var(--lb-rule)!important; }
.lbdr-title,.lbdr-it-n,.lbdr-total b{ color:var(--lb-ink)!important; }
.lbdr-it-m,.lbdr-total span,.lbdr-ship{ color:var(--lb-ink-2)!important; }
.lbdr-it-img{ border:1px solid var(--lb-rule-soft)!important;border-radius:0!important; }
.lbdr-btn-g,#lbdrCheckout{ background:var(--lb-red)!important;color:#fff!important;border-radius:0!important; }
.lbdr-btn-c{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border-radius:0!important; }
.lbdr-x{ border:1px solid var(--lb-ink)!important;color:var(--lb-ink)!important;border-radius:0!important; }
.lbqa-sheet-in{ background:var(--lb-bone)!important;border:1px solid var(--lb-ink)!important;border-radius:0!important; }
.lbqa-sz{ background:var(--lb-bone)!important;color:var(--lb-ink)!important;border:1px solid var(--lb-rule)!important;border-radius:0!important; }

/* ══════════════ HERO — white split: type block | real 1/1 piece ══════════════
   The old hero was a scroll-scrubbed film behind the type. It looked cinematic
   but showed no purchasable item, which quietly contradicted the brand's core
   claim (real photos of the exact piece). The film markup stays in the DOM so
   the scroll JS keeps its references; it is simply no longer the hero. */
.hero{
  background:var(--lb-bone)!important;
  height:auto!important;min-height:0!important;   /* was 1404px of scroll-scrub runway */
  padding:0!important;margin:0!important;
  display:block!important;position:relative!important;
}
.hero-sticky{ background:var(--lb-bone)!important;position:relative!important;top:auto!important; }
.hero::after{ content:none!important; }
.hero-media,.hero-frames,.hero-video,.hero-poster,#heroFx,.hero-star-bg{
  display:none!important;
}
.hero-sticky{
  position:relative!important;
  height:auto!important;min-height:0!important;
  display:grid;
  grid-template-columns:1fr;
  gap:clamp(22px,4vw,44px);
  align-items:center;
  max-width:1240px;margin:0 auto;
  padding:clamp(20px,3.4vw,40px) clamp(16px,4vw,40px) clamp(22px,3vw,40px);
}
.hero-in{ position:relative;z-index:1;text-align:start; }
.hero-h,.hero-h *{ color:var(--lb-ink)!important; }
.hero-h{ font-family:var(--lb-arabic)!important;font-weight:900!important;
  font-size:clamp(38px,7.4vw,88px)!important;line-height:.96!important;letter-spacing:-.025em;margin:10px 0 0!important; }
.hero-h em{ color:var(--lb-red)!important;font-style:normal; }
.hero-lt{ color:var(--lb-ink-3)!important;font-family:var(--lb-display)!important;
  letter-spacing:.18em!important;font-size:clamp(9.5px,1vw,11.5px)!important;margin:14px 0 0!important;line-height:1.5; }
.hero-lt+.hero-lt{ margin-top:2px!important;opacity:.72; }
.hero-sub{ color:var(--lb-ink-2)!important;max-width:46ch;font-size:clamp(13.5px,1.4vw,15px)!important;
  line-height:1.7!important;margin:14px 0 18px!important;padding-top:14px;border-top:1px solid var(--lb-rule-soft); }
.hero-kicker{
  display:inline-block;background:var(--lb-ink)!important;color:var(--lb-bone)!important;
  border:none!important;border-radius:0!important;font-family:var(--lb-arabic)!important;
  font-weight:900!important;font-size:12px!important;padding:8px 14px!important;letter-spacing:0;
}
.hero-ctas{ display:flex;flex-wrap:wrap;gap:10px; }
.hero .btn-gold{ background:var(--lb-red)!important;color:#fff!important;border:1px solid var(--lb-red)!important;border-radius:0!important;min-height:52px;display:inline-flex;align-items:center; }
.hero .btn-line{ background:transparent!important;color:var(--lb-ink)!important;border:1px solid var(--lb-ink)!important;border-radius:0!important;min-height:52px;display:inline-flex;align-items:center; }
.hero-proof{ display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin-top:18px;border-top:1px solid var(--lb-rule); }
.hp-item{ padding:10px 12px;border-bottom:1px solid var(--lb-rule-soft); }
.hp-item:nth-child(odd){ border-inline-end:1px solid var(--lb-rule-soft); }
.hp-num{ font-family:var(--lb-display)!important;font-size:15px!important;color:var(--lb-red)!important;letter-spacing:.12em; }
.hp-lbl{ color:var(--lb-ink-2)!important;font-size:11.5px!important;font-weight:600;line-height:1.5;margin-top:3px; }
.hero-scroll{ display:none!important; }

/* the real piece */
.hero-drop{
  position:relative;display:block;text-decoration:none;
  border:1px solid var(--lb-ink);background:var(--lb-bone);
  transition:transform var(--lb-med) var(--lb-ease),box-shadow var(--lb-med) var(--lb-ease);
}
@media (hover:hover){ .hero-drop:hover{ transform:translate(-4px,-4px);box-shadow:8px 8px 0 0 var(--lb-ink); } }
.hero-drop:focus-visible{ outline:3px solid var(--lb-red);outline-offset:3px; }
.hero-drop-img{ position:relative;aspect-ratio:1/1;overflow:hidden;background:var(--lb-bone-2);border-bottom:1px solid var(--lb-ink); }
.hero-drop-img img{ width:100%;height:100%;object-fit:cover;display:block;transition:transform 600ms var(--lb-ease); }
@media (hover:hover){ .hero-drop:hover .hero-drop-img img{ transform:scale(1.04); } }
.hero-drop-info{ display:grid;gap:5px;padding:14px 15px 16px; }
.hero-drop-kick{ font-family:var(--lb-display);font-size:10.5px;letter-spacing:.2em;color:var(--lb-red); }
.hero-drop-brand{ font-family:var(--lb-display);font-size:12px;letter-spacing:.14em;color:var(--lb-ink-2);direction:ltr; }
.hero-drop-name{ font-family:var(--lb-arabic);font-weight:700;font-size:15px;color:var(--lb-ink);line-height:1.4; }
.hero-drop-row{ display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-top:2px; }
.hero-drop-row b{ font-family:var(--lb-display);font-weight:400;font-size:24px;color:var(--lb-ink);direction:ltr;font-variant-numeric:tabular-nums; }
.hero-drop-go{ font-family:var(--lb-arabic);font-weight:900;font-size:13px;color:var(--lb-red); }

@media (min-width:900px){
  .hero-sticky{
    grid-template-columns:1.2fr .8fr;gap:clamp(30px,4.4vw,56px);
    min-height:calc(100svh - 118px);align-content:center;
  }
  .hero-drop{ max-width:330px;margin-inline-start:auto; }
  /* headline sized so the CTA + proof row clear the fold on a laptop */
  .hero-h{ font-size:clamp(44px,5.1vw,66px)!important; }
  .hero-sub{ margin:12px 0 16px!important;padding-top:12px; }
  .hero-kicker{ font-size:11px!important;padding:7px 12px!important; }
  .hero-proof{ margin-top:16px; }
  .hp-item{ padding:9px 10px; }
  .hero-proof{ grid-template-columns:repeat(4,minmax(0,1fr)); }
  .hp-item:nth-child(odd){ border-inline-end:none; }
  .hp-item:not(:last-child){ border-inline-end:1px solid var(--lb-rule-soft); }
}
@media (prefers-reduced-motion:reduce){
  .hero-drop,.hero-drop-img img{ transition:none!important; }
  .hero-drop:hover{ transform:none!important; }
  .hero-drop:hover .hero-drop-img img{ transform:none!important; }
}

/* ── detector fixes on inherited code ──
   Bounce/elastic easing overshoots and reads dated; the committed motion is a
   single snap curve. The custom cursor animated width/height (layout thrash) —
   same visual via transform. */
.cursor{ transition:transform 200ms var(--lb-ease),opacity 200ms var(--lb-ease),background 200ms var(--lb-ease)!important; }
.cursor.hover{ transform:scale(1.6); }

/* ── WhatsApp CTA — it had gone white-on-white and read as dead ──
   WhatsApp green carries its own recognition; keep it the one green on the page. */
.pdp-wa,.dr-wa,#lbdrWa{
  display:flex!important;align-items:center;justify-content:center;gap:9px;
  width:100%!important;box-sizing:border-box;
  min-height:54px!important;padding:15px 18px!important;
  border:1px solid #0E7A5F!important;border-radius:0!important;
  background:#128C7E!important;color:#fff!important;      /* 4.6:1 with white — AA */
  font-family:var(--lb-arabic)!important;font-weight:900!important;
  font-size:15px!important;line-height:1.2!important;text-decoration:none!important;
  cursor:pointer;
  transition:background var(--lb-fast) var(--lb-ease),transform var(--lb-fast) var(--lb-ease)!important;
}
