          mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.2 14.1c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.3.1 1.6.8 1.9.9.3.2.5.2.5.4.1.1.1.7-.1 1.3Z'/></svg>") center/contain no-repeat; }
@media (hover:hover){ .pdp-wa:hover,.dr-wa:hover,#lbdrWa:hover{ background:#0E7A5F!important;transform:translateY(-1px); } }
.pdp-wa:active,#lbdrWa:active{ transform:translateY(0); }
.pdp-wa:focus-visible,#lbdrWa:focus-visible{ outline:3px solid var(--lb-ink)!important;outline-offset:3px!important; }
@media (prefers-reduced-motion:reduce){ .pdp-wa,.dr-wa,#lbdrWa{ transition:none!important; } .pdp-wa:hover{ transform:none!important; } }

/* PDP hierarchy: Shopify Add to Cart stays primary; WhatsApp is supportive. */
.pdp-buy-panel .pdp-wa{
  min-height:50px!important;padding:13px 17px!important;
  background:transparent!important;color:#0E7A5F!important;
  border-color:#0E7A5F!important;font-size:14.5px!important;
}
.pdp-buy-panel .pdp-wa::before{ background:#0E7A5F!important; }
@media (hover:hover){
  .pdp-buy-panel .pdp-wa:hover{ background:#0E7A5F!important;color:#fff!important; }
  .pdp-buy-panel .pdp-wa:hover::before{ background:#fff!important; }
}
.pdp-sticky .pdp-sticky-add{ background:var(--lb-ink)!important;color:var(--lb-bone)!important;border:1px solid var(--lb-ink)!important; }
.pdp-sticky .pdp-sticky-wa{ width:50px!important;padding:0!important;background:#128C7E!important;color:#fff!important;border:1px solid #0E7A5F!important; }
@media (prefers-reduced-motion:reduce){
  .pdp-cart::after{ display:none!important; }
  .pdp-sticky{ transition:none!important; }
}

/* ── hero proof chips + honest scarcity + 3-piece stack ── */
.hero-chips{ display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:14px 0 0!important;padding:0!important; }
.hero-chips li{
  border:1px solid var(--lb-rule-soft);border-radius:0;
  padding:6px 10px;font-family:var(--lb-arabic);font-weight:800;
  font-size:11.5px;line-height:1.2;color:var(--lb-ink-2);white-space:nowrap;
}
.hero-chips li:first-child{ background:var(--lb-red);border-color:var(--lb-red);color:#fff;font-family:var(--lb-display);letter-spacing:.04em; }
.hero-scarce{ margin:10px 0 0!important;font-family:var(--lb-arabic);font-weight:800;font-size:12.5px;color:var(--lb-ink-3)!important;line-height:1.6; }

.hero-stack{ display:grid;gap:8px;align-content:start; }
.hero-mini{
  display:grid;grid-template-columns:56px 1fr auto;align-items:center;gap:11px;
  padding:8px;border:1px solid var(--lb-rule-soft);background:var(--lb-bone);
  text-decoration:none;min-height:60px;
  transition:border-color var(--lb-fast) var(--lb-ease),transform var(--lb-fast) var(--lb-ease);
}
@media (hover:hover){ .hero-mini:hover{ border-color:var(--lb-ink);transform:translateX(-3px); } }
.hero-mini:focus-visible{ outline:3px solid var(--lb-red);outline-offset:2px; }
.hero-mini img{ width:56px;height:56px;object-fit:cover;display:block;border:1px solid var(--lb-rule-soft); }
.hero-mini-txt{ display:grid;gap:1px;min-width:0; }
.hero-mini-brand{ font-family:var(--lb-display);font-size:9.5px;letter-spacing:.16em;color:var(--lb-red);direction:ltr; }
.hero-mini-name{ font-family:var(--lb-arabic);font-weight:700;font-size:12.5px;color:var(--lb-ink);
  line-height:1.35;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical; }
.hero-mini-meta{ display:grid;justify-items:end;gap:2px; }
.hero-mini-meta b{ font-family:var(--lb-display);font-weight:400;font-size:15px;color:var(--lb-ink);direction:ltr;font-variant-numeric:tabular-nums; }
.hero-mini-11{ font-family:var(--lb-display);font-size:9.5px;color:#fff;background:var(--lb-red);padding:1px 5px;letter-spacing:.04em; }
@media (prefers-reduced-motion:reduce){ .hero-mini{ transition:none!important; } .hero-mini:hover{ transform:none!important; } }
@media (min-width:900px){ .hero-stack{ max-width:330px;margin-inline-start:auto; } .hero-drop{ max-width:none!important; } }

/* The compact chips carry the same four claims as .hero-proof in a fraction of
   the height. Keeping both repeated the pitch twice above the fold, so the
   verbose grid retires here — the detail still lives in the trust strip and the
   6-point inspection section further down the page. */
.hero-proof{ display:none!important; }
.hero-scarce{ margin-bottom:2px!important; }

/* ══════════ HERO — premium polish pass ══════════
   Fewer competing weights, more air, one dominant action. */
.hero-kicker{
  background:transparent!important;color:var(--lb-ink-2)!important;
  border:1px solid var(--lb-rule-soft)!important;
  font-family:var(--lb-display)!important;font-weight:400!important;
  font-size:10.5px!important;letter-spacing:.2em!important;
  padding:7px 13px!important;
}
.hero-h{ margin:18px 0 0!important; }
.hero-lt{ margin-top:16px!important; }
.hero-sub{
  max-width:44ch!important;font-size:clamp(14px,1.45vw,15.5px)!important;
  line-height:1.72!important;color:var(--lb-ink-2)!important;
  margin:16px 0 22px!important;padding-top:16px!important;
}
/* one dominant action; the secondary reads as a quiet link-button */
.hero-ctas{ gap:10px!important;margin-bottom:0!important;align-items:stretch; }
.hero .btn-gold{
  padding:0 26px!important;min-height:56px!important;font-size:15.5px!important;
  letter-spacing:0;box-shadow:0 1px 0 0 var(--lb-red-deep)!important;
}
.hero .btn-line{
  padding:0 20px!important;min-height:56px!important;font-size:14px!important;
  border-color:var(--lb-rule-soft)!important;color:var(--lb-ink-2)!important;background:transparent!important;
}
@media (hover:hover){
  .hero .btn-gold:hover{ background:var(--lb-red-deep)!important; }
  .hero .btn-line:hover{ border-color:var(--lb-ink)!important;color:var(--lb-ink)!important; }
}
/* chips: quieter, evenly weighted, one red anchor */
.hero-chips{ gap:5px!important;margin-top:18px!important; }
.hero-chips li{
  padding:5px 10px!important;font-size:11px!important;font-weight:700!important;
  color:var(--lb-ink-3)!important;border-color:var(--lb-rule-soft)!important;
}
.hero-chips li:first-child{
  background:transparent!important;color:var(--lb-red)!important;
  border-color:var(--lb-red)!important;font-weight:400!important;
}
.hero-scarce{ font-size:12px!important;color:var(--lb-ink-3)!important;margin-top:12px!important;font-weight:700!important; }

/* product preview: editorial plate, quiet depth */
.hero-stack{ gap:10px!important; }
.hero-drop{ border-color:var(--lb-rule-soft)!important;box-shadow:0 1px 2px rgba(11,11,12,.05); }
@media (hover:hover){
  .hero-drop:hover{ transform:translate(-3px,-3px)!important;box-shadow:7px 7px 0 0 var(--lb-ink)!important;border-color:var(--lb-ink)!important; }
}
.hero-drop-info{ padding:15px 16px 17px!important;gap:4px!important; }
.hero-drop-kick{ font-size:9.5px!important;letter-spacing:.22em!important;color:var(--lb-ink-3)!important; }
.hero-drop-brand{ font-size:11px!important;color:var(--lb-ink-2)!important; }
.hero-drop-name{ font-size:14.5px!important; }
.hero-drop-row{ margin-top:6px!important;padding-top:10px;border-top:1px solid var(--lb-rule-soft); }
.hero-drop-row b{ font-size:22px!important; }
.hero-drop-go{ font-size:12.5px!important; }
.hero-mini{ border-color:var(--lb-rule-soft)!important;min-height:64px!important;padding:9px!important; }
.hero-mini-name{ font-size:12px!important;color:var(--lb-ink-2)!important; }

