{%- comment -%}
  ═══ VAULT PDP — repaired 2026-08-23 ═══

  This snippet renders EVERY product matching templates/product.liquid line 1:
      {% if product.tags contains 'vault' or product.price >= 70000 %}
  i.e. anything tagged `vault` OR priced at/above 700 MAD. That is the most
  valuable stock in the catalogue, and until today this file shipped four bugs:

  1. NO structured data at all. templates/product.liquid emits Product + Offer +
     BreadcrumbList in its {% else %} branch only, so vault items were invisible
     to Google merchant listings and rich results. Verified 2026-08-23:
     /products/hoka-red-running-shoes → 1 JSON-LD block (Organization only)
     /products/vans-old-skool-black   → 3 blocks incl. Product + BreadcrumbList
     Schema is now emitted at the bottom of this file.

  2. NO image lightbox. A 1199 MAD second-hand shoe with no way to zoom the
     photos, when inspecting the photos IS the purchase decision.

  3. WRONG METAFIELD NAMESPACE. It read `product.metafields.custom.*`, but this
     store writes condition data to `lbass.*`. Every custom.* lookup returned
     nil on all six vault products (verified via Admin API), so every page fell
     through to the defaults below. Now reads lbass.* first, custom.* second.

  4. UNVERIFIED CONDITION CLAIMS — the serious one. Because of bug 3, the
     defaults were what shoppers actually saw:
       • notes defaulted to "ما بان حتى عيب واضح أثناء الفحص" — asserting a
         clean inspection result on items with NO inspection data recorded.
       • condition_label defaulted to 'بحالة مزيانة', so HOKA (really
         new_without_ticket) was understated and others were guesses.
       • the "علاش دخلات للـ Vault؟" block asserted "بحالة ممتازة" by TAG.
     A store whose whole promise is honest condition disclosure must not
     generate condition claims. Nothing below asserts a grade that is not
     recorded on the product. When it is missing, we say so and point to
     WhatsApp — never "no defects found".
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_one_of_one = false
  if product.total_inventory == 1
    assign is_one_of_one = true
  endif

  # Condition: lbass.* is authoritative, custom.* kept as a fallback so any

  # product genuinely using the old namespace keeps working.
  assign cond_val = product.metafields.lbass.condition_status.value
  if cond_val == blank
    assign cond_val = product.metafields.custom.condition.value
  endif

  assign condition_confirmed = false
  assign is_new_condition = false
  assign condition_label = ''

  if cond_val == 'new_with_ticket' or cond_val == 'جديد بالتّيكيت'
    assign condition_label = 'جديد بالتّيكيت'
    assign condition_confirmed = true
    assign is_new_condition = true
  elsif cond_val == 'new_without_ticket' or cond_val == 'جديد بلا تيكيت'
    assign condition_label = 'جديد بلا تيكيت'
    assign condition_confirmed = true
    assign is_new_condition = true
  elsif cond_val == 'excellent_almost_new' or cond_val == 'شبه جديد'
    assign condition_label = 'بحالة ممتازة · شبه جديد'
    assign condition_confirmed = true
  elsif cond_val == 'very_good' or cond_val == 'بحالة مزيانة بزاف'
    assign condition_label = 'بحالة مزيانة بزاف'
    assign condition_confirmed = true
  elsif cond_val == 'good' or cond_val == 'بحالة مزيانة'
    assign condition_label = 'بحالة مزيانة'
    assign condition_confirmed = true
  elsif cond_val == 'needs_note'
    assign condition_label = 'بحالة مزيانة · شوف الملاحظات'
    assign condition_confirmed = true
  endif

  # An owner-written condition label always wins over the mapping above.
  if product.metafields.lbass.condition_label.value != blank
    assign condition_label = product.metafields.lbass.condition_label.value
    assign condition_confirmed = true
  endif
  if condition_label == blank
    assign condition_label = 'الحالة موضحة فالصور — سولنا فالواتساب'
  endif

  # Inspection notes: real data only. No "no defects found" default.
  assign notes = product.metafields.lbass.inspection_notes.value
  if notes == blank
    assign notes = product.metafields.lbass.condition_notes.value
  endif
  if notes == blank
    assign notes = product.metafields.lbass.flaws.value
  endif
  if notes == blank
    assign notes = product.metafields.custom.condition_notes.value
  endif
  assign notes_confirmed = true
  if notes == blank
    assign notes_confirmed = false
    assign notes = 'ملاحظات الفحص المفصّلة مازال ما تزادوش لهاد القطعة. سولنا فالواتساب قبل ما تطلب ونعطيوك التفاصيل.'
  endif

  assign measurements = product.metafields.lbass.measurements.value
  if measurements == blank
    assign measurements = product.metafields.custom.measurements.value
  endif
  if measurements == blank
    assign measurements = 'القياسات بالسنتيمتر مازال ما تزادوش — سولنا فالواتساب ونعطيوهملك.'
  endif

  assign vault_sku = current_variant.sku
  if vault_sku == blank
    assign vault_sku = product.metafields.lbass.product_code.value
  endif
-%}

