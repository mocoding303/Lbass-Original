.vlb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:52px;height:52px;border-radius:50%;border:1px solid rgba(244,239,230,.3);background:rgba(10,10,11,.68);color:#F4EFE6;font-size:26px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;touch-action:manipulation;direction:ltr;unicode-bidi:isolate;padding-bottom:3px}
