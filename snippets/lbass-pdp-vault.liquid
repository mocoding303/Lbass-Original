<div class="wrap">
  <nav class="crumb" aria-label="مسار التصفح" style="margin: 20px 20px 0;">
    <a href="{{ routes.root_url }}">الرئيسية</a> ›
    <a href="/pages/vault">VAULT</a> ›
    <span aria-current="page">{{ product.vendor }}</span>
  </nav>

  <div class="vault-pdp">
    <div class="vault-gallery" id="vaultGallery">
      <div class="vault-gallery-badge">REAL PHOTOS</div>
      {%- comment -%}
        Written as a raw <img> rather than the image_tag filter so each photo can
        carry its own width/height plus the lightbox data-* hooks. Do not hardcode
        a shared ratio: these are one-of-one second-hand photos and they do not
        share one. The lightbox reads data-w/data-h to size each image correctly.

        ── srcset RESTORED 2026-08-23 ──────────────────────────────────────────
        The first version of this loop dropped the responsive output that
        `image_tag` had been generating (srcset at 352w/832w/1000w), so every
        visitor downloaded the single 1000px file. That is a real regression on
        mobile, which is 1,879 of the store's 2,520 impressions. The srcset is
        rebuilt below by hand — same job, but keeping full control of the
        attributes the lightbox needs.

        `sizes` is NEW rather than restored: without it a browser assumes the
        image fills 100vw and over-downloads on desktop, where the gallery
        column is roughly 46vw. The original omitted it.

        Candidate widths are filtered to those the source can actually supply —
        Shopify will not upscale, and listing a width above the original just
        advertises a file that does not exist at that size.
      {%- endcomment -%}
      {% for media in product.media %}
        {%- assign pv = media.preview_image -%}
        {%- capture vault_srcset -%}
          {%- assign w_list = '352,512,832,1000,1400,2000' | split: ',' -%}
          {%- assign w_first = true -%}
          {%- for w in w_list -%}
            {%- assign wn = w | times: 1 -%}
            {%- if wn <= pv.width -%}
              {%- unless w_first %}, {% endunless -%}
              {{ pv | image_url: width: wn }} {{ wn }}w
              {%- assign w_first = false -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        <img class="vault-img"
             src="{{ pv | image_url: width: 1000 }}"
             {% if vault_srcset != blank %}srcset="{{ vault_srcset | strip }}"
             sizes="(min-width: 900px) 46vw, 92vw"{% endif %}
             alt="{{ product.title | escape }}{% if condition_confirmed %} — {{ condition_label | escape }}{% endif %} — صورة {{ forloop.index }} من {{ product.media.size }}"
             width="{{ pv.width }}" height="{{ pv.height }}"
             loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async"
             data-vault-zoom="{{ pv | image_url: width: 2000 }}"
             data-w="{{ pv.width }}" data-h="{{ pv.height }}" data-i="{{ forloop.index0 }}"
             role="button" tabindex="0"
             aria-label="كبّر الصورة {{ forloop.index }} من {{ product.media.size }}">
      {% endfor %}
    </div>

    <div class="vault-info">
      <div class="vault-brand">VAULT · {{ product.vendor }}</div>
      <h1 class="vault-title">{{ product.title }}</h1>

      <div class="vault-facts">
        <div class="vault-fact"><b>الحالة:</b> {{ condition_label }}</div>
        {% unless product.has_only_default_variant %}
          <div class="vault-fact"><b>القياس:</b> {% for v in product.variants %}{{ v.title }}{% unless forloop.last %}, {% endunless %}{% endfor %}</div>
        {% endunless %}
        <div class="vault-fact"><b>التوفر:</b> {% if product.available %}متوفرة دابا{% else %}تباعت{% endif %}</div>
      </div>

      <div class="vault-price">{{ product.price | money }}</div>
      <div class="vault-shipping">🚚 20 د.م. مراكش · 40 د.م. باقي المدن · مجاني +500 د.م.</div>

      {% if product.available %}
        {% form 'product', product, id: 'vaultAddToCartForm' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <button type="submit" class="vault-btn vault-btn-primary">زيدها للسلة</button>
        {% endform %}
      {% else %}
        <button disabled class="vault-btn vault-btn-primary" style="opacity: 0.5;">القطعة تباعت</button>
      {% endif %}

      <a href="https://wa.me/491754264425?text={{ 'سلام Lbass، بغيت نسول على هاد القطعة من VAULT: ' | append: product.title | url_encode }}" class="vault-btn vault-btn-outline" target="_blank">سولنا فالواتساب</a>
      
      <div class="vault-trust-line">صور حقيقية لنفس القطعة · الحالة موضحة · COD أو PayPal</div>

      <div class="vault-passport">
        <h3>تفاصيل القطعة (Passport)</h3>
        <div class="vault-passport-row">
          <div class="vault-passport-label">الحالة</div>
          <div class="vault-passport-val">{{ condition_label }}</div>
        </div>
        <div class="vault-passport-row">
          <div class="vault-passport-label">الملاحظات</div>
          <div class="vault-passport-val">{{ notes }}</div>
        </div>
        <div class="vault-passport-row">
          <div class="vault-passport-label">القياسات</div>
          <div class="vault-passport-val">{{ measurements }}</div>
        </div>
        <div class="vault-passport-row">
          <div class="vault-passport-label">المصدر</div>
          <div class="vault-passport-val">جاية من ألمانيا · تشيكّات فمراكش</div>
        </div>
        <div class="vault-passport-row">
          <div class="vault-passport-label">الصور</div>
          <div class="vault-passport-val">الصور اللي كتشوف هي ديال نفس القطعة المعروضة.</div>
        </div>
      </div>

      <div style="font-size: 13px; font-weight: 700; background: #f8f8f8; padding: 16px; border-radius: 8px; margin-bottom: 30px;">
        <span style="color: #97928A; display: block; margin-bottom: 4px;">علاش دخلات للـ Vault؟</span>
        {%- comment -%}
          Condition claims removed 2026-08-23. This asserted "بحالة ممتازة"
          (excellent condition) purely from a TAG, so a `good`-grade item was
          advertised as excellent. Brand and style framing is fine; the grade
          must come from the recorded metafield or not be stated at all.
        {%- endcomment -%}
        {% if product.tags contains 'vintage' %}قطعة vintage أصلية من {{ product.vendor }}، مختارة ضمن قطع Vault.{% elsif product.tags contains 'sneakers' %}موديل مطلوب من {{ product.vendor }}، واختيار محدود فالمخزون.{% else %}قطعة {{ product.vendor }} بستايل مميز، مختارة ضمن قطع Vault الحالية.{% endif %}{% if condition_confirmed %} الحالة المسجّلة: {{ condition_label }}.{% endif %}
      </div>

      <div class="vault-acc">
        <div class="vault-acc-item">
          <div class="vault-acc-title" onclick="this.parentElement.classList.toggle('is-open')">التوصيل والخلاص <span>+</span></div>
          <div class="vault-acc-content">
            <b>🚚 التوصيل</b><br>
            20 د.م. داخل مراكش<br>
            40 د.م. باقي المدن<br>
            مجاني ابتداءً من 500 د.م.<br><br>
            <b>💵 COD</b><br>
            تقدر تخلص ملي توصلك القطعة وتشوفها.<br><br>
            <b>💳 PayPal</b><br>
            الدفع أونلاين متوفر بكل أمان.<br><br>
            <b>↩ الإرجاع</b><br>
            الإرجاع كيتطبق حسب طريقة الدفع والشروط المنشورة.<br>
            <a href="/pages/shipping-and-payment" style="color: #c89a0e; font-weight: 800;">شوف شروط الإرجاع كاملة →</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="vault-sticky" id="vaultSticky">
  <div style="font-weight: 900; font-size: 18px;">{{ product.price | money }}</div>
  {% if product.available %}
    <button onclick="document.querySelector('#vaultAddToCartForm button').click()" class="vault-btn vault-btn-primary" style="width: auto; margin: 0; padding: 12px 24px;">زيدها للسلة</button>
  {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sticky = document.getElementById('vaultSticky');
  const mainBtn = document.querySelector('#vaultAddToCartForm button');
  if (mainBtn && sticky) {
    const observer = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) {
        sticky.classList.add('is-visible');
      } else {
        sticky.classList.remove('is-visible');
      }
    }, { threshold: 0 });
    observer.observe(mainBtn);
  }
});
</script>

{%- comment -%} ══ VAULT LIGHTBOX — added 2026-08-23 ══ {%- endcomment -%}
<div class="vlb" id="vlb" role="dialog" aria-modal="true" aria-label="صور المنتج" aria-hidden="true">
  <button type="button" class="x" id="vlbX" aria-label="سدّ الصور">✕</button>
  <button type="button" class="vlb__nav vlb__nav--prev" id="vlbPrev" aria-label="الصورة السابقة" hidden>‹</button>
  <figure class="vlb__stage">
    {%- comment -%}
      ImgWidthAndHeight disabled for this one tag on purpose — the SAME reason
      documented in templates/product.liquid: ONE element shows every photo in
      turn and they do not share a ratio. Correct per-image width/height are set
      from data-w/data-h in JS. No CLS to prevent: the modal is display:none.
    {%- endcomment -%}
    {% # theme-check-disable ImgWidthAndHeight %}
    <img class="vlb__img" id="vlbImg" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" decoding="async">
    {% # theme-check-enable ImgWidthAndHeight %}
  </figure>
  <button type="button" class="vlb__nav vlb__nav--next" id="vlbNext" aria-label="الصورة الموالية" hidden>›</button>
  <p class="vlb__count" id="vlbCount" aria-live="polite" hidden></p>
</div>

<script>
(function(){
  var gal = document.getElementById('vaultGallery');
  var lb  = document.getElementById('vlb');
  if(!gal || !lb) return;
  var shots = [].slice.call(gal.querySelectorAll('.vault-img'));
  if(!shots.length) return;

  var img=document.getElementById('vlbImg'), cnt=document.getElementById('vlbCount'),
      prev=document.getElementById('vlbPrev'), next=document.getElementById('vlbNext'),
      closeBtn=document.getElementById('vlbX'), idx=0, lastFocus=null;

  function show(i){
    idx = (i + shots.length) % shots.length;
    var s = shots[idx];
    /* real per-image dimensions — never a shared hardcoded ratio */
    img.width  = s.getAttribute('data-w') || '';
    img.height = s.getAttribute('data-h') || '';
    img.src    = s.getAttribute('data-vault-zoom') || s.src;
    img.alt    = s.getAttribute('alt') || '';
    var many = shots.length > 1;
    prev.hidden = next.hidden = cnt.hidden = !many;
    if(many) cnt.textContent = (idx+1) + ' / ' + shots.length;
  }
  function open(i){
    lastFocus = document.activeElement;
    show(i);
    lb.classList.add('show');
    lb.setAttribute('aria-hidden','false');
    document.body.style.overflow='hidden';
    closeBtn.focus();
  }
  function close(){
    lb.classList.remove('show');
    lb.setAttribute('aria-hidden','true');
    document.body.style.overflow='';
    img.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
    if(lastFocus && lastFocus.focus) lastFocus.focus();
  }

  shots.forEach(function(s,i){
    s.addEventListener('click', function(){ open(i); });
    s.addEventListener('keydown', function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); open(i); }
    });
  });
  closeBtn.addEventListener('click', close);
  prev.addEventListener('click', function(e){ e.stopPropagation(); show(idx-1); });
  next.addEventListener('click', function(e){ e.stopPropagation(); show(idx+1); });
  lb.addEventListener('click', function(e){ if(e.target===lb||e.target.classList.contains('vlb__stage')) close(); });

  document.addEventListener('keydown', function(e){
    if(!lb.classList.contains('show')) return;
    if(e.key==='Escape'){ close(); }
    else if(e.key==='ArrowRight'){ show(idx+1); }
    else if(e.key==='ArrowLeft'){ show(idx-1); }
    else if(e.key==='Tab'){ /* focus trap */
      var f=[closeBtn,prev,next].filter(function(b){return !b.hidden;});
      var i=f.indexOf(document.activeElement);
      e.preventDefault();
      f[(i + (e.shiftKey?-1:1) + f.length) % f.length].focus();
    }
  });

  /* swipe */
  var x0=null,y0=null;
  lb.addEventListener('touchstart',function(e){ x0=e.touches[0].clientX; y0=e.touches[0].clientY; },{passive:true});
  lb.addEventListener('touchend',function(e){
    if(x0===null) return;
    var dx=e.changedTouches[0].clientX-x0, dy=e.changedTouches[0].clientY-y0;
    if(Math.abs(dx)>40 && Math.abs(dx)>Math.abs(dy)) show(idx + (dx<0?1:-1));
    x0=y0=null;
  },{passive:true});
})();
</script>

{%- comment -%}
  ══ VAULT STRUCTURED DATA — added 2026-08-23 ══
  Vault products emitted NO Product/Offer/BreadcrumbList at all, because
  templates/product.liquid only emits them in its {% else %} branch. Mirrors
  that block, with the same two non-negotiable rules:
    • itemCondition / condition claims only when condition_confirmed
    • aggregateRating ONLY when a real review exists (rating_count > 0)
  Breadcrumb matches the VISIBLE breadcrumb above (Home › VAULT › vendor).
{%- endcomment -%}
{%- assign vault_desc = product.description | strip_html | strip | truncate: 300 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  {% if vault_sku != blank %}"sku": {{ vault_sku | json }},{% endif %}
  "productID": "shopify:{{ product.id }}",
  {% if vault_desc != blank %}"description": {{ vault_desc | json }},{% endif %}
  "image": [{% for image in product.images %}"https:{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
  "category": {{ product.type | default: product.product_type | default: 'Apparel' | json }},
  "brand": {"@type": "Brand", "name": {{ product.vendor | json }}},
  {% if condition_confirmed %}"itemCondition": "{% if is_new_condition %}https://schema.org/NewCondition{% else %}https://schema.org/UsedCondition{% endif %}",{% endif %}
  {% unless product.has_only_default_variant %}"size": {{ current_variant.title | json }},{% endunless %}
  "additionalProperty": [
    {"@type": "PropertyValue", "name": "Photos", "value": "{% if is_new_condition %}Photos show the exact item offered for sale{% else %}Photos show the exact second-hand item offered for sale{% endif %}"}
    {% if is_one_of_one %},{"@type": "PropertyValue", "name": "Inventory status", "value": "One-of-one item; one unit is currently offered"}{% endif %}
    {% if condition_confirmed %},{"@type": "PropertyValue", "name": "Condition grade", "value": {{ condition_label | json }}}{% endif %}
    {% if notes_confirmed %},{"@type": "PropertyValue", "name": "Inspection notes", "value": {{ notes | strip_newlines | json }}}{% endif %}
    ,{"@type": "PropertyValue", "name": "Sourcing", "value": "Selected in Germany, checked in Marrakech"}
  ],
  {%- assign v_rating = product.metafields.reviews.rating.value -%}
  {%- assign v_count = product.metafields.reviews.rating_count.value | default: 0 -%}
  {%- if v_count > 0 and v_rating != blank and v_rating.rating != blank -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ v_rating.rating }},
    "reviewCount": {{ v_count }},
    "bestRating": {{ v_rating.scale_max | default: 5 }},
    "worstRating": {{ v_rating.scale_min | default: 1 }}
  },
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ shop.currency | json }},
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "availability": "{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"{% if condition_confirmed %},
    "itemCondition": "{% if is_new_condition %}https://schema.org/NewCondition{% else %}https://schema.org/UsedCondition{% endif %}"{% endif %},
    "inventoryLevel": {"@type": "QuantitativeValue", "value": {{ current_variant.inventory_quantity | at_least: 0 }}}{% if is_one_of_one %},
    "eligibleQuantity": {"@type": "QuantitativeValue", "value": 1, "unitText": "One-of-One"}{% endif %},
    {%- comment -%}
      Declares 40 MAD — the HIGHER of the two Morocco rates — so a Marrakech
      buyer is never charged more than advertised. Free over 500 MAD depends on
      cart total, which a per-product offer cannot express. deliveryTime omitted
      on purpose: no transit figure is published.
    {%- endcomment -%}
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {"@type": "MonetaryAmount", "value": "40", "currency": "MAD"},
      "shippingDestination": {"@type": "DefinedRegion", "addressCountry": "MA"},
      "shippingSettingsLink": "{{ shop.url }}/pages/shipping-and-payment",
      "description": "Delivery from Marrakech: 20 MAD within Marrakech, 40 MAD elsewhere in Morocco, free for orders of 500 MAD or more. Cash on delivery available."
    },
    "seller": {"@id": "{{ shop.url }}/#store"}
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "الرئيسية", "item": {{ shop.url | json }}},
    {"@type": "ListItem", "position": 2, "name": "VAULT", "item": "{{ shop.url }}/pages/vault"},
    {"@type": "ListItem", "position": 3, "name": {{ product.title | json }}}
  ]
}
</script>
