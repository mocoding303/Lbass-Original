.vlb .x{position:absolute;top:14px;right:14px;z-index:2;width:48px;height:48px;border-radius:50%;border:1px solid rgba(244,239,230,.34);color:#F4EFE6;font-size:20px;line-height:1;display:flex;align-items:center;justify-content:center;background:rgba(10,10,11,.72);cursor:pointer;touch-action:manipulation}
