{%- comment -%} stagger delays for the added items + support-list styling {%- endcomment -%}
{% render 'lbass-menu-nav-patch' %}

<script>
(function(){
  var bar=document.getElementById('lbhBar');
  var panel=document.getElementById('lbmPanel');
  var scrim=document.getElementById('lbmScrim');
  var openBtn=document.getElementById('lbmOpen');
  var closeBtn=document.getElementById('lbmClose');
  if(!bar||!panel||!openBtn) return;

  /* This snippet renders at the END of body; the header has to sit at the top.
     Moving server-rendered markup keeps every link crawlable — building it in
     JS would not. */
  var ann=document.querySelector('.announce');
  if(ann && ann.parentNode) ann.parentNode.insertBefore(bar, ann.nextSibling);
  else document.body.insertBefore(bar, document.body.firstChild);

  var lastFocus=null, scrollY=0;
  var FOCUSABLE='a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';

  function focusables(){
    return Array.prototype.filter.call(panel.querySelectorAll(FOCUSABLE),
      function(n){ return n.offsetParent !== null; });
  }
  function unlock(){
    document.body.style.position='';
    document.body.style.top='';
    document.body.style.width='';
  }

  function open(){
    lastFocus=document.activeElement;
    panel.hidden=false; scrim.hidden=false;
    void panel.offsetWidth;                 /* commit before animating */
    panel.classList.add('is-open'); scrim.classList.add('is-open');
    openBtn.setAttribute('aria-expanded','true');
    scrollY=window.scrollY||window.pageYOffset||0;
    document.body.style.position='fixed';   /* scroll lock that survives iOS */
    document.body.style.top=(-scrollY)+'px';
    document.body.style.width='100%';
    document.addEventListener('keydown',onKey);
    (closeBtn||panel).focus({preventScroll:true});
  }

  function close(){
    panel.classList.remove('is-open'); scrim.classList.remove('is-open');
    openBtn.setAttribute('aria-expanded','false');
    unlock(); window.scrollTo(0,scrollY);
    document.removeEventListener('keydown',onKey);
    var t=setTimeout(function(){ panel.hidden=true; scrim.hidden=true; }, 420);
    panel.addEventListener('transitionend',function h(){
      clearTimeout(t); panel.hidden=true; scrim.hidden=true;
      panel.removeEventListener('transitionend',h);
    },{once:true});
    if(lastFocus&&lastFocus.focus) lastFocus.focus({preventScroll:true});
  }

  function onKey(e){
    if(e.key==='Escape'){ e.preventDefault(); close(); return; }
    if(e.key!=='Tab') return;
    var f=focusables(); if(!f.length) return;
    var first=f[0], last=f[f.length-1];
    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
  }

  openBtn.addEventListener('click',open);
  if(closeBtn) closeBtn.addEventListener('click',close);
  scrim.addEventListener('click',close);   /* click the page behind to dismiss */

  panel.addEventListener('click',function(e){
    var t=e.target.closest('.lbm-toggle');
    if(t){
      var sub=document.getElementById(t.getAttribute('aria-controls'));
      var willOpen=t.getAttribute('aria-expanded')!=='true';
      Array.prototype.forEach.call(
        panel.querySelectorAll('.lbm-toggle[aria-expanded="true"]'),function(o){
          if(o===t) return;
          o.setAttribute('aria-expanded','false');
          var s=document.getElementById(o.getAttribute('aria-controls'));
          if(s) s.hidden=true;
        });
      t.setAttribute('aria-expanded', willOpen?'true':'false');
      if(sub) sub.hidden=!willOpen;
      return;
    }
    if(e.target.closest('a[href]')) unlock();
  });

  window.addEventListener('pageshow',function(ev){ if(ev.persisted) unlock(); });
})();
</script>
