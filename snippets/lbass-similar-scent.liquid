{%- comment -%}
  ═══ LBASS — FIND YOUR SIMILAR SCENT (2026-09-28) ═══
  Usage: {% render 'lbass-similar-scent', place: 'collection'|'page', heading: 'h1'|'h2' %}
  Rendered at the bottom of /collections/fragrances (after the grid) and on
  /pages/similar-scent (template page.similar, hidden from search engines).

  DATA — nothing hard-coded:
  · References = metaobject «Scent reference (similar-scent tool)»
    (lbass_scent_reference, Admin → Content → Metaobjects). Same schema as the
    fragrance.* product metafields: accords (12 values), sweetness / freshness /
    warmth (1–5), intensity (estimated from concentration), family, wearer,
    French notes. Sources + derivation rule: Lbass/expansion/2026-09-28-similar-scent.md
  · Candidates = every AVAILABLE product of collections['fragrances'], read from
    the same metafields the consultation uses.

  SCORE (transparent, same numbers as scratchpad model.py):
    accords (Dice overlap)                     35 %
    sweetness / freshness / warmth distance    30 %
    shared notes (top ×1, heart ×1.3, base ×1.6; same note family = half)  25 %
    family words (skipped when either side has none)                        10 %
    × 0.85 if the reference has oud and the bottle has not
    × 0.85 for a men-only ↔ women-only mismatch (unisex never penalised)
  Shown only from 60 %, max 4. Bands: ≥80 very close · ≥70 close · ≥60 some shared character.

  WORDING RULE (owner decision 2026-09-28): "similar scent direction" only —
  never "alternative", "dupe", "copy", "inspired by", never designer prices;
  trademark note at the bottom. Designer names stay out of page titles / URLs.
{%- endcomment -%}
{%- liquid
  assign lbss_place = place | default: 'collection'
  assign lbss_h = heading | default: 'h2'
  assign lbss_c = collections['fragrances']
  assign lbss_refs = shop.metaobjects.lbass_scent_reference.values
-%}
{%- if lbss_refs.size > 0 and lbss_c.products_count > 0 -%}
<section class="lbss" id="lbss" aria-labelledby="lbss-h" data-place="{{ lbss_place }}">
<style>
.lbss{--lbss-ink:var(--cream,#0B0B0C);--lbss-bg:var(--ink,#FFFFFF);--lbss-soft:var(--ink2,#F4F2ED);--lbss-line:var(--line,rgba(11,11,12,.14));--lbss-acc:var(--gold,#BF2E15);
  max-width:1100px;margin:clamp(28px,5vw,56px) auto;padding:0 clamp(16px,4vw,32px);direction:rtl;text-align:right;color:var(--lbss-ink)}
.lbss[data-place="collection"]{padding:0;max-width:none}
.lbss *{box-sizing:border-box}
.lbss__in{border:1px solid var(--lbss-line);border-radius:22px;background:var(--lbss-soft);padding:clamp(20px,4vw,40px)}
.lbss__kick{margin:0 0 10px!important;font-size:11.5px!important;font-weight:800!important;letter-spacing:.2em;color:var(--lbss-acc)!important;direction:ltr;text-align:right}
.lbss__h{margin:0 0 10px!important;font-size:clamp(26px,5vw,42px)!important;line-height:1.1!important;font-weight:900!important;color:var(--lbss-ink)!important;letter-spacing:-.01em}
.lbss__h small{display:block;margin-top:6px;font-size:clamp(15px,2.4vw,19px);font-weight:800;letter-spacing:0;opacity:.75}
.lbss__lede{margin:0 0 22px!important;max-width:64ch;font-size:15px!important;line-height:1.85!important;color:var(--txt2,#57534E)!important}
.lbss__q{margin:0 0 10px!important;font-size:16px!important;font-weight:900!important;color:var(--lbss-ink)!important}
.lbss__search{position:relative;margin:0 0 12px}
.lbss__search input{width:100%;min-height:52px;padding:0 44px 0 16px;border:1.5px solid var(--lbss-line);border-radius:14px;background:var(--lbss-bg);font:inherit;font-size:16px;color:var(--lbss-ink);direction:rtl}
.lbss__search input:focus{outline:none;border-color:var(--lbss-ink)}
.lbss__search svg{position:absolute;inset-inline-start:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;opacity:.55;pointer-events:none}
.lbss__tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0;padding:0;list-style:none}
.lbss__tile{width:100%;min-height:64px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:2px;padding:10px 14px;border:1.5px solid var(--lbss-line);border-radius:14px;background:var(--lbss-bg);font:inherit;color:var(--lbss-ink);cursor:pointer;text-align:left;direction:ltr;transition:border-color .2s,transform .2s,box-shadow .2s}
.lbss__tile:hover{border-color:var(--lbss-ink);transform:translateY(-1px)}
.lbss__tile:focus-visible{outline:3px solid var(--lbss-acc);outline-offset:2px}
.lbss__tile[aria-pressed="true"]{border-color:var(--lbss-ink);box-shadow:0 0 0 1.5px var(--lbss-ink) inset}
.lbss__tile i{font-style:normal;font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;opacity:.6}
.lbss__tile b{font-size:14.5px;font-weight:900;line-height:1.25}
.lbss__all{display:none;margin:10px 0 0;min-height:44px;padding:0 14px;border:1.5px solid var(--lbss-line);border-radius:12px;background:transparent;font:inherit;font-size:13.5px;font-weight:900;color:var(--lbss-ink);cursor:pointer}
.lbss__none{display:none;margin:10px 0 0!important;font-size:14px!important;font-weight:700!important;color:var(--txt2,#57534E)!important}
.lbss__none a{color:var(--lbss-ink);font-weight:900}
.lbss__res{margin-top:26px}
.lbss__res[hidden]{display:none}
.lbss__grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:14px;align-items:start}
.lbss__card{border:1px solid var(--lbss-line);border-radius:18px;background:var(--lbss-bg);padding:clamp(16px,2.6vw,24px)}
.lbss__label{margin:0 0 12px!important;font-size:11px!important;font-weight:800!important;letter-spacing:.18em;color:var(--lbss-acc)!important;direction:ltr;text-align:right;text-transform:uppercase}
.lbss__dna-legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin:0 0 14px;font-size:12.5px;font-weight:800}
.lbss__dna-legend span{display:inline-flex;align-items:center;gap:6px}
.lbss__dot{display:inline-block;width:11px;height:11px;border-radius:50%;background:var(--lbss-ink)}
.lbss__dia{display:inline-block;width:11px;height:11px;transform:rotate(45deg);background:var(--lbss-acc);border-radius:2px}
.lbss__row{display:grid;grid-template-columns:92px 1fr;align-items:center;gap:10px;margin:0 0 14px}
.lbss__row > span{font-size:13px;font-weight:800}
.lbss__track{position:relative;height:18px}
.lbss__track::before{content:"";position:absolute;inset-inline:0;top:50%;height:2px;margin-top:-1px;background:var(--lbss-line);border-radius:2px}
.lbss__track::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(to left,transparent 0,transparent calc(25% - 1px),var(--lbss-line) calc(25% - 1px),var(--lbss-line) 25%);opacity:.5;height:8px;top:5px}
.lbss__m{position:absolute;top:50%;inset-inline-start:0;width:14px;height:14px;margin-inline-start:-7px;margin-top:-7px;transition:inset-inline-start .7s cubic-bezier(.22,.61,.36,1)}
.lbss__m--ref{border-radius:50%;background:var(--lbss-ink);z-index:2;box-shadow:0 0 0 3px var(--lbss-bg)}
.lbss__m--ar{transform:rotate(45deg);background:var(--lbss-acc);border-radius:2px;z-index:1;box-shadow:0 0 0 3px var(--lbss-bg)}
.lbss__dna-note{margin:4px 0 0!important;font-size:11.5px!important;color:var(--txt2,#57534E)!important;line-height:1.6!important}
.lbss__chips{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}
.lbss__chips li{padding:5px 10px;border-radius:999px;background:var(--lbss-soft);font-size:12px;font-weight:800}
.lbss__top{display:grid;grid-template-columns:minmax(110px,190px) 1fr;gap:16px;align-items:start}
.lbss__img{aspect-ratio:1/1;border-radius:14px;overflow:hidden;background:#F6F2EA;display:flex;align-items:center;justify-content:center}
.lbss__img img{width:100%;height:100%;object-fit:contain}
.lbss__vendor{margin:0 0 2px!important;font-size:11px!important;font-weight:800!important;letter-spacing:.14em;text-transform:uppercase;color:var(--lbss-acc)!important;direction:ltr;text-align:right}
.lbss__name{margin:0 0 8px!important;font-size:clamp(18px,2.6vw,22px)!important;font-weight:900!important;line-height:1.25!important;color:var(--lbss-ink)!important;direction:ltr;text-align:right}
.lbss__pct{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin:0 0 12px}
.lbss__pct b{font-size:clamp(30px,5vw,40px);font-weight:900;line-height:1;direction:ltr}
.lbss__pct span{font-size:12.5px;font-weight:800;color:var(--txt2,#57534E)}
.lbss__pct em{font-style:normal;font-size:11.5px;font-weight:900;padding:4px 9px;border-radius:999px;background:var(--lbss-ink);color:var(--lbss-bg)}
.lbss__why{margin:0 0 12px;padding:0;list-style:none;display:grid;gap:7px}
.lbss__why li{position:relative;padding-inline-start:20px;font-size:14px;line-height:1.65;font-weight:700}
.lbss__why li::before{content:"";position:absolute;inset-inline-start:2px;top:.62em;width:8px;height:8px;border-radius:50%;background:var(--lbss-acc)}
.lbss__price{margin:0 0 12px!important;font-size:18px!important;font-weight:900!important;direction:ltr;text-align:right}
.lbss__acts{display:flex;flex-wrap:wrap;gap:8px}
.lbss__btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 18px;border-radius:12px;font:inherit;font-size:14.5px;font-weight:900;text-decoration:none;cursor:pointer;border:1.5px solid var(--lbss-ink);transition:background-color .2s,color .2s}
.lbss__btn--solid{background:var(--lbss-ink);color:var(--lbss-bg)!important}
.lbss__btn--ghost{background:transparent;color:var(--lbss-ink)!important}
.lbss__btn[data-in]{background:var(--lbss-soft);border-color:var(--lbss-line)}
.lbss__cmp{width:100%;border-collapse:collapse;font-size:13.5px}
.lbss__cmp th,.lbss__cmp td{padding:10px 8px;border-bottom:1px solid var(--lbss-line);vertical-align:top;text-align:right}
.lbss__cmp thead th{font-size:12px;font-weight:900;direction:ltr;text-align:right}
.lbss__cmp tbody th{width:26%;font-weight:800;color:var(--txt2,#57534E)}
.lbss__cmp td{font-weight:700;line-height:1.55}
.lbss__cmp td[dir="ltr"]{text-align:right}
.lbss__more{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:14px}
.lbss__mini{display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:start;border:1px solid var(--lbss-line);border-radius:16px;background:var(--lbss-bg);padding:12px}
.lbss__mini .lbss__img{border-radius:10px}
.lbss__mini .lbss__name{font-size:14.5px!important;margin-bottom:4px!important}
.lbss__mini .lbss__pct{margin-bottom:6px}
.lbss__mini .lbss__pct b{font-size:22px}
.lbss__mini p.lbss__one{margin:0 0 8px!important;font-size:12.5px!important;line-height:1.55!important;font-weight:700!important;color:var(--txt2,#57534E)!important}
.lbss__mini .lbss__btn{min-height:40px;padding:0 12px;font-size:13px}
.lbss__pick{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:12.5px;font-weight:900;cursor:pointer}
.lbss__pick input{width:18px;height:18px;accent-color:var(--lbss-ink)}
.lbss__bundle{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:14px;padding:16px 18px;border-radius:16px;background:var(--lbss-ink);color:var(--lbss-bg)}
.lbss__bundle p{margin:0!important;font-size:15px!important;font-weight:900!important;color:inherit!important}
.lbss__bundle small{display:block;font-size:12.5px;font-weight:700;opacity:.8}
.lbss__bundle .lbss__btn{background:var(--lbss-bg);color:var(--lbss-ink)!important;border-color:var(--lbss-bg)}
.lbss__bundle .lbss__btn[disabled]{opacity:.45;cursor:not-allowed}
.lbss__nomatch{padding:18px;border-radius:16px;background:var(--lbss-bg);border:1px dashed var(--lbss-line);font-size:14.5px;font-weight:700;line-height:1.8}
.lbss__nomatch a{color:var(--lbss-ink);font-weight:900}
.lbss__how{margin-top:18px;border-top:1px solid var(--lbss-line);padding-top:12px}
.lbss__how summary{cursor:pointer;font-size:13px;font-weight:900;list-style:none}
.lbss__how summary::-webkit-details-marker{display:none}
.lbss__how p,.lbss__legal{margin:8px 0 0!important;font-size:12px!important;line-height:1.75!important;color:var(--txt2,#57534E)!important}
.lbss__legal{margin-top:12px!important}
.lbss__fade{opacity:0;transform:translateY(10px);transition:opacity .35s ease,transform .35s ease}
.lbss__fade.is-in{opacity:1;transform:none}
@media(max-width:900px){ .lbss__grid{grid-template-columns:1fr} .lbss__tiles{grid-template-columns:repeat(3,minmax(0,1fr))} .lbss__more{grid-template-columns:1fr} }
@media(max-width:600px){
  .lbss__tiles{grid-template-columns:repeat(2,minmax(0,1fr))}
  .lbss__tiles.is-collapsed li:nth-child(n+9){display:none}
  .lbss__tiles.is-collapsed ~ .lbss__all{display:inline-flex;align-items:center}
  .lbss__top{grid-template-columns:96px 1fr;gap:12px}
  .lbss__row{grid-template-columns:78px 1fr}
  .lbss__acts .lbss__btn{flex:1 1 0}
  .lbss__cmp{font-size:12.5px}
  .lbss__cmp tbody th{width:30%}
  .lbss__bundle .lbss__btn{width:100%}
}
@media(prefers-reduced-motion:reduce){ .lbss__m,.lbss__fade,.lbss__tile{transition:none} }
</style>
<div class="lbss__in">
  <p class="lbss__kick">ALREADY WEAR A WESTERN FRAGRANCE?</p>
  <{{ lbss_h }} class="lbss__h" id="lbss-h">Find Your Similar Scent<small>لقى عطر عربي عندو نفس الاتجاه فالريحة</small></{{ lbss_h }}>
  <p class="lbss__lede">عوض ما تشري قرعة ديال ماركة عالمية على العمى: ختار العطر اللي كتلبس دابا، نفكّو ليك البصمة ديالو — النوطات، الطابع والقوة — ونوريوك العطور العربية اللي عندنا بنفس الاتجاه فالريحة، بثمن معقول.</p>

  <p class="lbss__q" id="lbss-q">شنو العطر اللي كتلبس دابا؟</p>
  <div class="lbss__search">
    <input type="search" id="lbss-search" placeholder="قلّب على العطر ديالك… Sauvage، Aventus، BR540" autocomplete="off" aria-labelledby="lbss-q" data-lbss-search>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
  </div>
  <ul class="lbss__tiles is-collapsed" data-lbss-tiles aria-label="العطور العالمية">
    {%- for r in lbss_refs -%}
      {%- if r.active.value != false -%}
      <li data-pos="{{ r.position.value | default: 99 }}"><button type="button" class="lbss__tile" aria-pressed="false" data-lbss-ref="{{ r.system.handle }}"><i>{{ r.house.value }}</i><b>{{ r.name.value }}</b></button></li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
  <button type="button" class="lbss__all" data-lbss-all>شوف كل العطور ({{ lbss_refs.size }}) ↓</button>
  <p class="lbss__none" data-lbss-none>ما لقيناش هاد العطر فاللائحة ديالنا. <a href="/pages/find-your-fragrance" data-lbss-consult>دير الاستشارة ديال 60 ثانية ←</a></p>

  <div class="lbss__res" data-lbss-res aria-live="polite" hidden></div>

  <details class="lbss__how">
    <summary>كيفاش كنحسبو النسبة؟</summary>
    <p>كل عطر عالمي فاللائحة وكل عطر عندنا عندو نفس المعلومات، مأخوذة من اللوائح المنشورة ديال النوطات (Fragrantica): الطابع (فريش، حلو، خشبي، حار…)، مستوى الحلاوة والفرشة والدفء من 1 حتى 5، النوطات والعائلة. النسبة = الطابع 35% + الحلاوة/الفرشة/الدفء 30% + النوطات المشتركة 25% + العائلة 10%. كنقصو من النسبة إلا العطر العالمي فيه العود والعطر ديالنا لا، ولا إلا واحد للرجال والآخر للنساء. ما كنبينو غير العطور اللي متوفرة وفوق 60%. النسبة كتقيس الاتجاه ديال الريحة، ماشي أن الريحة هي نفسها.</p>
  </details>
  <p class="lbss__legal">الأسماء ديال الماركات العالمية ملك لأصحابها، وكنستعملوها غير باش نوصفو الاتجاه ديال الريحة. Lbass Original كيبيع عطور عربية أصلية؛ ماشي نسخ ديال هاد العطور وما عندنا حتى علاقة بهاد الماركات. · Les marques citées appartiennent à leurs propriétaires et ne sont mentionnées qu'à titre descriptif du profil olfactif.</p>
</div>

<script type="application/json" data-lbss-refs>
[
{%- assign lbss_first = true -%}
{%- for r in lbss_refs -%}
  {%- if r.active.value != false -%}
  {%- unless lbss_first -%},{%- endunless -%}{%- assign lbss_first = false -%}
  {"h":{{ r.system.handle | json }},"n":{{ r.name.value | json }},"house":{{ r.house.value | json }},"conc":{{ r.concentration.value | json }},"wear":{{ r.wearer.value | json }},"fam":{{ r.family.value | json }},"top":{{ r.notes_top.value | json }},"heart":{{ r.notes_heart.value | json }},"base":{{ r.notes_base.value | json }},"acc":{{ r.accords.value | json }},"sw":{{ r.sweetness.value | json }},"fr":{{ r.freshness.value | json }},"wa":{{ r.warmth.value | json }},"in":{{ r.intensity.value | json }},"q":{{ r.search_terms.value | json }},"pos":{{ r.position.value | default: 99 | json }}}
  {%- endif -%}
{%- endfor -%}
]
</script>
<script type="application/json" data-lbss-products>
[
{%- assign lbss_first = true -%}
{%- for p in lbss_c.products -%}
  {%- if p.available -%}
  {%- assign v = p.selected_or_first_available_variant -%}
  {%- assign vmax = v.inventory_quantity | default: 1 -%}
  {%- if v.inventory_management == blank -%}{%- assign vmax = 9 -%}{%- endif -%}
  {%- unless lbss_first -%},{%- endunless -%}{%- assign lbss_first = false -%}
  {"v":{{ v.id | json }},"h":{{ p.handle | json }},"t":{{ p.title | split: ' | ' | first | remove_first: p.vendor | split: ' Eau de ' | first | split: ' Extrait' | first | split: ' Concentrated' | first | strip | json }},"b":{{ p.vendor | json }},"url":{{ p.url | json }},"img":{{ p.featured_image | image_url: width: 400 | json }},"price":{{ v.price | json }},"max":{{ vmax | json }},"acc":{{ p.metafields.fragrance.accords.value | json }},"sw":{{ p.metafields.fragrance.sweetness.value | json }},"fr":{{ p.metafields.fragrance.freshness.value | json }},"wa":{{ p.metafields.fragrance.warmth.value | json }},"in":{{ p.metafields.fragrance.intensity.value | json }},"wear":{{ p.metafields.fragrance.wearer.value | json }},"fam":{{ p.metafields.fragrance.family.value | json }},"top":{{ p.metafields.fragrance.notes_top.value | json }},"heart":{{ p.metafields.fragrance.notes_heart.value | json }},"base":{{ p.metafields.fragrance.notes_base.value | json }},"conc":{{ p.metafields.fragrance.concentration.value | json }},"ml":{{ p.metafields.fragrance.volume_ml.value | json }}}
  {%- endif -%}
{%- endfor -%}
]
</script>
<script>
(function(){
  'use strict';
  function boot(){
  var root = document.getElementById('lbss'); if (!root) return;
  var REFS = [], P = [];
  try { REFS = JSON.parse(root.querySelector('[data-lbss-refs]').textContent || '[]'); } catch (e) {}
  try { P = JSON.parse(root.querySelector('[data-lbss-products]').textContent || '[]'); } catch (e) {}
  P = P.filter(function(p){ return p.price > 0 && p.acc && p.sw; });
  var byH = {}; REFS.forEach(function(r){ byH[r.h] = r; });
  var B = window.LbassBundle || null;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var res = root.querySelector('[data-lbss-res]');
  var tilesUl = root.querySelector('[data-lbss-tiles]');
  var search = root.querySelector('[data-lbss-search]');
  var none = root.querySelector('[data-lbss-none]');
  var allBtn = root.querySelector('[data-lbss-all]');
  allBtn.addEventListener('click', function(){ tilesUl.classList.remove('is-collapsed'); });

  /* order tiles by the metaobject's Position field */
  Array.prototype.slice.call(tilesUl.children).sort(function(a, b){ return (+a.getAttribute('data-pos')) - (+b.getAttribute('data-pos')); }).forEach(function(li){ tilesUl.appendChild(li); });

  /* ---------- labels ---------- */
  var ACC = { fresh: 'فريش', sweet: 'حلو', woody: 'خشبي', spicy: 'حار', floral: 'وردي', oud: 'عود', vanilla: 'فانيلا', citrus: 'حامض', amber: 'عنبر', fruity: 'فواكه', leather: 'جلد', musk: 'مسك' };
  var GRP = { citrus: 'حوامض', resin: 'بخور وراتنج', amber: 'عنبر', woods: 'أخشاب', spices: 'توابل', gourmand: 'نوطات حلوة (gourmand)', vanilla: 'فانيلا وتونكا', musk: 'مسك', whitefloral: 'ورود بيضاء', floral: 'ورود', aromatic: 'أعشاب عطرية', fruity: 'فواكه', smoky: 'تبغ وجلد', marine: 'نوطات بحرية', oud: 'عود' };
