    if (bb && B && !bb.disabled) {
      var picks = Array.prototype.map.call(res.querySelectorAll('[data-lbss-pick]:checked'), function(i){ return i.getAttribute('data-lbss-pick'); });
      picks.forEach(function(v){ var p = P.filter(function(x){ return String(x.v) === v; })[0]; if (p && !inBundle(v)) B.add('fragrance', { v: p.v, h: p.h, q: 1, max: p.max }, 'similar_scent'); });
      track('similar_scent_bundle_click', { reference: res._ref ? res._ref.h : '', items: picks.length });
      location.href = B.cfg.fragrance.page + '?from=similar';
      return;
    }
    var g = e.target.closest('[data-lbss-go]');
    if (g) track('similar_scent_product_click', { reference: res._ref ? res._ref.h : '', product_handle: g.getAttribute('data-lbss-go') });
    var c = e.target.closest('[data-lbss-consult]');
    if (c) track('similar_scent_consult_click', { reference: res._ref ? res._ref.h : '' });
  });
  document.addEventListener('lbass:bundle', function(){ if (!res.hidden) { paintAdd(); paintBundle(); } });

  var m = (location.hash || '').match(/scent=([a-z0-9-]+)/);
  if (m && byH[m[1]]) select(m[1], 'load');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
</section>
{%- endif -%}
