{%- comment -%}
  LBASS — HOMEPAGE HERO SWAP (2026-08-01)

  WHY THIS EXISTS. The new hero lives in sections/lbass-hero.liquid, and the
  correct way to ship it is one line inside templates/index.liquid:
      replace  <header id="top" class="hero">...</header>
      with     {% section 'lbass-hero' %}
  index.liquid is 226,298 bytes. themeFilesUpsert requires the WHOLE file body,
  and 226KB cannot be emitted in one write, so that edit cannot be made through
  the Admin API. This snippet is the workaround.

  WHY IT IS SCRIPTED RATHER THAN SERVER-RENDERED. index.liquid uses
  {% layout none %} — it is a standalone document, so layout/theme.liquid never
  wraps the homepage (there is no <main> element on it). The one hook it does
  give us is lbass-entity-schema, which index.liquid renders — but that output
  lands in <head>, where markup cannot be placed. So the markup is built in JS
  and inserted in place of the old hero.

  FAILURE MODE IS DELIBERATELY SAFE. If anything here throws, nothing is
  removed and the ORIGINAL hero stays on screen. The old hero is never hidden
  by CSS — it is only replaced once the new one is successfully built.

  LCP. The background image is preloaded in <head> below, so the browser starts
  fetching it during head parsing rather than waiting for this script. That is
  what keeps a JS-inserted hero from costing LCP.

  SEO. The enhanced hero mirrors the crawlable commercial H1 from
  templates/index.liquid so the DOM still has one stable topic after the swap.

  DELETE THIS FILE the moment index.liquid gets the one-line edit. It guards
  itself (bails if a .lbh already exists) so the two can never double-render,
  but it is a workaround and should not outlive the thing it works around.
{%- endcomment -%}

{%- if template == 'index' -%}
<link rel="preload" as="image" fetchpriority="high"
      href="{{ 'hero-lifestyle-1.webp' | asset_url }}">

{% render 'lbass-hero-cta' %}
{% render 'lbass-hero-type' %}
{% render 'lbass-hero-mobile' %}

<style>
.lbh{
  --i:#0B0B0C; --i2:#3A3A3C; --i3:#6B6B6E;
  --bone:#FFFFFF; --bone2:#F4F2ED; --red:#BF2E15; --rule:rgba(11,11,12,.14);
  --ar:var(--lb-arabic,'Alexandria','Tajawal',system-ui,sans-serif);
  --lt:var(--lb-latin,'Epilogue',system-ui,sans-serif);
  --dp:var(--lb-display,'Anton',Impact,sans-serif);
  --fg:var(--i); --fg2:var(--i2); --fg3:var(--i3); --plate:var(--bone);
  position:relative; width:100%; overflow:hidden;
  min-height:100svh; display:flex; align-items:center; justify-content:center;
  padding-top:clamp(36px,5vh,72px);
  background:
    radial-gradient(ellipse 70% 55% at 50% 92%, rgba(191,46,21,.075) 0%, rgba(191,46,21,.022) 45%, transparent 72%),
    radial-gradient(125% 95% at 50% 0%, #FFFFFF 0%, #FCFBF8 50%, #F1EEE7 100%);
  border-bottom:1px solid var(--rule);
}
@supports not (min-height:100svh){ .lbh{min-height:100vh} }
.lbh-fx{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.lbh-bg{position:absolute;inset:0;z-index:0;overflow:hidden}
.lbh-bg img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;
  filter:grayscale(12%) contrast(1.04) saturate(1.05)}
.lbh-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;
  background:
    radial-gradient(ellipse 58% 54% at 50% 44%,
      rgba(252,251,248,.92) 0%, rgba(252,251,248,.72) 36%,
      rgba(252,251,248,.34) 68%, rgba(252,251,248,.18) 100%),
    linear-gradient(180deg, rgba(255,255,255,.30) 0%, rgba(241,238,231,.46) 100%);
}
.lbh .lbh-fx{z-index:2}
.lbh .lbh-wrap,.lbh .lbh-cue{z-index:3}
.lbh-wrap{position:relative;display:flex;flex-direction:column;
  align-items:center;text-align:center;gap:0;
  width:100%;max-width:1400px;margin:0 auto;
  padding:clamp(18px,2.6vw,34px) 32px clamp(48px,5.5vw,72px)}
.lbh-eyebrow{display:flex;align-items:center;gap:1.2rem;margin:0 0 20px;
  font-family:var(--lt);font-size:11px;font-weight:700;letter-spacing:.42em;
  text-transform:uppercase;color:var(--red);line-height:1.5}
.lbh-eyebrow::before,.lbh-eyebrow::after{content:'';width:34px;height:1px;background:currentColor;opacity:.42;flex:0 0 auto}
{%- comment -%}
  WORD-BY-WORD REVEAL — do NOT re-implement it here.
  snippets/lbass-hero-type.liquid already owns it (.lbh-w from-state,
  .lbh-go starts it, .lbh-shown is a 3.2s fail-visible backstop), and
  snippets/lbass-hero-fx.liquid splits any [data-lbh-reveal] element into
  .lbh-w word spans. So the H1 above only needs the attribute.

  Removing data-lbh-reveal disables the splitter, and the from-state in
  hero-type (opacity:0; translateY(115%)) then holds the words hidden forever —
  measured 2026-08-10: the headline was invisible past 2.2s with
  animation-play-state running and animation-name none. If you hand-write
  .lbh-w spans, you get two competing systems and an invisible hero.
{%- endcomment -%}
.lbh-ht--wide{white-space:nowrap}
/* mobile: show only the first four chips — من ألمانيا · صور حقيقية · 1/1 · COD.
   The shipping chips stay on desktop; on a phone they push the CTA below the
   fold, and the same figures already appear in the cart drawer and footer. */
@media(max-width:640px){
  .lbh-ht:nth-child(n+5){display:none}
}
.lbh-h{margin:0;font-family:var(--ar);font-weight:900;color:var(--fg);
  word-spacing:.01em;max-width:none;width:100%}
.lbh-ln{display:block}
.lbh-ln--accent{color:var(--red)}
.lbh-w{display:inline-block;opacity:0;transform:translateY(.5em);
  animation:lbhUp .8s cubic-bezier(.16,1,.3,1) forwards}
@keyframes lbhUp{to{opacity:1;transform:none}}
.lbh-sub{margin:26px 0 0;max-width:56ch;font-family:var(--ar);
  font-size:clamp(14px,1.25vw,17px);line-height:1.95;font-weight:500;color:var(--fg2)}
.lbh-divider{width:52px;height:1px;margin:26px 0 0;
  background:linear-gradient(90deg,transparent,var(--red),transparent)}
.lbh-ctas{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;align-items:center;margin:28px 0 0}
.lbh-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;
  min-height:60px;padding:0 38px;border-radius:0;font-family:var(--ar);
  font-size:16px;font-weight:900;text-decoration:none;
  transition:background .2s,color .2s,border-color .2s,transform .2s,box-shadow .2s}
.lbh-btn-primary{background:var(--cta-bg);color:var(--cta-fg);border:1px solid var(--cta-bg)}
.lbh-btn-primary:hover{background:var(--cta-bg-hover);border-color:var(--cta-bg-hover);
  transform:translateY(-2px);box-shadow:0 10px 26px rgba(11,11,12,.22)}
.lbh-btn-ghost{background:rgba(255,255,255,.78);color:var(--fg);border:1px solid var(--fg);
  backdrop-filter:blur(6px)}
.lbh-btn-ghost:hover{border-color:var(--cta-bg);color:var(--cta-bg)}
.lbh-m{display:none}
.lbh-trust{display:flex;flex-wrap:wrap;justify-content:center;margin:30px 0 0;
  border:1px solid var(--rule);background:rgba(255,255,255,.78);backdrop-filter:blur(8px)}
.lbh-ht{font-family:var(--ar);font-size:12px;color:var(--fg2);
  padding:12px 20px;border-inline-end:1px solid var(--rule);white-space:nowrap;line-height:1.4}
.lbh-ht:last-child{border-inline-end:none}
.lbh-ht b{color:var(--fg);font-weight:900}
.lbh-scarce{margin:20px 0 0;font-family:var(--ar);font-size:12.5px;font-weight:700;color:var(--fg3)}
.lbh-cue{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;
  font-family:var(--lt);font-size:10px;font-weight:700;letter-spacing:.35em;
  text-transform:uppercase;color:var(--fg3)}
.lbh-cue-line{width:1px;height:32px;background:linear-gradient(to bottom,var(--red),transparent);
  animation:lbhPulse 2.2s ease-in-out infinite}
@keyframes lbhPulse{0%,100%{opacity:.35;transform:scaleY(1)}50%{opacity:.95;transform:scaleY(1.12)}}
@media(max-width:900px){.lbh-cue{display:none}}
@media(max-width:767px){
  .lbh{min-height:0;height:auto;align-items:flex-start;padding-top:0}
  .lbh-wrap{align-items:flex-start;text-align:start;max-width:100%;
    padding:clamp(24px,7vw,38px) 20px clamp(32px,8vw,46px)}
  .lbh-eyebrow{font-size:9.5px;letter-spacing:.22em;gap:.7rem;margin-bottom:16px}
  .lbh-eyebrow::before,.lbh-eyebrow::after{width:18px}
  .lbh-sub{font-size:14px;line-height:1.8;margin-top:18px;max-width:100%}
  .lbh-divider{display:none}
  .lbh-ctas{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:24px}
  .lbh-btn{width:100%;padding:0 12px;font-size:13.5px;min-height:52px;line-height:1.25;text-align:center}
  .lbh-d{display:none}
  .lbh-m{display:inline}
  /* 7 chips wrap rather than scroll on mobile — a horizontal scroller hides
     "من ألمانيا" / "تشيك فمراكش" off-screen, which are the two the hero exists
     to communicate. Wrapping keeps all of them above the fold. */
  .lbh-trust{width:100%;justify-content:flex-start;gap:7px;flex-wrap:wrap;
    overflow-x:visible;border:0;background:transparent;backdrop-filter:none;
    padding-bottom:0;margin-top:20px}
  .lbh-trust::-webkit-scrollbar{display:none}
  .lbh-ht{flex:0 0 auto;border:1px solid var(--rule);background:rgba(255,255,255,.85);padding:9px 13px}
  .lbh-bg img{object-position:center 34%}
  .lbh-scrim{background:
    radial-gradient(ellipse 86% 52% at 30% 40%,
      rgba(252,251,248,.92) 0%, rgba(252,251,248,.72) 42%,
      rgba(252,251,248,.34) 76%, rgba(252,251,248,.18) 100%),
    linear-gradient(180deg, rgba(255,255,255,.34) 0%, rgba(241,238,231,.50) 100%)}
}
@media(prefers-reduced-motion:reduce){
  .lbh-w{opacity:1;transform:none;animation:none}
  .lbh-cue-line{animation:none}
  .lbh-btn{transition:none}
}
</style>

<script>
(function(){
  function build(){
    /* guard: if the section was installed properly in index.liquid, do nothing */
    if(document.querySelector('.lbh')) return;
    var old = document.getElementById('top') || document.querySelector('header.hero');
    if(!old) return;                       /* nothing to replace — leave page alone */

    var h = document.createElement('header');
    h.className = 'lbh';
    h.id = 'top';                          /* preserve the #top anchor target */
    h.setAttribute('role','banner');
    h.innerHTML =
      '<div class="lbh-bg" aria-hidden="true"><img src="{{ 'hero-lifestyle-1.webp' | asset_url }}" width="1264" height="848" alt="" fetchpriority="high" decoding="async"></div>' +
      '<div class="lbh-scrim" aria-hidden="true"></div>' +
      '<canvas id="lbhParticles" class="lbh-fx" aria-hidden="true" data-tint="11,11,12"></canvas>' +
      '<div class="lbh-wrap">' +
        '<p class="lbh-eyebrow">مختارة من ألمانيا · تشيك فمراكش</p>' +
        '<h1 class="lbh-h">' +
          '<span class="lbh-ln" data-lbh-reveal="Lbass Original —">Lbass Original —</span>' +
          '<span class="lbh-ln lbh-ln--accent" data-lbh-reveal="حوايج Second-Hand أصلية فالمغرب">حوايج Second-Hand أصلية فالمغرب</span>' +
        '</h1>' +
        '<p class="lbh-sub">Lbass Original هو متجر second-hand أونلاين من مراكش كيعرض حوايج براند، صبابط وstreetwear مختارة من ألمانيا ومفحوصة فمراكش.</p>' +
        '<div class="lbh-divider" aria-hidden="true"></div>' +
        '<div class="lbh-ctas">' +
          '<a class="lbh-btn lbh-btn-primary" href="{{ routes.all_products_collection_url }}" data-lbh-cta="primary">' +
            '<span class="lbh-d">شوف الدروب دابا ←</span><span class="lbh-m">شوف الدروب</span></a>' +
          '<a class="lbh-btn lbh-btn-ghost" href="/pages/condition-guide" data-lbh-cta="secondary">' +
            '<span class="lbh-d">كيفاش كنشيّكو القطع؟</span><span class="lbh-m">كيفاش كنشيّكو؟</span></a>' +
        '</div>' +
        '<div class="lbh-trust">' +
          '<div class="lbh-ht"><b>من ألمانيا</b></div>' +
          '<div class="lbh-ht"><b>صور حقيقية</b></div>' +
          '<div class="lbh-ht"><b>قطعة 1/1</b></div>' +
          '<div class="lbh-ht"><b>COD</b></div>' +
          '<div class="lbh-ht lbh-ht--wide"><b>مراكش</b> 20 درهم</div>' +
          '<div class="lbh-ht lbh-ht--wide"><b>خارج مراكش</b> 40 درهم</div>' +
        '</div>' +
        '<p class="lbh-scarce">ملي كتباع القطعة، كتخرج من الكوليكسيون.</p>' +
      '</div>' +
      '<a class="lbh-cue" href="#drop" data-lbh-cue><span class="lbh-cue-line" aria-hidden="true"></span><span>SCROLL</span></a>';

    old.removeAttribute('id');             /* free #top before adopting it */
    old.parentNode.insertBefore(h, old);
    old.parentNode.removeChild(old);

    /* the reveal + particles script runs before this, so re-run it for the new nodes */
    document.dispatchEvent(new CustomEvent('lbass:hero-ready'));
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', build);
  } else { build(); }
})();
</script>

{% render 'lbass-hero-fx' %}
{%- endif -%}
