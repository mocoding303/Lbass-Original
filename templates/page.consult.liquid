{%- comment -%}
  ═══ LBASS — CONSULTATION PAGE TEMPLATE (2026-09-28) ═══
  Pages: /pages/find-your-fragrance and /pages/k-beauty-consultation (template suffix "consult").
  The department comes from the handle: a handle containing "beauty" gives
  K-beauty; anything else gives fragrances.
  The quiz is JavaScript; everything below it is plain crawlable HTML:
  how the matching works, links to every product, the FAQ and JSON-LD. The FAQ
  is one list that feeds both the visible <details> and FAQPage.
{%- endcomment -%}
{%- liquid
  if page.handle contains 'beauty'
    assign dept = 'beauty'
    assign coll = collections['cosmetics']
    assign crumb = 'تجميل كوري · K-Beauty'
    assign bundle_url = '/pages/k-beauty-bundle'
    assign faq = 'كيفاش كتختارو ليا المنتوجات؟||كل منتوج عندو معلومات مكتوبة: الهدف ديالو (بحال الترطيب ولا البقع)، أنواع البشرة اللي كيناسبها، إمتى كيتستعمل والثمن. كنقارنو الأجوبة ديالك بهاد المعلومات وكنعطيو لكل منتوج نسبة تطابق، والسبب مكتوب تحت كل اقتراح.@@واش هادي نصيحة طبية؟||لا. الاستشارة كتعاونك تختار من المنتوجات اللي عندنا حسب اللي كتقوله الماركة. إلا عندك مشكل فالبشرة ولا حساسية قوية، سول طبيب الجلد. منتوجات الريتينال ماشي للحوامل ولا المرضعات.@@واش نقدر نشري الروتين كامل بخصم؟||إيه. من النتيجة، ختار المنتوجات وضغط «ركّب باك بهادو»: جوج منتوجات = ⁦−5%⁩، و3 ولفوق = ⁦−10%⁩، أوتوماتيكياً.'
    assign how = 'كل منتوج K-beauty فالمتجر عندو معلومات مكتوبة: الهدف الأساسي والثانوي (التجاعيد، البقع، الترطيب، الحساسية، المسام، توحيد اللون، التنظيف)، أنواع البشرة اللي كيناسبها، إمتى كيتستعمل (الصباح ولا الليل) والثمن. الهدف كيحسب 45%، نوع البشرة 25%، الوقت 15% والميزانية 15%. المنتوجات اللي مابقاتش متوفرة ما كتبانش. إلا بغيتي روتين، كنختارو أحسن منتوج لكل خطوة: تنظيف، علاج، ترطيب وحماية النهار.'
  else
    assign dept = 'fragrance'
    assign coll = collections['fragrances']
    assign crumb = 'عطور · Fragrances'
    assign bundle_url = '/pages/fragrance-bundle'
    assign faq = 'كيفاش كتختارو ليا العطور؟||كل عطر عندو معلومات مكتوبة من الهرم ديال النوطات: نوع الريحة، شحال حلو، فريش، دافي وقوي، المناسبات، الانطباع والثمن. كنقارنو الأجوبة ديالك بهاد المعلومات وكنعطيو لكل عطر نسبة تطابق، والسبب مكتوب تحت كل اقتراح.@@واش نقدر نشري أكثر من عطر بخصم؟||إيه. من النتيجة، ختار العطور وضغط «ركّب باك بهادو»: جوج عطور = ⁦−10%⁩، و3 ولفوق = ⁦−15%⁩، أوتوماتيكياً بلا كود.@@واش العطور قرعات كاملة؟||إيه: قرعات كاملة جديدة فالكرطونة، ماشي ديكانت. كتخلص عند الاستلام ولا بـ PayPal، والتوصيل مجاني من 500 درهم.'
    assign how = 'كل عطر فالمتجر عندو معلومات مكتوبة من الهرم ديال النوطات المنشور: الأكوردات الأساسية (فريش، حلو، فانيلا، خشبي، حار، وردي، عود، حامض)، سلالم من 1 حتى 5 للحلاوة، الفرشة، الدفء والقوة، المناسبات والانطباع. نوع الريحة كيحسب 30%، المناسبة 20%، الانطباع 20%، القوة 20% والميزانية 10%. العطور اللي مابقاتش متوفرة ما كتبانش.'
  endif
  assign faq_rows = faq | split: '@@'
-%}
<style>
.lbx-bc{max-width:960px;margin:0 auto;padding:14px clamp(16px,4vw,32px) 0;font-size:12.5px;color:var(--txt2,#57534E);direction:rtl;text-align:right}
.lbx-bc a{color:var(--txt2,#57534E)}
.lbx{max-width:960px;margin:0 auto;padding:10px clamp(16px,4vw,32px) 48px;direction:rtl;text-align:right;color:var(--cream,#0B0B0C)}
.lbx h2{margin:26px 0 10px!important;font-size:clamp(19px,3.6vw,24px)!important;font-weight:900!important;color:var(--cream,#0B0B0C)!important}
.lbx p,.lbx li{font-size:14.5px;line-height:1.8;color:var(--txt2,#57534E)}
.lbx details{border:1px solid var(--line,rgba(11,11,12,.16));border-radius:12px;margin:0 0 8px;background:var(--ink,#fff)}
.lbx summary{cursor:pointer;padding:14px;font-weight:900;font-size:14.5px;color:var(--cream,#0B0B0C);list-style:none}
.lbx summary::-webkit-details-marker{display:none}
.lbx details p{margin:0;padding:0 14px 14px}
.lbx-links{display:flex;flex-wrap:wrap;gap:6px;padding:0;list-style:none}
.lbx-links a{display:inline-block;padding:7px 11px;border:1px solid var(--line,rgba(11,11,12,.16));border-radius:999px;font-size:12.5px;font-weight:800;color:var(--cream,#0B0B0C);text-decoration:none}
</style>

<nav class="lbx-bc" aria-label="مسار التنقل">
  <a href="{{ routes.root_url }}">الرئيسية</a> ›
  {% if coll != blank %}<a href="{{ coll.url }}">{{ crumb }}</a> ›{% endif %}
  <span aria-current="page">{{ page.title }}</span>
</nav>

{% render 'lbass-consult', dept: dept %}

<div class="lbx">
  <h2>كيفاش كنختارو ليك؟</h2>
  <p>{{ how }}</p>
  <p><a href="{{ bundle_url }}" style="color:var(--cream,#0B0B0C);font-weight:900">عارف شنو بغيتي؟ ركّب الباك ديالك مباشرة ←</a></p>

  {%- if coll != blank and coll.products_count > 0 -%}
  <h2>{% if dept == 'beauty' %}كل منتوجات K-beauty{% else %}كل العطور{% endif %}</h2>
  <ul class="lbx-links">
    {%- for p in coll.products -%}<li><a href="{{ p.url }}">{{ p.title | split: ' | ' | first }}</a></li>{%- endfor -%}
  </ul>
  {%- endif -%}

  <h2>أسئلة على الاستشارة</h2>
  {%- for row in faq_rows -%}
    {%- assign qa = row | split: '||' -%}
    <details><summary>{{ qa[0] }}</summary><p>{{ qa[1] }}</p></details>
  {%- endfor -%}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "الرئيسية", "item": {{ shop.url | json }}},
        {"@type": "ListItem", "position": 2, "name": {{ crumb | json }}, "item": {{ shop.url | append: coll.url | json }}},
        {"@type": "ListItem", "position": 3, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }}}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for row in faq_rows -%}
        {%- assign qa = row | split: '||' -%}
        {"@type": "Question", "name": {{ qa[0] | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ qa[1] | json }}}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  ]
}
</script>
