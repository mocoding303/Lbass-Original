<script>
(function(){
  var EI_KEY='lbass_ei_ts',done=false;
  var last=localStorage.getItem(EI_KEY);
  if(last&&Date.now()-Number(last)<7*86400000)return;
  function show(){if(done)return;done=true;document.getElementById('eiOverlay').classList.add('show')}
  if(matchMedia('(pointer:fine)').matches){document.addEventListener('mouseout',function(e){if(!e.relatedTarget&&e.clientY<2)show()})}
  else{setTimeout(show,25000);var pct=0;window.addEventListener('scroll',function(){var h=document.documentElement.scrollHeight-innerHeight;if(h>0)pct=Math.max(pct,scrollY/h);if(pct>.6)show()},{passive:true})}
  document.getElementById('eiX').onclick=function(){document.getElementById('eiOverlay').classList.remove('show');localStorage.setItem(EI_KEY,Date.now())};
  document.getElementById('eiOverlay').addEventListener('click',function(e){if(e.target===this){this.classList.remove('show');localStorage.setItem(EI_KEY,Date.now())}});
  document.getElementById('eiForm').addEventListener('submit',function(){localStorage.setItem(EI_KEY,Date.now())});
})();
</script>

