  {% assign compare_price = variant.compare_at_price %}
  {% if compare_price == blank or compare_price <= variant.price %}{% assign compare_price = nil %}{% endif %}
  {% assign hp_ticket = product.metafields.lbass.ticket_status.value | default: 'unknown' %}
  {% assign hp_status = product.metafields.lbass.condition_status.value | default: 'unknown' %}
  {% assign hp_inspection = product.metafields.lbass.inspection_status.value %}
  {% assign hp_has_ticket = product.metafields.lbass.has_original_ticket.value %}
  {% assign hp_notes = product.metafields.lbass.condition_notes.value %}
  {% assign hp_defects = product.metafields.lbass.visible_defects.value %}
  {% assign hp_ticket_confirmed = false %}
  {% if hp_has_ticket == true %}
    {% if hp_ticket == 'ticket_attached' or hp_ticket == 'ticket_included' %}{% assign hp_ticket_confirmed = true %}{% endif %}
  {% elsif hp_has_ticket == false and hp_ticket == 'no_ticket' %}
    {% assign hp_ticket_confirmed = true %}
  {% endif %}
  {% assign hp_grade = 'unknown' %}
  {% assign hp_label = '' %}
  {% if hp_inspection == 'inspected_confirmed' %}
    {% if hp_has_ticket == true and hp_status == 'new_with_ticket' %}
      {% if hp_ticket == 'ticket_attached' or hp_ticket == 'ticket_included' %}{% assign hp_grade = 'new_with_ticket' %}{% assign hp_label = 'جديد بالتّيكيت' %}{% endif %}
    {% elsif hp_has_ticket == false and hp_ticket == 'no_ticket' and hp_status == 'excellent_almost_new' %}
      {% assign hp_grade = 'excellent_almost_new' %}{% assign hp_label = 'بحالة ممتازة · شبه جديد' %}
    {% elsif hp_ticket_confirmed and hp_status == 'very_good' %}
      {% assign hp_grade = 'very_good' %}{% assign hp_label = 'بحالة مزيانة بزاف' %}
    {% elsif hp_ticket_confirmed and hp_status == 'good' %}
      {% assign hp_grade = 'good' %}{% assign hp_label = 'بحالة مزيانة · شوف الملاحظات' %}
    {% elsif hp_ticket_confirmed and hp_status == 'needs_note' %}
      {% if hp_notes != blank or hp_defects != blank %}{% assign hp_grade = 'needs_note' %}{% assign hp_label = 'بحالة مزيانة · شوف الملاحظات' %}{% endif %}
    {% endif %}
  {% endif %}
  {% assign hp_one = false %}
  {% capture hp_one_s %}{% render 'lbass-one-of-one', product: product %}{% endcapture %}{% assign hp_one_s = hp_one_s | strip %}{% if hp_one_s == '1' %}{% assign hp_one = true %}{% endif %}
  {% assign hp_promo = false %}
  {% if variant.available and product.metafields.lbass.promo_eligible.value == true %}
    {% if hp_grade == 'new_with_ticket' or hp_grade == 'excellent_almost_new' %}{% assign hp_promo = true %}{% endif %}
  {% endif %}
  {% assign display_title = product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first %}
  {% assign display_desc = product.description | strip_html | strip | truncate: 180 %}
  {
    id: {{ product.handle | json }},
    name: {{ display_title | json }},
    brand: {{ product.vendor | json }},
    cat: {{ cat | json }},
    sizes: [{% for v in product.variants %}{% unless v.title == 'Default Title' %}{{ v.title | json }}{% else %}"One Size"{% endunless %}{% unless forloop.last %},{% endunless %}{% endfor %}],
    vids: [{% for v in product.variants %}{id:{{ v.id }},t:{% unless v.title == 'Default Title' %}{{ v.title | json }}{% else %}"One Size"{% endunless %},a:{% if v.available %}true{% else %}false{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}],
    price: {{ variant.price | divided_by: 100.0 }},
    old: {% if compare_price %}{{ compare_price | divided_by: 100.0 }}{% else %}null{% endif %},
    grade: {{ hp_grade | json }},
    conditionLabel: {{ hp_label | json }},
    one: {% if hp_one %}true{% else %}false{% endif %},
    available: {% if variant.available %}true{% else %}false{% endif %},
    badges: [{% if hp_promo %}'promo'{% endif %}],
    img: {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | json }}{% else %}''{% endif %},
    imgs: [{% for image in product.images limit: 8 %}{{ image | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
    url: {{ product.url | json }},
    desc: {{ display_desc | json }},
    material: {{ product.metafields.lbass.material.value | default: '' | json }},
    fit: {{ product.metafields.lbass.fit.value | default: '' | json }},
    color: {{ product.metafields.lbass.color.value | default: '' | json }},
    meas: {% if product.metafields.lbass.measurements.value != blank %}{'ملاحظة':{{ product.metafields.lbass.measurements.value | json }}}{% else %}{}{% endif %},
    flaws: [{% if hp_grade != 'unknown' and product.metafields.lbass.visible_defects.value != blank %}{{ product.metafields.lbass.visible_defects.value | json }}{% endif %}]
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
{% endif %}
];
PRODUCTS.splice(0, PRODUCTS.length, ...SHOPIFY_PRODUCTS);

/* ════════════════ HELPERS ════════════════ */
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const dh = n => Number(n).toLocaleString('en-US') + ' درهم';
const save = p => p.old && p.old > p.price ? Math.round((1 - p.price / p.old) * 100) : 0;
const byId = id => PRODUCTS.find(p => p.id === id);
const gradeText = p => p.conditionLabel || GRADES[p.grade] || GRADES.unknown;
const GRADE_NOTES = {
  new_with_ticket:'التّيكيت الأصلي مؤكد فبيانات القطعة.',
  excellent_almost_new:'ما فيهاش التّيكيت والحالة الممتازة مؤكدة.',
  very_good:'الحالة مزيانة بزاف ومؤكدة.',
  good:'راجع الملاحظات والصور قبل الطلب.',
  needs_note:'راجع الملاحظات والعيوب المبينة.',
  unknown:'خاص تأكيد صاحب المتجر قبل البيع.'
};
const gradeMeaning = p => GRADE_NOTES[p.grade] || GRADE_NOTES.unknown;
function searchText(p){
  return [
    p.brand, p.name, CAT_META[p.cat].t, p.cat,
    p.sizes.join(' '), p.color, p.material, p.fit, gradeText(p), ...(p.flaws||[])
  ].join(' ').toLowerCase();
}

let toastT;
function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 2600);
}

/* ════════════════ PRODUCT CARD ════════════════ */
function vizHTML(p, big){
  const m = CAT_META[p.cat];
  if (p.img) return `<img src="${esc(p.img)}" alt="${esc(p.brand + ' ' + p.name)}" loading="lazy" decoding="async">`;
  return `<div class="pviz-bg" style="background:${m.bg}"></div>
    <span class="pviz-star star8"><svg><use href="#star8sym"/></svg></span>
    <span class="pviz-ico">${m.ico}</span>
    <span class="pviz-brand">${esc(p.brand)}</span>`;
}
const BADGE = {promo:'<span class="pb pb-drop">قطعة مختارة</span>'};

function cardHTML(p, cls){
  const href = productURL(p);
  const tag  = href ? 'a' : 'article';
  const attr = href ? `href="${esc(href)}"` : `data-id="${p.id}"`;
  const saving = save(p);
  const oldPrice = saving ? `<span class="pold">${p.old}</span>` : '';
  const savingBadge = saving ? `<span class="psave">−${saving}%</span>` : (p.one ? '<span class="psave">1/1</span>' : '');
  return `<${tag} class="pcard ${cls||''}" ${attr}>
    <div class="pviz">
      ${vizHTML(p)}
      <div class="pbadges">${(p.badges||[]).map(b=>BADGE[b]||'').join('')}<span class="pb pb-grade">${GRADES[p.grade]}</span></div>
      <button class="pwish${wish.includes(p.id)?' on':''}" data-wish="${p.id}" aria-label="زيدها للمفضلة">${wish.includes(p.id)?'♥':'♡'}</button>
    </div>
    <div class="pinfo">
      <p class="pinfo-brand">${esc(p.brand)}</p>
      <h3 class="pname">${esc(p.name)}</h3>
      <div class="prow">
        <span><span class="pprice">${p.price} DH</span> ${oldPrice}</span>
        ${savingBadge}
      </div>
      <div class="psizes">${p.sizes.map(s=>`<span class="psz">${esc(s)}</span>`).join('')}</div>
      <div class="pmeta-row"><span>${p.available ? (p.one ? 'قطعة وحدة' : 'متوفرة دابا') : 'تباعت'}</span><span>${esc(p.conditionLabel || GRADES.unknown)}</span><span>COD أو PayPal</span></div>
      <p class="pdelivery">🚚 توصيل لكل المغرب</p>
    </div>
  </${tag}>`;
}

