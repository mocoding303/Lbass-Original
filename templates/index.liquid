/* ── Reveals: IntersectionObserver + CSS transitions (rAF-independent, can't stall hidden) ── */
const animOn = document.documentElement.classList.contains('anim');
function reveal(el){ el.classList.add('in'); }
if (animOn && 'IntersectionObserver' in window){
  const io = new IntersectionObserver((ents) => {
    ents.forEach(e => { if (e.isIntersecting){ reveal(e.target); io.unobserve(e.target); } });
  }, {threshold:.12, rootMargin:'0px 0px -8% 0px'});
  $$('.rev, .rev-hero').forEach(el => io.observe(el));
  /* hero is above the fold — reveal next frame for the entrance transition */
  requestAnimationFrame(() => $$('.hero .rev, .rev-hero').forEach(reveal));
  /* watchdog: if anything never got revealed, force it visible */
  setTimeout(() => $$('.rev, .rev-hero').forEach(reveal), 2600);
} else {
  $$('.rev, .rev-hero').forEach(reveal);
}

/* ── Count-up stats (purely additive; numbers show even if it never runs) ── */
function countUp(el){
  const end = +el.dataset.count, t0 = performance.now(), dur = 1500;
  const fin = () => el.textContent = end.toLocaleString('en-US');
  (function tick(now){
    const p = Math.min(1, (now - t0) / dur);
    el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
    if (p < 1) requestAnimationFrame(tick);
  })(t0);
  setTimeout(fin, dur + 400); // guarantee final value even if rAF is throttled
}
if ('IntersectionObserver' in window){
  const cio = new IntersectionObserver((ents) => {
    ents.forEach(e => { if (e.isIntersecting){ countUp(e.target); cio.unobserve(e.target); } });
  }, {threshold:.5});
  $$('[data-count]').forEach(el => cio.observe(el));
} else {
  $$('[data-count]').forEach(el => el.textContent = (+el.dataset.count).toLocaleString('en-US'));
}

/* ── clip-path image reveals (failsafe) ── */
if (animOn && 'IntersectionObserver' in window){
  const cio = new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');cio.unobserve(e.target);}})},{threshold:.2});
  $$('.clip-rev').forEach(el=>cio.observe(el));
  setTimeout(()=>$$('.clip-rev').forEach(el=>el.classList.add('in')),3000);
} else { $$('.clip-rev').forEach(el=>el.classList.add('in')); }

/* ════════════════ PRELOADER ════════════════
   2026-10-11 SPEED: markup removed (see the comment at the top of <body>), so this returns
   at `if (!pl) return;` and does nothing. Kept only so a restore is copy-paste. */
(function(){
  const pl = $('#preload'), bar = $('#preloadBar');
  if (!pl) return;
  let p = 0;
  const tick = setInterval(()=>{ p = Math.min(96, p + Math.random()*22); bar.style.width = p + '%'; }, 140);
  /* 2026-09-26: no longer toggles body overflow. The overlay is position:fixed and
     covers the page anyway; locking and unlocking <body> scroll made Chrome report a
     whole-page layout shift of 0.73 on phones (CLS) when the lock was released. */
  function finish(){ clearInterval(tick); bar.style.width='100%'; setTimeout(()=>{ pl.classList.add('done'); }, 260); }
  window.addEventListener('load', () => setTimeout(finish, 380));
  setTimeout(finish, 4000); // hard failsafe
})();

const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
const FINE = matchMedia('(hover:hover) and (pointer:fine)').matches;

/* ── scroll-scrubbed hero film (vanilla + one rAF per paint) ── */
(function(){
  const hero=$('.hero'), camera=$('#heroFrames'), video=$('#heroVideo');
  const content=$('.hero-in'), indicator=$('.hero-scroll');
  if (REDUCED || !hero || !camera || !video) return;

  const clamp=n=>Math.max(0,Math.min(1,n));
  let queued=false;
  let duration=0;

  function revealFilm(){
    duration=Number.isFinite(video.duration)?video.duration:0;
    if(video.readyState>=2) video.classList.add('is-ready');
    requestHeroRender();
  }

  function renderHero(){
    const rect=hero.getBoundingClientRect();
    const total=Math.max(1,rect.height-innerHeight);
    const progress=clamp(-rect.top/total);

    if(duration && video.readyState>=2){
      const target=Math.min(duration-.04,progress*duration);
      if(Math.abs(video.currentTime-target)>.018) video.currentTime=Math.max(0,target);
    }

    /* The encoded scenes share one direction; keep the outer camera level. */
    const x=innerWidth>=768?-8*progress:0;
    const scale=1.045-.025*progress;
    camera.style.transform=`translate3d(${x.toFixed(2)}px,0,0) scale(${scale.toFixed(4)})`;

    /* Keep a visible CTA through the section handoff instead of fading to black. */
    const contentFade=clamp((progress-.78)/.22);
    content.style.transform=`translate3d(0,${(-18*contentFade).toFixed(2)}px,0)`;
    content.style.opacity=(1-.58*contentFade).toFixed(4);
    if(indicator) indicator.style.opacity=(1-clamp(progress/.12)).toFixed(4);
    queued=false;
  }

  function requestHeroRender(){
    if(queued) return;
    queued=true;
    requestAnimationFrame(renderHero);
  }

  addEventListener('scroll',requestHeroRender,{passive:true});
  addEventListener('resize',requestHeroRender,{passive:true});
  video.addEventListener('loadedmetadata',revealFilm,{once:true});
  video.addEventListener('loadeddata',revealFilm,{once:true});
  video.pause();
  if(video.readyState>=1) revealFilm();
  else video.load();
  requestHeroRender();
})();

/* ════════════════ MAIN ENHANCEMENTS (after libs load) ════════════════ */
window.addEventListener('load', () => {
  if (REDUCED) return;
  const hasGsap = !!window.gsap;
  if (hasGsap) gsap.registerPlugin(ScrollTrigger);

  /* ── native scroll (no smooth-scroll hijack — faster, more responsive) ── */
  let scrollTick = false;
  const sprog = $('#sprog');
  function onScroll(){
    if (scrollTick) return; scrollTick = true;
    requestAnimationFrame(() => {
      const h=document.documentElement; const m=h.scrollHeight-innerHeight;
      sprog.style.transform='scaleX('+(m>0?Math.min(1,scrollY/m):0)+')';
      scrollTick = false;
    });
  }
  addEventListener('scroll', onScroll, {passive:true}); onScroll();

  /* ── GSAP parallax below the hero (the hero now uses vanilla frame scrubbing) ── */
  if (hasGsap){
    gsap.to('#editImg', {yPercent:-8, ease:'none', scrollTrigger:{trigger:'.edit', start:'top bottom', end:'bottom top', scrub:.3}});
  }

  /* ── custom cursor + magnetic + tilt (fine pointer only) ── */
  if (FINE && hasGsap){
    document.body.classList.add('cursor-on');
    const cur=$('#cursor'), dot=$('#cursorDot');
    const cx=gsap.quickTo(cur,'x',{duration:.5,ease:'power3'}), cy=gsap.quickTo(cur,'y',{duration:.5,ease:'power3'});
    const dx=gsap.quickTo(dot,'x',{duration:.12,ease:'power2'}), dy=gsap.quickTo(dot,'y',{duration:.12,ease:'power2'});
    addEventListener('mousemove', e=>{ cx(e.clientX);cy(e.clientY);dx(e.clientX);dy(e.clientY);
      if(!cur.classList.contains('on')){cur.classList.add('on');dot.classList.add('on');} });
    addEventListener('mousedown', ()=>cur.classList.add('down'));
    addEventListener('mouseup', ()=>cur.classList.remove('down'));
    document.addEventListener('mouseover', e=>{ if(e.target.closest('a,button,.pcard,input,select,details summary')) cur.classList.add('hover'); });
    document.addEventListener('mouseout', e=>{ if(e.target.closest('a,button,.pcard,input,select,details summary')) cur.classList.remove('hover'); });

    /* magnetic buttons */
    $$('.btn, .nav-wa, .dr-wa, .see-all, .icon-b, .nl-btn').forEach(el=>{
      const mx=gsap.quickTo(el,'x',{duration:.45,ease:'power3'}), my=gsap.quickTo(el,'y',{duration:.45,ease:'power3'});
      el.addEventListener('mousemove', e=>{ const r=el.getBoundingClientRect(); mx((e.clientX-r.left-r.width/2)*.4); my((e.clientY-r.top-r.height/2)*.4); });
      el.addEventListener('mouseleave', ()=>{ mx(0); my(0); });
    });
  }

  /* ── 3D tilt on product cards (delegated, fine pointer) ── */
  if (FINE){
    const tiltable = e => e.target.closest('.pcard');
    document.addEventListener('mousemove', e=>{
      const c = tiltable(e); if(!c) return;
      c.classList.add('tilt'); c.style.perspective='800px';
      const r=c.getBoundingClientRect(); const px=(e.clientX-r.left)/r.width-.5, py=(e.clientY-r.top)/r.height-.5;
      c.style.transform=`translateY(-6px) rotateX(${py*-7}deg) rotateY(${px*8}deg)`;
    });
    document.addEventListener('mouseout', e=>{ const c=e.target.closest('.pcard'); if(c && !c.contains(e.relatedTarget)){ c.style.transform=''; } });
  }

  /* ── Three.js gold-dust field in hero (cheap: capped DPR, paused while scrolled away) ── */
  if (window.THREE && FINE && innerWidth > 900 && !navigator.connection?.saveData && document.getElementById('heroFx') && document.querySelector('.hero-sticky')){
    const cv=$('#heroFx'), hero=$('.hero-sticky');
    try{
      const renderer=new THREE.WebGLRenderer({canvas:cv,alpha:true,antialias:false,powerPreference:'low-power'});
      renderer.setPixelRatio(Math.min(devicePixelRatio,1.25));
      const scene=new THREE.Scene();
      const cam=new THREE.PerspectiveCamera(60,1,.1,100); cam.position.z=8;
      const N=120, pos=new Float32Array(N*3), spd=new Float32Array(N);
      for(let i=0;i<N;i++){ pos[i*3]=(Math.random()-.5)*18; pos[i*3+1]=(Math.random()-.5)*12; pos[i*3+2]=(Math.random()-.5)*8; spd[i]=.002+Math.random()*.006; }
      const geo=new THREE.BufferGeometry(); geo.setAttribute('position',new THREE.BufferAttribute(pos,3));
      const sprite=(()=>{ const c=document.createElement('canvas'); c.width=c.height=64; const x=c.getContext('2d');
        const g=x.createRadialGradient(32,32,0,32,32,32); g.addColorStop(0,'rgba(224,181,42,.95)'); g.addColorStop(.4,'rgba(200,154,14,.5)'); g.addColorStop(1,'rgba(200,154,14,0)');
        x.fillStyle=g; x.fillRect(0,0,64,64); const t=new THREE.CanvasTexture(c); return t; })();
      const mat=new THREE.PointsMaterial({size:.16,map:sprite,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending});
      const pts=new THREE.Points(geo,mat); scene.add(pts);
      let mx=0,my=0; hero.addEventListener('mousemove',e=>{const r=hero.getBoundingClientRect();mx=(e.clientX/r.width-.5);my=(e.clientY/r.height-.5);},{passive:true});
      function size(){ const r=hero.getBoundingClientRect(); renderer.setSize(r.width,r.height,false); cam.aspect=r.width/r.height; cam.updateProjectionMatrix(); }
      size(); addEventListener('resize',size,{passive:true});
      let vis=true; const io=new IntersectionObserver(es=>{vis=es[0].isIntersecting;},{threshold:.01}); io.observe(hero);
      (function loop(){ requestAnimationFrame(loop); if(!vis||document.hidden)return; /* skip all work when hero off-screen or tab hidden */
        const a=geo.attributes.position.array;
        for(let i=0;i<N;i++){ a[i*3+1]+=spd[i]; if(a[i*3+1]>6)a[i*3+1]=-6; }
        geo.attributes.position.needsUpdate=true;
        pts.rotation.y += .0006; cam.position.x += (mx*1.4-cam.position.x)*.04; cam.position.y += (-my*1-cam.position.y)*.04; cam.lookAt(0,0,0);
        renderer.render(scene,cam);
      })();
    }catch(err){ cv.style.display='none'; }
  }

  /* ── cart drawer open: stagger items in (targets the shared Shopify drawer) ── */
  const origOpen = window.openDrawer;
  if (hasGsap && typeof origOpen==='function'){
    window.openDrawer = function(){ origOpen(); gsap.fromTo('#lbdrItems .lbdr-it',{opacity:0,x:-20},{opacity:1,x:0,duration:.45,stagger:.07,ease:'power2.out',overwrite:true}); };
    $('#cartBtn').onclick = window.openDrawer;
    $('#pdpCartBtn').onclick = () => { closePDP(); window.openDrawer(); };
  }
});

/* ── LUX POLISH: cart success micro-state (decoupled — watches the badge) ── */
(function(){
  const bub = document.getElementById('cartBub'), btn = document.getElementById('cartBtn');
  if (!bub) return;
  let last = parseInt(bub.textContent) || 0;
  const pulse = () => {
    bub.classList.remove('pulse'); void bub.offsetWidth; bub.classList.add('pulse');
    if (btn){ btn.classList.add('cart-flash'); setTimeout(()=>btn.classList.remove('cart-flash'), 450); }
  };
  new MutationObserver(() => {
    const n = parseInt(bub.textContent) || 0;
    if (n > last) pulse();
    last = n;
  }).observe(bub, {childList:true, characterData:true, subtree:true});
})();

/* ── SEO deep-link: open a product from /index.html#product=ID or ?product=ID (static SEO pages link here) ── */
(function(){
  function stripProductCodes(root){
    if (!root) return;
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(node){
        return node.nodeValue && /LBO-[A-Z0-9-]+/i.test(node.nodeValue)
          ? NodeFilter.FILTER_ACCEPT
          : NodeFilter.FILTER_REJECT;
      }
    });
    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(node => {
      node.nodeValue = node.nodeValue
        .replace(/\s*[—–-]\s*LBO-[A-Z0-9-]+/gi, '')
        .replace(/(?:Product\s*code|Code produit|الكود)\s*:?\s*LBO-[A-Z0-9-]+/gi, '')
        .replace(/\bLBO-[A-Z0-9-]+\b/gi, '')
        .replace(/\s{2,}/g, ' ')
        .trim();
    });
  }
  stripProductCodes(document.body);

  function openFromUrl(){
    var m = (location.hash + ' ' + location.search).match(/product=([A-Za-z0-9_-]+)/);
    if (m && typeof openPDP === 'function' && typeof byId === 'function' && byId(m[1])) openPDP(m[1]);
  }
  setTimeout(openFromUrl, 80);
  addEventListener('hashchange', openFromUrl);
})();
</script>

