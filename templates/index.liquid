  if (btn){ btn.classList.add('ok'); btn.textContent = '✓ تزادت فالسلة'; btn.disabled = true;
    setTimeout(()=>{ if($('#pdpAdd')){ btn.classList.remove('ok'); btn.textContent='+ زيدها للسلة'; btn.disabled=false; } }, 1800); }
}
function closePDP(){ $('#pdp').classList.remove('open'); document.body.style.overflow = ''; document.body.classList.remove('pdp-open'); pdpProduct = null; }
function activePdpImageIndex(){
  const thumbs = Array.from(document.querySelectorAll('[data-pdp-thumb]'));
  const active = thumbs.findIndex(b => b.classList.contains('on'));
  return active >= 0 ? active : 0;
}
function setQuickPdpImage(index){
  const thumbs = Array.from(document.querySelectorAll('[data-pdp-thumb]'));
  const main = document.getElementById('pdpMainImg');
  if (!thumbs.length || !main) return;
  const current = (index + thumbs.length) % thumbs.length;
  const thumb = thumbs[current];
  const src = thumb.dataset.src;
  const viz = document.getElementById('pdpMainViz');
  const count = document.getElementById('pdpImgCount');
  if (src){
    main.src = src;
    if (viz) viz.dataset.zoom = src;
  }
  thumbs.forEach((b, i) => {
    const active = i === current;
    b.classList.toggle('on', active);
    b.setAttribute('aria-current', active ? 'true' : 'false');
  });
  if (count) count.textContent = `${current + 1} / ${thumbs.length}`;
  thumb.scrollIntoView({block:'nearest', inline:'nearest'});
}
function shiftQuickPdpImage(step){
  setQuickPdpImage(activePdpImageIndex() + step);
}
function bindPdpGallerySwipe(){
  const viz = document.getElementById('pdpMainViz');
  if (!viz || !document.querySelector('[data-pdp-thumb]')) return;
  let sx = 0, sy = 0;
  viz.addEventListener('touchstart', e => {
    sx = e.touches[0].clientX;
    sy = e.touches[0].clientY;
  }, {passive:true});
  viz.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - sx;
    const dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4){
      shiftQuickPdpImage(dx < 0 ? 1 : -1);
    }
  }, {passive:true});
}
function pdpOrderWA(){
  if (!pdpProduct) return;
