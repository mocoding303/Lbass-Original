<!-- ── AI Referral Welcome Block ─────────────────────────────────────────
     Appears only when visitor comes from ChatGPT/Perplexity/Gemini etc.
     GA4 data: 254 ChatGPT sessions → homepage, 1.4% ATC, 0 revenue.
     Fix: route AI visitors to products immediately.
     Source: GA4 analysis 2026-08-22.
───────────────────────────────────────────────────────────────────────── -->
{%- comment -%}
  2026-10-04 (AI-readiness audit). This block used to sit in the HTML with
  display:none and be revealed by JS: hidden text in the page source, which the
  audit penalised. The script now BUILDS it, and only for AI referrers (or
  ?ref=ai), so crawlers and normal visitors get no hidden copy. Copy toned down:
  the old line «هاد القطع اللي كيتحدث عليهم ChatGPT وPerplexity» claimed something
  we cannot check. The kicker lost letter-spacing:.15em, which broke Arabic letter
  joining. Same links, same GA4 event (ai_referral_detected).
{%- endcomment -%}
<div id="lb-ai-block"></div>
<script>
(function(){
  var ref = document.referrer || '';
  var ai  = ['chatgpt.com','perplexity.ai','claude.ai','copilot.microsoft.com',
              'gemini.google.com','you.com','phind.com','kagi.com'];
  var isAI = ai.some(function(s){ return ref.indexOf(s) > -1; });
  if(!(isAI || new URLSearchParams(window.location.search).get('ref') === 'ai')) return;
  var el = document.getElementById('lb-ai-block');
  if(!el) return;
  el.style.cssText = 'max-width:var(--max,1100px);margin:0 auto;padding:0 20px';
  el.innerHTML =
    '<div style="padding:18px 20px;background:rgba(37,211,102,.06);border:1px solid rgba(37,211,102,.2);border-radius:12px">' +
      '<p style="margin:0 0 4px;font-size:12px;font-weight:800;color:rgba(37,211,102,.75)">جيت من مساعد AI؟ مرحبا بيك</p>' +
      '<p style="margin:0 0 14px;font-size:15px;font-weight:800;color:var(--cream,#F4EFE6)">هنا كتلقى حوايج براند second-hand أصلية متوفرة دابا، بصور حقيقية لنفس القطعة.</p>' +
      '<div style="display:flex;gap:10px;flex-wrap:wrap">' +
        '<a href="/collections/%D8%B5%D8%A8%D8%A7%D8%A8%D8%B7" style="padding:10px 16px;background:var(--gold,#c89a0e);color:#000;border-radius:8px;text-decoration:none;font-weight:800;font-size:13px">👟 الصبابط</a>' +
        '<a href="/collections/adidas-originals" style="padding:10px 16px;background:transparent;border:1px solid rgba(200,154,14,.4);color:var(--gold2,#E0B52A);border-radius:8px;text-decoration:none;font-weight:700;font-size:13px">Adidas</a>' +
        '<a href="/collections/nike" style="padding:10px 16px;background:transparent;border:1px solid rgba(200,154,14,.4);color:var(--gold2,#E0B52A);border-radius:8px;text-decoration:none;font-weight:700;font-size:13px">Nike</a>' +
        '<a href="/collections/all" style="padding:10px 16px;background:transparent;border:1px solid #444;color:var(--txt2,#97928A);border-radius:8px;text-decoration:none;font-weight:700;font-size:13px">كل القطع</a>' +
      '</div>' +
      '<p style="margin:10px 0 0;font-size:12px;color:var(--txt3,#66615A)">COD — خلّص ملي توصلك · 20 درهم مراكش · 50 درهم باقي المغرب · مجاني من 500 درهم · صور حقيقية · حالة واضحة</p>' +
    '</div>';
  if(typeof gtag === 'function'){
    gtag('event','ai_referral_detected',{event_category:'acquisition',event_label:ref.split('/')[2]||'ai_param'});
  }
})();
</script>


