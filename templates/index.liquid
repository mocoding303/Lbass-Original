    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px">
      {% for bp in bf_avail %}
        {% if bp.tags contains 'vault' and bf_count < 4 %}
          {% assign bf_count = bf_count | plus: 1 %}
          {% render 'lbass-look-card', rp: bp %}
        {% endif %}
      {% endfor %}
      {% if bf_count < 4 %}
        {% assign bf_by_price = bf_avail | sort: 'price' | reverse %}
        {% for bp in bf_by_price %}
          {% if bf_count >= 4 %}{% break %}{% endif %}
          {% unless bp.tags contains 'vault' %}
            {% assign bf_count = bf_count | plus: 1 %}
            {% render 'lbass-look-card', rp: bp %}
          {% endunless %}
        {% endfor %}
