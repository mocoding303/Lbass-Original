/* ── Reveals: IntersectionObserver + CSS transitions (rAF-independent, can't stall hidden) ── */
const animOn = document.documentElement.classList.contains('anim');
function reveal(el){ el.classList.add('in'); }
if (animOn && 'IntersectionObserver' in window){
  const io = new IntersectionObserver((ents) => {
    ents.forEach(e => { if (e.isIntersecting){ reveal(e.target); io.unobserve(e.target); } });
  }, {threshold:.12, rootMargin:'0px 0px -8% 0px'});
  $$('.rev, .rev-hero').forEach(el => io.observe(el));
  /* hero is above the fold — reveal next frame for the entrance transition */
  requestAnimationFrame(() => $$('.hero .rev, .rev-hero').forEach(reveal));
  /* watchdog: if anything never got revealed, force it visible */
  setTimeout(() => $$('.rev, .rev-hero').forEach(reveal), 2600);
} else {
  $$('.rev, .rev-hero').forEach(reveal);
}

/* ── Count-up stats (purely additive; numbers show even if it never runs) ── */
function countUp(el){
  const end = +el.dataset.count, t0 = performance.now(), dur = 1500;
  const fin = () => el.textContent = end.toLocaleString('en-US');
  (function tick(now){
    const p = Math.min(1, (now - t0) / dur);
    el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
    if (p < 1) requestAnimationFrame(tick);
  })(t0);
  setTimeout(fin, dur + 400); // guarantee final value even if rAF is throttled
}
if ('IntersectionObserver' in window){
  const cio = new IntersectionObserver((ents) => {
    ents.forEach(e => { if (e.isIntersecting){ countUp(e.target); cio.unobserve(e.target); } });
  }, {threshold:.5});
  $$('[data-count]').forEach(el => cio.observe(el));
} else {
  $$('[data-count]').forEach(el => el.textContent = (+el.dataset.count).toLocaleString('en-US'));
}

/* ── clip-path image reveals (failsafe) ── */
if (animOn && 'IntersectionObserver' in window){
  const cio = new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');cio.unobserve(e.target);}})},{threshold:.2});
  $$('.clip-rev').forEach(el=>cio.observe(el));
  setTimeout(()=>$$('.clip-rev').forEach(el=>el.classList.add('in')),3000);
} else { $$('.clip-rev').forEach(el=>el.classList.add('in')); }

