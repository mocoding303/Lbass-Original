<!-- ═══ VAULT ═══ -->
<section class="sec vault-section" id="vault" aria-labelledby="vault-h">
  <div class="sec-in">
    <div class="sec-head vault-head rev">
      <div class="vault-head-copy">
        <p class="kick">VAULT</p>
        <h2 class="h2" id="vault-h">لقطات نادرة <em>قبل ما تمشي</em></h2>
        <p class="sec-sub">مختارات من قطع second-hand أصلية، بصور حقيقية وحالة ومخزون حسب كل منتج.</p>
        <p class="vault-urgency">شوف التوفر الحقيقي فصفحة القطعة</p>
      </div>
      <a class="vault-primary-cta" href="/pages/vault" data-vault-main-cta data-vault-placement="headline">دخل للـ VAULT <span aria-hidden="true">←</span></a>
    </div>
    <div class="vault-trust-row rev" aria-label="معلومات الثقة ديال Vault">
      <span>صور حقيقية لنفس القطعة</span>
      <span>الحالة والعيوب واضحة</span>
      <span>الدفع عند الاستلام</span>
      <span>توصيل لكل المغرب</span>
    </div>
    {% comment %} Live Vault stats — same pool logic as page.vault (vault-tagged + top-14 priced, available only) {% endcomment %}
    {% assign v_avail = collections.all.products | where: 'available', true %}
    {% capture v_pool %},{% for p in v_avail %}{% if p.tags contains 'vault' %}{{ p.id }},{% endif %}{% endfor %}{% endcapture %}
    {% assign v_sorted = v_avail | sort: 'price' | reverse %}
    {% for p in v_sorted limit: 14 %}
      {% capture v_pid %},{{ p.id }},{% endcapture %}
      {% unless v_pool contains v_pid %}{% assign v_pool = v_pool | append: p.id | append: ',' %}{% endunless %}
    {% endfor %}
    {% assign vn_shoes = 0 %}{% assign vn_street = 0 %}{% assign vn_denim = 0 %}
    {% assign vm_shoes = 999999900 %}{% assign vm_street = 999999900 %}{% assign vm_denim = 999999900 %}
    {% assign vt_shoes = '' %}{% assign vt_street = '' %}{% assign vt_denim = '' %}
    {% for p in v_avail %}
      {% capture v_pid %},{{ p.id }},{% endcapture %}
      {% unless v_pool contains v_pid %}{% continue %}{% endunless %}
      {% assign v_tags = p.tags | join: ',' | downcase %}
      {% assign v_type = p.product_type | downcase %}
      {% assign v_cat = '' %}
      {% if v_tags contains 'shoes' or v_tags contains 'sneaker' or v_tags contains 'slides' or v_type == 'shoes' %}
        {% assign v_cat = 'shoes' %}
      {% elsif v_tags contains 'jacket' or v_tags contains 'jeans' or v_tags contains 'denim' or v_tags contains 'pants' or v_tags contains 'cargo' or v_type == 'jackets' or v_type == 'jeans' or v_type == 'pants' %}
        {% assign v_cat = 'denim' %}
      {% elsif v_tags contains 't-shirt' or v_tags contains 'tshirt' or v_tags contains 'hoodie' or v_tags contains 'shirt' or v_tags contains 'streetwear' or v_tags contains 'jersey' or v_type == 't-shirts' or v_type == 'hoodies' or v_type == 'sets' %}
        {% assign v_cat = 'street' %}
      {% endif %}
      {% if v_cat == 'shoes' %}
        {% assign vn_shoes = vn_shoes | plus: 1 %}
        {% if p.price < vm_shoes %}{% assign vm_shoes = p.price %}{% endif %}
        {% if vn_shoes <= 3 and p.featured_image %}{% capture vt_shoes %}{{ vt_shoes }}<img src="{{ p.featured_image | image_url: width: 80 }}" alt="" loading="lazy" width="30" height="30">{% endcapture %}{% endif %}
      {% elsif v_cat == 'denim' %}
        {% assign vn_denim = vn_denim | plus: 1 %}
        {% if p.price < vm_denim %}{% assign vm_denim = p.price %}{% endif %}
        {% if vn_denim <= 3 and p.featured_image %}{% capture vt_denim %}{{ vt_denim }}<img src="{{ p.featured_image | image_url: width: 80 }}" alt="" loading="lazy" width="30" height="30">{% endcapture %}{% endif %}
      {% elsif v_cat == 'street' %}
        {% assign vn_street = vn_street | plus: 1 %}
        {% if p.price < vm_street %}{% assign vm_street = p.price %}{% endif %}
        {% if vn_street <= 3 and p.featured_image %}{% capture vt_street %}{{ vt_street }}<img src="{{ p.featured_image | image_url: width: 80 }}" alt="" loading="lazy" width="30" height="30">{% endcapture %}{% endif %}
      {% endif %}
    {% endfor %}
    {% assign v_total = vn_shoes | plus: vn_street | plus: vn_denim %}
    {% assign v_shoes_url = collections['صبابط'].url | default: '/pages/vault?cat=shoes' %}
    {% assign v_street_url = collections['audited-drop-p001-p012'].url | default: '/pages/vault?cat=streetwear' %}
    {% assign v_denim_url = collections['جاكيطات-و-معاطف'].url | default: '/pages/vault?cat=denim' %}
    <div class="vault-grid" data-vault-total="{{ v_total }}">
      <a class="vault-card rev" href="{{ v_shoes_url }}" data-vault-card data-vault-category="sneakers" data-vault-destination="{{ v_shoes_url }}">
        <img src="{{ 'hero-lifestyle-1.webp' | asset_url }}" alt="سنيكرز وصبابط أصلية متوفرة فـ Lbass Original" loading="lazy" decoding="async" width="1376" height="768">
        <div class="vault-card-content">
          <small>SNEAKERS{% if vn_shoes > 0 %} · {{ vn_shoes }} متوفرة دابا{% endif %}</small>
          <b>Sneakers</b>
          <span class="vault-benefit">صبابط أصلية كتبدل اللوك كامل.</span>
          <span class="vlt-proof">صور حقيقية · حالة ومخزون حسب كل قطعة</span>
          {% if vn_shoes > 0 %}
          <span class="vlt-meta"><span class="vlt-thumbs">{{ vt_shoes }}</span><span class="vlt-live">{{ vn_shoes }} {% if vn_shoes == 1 %}قطعة متوفرة{% else %}قطع متوفرة{% endif %}</span></span>
          <span class="vlt-cta">شوف السنيكرز ←</span>
          {% else %}<span class="vlt-live">حالياً ما كايناش قطعة متوفرة</span><span class="vlt-cta vlt-out">شوف الكاتيجوري ←</span>{% endif %}
        </div>
      </a>
      <a class="vault-card rev" href="{{ v_street_url }}" data-vault-card data-vault-category="streetwear" data-vault-destination="{{ v_street_url }}">
        <img src="{{ 'editorial-campaign.webp' | asset_url }}" alt="قطع streetwear أصلية مختارة من Lbass Original" loading="lazy" decoding="async" width="896" height="1200">
        <div class="vault-card-content">
          <small>STREETWEAR{% if vn_street > 0 %} · {{ vn_street }} متوفرة دابا{% endif %}</small>
          <b>Streetwear</b>
          <span class="vault-benefit">قطع كتخلي اللوك ديالك ماشي عادي.</span>
          <span class="vlt-proof">مختارة بعناية · صور حقيقية · مخزون حسب المنتج</span>
          {% if vn_street > 0 %}
          <span class="vlt-meta"><span class="vlt-thumbs">{{ vt_street }}</span><span class="vlt-live">{{ vn_street }} {% if vn_street == 1 %}قطعة متوفرة{% else %}قطع متوفرة{% endif %}</span></span>
          <span class="vlt-cta">دخل للـ Streetwear ←</span>
          {% else %}<span class="vlt-live">حالياً ما كايناش قطعة متوفرة</span><span class="vlt-cta vlt-out">شوف آخر الـ drops ←</span>{% endif %}
        </div>
      </a>
      <a class="vault-card rev" href="{{ v_denim_url }}" data-vault-card data-vault-category="denim-jackets" data-vault-destination="{{ v_denim_url }}">
        <img src="{{ 'hero-lifestyle-3b.webp' | asset_url }}" alt="جينز وجاكيتات أصلية مختارة من Lbass Original" loading="lazy" decoding="async" width="1264" height="848">
        <div class="vault-card-content">
          <small>DENIM &amp; JACKETS{% if vn_denim > 0 %} · {{ vn_denim }} متوفرة دابا{% endif %}</small>
          <b>Denim &amp; Jackets</b>
          <span class="vault-benefit">جينز وجاكيتات كيزيدو قيمة للوك.</span>
          <span class="vlt-proof">حالة ومخزون حسب المنتج · صور حقيقية</span>
          {% if vn_denim > 0 %}
          <span class="vlt-meta"><span class="vlt-thumbs">{{ vt_denim }}</span><span class="vlt-live">{{ vn_denim }} {% if vn_denim == 1 %}قطعة متوفرة{% else %}قطع متوفرة{% endif %}</span></span>
          <span class="vlt-cta">شوف الدنيم والجاكيطات ←</span>
          {% else %}<span class="vlt-live">حالياً ما كايناش قطعة متوفرة</span><span class="vlt-cta vlt-out">شوف الجاكيطات ←</span>{% endif %}
        </div>
      </a>
    </div>
    <p class="vault-aeo rev"><strong>Vault ديال Lbass Original</strong> هو اختيار مركز من قطع streetwear أصلية second-hand فالمغرب: سنيكرز، جاكيتات، دنيم وقطع محدودة. كل منتج كيبان بصورو الحقيقية، وحالتو ومخزونو حسب المعلومات المؤكدة.</p>
    <div class="vlt-foot rev">
      {% if v_total > 0 %}
      <p>المخزون وشارة <b>1/1</b> كيبانو حسب Shopify فصفحة كل قطعة.</p>
      <a class="btn btn-gold" href="/pages/vault" data-vault-main-cta data-vault-placement="after_cards">شوف القطع قبل ما تمشي — {{ v_total }} متوفرة دابا</a>
      {% else %}
      <p>ملي تدخل قطع جديدة، المخزون وشارة <b>1/1</b> كيبانو حسب Shopify.</p>
      <a class="btn btn-gold" href="{{ v_street_url }}" data-vault-main-cta data-vault-placement="after_cards">تفرج فآخر الـ drops</a>
      {% endif %}
    </div>
  </div>
</section>

<script>
/* Vault funnel attribution: homepage impression -> CTA/card -> Vault product -> cart/checkout. */
(function(){
  var section=document.getElementById('vault');
  if(!section)return;
  var key='lbass_vault_attribution_v1';
  var totalNode=section.querySelector('[data-vault-total]');
  var total=parseInt(totalNode ? totalNode.getAttribute('data-vault-total') : '0',10)||0;
  function send(name,params){
    params=params||{};
    try{if(window.Shopify&&Shopify.analytics&&typeof Shopify.analytics.publish==='function')Shopify.analytics.publish(name,params)}catch(e){}
    try{
      if(typeof window.fbq === 'function') {
        window.fbq('trackCustom', name, params);
      } else {
        var fbqInterval = setInterval(function(){
          if(typeof window.fbq === 'function') {
            window.fbq('trackCustom', name, params);
            clearInterval(fbqInterval);
          }
        }, 300);
        setTimeout(function(){ clearInterval(fbqInterval); }, 5000);
      }
    }catch(e){}
  }
  function save(touch,category,destination){
    try{sessionStorage.setItem(key,JSON.stringify({source:'vault_home',touch:touch,category:category||'all',destination:destination||'/pages/vault',ts:Date.now()}))}catch(e){}
  }
  var viewed=false;
  function viewedOnce(){
    if(viewed)return;
    viewed=true;
    send('lbass_vault_view',{available_items:total,page_path:location.pathname});
  }
  if('IntersectionObserver' in window){
    var observer=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){if(entry.isIntersecting){viewedOnce();observer.disconnect()}});
    },{threshold:.3});
    observer.observe(section);
  }else{viewedOnce()}
  section.addEventListener('click',function(event){
    var card=event.target.closest('[data-vault-card]');
    var main=event.target.closest('[data-vault-main-cta]');
    if(card){
      var category=card.getAttribute('data-vault-category')||'unknown';
      var destination=card.getAttribute('data-vault-destination')||card.getAttribute('href')||'';
      save('card',category,destination);
      send('lbass_vault_card_click',{category:category,destination:destination,available_items:total});
    }else if(main){
      var placement=main.getAttribute('data-vault-placement')||'unknown';
      var href=main.getAttribute('href')||'/pages/vault';
      save('main_cta','all',href);
      send('lbass_vault_main_cta_click',{placement:placement,destination:href,available_items:total});
    }
  });
})();
</script>

