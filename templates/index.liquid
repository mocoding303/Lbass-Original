<style>
/* ════════════════ TOKENS ════════════════ */
:root{
  --ink:#0A0A0B; --ink2:#121214; --ink3:#1A1A1E; --line:#26262B; --line2:#34343B;
  --gold:#C89A0E; --gold2:#E0B52A; --gold-dim:rgba(200,154,14,.14); --gold-br:rgba(200,154,14,.35);
  --sand:#EDE4D3; --sand2:#E2D5BC; --clay:#B4502A; --clay2:#D4683E;
  --green:#1FA855; --green2:#27C063;
  --txt:#D8D4CC; --txt2:#97928A; --txt3:#5E5A55; --cream:#F4EFE6;
  --ar:'Tajawal',sans-serif; --lt:'Space Grotesk',sans-serif;
  --r-sm:10px; --r-md:16px; --r-lg:24px;
  --tr:.28s cubic-bezier(.4,0,.2,1);
  --pad:clamp(18px,5vw,64px);
  --max:1500px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
/* `clip` prevents horizontal bleed without creating a scroll container that breaks the sticky hero. */
html{scroll-behavior:smooth;overflow-x:clip}
body{background:var(--ink);color:var(--txt);font-family:var(--ar);font-size:16px;line-height:1.7;overflow-x:clip;max-width:100%}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer;font-size:inherit}
input,select{font-family:inherit}
::selection{background:var(--gold);color:var(--ink)}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:4px}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

/* ════════════════ STAR MOTIF ════════════════ */
.star8{display:inline-block;width:1em;aspect-ratio:1;vertical-align:-0.12em}
.star8 svg{width:100%;height:100%;display:block}
.nl-star{aspect-ratio:1}

/* ════════════════ ANNOUNCEMENT BAR + BRAND MARK (footer) ════════════════ */
.lb-bar{position:sticky;top:0;z-index:56;background:rgba(200,154,14,.13);border-bottom:1px solid rgba(200,154,14,.22);backdrop-filter:blur(8px);overflow:hidden;height:36px;display:flex;align-items:center}
.lb-bar-track{display:flex;align-items:center;gap:0;white-space:nowrap;animation:lbMarquee 50s linear infinite}
.lb-bar-item{display:inline-flex;align-items:center;gap:7px;padding:0 32px;font-size:12.5px;font-weight:800;color:var(--gold2);letter-spacing:.03em}
.lb-bar-sep{color:rgba(200,154,14,.5);font-size:10px}
@keyframes lbMarquee{0%{transform:translateX(0)}100%{transform:translateX(50%)}}
@media(max-width:480px){.lb-bar-item{padding:0 20px;font-size:11.5px}}
.brand{display:flex;align-items:center;gap:12px;flex-shrink:0}
.brand-logo{display:block;width:clamp(154px,15vw,196px);height:auto;transition:transform .35s ease,filter .35s ease}
.brand-monogram{display:none;width:38px;height:38px;transition:transform .35s ease,filter .35s ease}
.brand:hover .brand-logo,.brand:hover .brand-monogram{transform:translateY(-1px);filter:drop-shadow(0 0 10px rgba(200,154,14,.22))}
@media(max-width:560px){
  .brand{gap:8px}
      .brand-logo{width:154px}
}
@media(max-width:340px){.brand-logo{display:none}.brand-monogram{display:block}}

/* ════════════════ HERO (server-rendered, 2026-09-30) ════════════════
   Colours come from the lbass-stamp --lb-* tokens, not --ink/--cream: this page
   inverts the legacy tokens at runtime (see snippets/lbass-home-collections).
   h1 needs (0,2,1) + !important to beat lbass-stamp's global h1 size rule. */
.lbx-hero{background:radial-gradient(120% 70% at 50% 0%,#FFFFFF 0%,#FBFAF7 55%,#F1EEE7 100%);border-bottom:1px solid rgba(11,11,12,.12)}
.lbx-hero-in{max-width:1240px;margin:0 auto;padding:clamp(18px,4vw,52px) clamp(16px,4vw,48px) clamp(22px,4vw,56px);display:grid;gap:clamp(18px,4vw,64px);align-items:center}
.lbx-eyebrow{margin:0 0 10px;display:flex;align-items:center;gap:8px;font-family:var(--lb-arabic,'Alexandria','Tajawal',sans-serif);font-size:13px;font-weight:700;line-height:1.5;color:var(--lb-ink-2,#3A3A3C)}
.lbx-eyebrow::before{content:"";flex:none;width:8px;height:8px;background:var(--lb-red,#BF2E15)}
.lbx-hero h1.lbx-h1{margin:0;font-size:clamp(31px,5.4vw,66px)!important;line-height:1.16!important;letter-spacing:normal!important;color:var(--lb-ink,#0B0B0C)!important;text-wrap:balance}
.lbx-h1-brand{display:block;font-size:.52em;line-height:1.35;margin-bottom:.12em}
.lbx-h1-main{display:block;color:var(--lb-red,#BF2E15)}
.lbx-nb{white-space:nowrap}
.lbx-lead{margin:14px 0 0;max-width:48ch;font-size:clamp(14.5px,1.45vw,17px);line-height:1.8;color:var(--lb-ink-2,#3A3A3C)}
.lbx-latin{margin:6px 0 0;max-width:48ch;font-family:var(--lb-body,'Epilogue',sans-serif);font-size:12px;line-height:1.6;color:var(--lb-ink-3,#6B6B6E);text-align:end}
.lbx-ctas{display:flex;flex-wrap:wrap;align-items:center;gap:6px 20px;margin-top:20px}
.lbx-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 28px;border:1px solid var(--lb-red,#BF2E15);background:var(--lb-red,#BF2E15);color:#fff;font-family:var(--lb-arabic,'Alexandria','Tajawal',sans-serif);font-size:16px;font-weight:900;text-decoration:none;transition:background .2s,border-color .2s}
.lbx-btn:hover{background:var(--lb-red-deep,#8F1F0D);border-color:var(--lb-red-deep,#8F1F0D)}
.lbx-btn:active{transform:translateY(1px)}
.lbx-link{display:inline-flex;align-items:center;min-height:44px;font-family:var(--lb-arabic,'Alexandria','Tajawal',sans-serif);font-size:14.5px;font-weight:800;color:var(--lb-ink,#0B0B0C);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:6px}
.lbx-link:hover{color:var(--lb-red,#BF2E15)}
.lbx-btn:focus-visible,.lbx-link:focus-visible,.lbx-piece:focus-visible{outline:3px solid var(--lb-ink,#0B0B0C);outline-offset:3px}
.lbx-facts{list-style:none;margin:18px 0 0;padding:14px 0 0;display:grid;gap:7px;border-top:1px solid rgba(11,11,12,.14)}
.lbx-facts li{position:relative;padding-inline-start:16px;font-size:14px;line-height:1.65;color:var(--lb-ink-2,#3A3A3C)}
.lbx-facts li::before{content:"";position:absolute;inset-inline-start:0;top:.66em;width:6px;height:6px;background:var(--lb-red,#BF2E15)}
.lbx-facts b{font-weight:800;color:var(--lb-ink,#0B0B0C)}
/* the real piece: a horizontal card on phones so the whole hero fits one screen */
.lbx-piece{display:grid;grid-template-columns:128px minmax(0,1fr);width:100%;background:#fff;border:1px solid var(--lb-ink,#0B0B0C);color:inherit;text-decoration:none;transition:transform .24s,box-shadow .24s}
.lbx-piece-img{position:relative;display:block;aspect-ratio:4/5;background:var(--lb-bone-2,#F4F2ED);overflow:hidden}
.lbx-piece-img img{width:100%;height:100%;object-fit:cover;display:block}
.lbx-piece-img .lb-stamp{min-width:44px;height:28px;font-size:16px!important;bottom:8px}
.lbx-piece-info{display:flex;flex-direction:column;gap:3px;padding:10px 12px;border-inline-start:1px solid var(--lb-ink,#0B0B0C);min-width:0}
.lbx-piece-kick{font-size:12px;font-weight:800;color:var(--lb-red,#BF2E15)}
.lbx-piece-brand{font-family:var(--lb-display,'Anton',sans-serif);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--lb-ink-2,#3A3A3C);text-align:end}
.lbx-piece-name{font-size:14px;font-weight:700;line-height:1.45;color:var(--lb-ink,#0B0B0C);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.lbx-piece-cond{font-size:12.5px;font-weight:700;color:var(--lb-ink-2,#3A3A3C)}
.lbx-piece-row{display:flex;align-items:baseline;gap:8px;margin-top:auto}
.lbx-piece-row b{font-family:var(--lb-display,'Anton',sans-serif);font-weight:400;font-size:22px;color:var(--lb-ink,#0B0B0C);direction:ltr;font-variant-numeric:tabular-nums}
.lbx-piece-size{border:1px solid rgba(11,11,12,.2);padding:1px 7px;font-family:var(--lb-body,'Epilogue',sans-serif);font-size:11px;font-weight:600;color:var(--lb-ink-2,#3A3A3C)}
.lbx-piece-go{font-size:13px;font-weight:900;color:var(--lb-red,#BF2E15)}
@media(hover:hover){.lbx-piece:hover{transform:translate(-3px,-3px);box-shadow:6px 6px 0 0 var(--lb-ink,#0B0B0C)}}
@media(max-width:599px){.lbx-btn{flex:1 1 100%}}
@media(min-width:900px){
  .lbx-hero-in{grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr)}
  .lbx-piece{grid-template-columns:1fr;max-width:340px;justify-self:end}
  .lbx-piece-info{border-inline-start:0;border-top:1px solid var(--lb-ink,#0B0B0C);padding:14px 16px 16px}
  .lbx-piece-name{font-size:15px}
  .lbx-piece-row b{font-size:24px}
}
@media(prefers-reduced-motion:reduce){.lbx-piece,.lbx-btn{transition:none}.lbx-piece:hover{transform:none;box-shadow:none}}

/* ════════════════ AVAILABLE NOW (2026-09-30) ════════════════ */
.sec.lbx-avail{padding-block:clamp(28px,4.4vw,64px) clamp(40px,5vw,72px)!important}
.real-grid.lbx-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.lbx-grid .real-card .real-row{flex-wrap:wrap;row-gap:4px}
.lbx-grid .real-card .pold{white-space:nowrap}
.lbx-grid .real-card .real-size{max-width:none}
.lbx-more{margin:22px 0 0;text-align:center}
@media(max-width:899px){.lbx-grid > .lbqa-wrap:nth-child(n+7){display:none}}
@media(min-width:900px){.real-grid.lbx-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}}

/* ════════════════ HOW WE CHECK + DELIVERY/RETURNS (2026-09-30) ════════════════ */
.lbx-path{list-style:none;margin:22px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--lb-ink,#0B0B0C);background:#fff;counter-reset:lbxstep}
.lbx-path li{position:relative;padding:12px 12px 14px;display:flex;flex-direction:column;gap:3px;border-inline-start:1px solid rgba(11,11,12,.14)}
.lbx-path li:first-child{border-inline-start:0}
.lbx-path b{font-size:15px;font-weight:900;color:var(--lb-ink,#0B0B0C)}
.lbx-path span{font-size:12.5px;line-height:1.55;color:var(--lb-ink-2,#3A3A3C)}
.lbx-aeo{margin:8px 0 0;font-family:var(--lb-body,'Epilogue',sans-serif);font-size:12.5px;line-height:1.6;color:var(--lb-ink-3,#6B6B6E);text-align:end}
.lbx-checks{list-style:none;margin:26px 0 0;padding:0;display:grid;gap:0;counter-reset:lbxchk;border-top:1px solid rgba(11,11,12,.14)}
.lbx-checks li{counter-increment:lbxchk;display:grid;grid-template-columns:34px minmax(0,1fr);column-gap:10px;padding:12px 0;border-bottom:1px solid rgba(11,11,12,.14)}
.lbx-checks li::before{content:"0" counter(lbxchk);grid-row:span 2;font-family:var(--lb-display,'Anton',sans-serif);font-size:15px;color:var(--lb-red,#BF2E15);direction:ltr;padding-top:2px}
.lbx-checks b{font-size:15px;font-weight:900;color:var(--lb-ink,#0B0B0C)}
.lbx-checks span{font-size:13.5px;line-height:1.7;color:var(--lb-ink-2,#3A3A3C)}
.lbx-proof-photos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:22px 0 0}
.lbx-proof-photos img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border:1px solid rgba(11,11,12,.16)}
.lbx-grades{margin:22px 0 0;padding:12px 18px;background:var(--lb-bone-2,#F4F2ED);border:1px solid rgba(11,11,12,.14)}
.lbx-grades summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px}
.lbx-grades summary::-webkit-details-marker{display:none}
.lbx-grades summary span{flex:none;font-size:13px;font-weight:800;color:var(--lb-red,#BF2E15);text-decoration:underline;text-underline-offset:5px}
.lbx-grades[open] summary{margin-bottom:12px}
.lbx-grades h3{margin:0;font-size:18px!important;line-height:1.35}
.lbx-grades dl{margin:0;display:grid;gap:10px}
.lbx-grades dl > div{display:grid;gap:2px}
.lbx-grades dt{font-size:14px;font-weight:900;color:var(--lb-ink,#0B0B0C)}
.lbx-grades dd{margin:0;font-size:13px;line-height:1.65;color:var(--lb-ink-2,#3A3A3C)}
.lbx-quote{margin:26px 0 0;padding:18px 20px;border-inline-start:3px solid var(--lb-red,#BF2E15);background:#fff}
.lbx-quote blockquote{margin:0;font-size:16px;font-weight:700;line-height:1.8;color:var(--lb-ink,#0B0B0C)}
.lbx-quote figcaption{margin-top:8px;font-size:12.5px;line-height:1.6;color:var(--lb-ink-2,#3A3A3C)}
.lbx-check-more{margin:18px 0 0}
.lbx-terms-grid{display:grid;gap:10px;margin-top:6px}
.lbx-term{padding:16px 18px;background:#fff;border:1px solid rgba(11,11,12,.14)}
.lbx-term h3{margin:0 0 6px;font-size:16px!important;line-height:1.4}
.lbx-term p{margin:0;font-size:14px;line-height:1.75;color:var(--lb-ink-2,#3A3A3C)}
.lbx-term p + p{margin-top:6px}
.lbx-term b{color:var(--lb-ink,#0B0B0C);font-weight:800}
.lbx-term--key{border:1px solid var(--lb-ink,#0B0B0C);border-inline-start:4px solid var(--lb-red,#BF2E15)}
.lbx-terms-links{display:flex;flex-wrap:wrap;gap:4px 22px;margin:14px 0 0}
@media(min-width:900px){
  .lbx-checks{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28px}
  .lbx-grades dl{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 20px}
  .lbx-terms-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .lbx-term--key{grid-row:span 2}
}

/* story + answer (2026-09-30): one text column; the answer block closes the story */
.story .sec-in{grid-template-columns:minmax(0,1fr)!important;max-width:760px}
.sec.story{padding-bottom:18px!important}
.lb-answer{max-width:none!important;margin:0!important;padding:0 var(--pad) clamp(40px,6vw,72px)!important;background:var(--sand,#F4F2ED)}
.lb-answer p{max-width:760px;margin:0 auto!important}
.lbx-rev-note{margin:14px 0 0;font-size:13.5px;font-weight:700;color:var(--lb-ink-2,#3A3A3C);text-align:center}

/* ════════════════ VAULT (2026-09-30): the one ink band, gold as its accent ════════════════
   Gold's single job on this page: rarity. #E0B52A on #0A0A0B is ~10:1. Literal colours:
   this page inverts the legacy tokens (--gold is red, --ink is white). */
.sec.vault-section{background:#0A0A0B!important;border-block:0!important}
.vault-section .sec-in,.vault-section .sec-head{background:transparent!important}
.vault-section .kick{color:#E0B52A!important}
.vault-section .kick::before{background:#E0B52A!important}
.vault-section .h2,.vault-section h2{color:#F4EFE6!important}
.vault-section .h2 em{color:#E0B52A!important}
.vault-section .sec-sub,.vault-section .vault-aeo,.vault-section .vlt-foot p{color:rgba(244,239,230,.80)!important}
.vault-section .vault-aeo strong,.vault-section .vlt-foot p b{color:#F4EFE6!important}
.vault-section .vault-urgency{background:transparent!important;border-color:rgba(224,181,42,.5)!important;color:#E0B52A!important}
.vault-section .vault-urgency::before{background:#E0B52A!important}
.vault-section .vault-primary-cta,.vault-section .vlt-foot .btn-gold{background:#E0B52A!important;color:#0A0A0B!important;border:1px solid #E0B52A!important;border-radius:0!important;box-shadow:none!important}
.vault-section .vault-primary-cta:hover,.vault-section .vlt-foot .btn-gold:hover{background:#C89A0E!important;border-color:#C89A0E!important}
.vault-section .vault-card{border-color:rgba(244,239,230,.22)!important;background:#1A1A1E!important}
/* (0,4,x): lbass-cards-fix loads after this sheet with (0,2,x) !important rules */
.sec.vault-section .vault-card .vault-card-content small,.sec.vault-section .vault-card .vlt-live{color:#E0B52A!important}

/* sell + opinion (one block) and the guides row inside the FAQ (2026-09-30) */
.sell-card .sell-actions{margin-top:16px}
.lbx-opinion{padding-top:16px;border-top:1px solid rgba(11,11,12,.14)}
.lbx-opinion h3{margin:0 0 6px;font-size:17px!important;line-height:1.4}
.lbx-opinion p{margin:0;font-size:14px;line-height:1.75;color:var(--lb-ink-2,#3A3A3C)}
.lbx-opinion-links{display:flex;flex-wrap:wrap;gap:0 18px;margin-top:6px!important}
@media(min-width:900px){.lbx-opinion{padding:0 0 0 0;border-top:0;border-inline-start:1px solid rgba(11,11,12,.14);padding-inline-start:22px}}
.intent-moments.lbx-guides{max-width:980px;margin:28px auto 0!important;padding:0!important}
.lbx-guides .intent-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px}
.lbx-guides .intent-card{min-height:0!important;padding:12px!important;gap:5px!important}
.lbx-guides .intent-card b{font-size:14px!important}
.lbx-guides .intent-card p{font-size:12.5px!important;line-height:1.6!important}
.lbx-guides .intent-card a{display:inline-flex;align-items:center;min-height:44px;padding:0!important}
@media(min-width:900px){.lbx-guides .intent-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}}

/* ════════════════ SECTION SHELL ════════════════ */
.sec{padding:clamp(64px,10vw,120px) var(--pad)}
.sec-in{max-width:1500px;margin:0 auto}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:clamp(28px,5vw,52px);flex-wrap:wrap}
.kick{display:flex;align-items:center;gap:10px;color:var(--gold);font-weight:800;font-size:13.5px;letter-spacing:.06em;margin-bottom:12px}
.kick::before{content:"";width:26px;height:1px;background:var(--gold)}
.h2{font-size:clamp(30px,5.4vw,58px);line-height:1.12;font-weight:900;color:var(--cream)}
.h2 em{font-style:normal;color:var(--gold)}
.sec-sub{margin-top:12px;color:var(--txt2);max-width:520px;font-size:15.5px}
/* Button base (restored: it lived in the old hero block, and the FAQ, Vault and
   sell buttons still use it; lbass-stamp adds the square corners and the red) */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:800;font-size:15.5px;padding:17px 38px;border-radius:50px;transition:var(--tr);position:relative;overflow:hidden}
.btn-gold{background:var(--gold);color:var(--ink)}
.btn-gold:hover{background:var(--gold2);transform:translateY(-2px);box-shadow:0 14px 40px rgba(200,154,14,.3)}

/* ════════════════ PRICE DETAILS (grid cards) ════════════════ */
.pold{font-family:var(--lt);font-size:12.5px;color:var(--txt3);text-decoration:line-through;direction:ltr}
/* Monetary saving on the homepage grid cards. Clay rather than
   gold: gold is the PRICE colour on this page, and the saving must not compete
   with the number the customer pays. */
.psaving{margin:3px 0 0;font-family:var(--lt);font-size:12px;font-weight:900;color:var(--clay);direction:rtl;text-align:start;letter-spacing:.01em}
.psaving [dir=ltr]{font-variant-numeric:tabular-nums}
/* The percentage chip. */
.real-off{font-family:var(--lt);font-size:11px;font-weight:900;color:var(--clay);direction:ltr;
  padding:2px 7px;border-radius:30px;border:1px solid var(--clay);font-variant-numeric:tabular-nums}

/* ════════════════ REAL SHOPIFY PRODUCT GRID ════════════════ */
.real-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.real-card{display:flex!important;visibility:visible!important;opacity:1!important;flex-direction:column;overflow:hidden;border-radius:var(--r-md);border:1px solid var(--line);background:var(--ink2);color:inherit;text-decoration:none;transition:transform var(--tr),border-color var(--tr),box-shadow var(--tr)}
.real-card:hover{transform:translateY(-5px);border-color:var(--gold-br);box-shadow:0 24px 60px rgba(0,0,0,.5)}
.real-media{position:relative;aspect-ratio:4/5;background:#101113;overflow:hidden;margin:0}
.real-media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .75s cubic-bezier(.2,.7,.2,1)}
.real-card:hover .real-media img{transform:scale(1.045)}
.real-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--gold);font-family:var(--lt);font-weight:800;letter-spacing:.18em;text-align:center;text-transform:uppercase;padding:20px}
.real-badge{position:absolute;top:12px;right:12px;border:1px solid rgba(244,239,230,.24);border-radius:999px;background:rgba(10,10,11,.72);color:var(--cream);font-size:11px;font-weight:900;padding:6px 10px}
.real-info{padding:14px 15px 16px}
.real-vendor{font-family:var(--lt);font-size:10.5px;font-weight:800;letter-spacing:.2em;color:var(--gold);text-transform:uppercase;direction:ltr;text-align:right;margin:0 0 5px}
.real-title{font-size:15.5px;line-height:1.35;font-weight:900;color:var(--cream);margin:0 0 10px;min-height:42px}
.real-row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.real-price{font-family:var(--lt);font-size:17px;font-weight:900;color:var(--gold);direction:ltr;white-space:nowrap}
.real-size{font-family:var(--lt);font-size:11px;font-weight:700;color:var(--txt2);border:1px solid var(--line);border-radius:7px;padding:3px 7px;direction:ltr;max-width:52%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:640px){
  .real-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .real-info{padding:11px 12px 13px}
  .real-title{font-size:13.5px;min-height:38px}
  .real-price{font-size:15px}
  .real-size{max-width:58%;font-size:10px}
}

/* ════════════════ STORY (sand block) ════════════════ */
.story{background:var(--sand);color:var(--ink)}
.story .sec-in{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(28px,6vw,80px);align-items:center}
.story-kick{color:var(--clay);font-weight:800;font-size:13.5px;display:flex;align-items:center;gap:10px;margin-bottom:14px}
.story-kick::before{content:"";width:26px;height:1px;background:var(--clay)}
.story-h{font-size:clamp(30px,4.8vw,54px);font-weight:900;line-height:1.14;color:#161310;margin-bottom:20px}
.story-h em{font-style:normal;color:var(--clay)}
.story-p{font-size:clamp(15px,1.8vw,18px);color:#3E3830;margin-bottom:14px;max-width:560px}
.story-p strong{color:#161310}
.story-visual{position:relative;border-radius:var(--r-lg);overflow:hidden;aspect-ratio:4/5;border:1px solid rgba(22,19,16,.12)}
.story-visual img{width:100%;height:100%;object-fit:cover}
@media(max-width:900px){.story .sec-in{grid-template-columns:1fr}.story-visual{aspect-ratio:16/10;order:-1}}

/* ════════════════ NEWSLETTER ════════════════ */
.nl{background:linear-gradient(140deg,var(--ink2),var(--ink3));border-block:1px solid var(--line)}
.nl-in{max-width:760px;margin:0 auto;text-align:center}
.nl-star{width:54px;height:54px;color:var(--gold);margin:0 auto 18px;animation:slowspin 40s linear infinite}
.nl-h{font-size:clamp(26px,4.4vw,44px);font-weight:900;color:var(--cream);margin-bottom:12px}
.nl-p{color:var(--txt2);margin-bottom:28px;font-size:15.5px}
.nl-form{display:flex;gap:10px;max-width:520px;margin:0 auto 14px}
.nl-input{flex:1;background:var(--ink);border:1px solid var(--line2);border-radius:50px;padding:16px 24px;color:var(--cream);font-size:15px;min-width:0}
.nl-input::placeholder{color:var(--txt3)}
.nl-input:focus{outline:none;border-color:var(--gold)}
.nl-btn{background:var(--gold);color:var(--ink);font-weight:900;padding:16px 30px;border-radius:50px;transition:var(--tr);flex-shrink:0}
.nl-btn:hover{background:var(--gold2)}
.nl-note{font-size:12.5px;color:var(--txt3)}
@media(max-width:560px){.nl-form{flex-direction:column}.nl-btn{padding:16px}}

/* ════════════════ FOOTER ════════════════ */
.foot{border-top:1px solid var(--line);padding:clamp(48px,7vw,80px) var(--pad) 0}
.foot-in{max-width:1500px;margin:0 auto}
.foot-brand{min-height:44px}
.foot-grid{display:grid;grid-template-columns:1.4fr repeat(4,minmax(0,1fr));gap:clamp(28px,4vw,60px);padding-bottom:48px}
.foot-desc{color:var(--txt2);font-size:14.5px;max-width:340px;margin:16px 0 22px}
.foot-soc{display:flex;gap:10px}
.fs-b{width:44px;height:44px;border-radius:50%;border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;font-size:17px;transition:var(--tr)}
.fs-b img{width:30px;height:30px;display:block;border-radius:50%}
.fs-b:hover{border-color:var(--gold);background:var(--gold-dim)}
.fcol-t{font-family:var(--lt);font-size:11.5px;font-weight:700;letter-spacing:.26em;color:var(--txt3);text-transform:uppercase;margin-bottom:18px;direction:ltr;text-align:right}
.fcol a{display:flex;align-items:center;min-height:44px;padding:0;color:var(--txt2);font-weight:600;font-size:14.5px;transition:var(--tr)}
.fcol a:hover{color:var(--gold2);transform:translateX(-4px)}
.foot-bot{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:22px 0;border-top:1px solid var(--line);font-size:13px;color:var(--txt3)}
.foot-pay{display:flex;align-items:center;gap:8px;font-weight:800}
@media(max-width:900px){.foot-grid{grid-template-columns:1fr 1fr}}

/* ════════════════ WHATSAPP FLOAT ════════════════ */
.waf{position:fixed;bottom:24px;right:24px;z-index:80;width:56px;height:56px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;box-shadow:0 10px 34px rgba(0,0,0,.45);transition:var(--tr)}
.waf:hover{transform:scale(1.1);background:var(--green2)}
.waf svg{width:27px;height:27px;fill:#fff}
@media(max-width:640px){.waf{bottom:18px;right:16px;width:52px;height:52px}}

/* ════════════════ ENHANCEMENTS ════════════════ */

/* CTA sheen */
.btn-gold{position:relative;overflow:hidden}
.btn-gold::after{content:"";position:absolute;top:0;left:-120%;width:55%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.5),transparent);transform:skewX(-18deg);transition:left .6s ease;pointer-events:none}
.btn-gold:hover::after{left:170%}

/* ════════════════ CRO trust and resale clarity layer ════════════════ */
.lb-answer{max-width:var(--max);margin:26px auto 0;padding:0 20px}
.lb-answer p{margin:0;padding:14px 18px;border:1px solid var(--gold-br,rgba(200,154,14,.3));border-radius:var(--r-sm,12px);background:rgba(200,154,14,.05);color:var(--txt);font-size:13.5px;font-weight:700;line-height:1.85}
.lb-answer strong{color:var(--gold2)}
.lb-answer span{display:block;margin-top:4px;color:var(--txt3);font-size:11.5px;font-weight:700}

.intent-moments{max-width:var(--max);margin:22px auto 0;padding:0 20px 10px}
.intent-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.intent-card{border:1px solid var(--line);border-radius:var(--r-sm);background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.015));padding:16px;min-height:178px;display:flex;flex-direction:column;gap:9px}
.intent-card i{font-style:normal;font-family:var(--lt);font-size:11px;font-weight:700;letter-spacing:.18em;color:var(--gold);direction:ltr;text-transform:uppercase}
.intent-card b{color:var(--cream);font-size:17px;line-height:1.3}
.intent-card p{color:var(--txt2);font-size:13px;font-weight:700;line-height:1.7;margin:0}
.intent-card a{margin-top:auto;display:inline-flex;width:max-content;border-bottom:1px solid var(--line2);color:var(--gold2);font-weight:900;font-size:12.5px;padding-bottom:3px}
@media(max-width:860px){.intent-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.intent-grid{grid-template-columns:1fr}.intent-card{min-height:auto}}
.home-faq{background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(200,154,14,.055));border-top:1px solid var(--line)}
.home-faq-list{max-width:980px;margin:0 auto;display:grid;gap:10px}
.home-faq details{border:1px solid var(--line);border-radius:var(--r-sm);background:rgba(255,255,255,.035);overflow:hidden}
.home-faq summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 18px;color:var(--cream);font-weight:900}
.home-faq summary::-webkit-details-marker{display:none}
.home-faq summary::after{content:"+";font-family:var(--lt);color:var(--gold);font-size:22px}
.home-faq details[open] summary::after{content:"-"}
.home-faq p{padding:0 18px 18px;color:var(--txt2);font-weight:700;line-height:1.8}
.home-faq b{color:var(--cream)}
.faq-cta{text-align:center;margin-top:28px}
.faq-cta p{padding:0;color:var(--txt2);font-weight:800;margin-bottom:12px}
.shop-by{padding-block:clamp(36px,5vw,64px)}
/* lb-origin: Germany → Marrakech → Morocco trust section */

.vault-section{position:relative;overflow:hidden;background:radial-gradient(circle at 18% 10%,rgba(200,154,14,.19),transparent 34%),linear-gradient(180deg,#0f0e0b,#070707);border-block:1px solid rgba(200,154,14,.18)}
.vault-section::before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 0 48%,rgba(200,154,14,.035) 48% 49%,transparent 49% 100%);pointer-events:none}
.vault-head{position:relative;align-items:center;margin-bottom:24px}
.vault-head-copy{max-width:760px}
.vault-urgency{display:inline-flex;align-items:center;gap:8px;margin-top:16px;padding:7px 12px;border:1px solid rgba(200,154,14,.26);border-radius:999px;background:rgba(200,154,14,.08);color:var(--gold2);font-size:12.5px;font-weight:900}
.vault-urgency::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 5px rgba(200,154,14,.12)}
.vault-primary-cta{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:14px 24px;border-radius:12px;background:var(--gold);color:var(--ink);font-size:15px;font-weight:900;box-shadow:0 14px 38px rgba(200,154,14,.18);transition:transform .25s,background .25s,box-shadow .25s}
.vault-primary-cta:hover{background:var(--gold2);transform:translateY(-2px);box-shadow:0 18px 46px rgba(200,154,14,.28)}
.vault-primary-cta:focus-visible{outline-color:var(--cream)}
.vault-grid{position:relative;display:grid;grid-template-columns:1.1fr .9fr .9fr;gap:14px;align-items:stretch}
.vault-card{position:relative;isolation:isolate;min-height:380px;border:1px solid rgba(200,154,14,.24);border-radius:var(--r-md);overflow:hidden;background:var(--ink2);display:flex;align-items:flex-end;padding:24px;transition:transform .35s cubic-bezier(.2,.7,.2,1),border-color .3s,box-shadow .35s}
.vault-card::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.03) 8%,rgba(0,0,0,.3) 48%,rgba(4,4,5,.94) 100%);z-index:1}
.vault-card::after{content:"";position:absolute;inset:0;border:1px solid transparent;border-radius:inherit;z-index:3;pointer-events:none;transition:border-color .3s}
.vault-card>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.82;transition:transform .7s cubic-bezier(.2,.7,.2,1),opacity .35s}
.vault-card-content{position:relative;z-index:2;width:100%}
.vault-card small{display:block;font-family:var(--lt);font-weight:700;letter-spacing:.16em;color:var(--gold2);direction:ltr;text-align:right;font-size:11px}
.vault-card b{display:block;color:var(--cream);font-size:clamp(23px,2.7vw,36px);line-height:1.08;margin:8px 0 10px}
.vault-benefit{display:block;color:var(--cream);font-size:14.5px;font-weight:800;line-height:1.6;max-width:34ch}
.vlt-proof{display:block;margin-top:6px;color:var(--txt2);font-size:12px;font-weight:800;line-height:1.55}
.vault-card:first-child{min-height:450px}
.vlt-meta{display:flex!important;align-items:center;gap:10px;margin-top:14px}
.vlt-thumbs{display:flex;align-items:center}
.vlt-thumbs img{position:static!important;width:30px!important;height:30px!important;border-radius:50%;object-fit:cover;border:2px solid var(--ink2);opacity:1!important;margin-inline-start:-8px}
.vlt-thumbs img:first-child{margin-inline-start:0}
.vlt-live{color:var(--gold2);font-weight:900;font-size:12.5px}
.vlt-cta{display:inline-flex!important;align-items:center;gap:7px;margin-top:14px;padding:10px 17px;border:1px solid var(--gold-br,rgba(200,154,14,.4));border-radius:30px;color:var(--gold2);font-size:13px;font-weight:900;background:rgba(10,10,11,.62);max-width:max-content;transition:background .25s,color .25s,transform .25s}
.vault-card:hover{transform:translateY(-6px);border-color:rgba(224,181,42,.58);box-shadow:0 28px 70px rgba(0,0,0,.48)}
.vault-card:hover::after{border-color:rgba(224,181,42,.38)}
.vault-card:hover>img{transform:scale(1.045);opacity:.9}
.vault-card:hover .vlt-cta{background:var(--gold);color:var(--ink);transform:translateX(-3px)}
.vault-card:focus-visible{outline:2px solid var(--gold2);outline-offset:4px}
.vlt-cta.vlt-out{border-color:var(--line);color:var(--txt3)}
.vault-aeo{max-width:980px;margin:20px auto 0;color:var(--txt2);font-size:13px;font-weight:700;line-height:1.8;text-align:center}
.vault-aeo strong{color:var(--cream)}
.vlt-foot{margin-top:18px;text-align:center;display:flex;flex-direction:column;gap:12px;align-items:center}
.vlt-foot p{color:var(--txt2);font-size:13.5px;font-weight:800;margin:0}
.vlt-foot p b{color:var(--gold2)}
.vlt-foot .btn-gold{display:inline-flex;align-items:center;gap:8px;padding:15px 30px;border-radius:12px;font-weight:900;font-size:15px;min-height:50px}
.sell-card h2{font-size:clamp(24px,3vw,42px);line-height:1;margin:0}.sell-card p{color:var(--txt2);font-weight:700;line-height:1.7;max-width:620px;margin:0}

.sell-card{display:grid;grid-template-columns:1.15fr .85fr;gap:20px;align-items:center;background:linear-gradient(135deg,rgba(19,59,36,.72),rgba(25,24,27,.88));border:1px solid rgba(66,216,121,.23);border-radius:var(--r-lg);padding:28px;box-shadow:var(--shadow)}
.sell-steps{display:grid;gap:10px}.sell-steps span{background:rgba(255,255,255,.055);border:1px solid var(--line);border-radius:999px;padding:11px 14px;color:var(--txt2);font-weight:800}
.sell-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.payment-badges{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.pay-badge{border:1px solid var(--line2);border-radius:8px;padding:6px 11px;color:var(--txt2);font-size:11px;font-weight:900;background:rgba(255,255,255,.035)}.pay-badge.active{border-color:rgba(66,216,121,.45);color:var(--green2);background:rgba(66,216,121,.08)}

.pdelivery{margin:9px 0 0;color:var(--txt3);font-size:12px;font-weight:800}

@media (max-width:900px){
.vault-grid{grid-template-columns:1fr}.vault-head{align-items:flex-start}.vault-card,.vault-card:first-child{min-height:340px}.sell-card{grid-template-columns:1fr}.sell-card{padding:18px}
}
@media (max-width:520px){
.vault-head{margin-bottom:18px}.vault-head-copy .sec-sub{font-size:14px}.vault-primary-cta{width:100%;min-height:52px}.vault-urgency{font-size:11.5px}.vault-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:2px;overscroll-behavior-inline:contain;padding:2px 2px 12px;gap:12px;scrollbar-width:none}.vault-grid::-webkit-scrollbar{display:none}.vault-card,.vault-card:first-child{min-width:84vw;min-height:390px;scroll-snap-align:start;padding:20px}.vault-card-content{padding-inline-end:48px}.vault-card b{font-size:28px}.vault-benefit{font-size:14px}.vlt-proof{font-size:11.5px}.vault-aeo{text-align:right;font-size:12.5px}.vlt-foot .btn-gold{width:100%;justify-content:center}.payment-badges{gap:6px}.pay-badge{font-size:10px;padding:5px 8px}
}

/* ════════════════ LUX POLISH LAYER (additive — no HTML/structure changes) ════════════════ */
/* 1 · Typographic rhythm — tighter editorial headings, calmer Latin micro-labels */
.h2{letter-spacing:-.018em}
.kick,.fcol-t{letter-spacing:.2em}
.sec-sub,.story-p{max-width:60ch}
/* 2 · Section breathing + whisper-thin dividers between stacked blocks */
.sec{padding-block:clamp(76px,11vw,140px)}
.sec + .sec{border-top:1px solid color-mix(in srgb,var(--line) 60%,transparent)}
[id]{scroll-margin-top:84px}

/* 5 · Tactile buttons + animated see-all underline */
.btn,.nl-btn{transition:transform .2s cubic-bezier(.2,.7,.2,1),background .25s,box-shadow .25s}
.btn:active,.nl-btn:active{transform:scale(.975)}

/* 7 · Image fade-in to kill load flash (CLS-safe — dimensions already reserved) */
.story-visual img{background:var(--ink2)}

/* ════════════════ INSPECTION CHECKLIST ════════════════ */
.inspect-h{font-size:clamp(26px,4vw,40px);font-weight:900;color:var(--cream);line-height:1.15;margin-top:6px}
.inspect-h em{font-style:normal;color:var(--gold2)}

</style>
