    <form class="ei-form" id="eiForm" action="/contact" method="post">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="return_to" value="/pages/newsletter-confirmation">
      <input type="hidden" name="contact[tags]" value="newsletter,exit-intent">
      <input class="ei-input" type="email" name="contact[email]" placeholder="الإيميل ديالك…" required aria-label="الإيميل">
      <button class="ei-btn" type="submit">عَلمني ←</button>
    </form>
  </div>
</div>
<script>
(function(){
  var EI_KEY='lbass_ei_ts',done=false;
  /* Desktop only, and only on a real exit gesture. The phone triggers (a 25 s timer
     and 60% scroll) interrupted Moroccan mobile shoppers mid-browse; orders and
     WhatsApp rank above email. Storage is guarded: it can throw in private modes. */
  function get(){try{return localStorage.getItem(EI_KEY)}catch(e){return null}}
  function set(){try{localStorage.setItem(EI_KEY,Date.now())}catch(e){}}
  if(!matchMedia('(pointer:fine)').matches)return;
  var last=get();
  if(last&&Date.now()-Number(last)<7*86400000)return;
  function show(){if(done)return;done=true;document.getElementById('eiOverlay').classList.add('show')}
  document.addEventListener('mouseout',function(e){if(!e.relatedTarget&&e.clientY<2)show()});
  document.getElementById('eiX').onclick=function(){document.getElementById('eiOverlay').classList.remove('show');set()};
  document.getElementById('eiOverlay').addEventListener('click',function(e){if(e.target===this){this.classList.remove('show');set()}});
  document.getElementById('eiForm').addEventListener('submit',set);
})();
</script>


<script>
/* Old links to /?product=HANDLE or /#product=HANDLE open that product's page when
   the product exists (checked first, so a dead handle stays on the homepage). */
(function(){
  function openFromUrl(){
    var m = (location.hash + ' ' + location.search).match(/product=([A-Za-z0-9_-]+)/);
    if (!m || !window.fetch) return;
    fetch('/products/' + m[1] + '.js', { credentials: 'same-origin' })
      .then(function(r){ if (r.ok) location.replace('/products/' + m[1]); })
      .catch(function(){});
  }
  openFromUrl();
  addEventListener('hashchange', openFromUrl);
})();
/* Internal stock codes (LBO-…) never show to shoppers. */
(function(){
  var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
    acceptNode: function(node){
      return node.nodeValue && /LBO-[A-Z0-9-]+/i.test(node.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
    }
  });
  var nodes = [];
  while (walker.nextNode()) nodes.push(walker.currentNode);
  nodes.forEach(function(node){
    node.nodeValue = node.nodeValue
      .replace(/\s*[—–-]\s*LBO-[A-Z0-9-]+/gi, '')
      .replace(/(?:Product\s*code|Code produit|الكود)\s*:?\s*LBO-[A-Z0-9-]+/gi, '')
      .replace(/\bLBO-[A-Z0-9-]+\b/gi, '')
      .replace(/\s{2,}/g, ' ')
      .trim();
  });
})();
</script>

