<!-- ═══ HERO ═══ -->
<section class="hero" id="top" aria-labelledby="home-h1">
  <!-- Sticky viewport: the real MP4 timeline is scrubbed by page scroll. -->
  <div class="hero-sticky">
    <div class="hero-media">
      <div class="hero-frames" id="heroFrames">
        <img class="hero-poster" src="{{ 'hero-frame-1.webp' | asset_url }}" alt="مختارات Lbass Original من السنيكرز والستريتوير الأصلي فالمغرب" fetchpriority="high" loading="eager" decoding="async" width="1376" height="768">
        <video class="hero-video" id="heroVideo" muted playsinline webkit-playsinline preload="auto" poster="{{ 'hero-frame-1.webp' | asset_url }}" aria-hidden="true" tabindex="-1">
          <source src="{{ 'hero-scroll-film.mp4' | asset_url }}" type="video/mp4">
        </video>
      </div>
      <canvas id="heroFx" aria-hidden="true"></canvas>
    </div>
    <span class="hero-star-bg star8"><svg><use href="#star8sym"/></svg></span>
    <div class="hero-in">
      <div class="hero-kicker rev">DROP جديد · قطع محدودة</div>
      {%- comment -%}
        This H1 is what crawlers receive in raw HTML. snippets/lbass-hero-swap
        replaces this whole block with .lbh once JS runs, so the two MUST say
        the same thing — otherwise the indexed headline is not the one users
        see. Measured 2026-08-10: raw HTML said "حوايج Second-Hand أصلية
        فالمغرب." while the rendered page said "…من ألمانيا…". Googlebot renders
        JS and resolves it; Bing and most LLM crawlers do not.
        If you change the headline, change it in BOTH places.
      {%- endcomment -%}
      <h1 class="hero-h rev-hero" id="home-h1">
        <span class="ln"><span>Lbass Original —</span></span>
        <span class="ln"><span><em>حوايج Second-Hand أصلية فالمغرب</em></span></span>
      </h1>
      <p class="hero-lt rev">ORIGINAL SECOND-HAND STREETWEAR — MOROCCO</p>
      <p class="hero-lt rev" style="letter-spacing:.12em;font-size:clamp(10px,1.2vw,13px);opacity:.7;margin-top:-18px">FRIPERIE EN LIGNE — VÊTEMENTS DE MARQUE, PARTOUT AU MAROC</p>
      <p class="hero-sub rev">Lbass Original هو متجر second-hand أونلاين من مراكش كيعرض حوايج براند، صبابط وstreetwear مختارة من ألمانيا ومفحوصة فمراكش.</p>
      <div class="hero-ctas rev">
        <a class="btn btn-gold" href="#shop" data-cro-event="hero_cta_click" data-cro-label="shop_now">شوف الدروب دابا ←</a>
        <a class="btn btn-line" href="/collections/%D8%B5%D8%A8%D8%A7%D8%A8%D8%B7" data-cro-event="hero_cta_click" data-cro-label="sneakers_hero">تسوق الصبابط</a>
        <a class="btn btn-line" href="#faq" data-cro-event="hero_cta_click" data-cro-label="condition_proof">كيفاش كنشيّكو القطع؟</a>
      </div>
      <ul class="hero-chips rev" aria-label="معلومات Lbass">
        <li>غالباً 1/1</li><li>صور حقيقية</li><li>حالة واضحة</li><li>COD</li><li>توصيل لكل المغرب</li>
      </ul>
      <p class="hero-scarce rev">ملي كتباع القطعة، كتخرج من الكوليكسيون.</p>
      <div class="hero-proof rev">
        <div class="hp-item"><div class="hp-num">CLEAR</div><div class="hp-lbl">الحالة والتّيكيت كيبانو قبل الشراء</div></div>
        <div class="hp-item"><div class="hp-num">REAL</div><div class="hp-lbl">نفس القطعة فالصور، ماشي صور البراند</div></div>
        <div class="hp-item"><div class="hp-num">1/1</div><div class="hp-lbl">غالباً قطعة وحدة حسب المخزون</div></div>
        <div class="hp-item"><div class="hp-num">PAY</div><div class="hp-lbl">COD أو PayPal — فيك الاختيار</div></div>
      </div>
    </div>
    {%- comment -%} Split hero: a real in-stock piece, not a stock image.
        Proves the "صور حقيقية ديال نفس القطعة" promise in the first viewport. {%- endcomment -%}
    {%- assign hero_avail = collections.all.products | where: 'available', true -%}
    {%- assign hero_pick = hero_avail | first -%}
    {%- if hero_pick -%}
      <div class="hero-stack">
      {%- assign hp_v = hero_pick.selected_or_first_available_variant -%}
      {%- assign hp_title = hero_pick.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first | split: ' — ' | first -%}
      <a class="hero-drop" href="{{ hero_pick.url }}" data-cro-event="hero_cta_click" data-cro-label="hero_drop_piece">
        <div class="hero-drop-img">
          {%- if hero_pick.featured_image -%}
            <img src="{{ hero_pick.featured_image | image_url: width: 800 }}" alt="{{ hp_title | escape }}" width="800" height="1000" fetchpriority="high" decoding="async">
          {%- endif -%}
          {% capture hero_one_s %}{% render 'lbass-one-of-one', product: hero_pick %}{% endcapture %}{% assign hero_one_s = hero_one_s | strip %}<span class="lb-stamp" aria-hidden="true">{% if hero_one_s == '1' %}1/1{% else %}LIVE{% endif %}</span>
        </div>
        <div class="hero-drop-info">
          <span class="hero-drop-kick">متوفرة دابا</span>
          <span class="hero-drop-brand">{{ hero_pick.vendor }}</span>
          <span class="hero-drop-name">{{ hp_title }}</span>
          <span class="hero-drop-row">
            <b>{{ hp_v.price | money }}</b>
            {%- unless hero_pick.has_only_default_variant -%}<span class="hero-drop-size">{{ hp_v.title }}</span>{%- endunless -%}
            <span class="hero-drop-go">شوفها ←</span>
          </span>
        </div>
      </a>
      {%- comment -%} two more available pieces — compact rows, never sold-out {%- endcomment -%}
      {%- for hp2 in hero_avail offset: 1 limit: 2 -%}
        {%- assign hp2_t = hp2.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first | split: ' — ' | first -%}
        <a class="hero-mini" href="{{ hp2.url }}" data-cro-event="hero_cta_click" data-cro-label="hero_drop_piece_{{ forloop.index | plus: 1 }}">
          {%- if hp2.featured_image -%}
            <img src="{{ hp2.featured_image | image_url: width: 160 }}" alt="{{ hp2_t | escape }}" width="72" height="72" loading="lazy" decoding="async">
          {%- endif -%}
          <span class="hero-mini-txt">
            <span class="hero-mini-brand">{{ hp2.vendor }}</span>
            <span class="hero-mini-name">{{ hp2_t }}</span>
          </span>
          <span class="hero-mini-meta">
            <b>{{ hp2.selected_or_first_available_variant.price | money }}</b>
            {%- unless hp2.has_only_default_variant -%}<span class="hero-mini-size">{{ hp2.selected_or_first_available_variant.title }}</span>{%- else -%}{% capture hp2_one_s %}{% render 'lbass-one-of-one', product: hp2 %}{% endcapture %}{% assign hp2_one_s = hp2_one_s | strip %}<span class="hero-mini-11">{% if hp2_one_s == '1' %}1/1{% else %}LIVE{% endif %}</span>{%- endunless -%}
          </span>
        </a>
      {%- endfor -%}
      </div>
    {%- endif -%}
    <script>
    (function(){var h=document.querySelector('.hero');if(!h||!('IntersectionObserver' in window))return;var sent=false;
      new IntersectionObserver(function(es){es.forEach(function(e){
        if(!e.isIntersecting&&e.boundingClientRect.top<0&&!sent){sent=true;
          try{if(window.Shopify&&Shopify.analytics&&typeof Shopify.analytics.publish==='function')Shopify.analytics.publish('lbass_hero_scroll_past',{});}catch(x){}
          try{sessionStorage.setItem('lb_hero_seen','1');}catch(x){}}
      })},{threshold:0}).observe(h);})();
    </script>
    <div class="hero-scroll" aria-hidden="true"><span>SCROLL</span><i></i></div>
  </div>
</section>

