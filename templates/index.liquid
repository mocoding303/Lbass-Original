.inspect-sub{max-width:60ch;margin:10px auto 0;color:var(--txt2);font-size:14.5px;font-weight:500}
.inspect-grid{max-width:var(--max);margin:0 auto;padding:0 var(--pad);display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.inspect-card{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.035);border:1px solid var(--line);border-radius:var(--r-md);padding:18px 16px;transition:var(--tr)}
