  $('#pdpSizes').classList.remove('err'); $('#pdpSizeErr').classList.remove('show');
  renderStickyBar();
}
function pdpAddToCart(){
  if (!pdpProduct) return;
  if (!pdpSize){
    $('#pdpSizes').classList.add('err'); $('#pdpSizeErr').classList.add('show');
    $('#pdpSizes').scrollIntoView({behavior:'smooth', block:'center'});
