/* The old localStorage demo cart is gone: items now go to Shopify via the Ajax Cart API,
   so the drawer, the /cart page and checkout always agree. These shims keep every legacy
   call site (PDP modal, cart buttons, Esc handler, boot) working unchanged. */
function saveCart(){}
function cartCount(){ return 0; }
function cartTotal(){ return 0; }

function addToCart(id, size){
  const p = byId(id); if (!p) return;
  if (p.vids && p.vids.length){
    const sz = size || p.sizes[0];
    const match = p.vids.find(v => v.t === sz && v.a) || p.vids.find(v => v.a);
    if (match && window.LbassCart){ LbassCart.add(match.id); return; }
  }
  if (p.url){ location.href = p.url; }
}

function renderCart(){ if (window.LbassCart) LbassCart.refresh(); }
function checkoutWA(){ if (window.LbassCart) LbassCart.waCheckout(); }

