  const url = location.href.split('#')[0] + '#product-' + pdpProduct.id;
  const msg = `سلام Lbass Original! 👋\n\nبغيت نطلب:\n• ${pdpProduct.brand} ${pdpProduct.name}\n• القياس: ${pdpSize}\n• الثمن: ${pdpProduct.price} درهم\n• الرابط: ${url}\n• طريقة الخلاص المفضلة: COD أو PayPal\n\nشكراً ليك! 🙏`;
  window.open(waLink(msg), '_blank', 'noopener');
}
