<!-- ═══ THE DROP ═══ -->
<section class="sec" id="drop" aria-labelledby="drop-h">
  <div class="sec-in">
    <div class="sec-head rev">
      <div>
        <p class="kick">THE DROP — وصلو هاد السيمانة</p>
        <h2 class="h2" id="drop-h">قطع جداد، <em>وحدة بوحدة</em></h2>
        <p class="sec-sub">أغلب القطع كتكون وحدة فالمخزون؛ الحالة والتّيكيت كيبانو بوضوح قبل الشراء.</p>
      </div>
      <a class="see-all" href="/collections/audited-drop-p001-p012" data-cro-event="new_drop_click" data-cro-label="section_header">SHOP THE DROP →</a>
    </div>
    <div class="drop-rail" id="dropRail">
      {% assign homepage_collection = collections['audited-drop-p001-p012'] %}
      {%- comment -%}
        In-stock only. The rail used to loop the raw collection, so sold-out
        pieces took slots in the first product row a visitor sees. Measured
        2026-08-26: 8 of the catalogue's active products had totalInventory 0.
      {%- endcomment -%}
      {% assign drop_available = homepage_collection.products | where: 'available', true %}
      {% for product in drop_available limit: 8 %}
        {% assign variant = product.selected_or_first_available_variant %}
        {% assign display_title = product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first %}
        {% assign drop_ticket = product.metafields.lbass.ticket_status.value | default: 'unknown' %}
        {% assign drop_status = product.metafields.lbass.condition_status.value | default: 'unknown' %}
        {% assign drop_inspection = product.metafields.lbass.inspection_status.value %}
        {% assign drop_has_ticket = product.metafields.lbass.has_original_ticket.value %}
        {% assign drop_notes = product.metafields.lbass.condition_notes.value %}
        {% assign drop_defects = product.metafields.lbass.visible_defects.value %}
        {% assign drop_ticket_confirmed = false %}
        {% if drop_has_ticket == true %}
          {% if drop_ticket == 'ticket_attached' or drop_ticket == 'ticket_included' %}{% assign drop_ticket_confirmed = true %}{% endif %}
        {% elsif drop_has_ticket == false and drop_ticket == 'no_ticket' %}
          {% assign drop_ticket_confirmed = true %}
        {% endif %}
        {% assign drop_condition = '' %}
        {% assign drop_confirmed = false %}
        {% if drop_inspection == 'inspected_confirmed' %}
          {% if drop_has_ticket == true and drop_status == 'new_with_ticket' %}
            {% if drop_ticket == 'ticket_attached' or drop_ticket == 'ticket_included' %}{% assign drop_condition = 'جديد بالتّيكيت' %}{% assign drop_confirmed = true %}{% endif %}
          {% elsif drop_has_ticket == false and drop_ticket == 'no_ticket' and drop_status == 'excellent_almost_new' %}
            {% assign drop_condition = 'بحالة ممتازة · شبه جديد' %}{% assign drop_confirmed = true %}
          {% elsif drop_ticket_confirmed and drop_status == 'very_good' %}
            {% assign drop_condition = 'بحالة مزيانة بزاف' %}{% assign drop_confirmed = true %}
          {% elsif drop_ticket_confirmed and drop_status == 'good' %}
            {% assign drop_condition = 'بحالة مزيانة · شوف الملاحظات' %}{% assign drop_confirmed = true %}
          {% elsif drop_ticket_confirmed and drop_status == 'needs_note' %}
            {% if drop_notes != blank or drop_defects != blank %}{% assign drop_condition = 'بحالة مزيانة · شوف الملاحظات' %}{% assign drop_confirmed = true %}{% endif %}
          {% endif %}
        {% endif %}
        {% capture drop_one_s %}{% render 'lbass-one-of-one', product: product %}{% endcapture %}{% assign drop_one_s = drop_one_s | strip %}{% assign drop_one = false %}{% if drop_one_s == '1' %}{% assign drop_one = true %}{% endif %}
        {% assign drop_promo = false %}{% if variant.available and drop_confirmed and product.metafields.lbass.promo_eligible.value == true %}{% if drop_status == 'new_with_ticket' or drop_status == 'excellent_almost_new' %}{% assign drop_promo = true %}{% endif %}{% endif %}
        {% assign drop_image = blank %}
        {% case product.handle %}
          {% when 'lbass-p001-striped-shirt-shorts-set' %}{% assign drop_image = 'lbass-preview-p001-striped-set.webp' | asset_url %}
          {% when 'lbass-p002-zara-khaki-jacket' %}{% assign drop_image = 'lbass-preview-p002-zara-jacket.webp' | asset_url %}
          {% when 'lbass-p003-nike-calm-flip-flop-beige' %}{% assign drop_image = 'lbass-preview-p003-nike-calm-beige.webp' | asset_url %}
          {% when 'lbass-p004-adidas-black-crossbody-bag' %}{% assign drop_image = 'lbass-preview-p004-adidas-bag.webp' | asset_url %}
          {% when 'lbass-p005-nike-black-slides' %}{% assign drop_image = 'lbass-preview-p005-nike-black-slides.webp' | asset_url %}
          {% when 'lbass-p006-karl-kani-blue-slides' %}{% assign drop_image = 'lbass-preview-p006-blue-slides.webp' | asset_url %}
          {% when 'lbass-p007-new-balance-black-jersey' %}{% assign drop_image = 'lbass-preview-p007-new-balance-jersey.webp' | asset_url %}
          {% when 'lbass-p008-nike-air-black-top' %}{% assign drop_image = 'lbass-preview-p008-nike-air-top.webp' | asset_url %}
          {% when 'lbass-p009-nike-black-waist-bag' %}{% assign drop_image = 'lbass-preview-p009-nike-waist-bag.webp' | asset_url %}
          {% when 'lbass-p010a-nike-navy-slides' %}{% assign drop_image = 'lbass-preview-p010a-nike-navy-slides.webp' | asset_url %}
          {% when 'lbass-p010b-adidas-black-slides' %}{% assign drop_image = 'lbass-preview-p010b-adidas-black-slides.webp' | asset_url %}
          {% when 'lbass-p011-nike-white-cap' %}{% assign drop_image = 'lbass-preview-p011-nike-white-cap.webp' | asset_url %}
          {% when 'lbass-p012-tommy-hilfiger-black-cap' %}{% assign drop_image = 'lbass-preview-p012-tommy-cap.webp' | asset_url %}
        {% endcase %}
        <div class="lbqa-wrap">
        <a class="pcard drop-card" href="{{ product.url }}" data-cro-product-card data-cro-placement="new_drop" data-product-id="{{ product.id }}" data-product-name="{{ display_title | escape }}">
          <div class="pviz">
            {% if drop_image != blank %}
              <img src="{{ drop_image }}" alt="{{ display_title | escape }}" loading="lazy" decoding="async" width="640" height="800">
            {% elsif product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ display_title | escape }}" loading="lazy" decoding="async" width="700" height="875">
            {% else %}
              <div class="pviz-bg" style="background:linear-gradient(150deg,#1f2420,#101312)"></div>
              <span class="pviz-brand">{{ product.vendor | escape }}</span>
            {% endif %}
            <div class="pbadges"><span class="pb">وصل جديد</span>{% if drop_promo %}<span class="pb pb-drop">قطعة مختارة</span>{% endif %}<span class="pb pb-grade">{{ drop_condition }}</span></div>
          </div>
          <div class="pinfo">
            <p class="pinfo-brand">{{ product.vendor | escape }}</p>
            <h3 class="pname">{{ display_title | escape }}</h3>
            <div class="prow">
              <span><span class="pprice">{{ variant.price | money_without_trailing_zeros }}</span>{% if variant.compare_at_price > variant.price %} <span class="pold">{{ variant.compare_at_price | money_without_trailing_zeros }}</span>{% endif %}</span>
              {% if drop_one %}<span class="psave">1/1</span>{% endif %}
            </div>
            <div class="psizes"><span class="psz">{% unless variant.title == 'Default Title' %}{{ variant.title | escape }}{% else %}One Size{% endunless %}</span></div>
            <div class="pmeta-row"><span>{% if drop_one %}قطعة وحدة{% elsif variant.available %}متوفرة دابا{% else %}تباعت{% endif %}</span><span>COD أو PayPal</span></div>
            <p class="pdelivery">🚚 توصيل لكل المغرب</p>
          </div>
        </a>
        {% render 'lbass-quick-add', product: product %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══ REAL SHOPIFY PRODUCTS ═══ -->
<section class="sec real-products" id="shop" style="padding-top:20px" aria-labelledby="shop-h">
  <div class="sec-in">
    {% assign homepage_collection = collections['audited-drop-p001-p012'] %}
    <div class="sec-head rev">
      <div>
        <p class="kick">الكولكسيون الكامل</p>
        <h2 class="h2" id="shop-h">القطع اللي <em>متوفرة دابا</em></h2>
        <p class="sec-sub">هاد المنتجات جاية مباشرة من Shopify: صور المنتج، الثمن، القياس، والرابط ديال كل قطعة.</p>
      </div>
      <a class="see-all" href="{{ homepage_collection.url | default: '/collections/audited-drop-p001-p012' }}">{{ homepage_collection.products_count }} قطعة →</a>
    </div>

    <div class="real-grid" aria-label="منتجات Shopify المتوفرة">
      {% for product in homepage_collection.products limit: 50 %}
        {% assign variant = product.selected_or_first_available_variant %}
        {% assign display_title = product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first %}
        {% assign real_ticket = product.metafields.lbass.ticket_status.value | default: 'unknown' %}
        {% assign real_status = product.metafields.lbass.condition_status.value | default: 'unknown' %}
        {% assign real_inspection = product.metafields.lbass.inspection_status.value %}
        {% assign real_has_ticket = product.metafields.lbass.has_original_ticket.value %}
        {% assign real_notes = product.metafields.lbass.condition_notes.value %}
        {% assign real_defects = product.metafields.lbass.visible_defects.value %}
        {% assign real_ticket_confirmed = false %}
        {% if real_has_ticket == true %}
          {% if real_ticket == 'ticket_attached' or real_ticket == 'ticket_included' %}{% assign real_ticket_confirmed = true %}{% endif %}
        {% elsif real_has_ticket == false and real_ticket == 'no_ticket' %}
          {% assign real_ticket_confirmed = true %}
        {% endif %}
        {% assign real_condition = '' %}
        {% if real_inspection == 'inspected_confirmed' %}
          {% if real_has_ticket == true and real_status == 'new_with_ticket' %}
            {% if real_ticket == 'ticket_attached' or real_ticket == 'ticket_included' %}{% assign real_condition = 'جديد بالتّيكيت' %}{% endif %}
          {% elsif real_has_ticket == false and real_ticket == 'no_ticket' and real_status == 'excellent_almost_new' %}
            {% assign real_condition = 'بحالة ممتازة · شبه جديد' %}
          {% elsif real_ticket_confirmed and real_status == 'very_good' %}
            {% assign real_condition = 'بحالة مزيانة بزاف' %}
          {% elsif real_ticket_confirmed and real_status == 'good' %}
            {% assign real_condition = 'بحالة مزيانة · شوف الملاحظات' %}
          {% elsif real_ticket_confirmed and real_status == 'needs_note' %}
            {% if real_notes != blank or real_defects != blank %}{% assign real_condition = 'بحالة مزيانة · شوف الملاحظات' %}{% endif %}
          {% endif %}
        {% endif %}
        {% capture real_one_s %}{% render 'lbass-one-of-one', product: product %}{% endcapture %}{% assign real_one_s = real_one_s | strip %}{% assign real_one = false %}{% if real_one_s == '1' %}{% assign real_one = true %}{% endif %}
        <div class="lbqa-wrap">
        <a class="real-card" href="{{ product.url }}" aria-label="{{ display_title | escape }}" data-cro-product-card data-cro-placement="homepage_collection" data-product-id="{{ product.id }}" data-product-name="{{ display_title | escape }}">
          <figure class="real-media">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ display_title | escape }}" loading="lazy" decoding="async" width="900" height="1125">
            {% else %}
              <span class="real-empty">{{ product.vendor | escape }}</span>
            {% endif %}
            <span class="real-badge">{% if real_one %}قطعة 1/1{% elsif variant.available %}متوفرة دابا{% else %}تباعت{% endif %}</span>
          </figure>
          <div class="real-info">
            <p class="real-vendor">{{ product.vendor | escape }}</p>
            <h3 class="real-title">{{ display_title | escape }}</h3>
            <div class="real-row">
              <span class="real-price">{{ variant.price | money_without_trailing_zeros }}</span>
              <span class="real-size">{% unless variant.title == 'Default Title' %}{{ variant.title | escape }}{% else %}One Size{% endunless %}</span>
            </div>
            <p class="pdelivery">{{ real_condition }}</p>
          </div>
        </a>
        {% render 'lbass-quick-add', product: product %}
        </div>
      {% else %}
        <div class="real-empty-state">
          <h3>مازال ماكاين حتى منتج فهاد الكولكسيون</h3>
          <p>زيد المنتجات لكولكسيون Audited Drop P001-P012 باش يبانوا هنا.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══ SHOP THE LOOK — لوك كامل من القطع المتوفرة ═══ -->
{% assign stl_avail = collections.all.products | where: 'available', true %}
{% assign stl_picked = ',' %}
{% assign stl_count = 0 %}
{% capture stl_slots %}top,bottom,shoes{% endcapture %}
{% assign stl_slot_arr = stl_slots | split: ',' %}
<section class="sec" id="shoplook" aria-labelledby="stl-h">
  <div class="sec-in">
    <div class="sec-head rev">
      <div>
        <p class="kick">SHOP THE LOOK</p>
        <h2 class="h2" id="stl-h">لوك كامل، <em>واجد فدقيقة</em></h2>
        <p class="sec-sub">قطع مختارة كيركبو مع بعضهم — وكلهم متوفرين دابا حسب مخزون Shopify.</p>
      </div>
    </div>
    <div id="lookGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px">
      {% for slot_cat in stl_slot_arr %}
        {% for cp in stl_avail %}
          {% capture cpid %},{{ cp.id }},{% endcapture %}
          {% if stl_picked contains cpid %}{% continue %}{% endif %}
          {% assign cp_tags = cp.tags | join: ',' | downcase %}
          {% assign cp_type = cp.type | downcase %}
          {% assign cp_cat = 'top' %}
          {% if cp_type contains 'shoe' or cp_tags contains 'shoes' or cp_tags contains 'slides' or cp_tags contains 'sneaker' or cp_tags contains 'flip' %}
            {% assign cp_cat = 'shoes' %}
          {% elsif cp_type contains 'pant' or cp_type contains 'jean' or cp_type contains 'sets' or cp_tags contains 'pants' or cp_tags contains 'cargo' or cp_tags contains 'jeans' or cp_tags contains 'shorts' %}
            {% assign cp_cat = 'bottom' %}
          {% elsif cp_type contains 'accessor' or cp_tags contains 'cap' or cp_tags contains 'bag' or cp_tags contains 'accessor' %}
            {% assign cp_cat = 'acc' %}
          {% endif %}
          {% if cp_cat == slot_cat %}
            {% assign stl_picked = stl_picked | append: cp.id | append: ',' %}
            {% assign stl_count = stl_count | plus: 1 %}
            {% render 'lbass-look-card', rp: cp %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    {% if stl_count > 1 %}
    <div class="look-all" style="margin-top:20px;text-align:center">
      <button type="button" id="lookAddAll" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:16px 28px;min-height:52px;border-radius:12px;border:1px solid var(--gold);background:var(--gold);color:var(--ink);font-family:inherit;font-weight:900;font-size:15.5px;cursor:pointer;max-width:100%">🛍 زيد القطع المؤكدة من هاد اللوك للسلة</button>
      <p style="margin:10px 0 0;color:var(--txt3);font-size:12.5px;font-weight:800">💵 كتخلّص غير ملي توصلك · 🚚 توصيل مجاني من 500 درهم</p>
    </div>
    {% endif %}
  </div>
</section>

