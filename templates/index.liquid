{%- comment -%} 2026-09-30 clothing-first homepage: K-beauty block no longer rendered on the homepage (menu-only). Restore the next line to revert: render 'lbass-home-beauty' {%- endcomment -%}

<!-- ═══ INSPECTION CHECKLIST ═══ -->
<section class="sec inspect" id="inspection" aria-labelledby="inspect-h">
  <div class="inspect-head rev">
    <p class="kick">INSPECTION</p>
    <h2 class="inspect-h" id="inspect-h">كنوثّقو <em>المعلومات المؤكدة</em> قبل العرض</h2>
    <p class="inspect-sub">التّيكيت، الحالة، القياس، والصور كيبانو حسب الفحص المسجّل لكل قطعة.</p>
  </div>
  <div class="inspect-grid">
    <div class="inspect-card rev"><span class="ic-num">01</span><div class="ic-body"><b>الإتيكيت</b><span>كنشوفو الإتيكيت الأصلي، الكود، وبلاد الصنع — كيتطابقو مع البراند.</span></div></div>
    <div class="inspect-card rev"><span class="ic-num">02</span><div class="ic-body"><b>الخياطة</b><span>الخيوط، اللصاقات، والتفاصيل ديال الداخل كيبانو شغل البراند.</span></div></div>
    <div class="inspect-card rev"><span class="ic-num">03</span><div class="ic-body"><b>الكود ديال البراند</b><span>كل براند عندو كود نموذج خاص — كنقارنوه مع موديلات حقيقية شفناهم قبل.</span></div></div>
    <div class="inspect-card rev"><span class="ic-num">04</span><div class="ic-body"><b>الحالة</b><span>كنفحصو القطعة من القدام، الور، الداخل، والأماكن اللي كيبدا فيها الـ wear.</span></div></div>
    <div class="inspect-card rev"><span class="ic-num">05</span><div class="ic-body"><b>القياس</b><span>كنقيسو القطعة بالشمتر فجوج اتجاهات — مكتوبة فصفحة المنتج.</span></div></div>
    <div class="inspect-card rev"><span class="ic-num">06</span><div class="ic-body"><b>الصور</b><span>صور حقيقية ديال نفس القطعة — ماشي صور البراند. كنحاولو نوصرو كل التفاصيل المهمة، و إلا بغيتي شي زاوية محددة سولنا فالواتساب.</span></div></div>
  </div>
</section>


<!-- ═══ REAL SHOPIFY PRODUCTS ═══ -->
<section class="sec real-products" id="shop" style="padding-top:20px" aria-labelledby="shop-h">
  <div class="sec-in">
    {%- comment -%} 2026-10-03: this section read the MANUAL collection audited-drop-p001-p012, last edited 2026-09-26, so nothing listed after that date ever appeared on the homepage (27 pieces missing, including the whole 2026-10-01 drop). It now reads the AUTOMATIC collection new-in (tags type:shoes / type:clothing / type:accessory, sorted newest first; perfume and K-beauty are not in it), so every new listing shows up by itself. The hero above still reads the manual collection on purpose: the owner picks the hero piece by ordering it. In-stock only, to match the heading «متوفرة دابا»; sold-out pieces stay on the collection page. {%- endcomment -%}
    {% assign homepage_collection = collections['new-in'] %}
    <div class="sec-head rev">
      <div>
        <p class="kick">الكولكسيون الكامل</p>
        <h2 class="h2" id="shop-h">القطع اللي <em>متوفرة دابا</em></h2>
        <p class="sec-sub">هاد المنتجات جاية مباشرة من Shopify: صور المنتج، الثمن، القياس، والرابط ديال كل قطعة.</p>
      </div>
      <a class="see-all" href="{{ homepage_collection.url | default: '/collections/new-in' }}">{{ homepage_collection.products_count }} قطعة →</a>
    </div>

    <div class="real-grid" aria-label="منتجات Shopify المتوفرة">
      {% assign shop_available = homepage_collection.products | where: 'available', true %}
      {% for product in shop_available limit: 24 %}
        {% assign variant = product.selected_or_first_available_variant %}
        {% assign display_title = product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first %}
        {% assign real_ticket = product.metafields.lbass.ticket_status.value | default: 'unknown' %}
        {% assign real_status = product.metafields.lbass.condition_status.value | default: 'unknown' %}
        {% assign real_inspection = product.metafields.lbass.inspection_status.value %}
        {% assign real_has_ticket = product.metafields.lbass.has_original_ticket.value %}
        {% assign real_notes = product.metafields.lbass.condition_notes.value %}
        {% assign real_defects = product.metafields.lbass.visible_defects.value %}
        {% assign real_ticket_confirmed = false %}
        {% if real_has_ticket == true %}
          {% if real_ticket == 'ticket_attached' or real_ticket == 'ticket_included' %}{% assign real_ticket_confirmed = true %}{% endif %}
        {% elsif real_has_ticket == false and real_ticket == 'no_ticket' %}
          {% assign real_ticket_confirmed = true %}
        {% endif %}
        {% assign real_condition = '' %}
        {% if real_inspection == 'inspected_confirmed' %}
          {% if real_has_ticket == true and real_status == 'new_with_ticket' %}
            {% if real_ticket == 'ticket_attached' or real_ticket == 'ticket_included' %}{% assign real_condition = 'جديد بالتّيكيت' %}{% endif %}
          {% elsif real_has_ticket == false and real_ticket == 'no_ticket' and real_status == 'excellent_almost_new' %}
            {% assign real_condition = 'بحالة ممتازة · شبه جديد' %}
          {% elsif real_ticket_confirmed and real_status == 'very_good' %}
            {% assign real_condition = 'بحالة مزيانة بزاف' %}
          {% elsif real_ticket_confirmed and real_status == 'good' %}
            {% assign real_condition = 'بحالة مزيانة · شوف الملاحظات' %}
          {% elsif real_ticket_confirmed and real_status == 'needs_note' %}
            {% if real_notes != blank or real_defects != blank %}{% assign real_condition = 'بحالة مزيانة · شوف الملاحظات' %}{% endif %}
          {% endif %}
        {% endif %}
        {% capture real_one_s %}{% render 'lbass-one-of-one', product: product %}{% endcapture %}{% assign real_one_s = real_one_s | strip %}{% assign real_one = false %}{% if real_one_s == '1' %}{% assign real_one = true %}{% endif %}
        <div class="lbqa-wrap">
        <a class="real-card" href="{{ product.url }}" aria-label="{{ display_title | escape }}" data-cro-product-card data-cro-placement="homepage_collection" data-product-id="{{ product.id }}" data-product-name="{{ display_title | escape }}">
          <figure class="real-media">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 540 }}" srcset="{{ product.featured_image | image_url: width: 360 }} 360w, {{ product.featured_image | image_url: width: 540 }} 540w, {{ product.featured_image | image_url: width: 720 }} 720w" sizes="(max-width: 767px) 47vw, (max-width: 1100px) 31vw, 280px" alt="{{ display_title | escape }}" loading="lazy" decoding="async" width="900" height="1125">
            {% else %}
              <span class="real-empty">{{ product.vendor | escape }}</span>
            {% endif %}
            <span class="real-badge">{% if real_one %}قطعة 1/1{% elsif variant.available %}متوفرة دابا{% else %}تباعت{% endif %}</span>
          </figure>
          <div class="real-info">
            <p class="real-vendor">{{ product.vendor | escape }}</p>
            <h3 class="real-title">{{ display_title | escape }}</h3>
            {%- comment -%}
              This rail rendered the price and nothing else, so a genuinely
              marked-down piece showed FULL PRICE here and a strikethrough on
              every other surface. Same class of drift that the collection grid
              had before the shared card: one catalogue, two answers.
            {%- endcomment -%}
            {%- assign real_sale = false -%}
            {%- if variant.compare_at_price and variant.compare_at_price > variant.price -%}{%- assign real_sale = true -%}{%- endif -%}
            {%- capture real_pct %}{% render 'lbass-sale', product: product, variant: variant %}{% endcapture -%}
            {%- assign real_pct = real_pct | strip -%}
            <div class="real-row">
              <span class="real-price">{{ variant.price | money_without_trailing_zeros }}</span>
              {% if real_sale %}<span class="pold">{{ variant.compare_at_price | money_without_trailing_zeros }}</span>{% endif %}
              {% if real_sale and real_pct != '0' %}<span class="real-off">&minus;{{ real_pct }}%</span>{% endif %}
              <span class="real-size">{% unless variant.title == 'Default Title' %}{{ variant.title | escape }}{% else %}One Size{% endunless %}</span>
            </div>
            {% if real_sale %}<p class="psaving" dir="auto">{{ settings.promo_save_label | default: 'وفّر' }} <span dir="ltr">{{ variant.compare_at_price | minus: variant.price | money_without_trailing_zeros }}</span></p>{% endif %}
            <p class="pdelivery">{{ real_condition }}</p>
          </div>
        </a>
        {% render 'lbass-quick-add', product: product %}
        </div>
      {% else %}
        <div class="real-empty-state">
          <h3>مازال ماكاين حتى منتج فهاد الكولكسيون</h3>
          <p>شوف <a href="/collections/new-in">كل القطع الجديدة</a>.</p>
        </div>
      {% endfor %}
    </div>
    {%- comment -%} 2026-10-11 SPEED 2: see Lbass/fixes/2026-10-11-speed-pass-2.md {%- endcomment -%}
    {%- if shop_available.size > 24 -%}
    <p style="text-align:center;margin:26px 0 0"><a class="see-all" href="{{ homepage_collection.url | default: '/collections/new-in' }}">شوف كل القطع ({{ shop_available.size }}) ←</a></p>
    {%- endif -%}
  </div>
</section>

<!-- ═══ SHOP THE LOOK — لوك كامل من القطع المتوفرة ═══ -->
{% assign stl_avail = collections.all.products | where: 'available', true %}
{% assign stl_picked = ',' %}
{% assign stl_count = 0 %}
{% capture stl_slots %}top,bottom,shoes{% endcapture %}
{% assign stl_slot_arr = stl_slots | split: ',' %}
<section class="sec" id="shoplook" aria-labelledby="stl-h">
  <div class="sec-in">
    <div class="sec-head rev">
      <div>
        <p class="kick">SHOP THE LOOK</p>
        <h2 class="h2" id="stl-h">لوك كامل، <em>واجد فدقيقة</em></h2>
        <p class="sec-sub">قطع مختارة كيركبو مع بعضهم — وكلهم متوفرين دابا حسب مخزون Shopify.</p>
      </div>
    </div>
    <div id="lookGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px">
      {% for slot_cat in stl_slot_arr %}
        {% for cp in stl_avail %}
          {% if cp.type == 'Fragrance' %}{% continue %}{% endif %}{% if cp.type == 'Cosmetics' %}{% continue %}{% endif %}{% comment %} fragrance + cosmetics guard 2026-09-26: own departments {% endcomment %}
          {% capture cpid %},{{ cp.id }},{% endcapture %}
          {% if stl_picked contains cpid %}{% continue %}{% endif %}
          {% assign cp_tags = cp.tags | join: ',' | downcase %}
          {% assign cp_type = cp.type | downcase %}
          {% assign cp_cat = 'top' %}
          {% if cp_type contains 'shoe' or cp_tags contains 'shoes' or cp_tags contains 'slides' or cp_tags contains 'sneaker' or cp_tags contains 'flip' %}
            {% assign cp_cat = 'shoes' %}
          {% elsif cp_type contains 'pant' or cp_type contains 'jean' or cp_type contains 'sets' or cp_tags contains 'pants' or cp_tags contains 'cargo' or cp_tags contains 'jeans' or cp_tags contains 'shorts' %}
            {% assign cp_cat = 'bottom' %}
          {% elsif cp_type contains 'accessor' or cp_tags contains 'cap' or cp_tags contains 'bag' or cp_tags contains 'accessor' %}
            {% assign cp_cat = 'acc' %}
          {% endif %}
          {% if cp_cat == slot_cat %}
            {% assign stl_picked = stl_picked | append: cp.id | append: ',' %}
            {% assign stl_count = stl_count | plus: 1 %}
            {% render 'lbass-look-card', rp: cp %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    {% if stl_count > 1 %}
