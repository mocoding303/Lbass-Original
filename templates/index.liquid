/* ════════════════ SEARCH ════════════════ */
function doSearch(q){
  q = q.trim().toLowerCase();
  let res = [];
  if (q) {
    if (q === 'under100' || q.includes('تحت 100')) res = PRODUCTS.filter(p=>p.price<=100);
    else if (q.includes('بحال الجديد')) res = PRODUCTS.filter(p=>p.grade==='lux');
    else if (q.includes('براند') || q.includes('brand') || q === 'branded') res = PRODUCTS.filter(p=>['Nike','Adidas',"Levi's",'The North Face','Ralph Lauren','Ray-Ban','Lacoste'].includes(p.brand));
    else res = PRODUCTS.filter(p => searchText(p).includes(q));
  }
  $('#searchRes').innerHTML = !q ? ''
    : !res.length ? `<p style="color:var(--txt3);text-align:center;padding:20px;font-weight:700">ما لقينا والو لـ "${esc(q)}" 🤷</p>`
    : res.map(p => `<button class="sr-it" data-view="${p.id}">
        <span class="sr-ico">${CAT_META[p.cat].ico}</span>
        <span class="sr-name">${esc(p.brand)} — ${esc(p.name)}</span>
        <span class="sr-price">${p.price} DH</span>
      </button>`).join('');
}

/* ════════════════ EVENTS ════════════════ */
document.addEventListener('click', e => {
  const t = e.target.closest('[data-cart],[data-view],[data-wish],[data-dec],[data-inc],[data-rm],[data-catlink],[data-sz],[data-wa],[data-szguide],[data-pdp-home],[data-pdp-cat],[data-search-chip]');
  if (!t) return;
  if (t.dataset.cart){ e.preventDefault(); addToCart(t.dataset.cart); }
  else if (t.dataset.view){ e.preventDefault(); closeSearch(); openPDP(t.dataset.view); }
  else if (t.dataset.wish){ e.preventDefault(); toggleWish(t.dataset.wish); }
  else if (t.dataset.dec !== undefined){ const i = +t.dataset.dec; if (--cart[i].qty < 1) cart.splice(i,1); saveCart(); renderCart(); }
  else if (t.dataset.inc !== undefined){ toast('راجع الكمية المتوفرة فالسلة.'); }
  else if (t.dataset.rm !== undefined){ cart.splice(+t.dataset.rm,1); saveCart(); renderCart(); }
  else if (t.dataset.catlink){ curFilter = t.dataset.catlink; $$('.fpill').forEach(b=>b.classList.toggle('on', b.dataset.f===curFilter)); renderGrid(); }
  else if (t.dataset.sz){ selectSize(t.dataset.sz); }
  else if (t.dataset.pdpHome !== undefined){ closePDP(); document.getElementById('shop').scrollIntoView({behavior:'smooth'}); }
  else if (t.dataset.pdpCat){ const c=t.dataset.pdpCat; closePDP(); curFilter=c; $$('.fpill').forEach(b=>b.classList.toggle('on', b.dataset.f===c)); renderGrid(); document.getElementById('shop').scrollIntoView({behavior:'smooth'}); }
  else if (t.dataset.searchChip !== undefined){ const q=t.dataset.searchChip; $('#searchIn').value=q; doSearch(q); }
  else if (t.dataset.szguide !== undefined){ e.preventDefault(); const a = $('#measAcc'); if (a){ a.open = true; a.scrollIntoView({behavior:'smooth',block:'center'}); } }
  else if (t.dataset.wa !== undefined){ e.preventDefault(); window.open(waLink(t.dataset.wa), '_blank', 'noopener'); }
});

