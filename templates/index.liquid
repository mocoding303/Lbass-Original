<!-- ═══ HERO ═══ -->
{%- comment -%}
  SERVER-RENDERED HERO (2026-09-30). Replaces snippets/lbass-hero-swap.liquid,
  which built a different hero in JavaScript after DOMContentLoaded. With the
  swap, crawlers and people read two different heroes, id="home-h1" vanished
  from the rendered page, the buttons carried no data-cro-event (so
  hero_cta_click never fired), and the word-by-word reveal wrapped
  "Lbass Original" in separate inline-blocks that RTL layout displayed as
  "Original Lbass".

  ONE PROMISE, ONE ACTION, THREE FACTS, ONE REAL PIECE.
  - The H1 text and id are unchanged. The Latin brand sits in <bdi> so it keeps
    its own reading order inside the RTL line.
  - The three facts are quoted from the published shipping and refund policies
    (27 Sep 2026). If a policy changes, change the line here too.
  - The piece is the first IN-STOCK product of the curated homepage collection,
    so the owner chooses it by ordering that collection. Fragrance and cosmetics
    are skipped: the homepage promise is second-hand clothing. Its photo proves
    "the photo is the piece" in the first screen instead of claiming it.
{%- endcomment -%}
{%- liquid
  assign hero_pick = nil
  assign hero_src = collections['audited-drop-p001-p012'].products | where: 'available', true
  for hp in hero_src
    assign hp_type = hp.type | downcase
    if hp_type == 'fragrance' or hp_type == 'cosmetics'
      continue
    endif
    assign hero_pick = hp
    break
  endfor
-%}
<section class="lbx-hero" id="top" aria-labelledby="home-h1">
  <div class="lbx-hero-in">
    <div class="lbx-hero-copy">
      <p class="lbx-eyebrow">مختارة من ألمانيا · تشيك فمراكش</p>
      <h1 class="lbx-h1" id="home-h1">
        <span class="lbx-h1-brand"><bdi>Lbass Original</bdi> —</span>
        <span class="lbx-h1-main">حوايج <span class="lbx-nb" dir="ltr">Second-Hand</span> أصلية فالمغرب</span>
      </h1>
      <p class="lbx-lead">Lbass Original هو متجر second-hand أونلاين من مراكش كيعرض حوايج براند، صبابط وstreetwear مختارة من ألمانيا ومفحوصة فمراكش.</p>
      <p class="lbx-latin" lang="fr" dir="ltr">Friperie en ligne — vêtements de marque second hand, partout au Maroc</p>
      <div class="lbx-ctas">
        <a class="lbx-btn" href="#shop" data-cro-event="hero_cta_click" data-cro-label="shop_now">شوف القطع المتوفرة ←</a>
        <a class="lbx-link" href="/pages/how-we-check-items" data-cro-event="hero_cta_click" data-cro-label="condition_proof">كيفاش كنشيّكو القطع؟</a>
      </div>
      <ul class="lbx-facts" aria-label="الدفع والتوصيل">
        <li><b>الدفع عند الاستلام:</b> حل وشوف القطعة قبل ما تخلص.</li>
        <li><b>التوصيل:</b> 20 درهم مراكش · 40 درهم باقي المغرب · مجاني من 500 درهم</li>
        <li><b>غالباً 1/1:</b> ملي كتباع القطعة، كتخرج من الكوليكسيون.</li>
      </ul>
    </div>
    {%- if hero_pick -%}
      {%- liquid
        assign hp_v = hero_pick.selected_or_first_available_variant
        assign hp_title = hero_pick.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first | split: ' — ' | first
        assign hp_ticket = hero_pick.metafields.lbass.ticket_status.value | default: 'unknown'
        assign hp_status = hero_pick.metafields.lbass.condition_status.value | default: 'unknown'
        assign hp_has_ticket = hero_pick.metafields.lbass.has_original_ticket.value
        assign hp_notes = hero_pick.metafields.lbass.condition_notes.value
        assign hp_defects = hero_pick.metafields.lbass.visible_defects.value
        assign hp_cond = ''
        if hero_pick.metafields.lbass.inspection_status.value == 'inspected_confirmed'
          if hp_has_ticket == true and hp_status == 'new_with_ticket'
            if hp_ticket == 'ticket_attached' or hp_ticket == 'ticket_included'
              assign hp_cond = 'جديد بالتّيكيت'
            endif
          elsif hp_has_ticket == false and hp_ticket == 'no_ticket' and hp_status == 'new_without_ticket'
            assign hp_cond = 'جديد بلا تيكيت'
          elsif hp_has_ticket == false and hp_ticket == 'no_ticket' and hp_status == 'excellent_almost_new'
            assign hp_cond = 'بحالة ممتازة · شبه جديد'
          elsif hp_status == 'very_good'
            assign hp_cond = 'بحالة مزيانة بزاف'
          elsif hp_status == 'good'
            assign hp_cond = 'بحالة مزيانة'
          elsif hp_status == 'needs_note'
            if hp_notes != blank or hp_defects != blank
              assign hp_cond = 'بحالة مزيانة · شوف الملاحظات'
            endif
          endif
        endif
      -%}
      {% capture hero_one_s %}{% render 'lbass-one-of-one', product: hero_pick %}{% endcapture %}{% assign hero_one_s = hero_one_s | strip %}
      <a class="lbx-piece" href="{{ hero_pick.url }}" data-cro-event="hero_cta_click" data-cro-label="hero_drop_piece" data-cro-product-card data-cro-placement="hero" data-product-id="{{ hero_pick.id }}" data-product-name="{{ hp_title | escape }}">
        <span class="lbx-piece-img">
          {%- if hero_pick.featured_image -%}
            <img src="{{ hero_pick.featured_image | image_url: width: 720 }}" srcset="{{ hero_pick.featured_image | image_url: width: 360 }} 360w, {{ hero_pick.featured_image | image_url: width: 720 }} 720w" sizes="(min-width: 900px) 340px, 128px" alt="{{ hero_pick.vendor | escape }} {{ hp_title | escape }}" width="720" height="900" fetchpriority="high" decoding="async">
          {%- endif -%}
          {%- if hero_one_s == '1' -%}<span class="lb-stamp" aria-hidden="true">1/1</span>{%- endif -%}
        </span>
        <span class="lbx-piece-info">
          <span class="lbx-piece-kick">متوفرة دابا</span>
          <span class="lbx-piece-brand" dir="ltr">{{ hero_pick.vendor }}</span>
          <span class="lbx-piece-name">{{ hp_title }}</span>
          {%- if hp_cond != blank -%}<span class="lbx-piece-cond">{{ hp_cond }}</span>{%- endif -%}
          <span class="lbx-piece-row">
            <b>{{ hp_v.price | money }}</b>
            {%- unless hero_pick.has_only_default_variant -%}<span class="lbx-piece-size" dir="ltr">{{ hp_v.title }}</span>{%- endunless -%}
          </span>
          <span class="lbx-piece-go">شوفها ←</span>
        </span>
      </a>
    {%- endif -%}
  </div>
  <script>
  (function(){var h=document.getElementById('top');if(!h||!('IntersectionObserver' in window))return;var sent=false;
    new IntersectionObserver(function(es){es.forEach(function(e){
      if(!e.isIntersecting&&e.boundingClientRect.top<0&&!sent){sent=true;
        try{if(window.Shopify&&Shopify.analytics&&typeof Shopify.analytics.publish==='function')Shopify.analytics.publish('lbass_hero_scroll_past',{});}catch(x){}
        try{sessionStorage.setItem('lb_hero_seen','1');}catch(x){}}
    })},{threshold:0}).observe(h);})();
  </script>
</section>

<!-- ═══ AVAILABLE NOW ═══ -->
{%- comment -%}
  AVAILABLE NOW (2026-09-30). Replaces "THE DROP" rail and the "القطع اللي
  متوفرة دابا" grid, which looped the same curated collection twice:
    • the rail showed about 1.2 cards per phone screen (measured at 390px);
    • the grid printed up to 50 cards with NO stock filter: 16 were sold out
      under a heading that says "available now" (catalogue of 2026-09-30),
      and it was 12,582px tall at 390px, a third of the whole page.
  One grid now: in-stock only, fragrance/cosmetics skipped (the homepage
  sells second-hand clothing), the hero's piece skipped so nothing repeats,
  8 pieces (6 on phones), then one link to the full collection. The
  collection's manual order still decides what shows first.

  Condition labels use the sitewide vocabulary (snippets/lbass-product-card,
  templates/product.liquid), so this card, the product page and the legend
  further down say the same words. The price block is unchanged:
  test/render/test_home_rails.rb pins it to snippets/lbass-price.
{%- endcomment -%}
{%- liquid
  assign avail_src = collections['audited-drop-p001-p012'].products | where: 'available', true
  assign avail_count = 0
-%}
<section class="sec lbx-avail" id="shop" aria-labelledby="shop-h">
  <div class="sec-in" id="drop">
    <div class="sec-head">
      <div>
        <h2 class="h2" id="shop-h">القطع اللي <em>متوفرة دابا</em></h2>
        <p class="sec-sub">أغلب القطع كتكون وحدة فالمخزون؛ الحالة والتّيكيت كيبانو بوضوح قبل الشراء.</p>
      </div>
    </div>
    <div class="real-grid lbx-grid">
      {%- for product in avail_src -%}
        {%- liquid
          if avail_count >= 8
            break
          endif
          assign av_type = product.type | downcase
          if av_type == 'fragrance' or av_type == 'cosmetics'
            continue
          endif
          if hero_pick and product.id == hero_pick.id
            continue
          endif
          assign avail_count = avail_count | plus: 1
          assign variant = product.selected_or_first_available_variant
          assign display_title = product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first
          assign real_ticket = product.metafields.lbass.ticket_status.value | default: 'unknown'
          assign real_status = product.metafields.lbass.condition_status.value | default: 'unknown'
          assign real_has_ticket = product.metafields.lbass.has_original_ticket.value
          assign real_notes = product.metafields.lbass.condition_notes.value
          assign real_defects = product.metafields.lbass.visible_defects.value
          assign real_condition = ''
          if product.metafields.lbass.inspection_status.value == 'inspected_confirmed'
            if real_has_ticket == true and real_status == 'new_with_ticket'
              if real_ticket == 'ticket_attached' or real_ticket == 'ticket_included'
                assign real_condition = 'جديد بالتّيكيت'
              endif
            elsif real_has_ticket == false and real_ticket == 'no_ticket' and real_status == 'new_without_ticket'
              assign real_condition = 'جديد بلا تيكيت'
            elsif real_has_ticket == false and real_ticket == 'no_ticket' and real_status == 'excellent_almost_new'
              assign real_condition = 'بحالة ممتازة · شبه جديد'
            elsif real_status == 'very_good'
              assign real_condition = 'بحالة مزيانة بزاف'
            elsif real_status == 'good'
              assign real_condition = 'بحالة مزيانة'
            elsif real_status == 'needs_note'
              if real_notes != blank or real_defects != blank
                assign real_condition = 'بحالة مزيانة · شوف الملاحظات'
              endif
            endif
          endif
        -%}
        {% capture real_one_s %}{% render 'lbass-one-of-one', product: product %}{% endcapture %}{% assign real_one_s = real_one_s | strip %}{% assign real_one = false %}{% if real_one_s == '1' %}{% assign real_one = true %}{% endif %}
        <div class="lbqa-wrap">
        <a class="real-card" href="{{ product.url }}" aria-label="{{ display_title | escape }}" data-cro-product-card data-cro-placement="new_drop" data-product-id="{{ product.id }}" data-product-name="{{ display_title | escape }}">
          <figure class="real-media">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" srcset="{{ product.featured_image | image_url: width: 360 }} 360w, {{ product.featured_image | image_url: width: 600 }} 600w" sizes="(min-width: 900px) 280px, 46vw" alt="{{ product.vendor | escape }} {{ display_title | escape }}" loading="lazy" decoding="async" width="600" height="750">
            {% else %}
              <span class="real-empty">{{ product.vendor | escape }}</span>
            {% endif %}
            <span class="real-badge">{% if real_one %}قطعة 1/1{% else %}متوفرة دابا{% endif %}</span>
          </figure>
          <div class="real-info">
            <p class="real-vendor">{{ product.vendor | escape }}</p>
            <h3 class="real-title">{{ display_title | escape }}</h3>
            {%- assign real_sale = false -%}
            {%- if variant.compare_at_price and variant.compare_at_price > variant.price -%}{%- assign real_sale = true -%}{%- endif -%}
            {%- capture real_pct %}{% render 'lbass-sale', product: product, variant: variant %}{% endcapture -%}
            {%- assign real_pct = real_pct | strip -%}
            <div class="real-row">
              <span class="real-price">{{ variant.price | money_without_trailing_zeros }}</span>
              {% if real_sale %}<span class="pold">{{ variant.compare_at_price | money_without_trailing_zeros }}</span>{% endif %}
              {% if real_sale and real_pct != '0' %}<span class="real-off">&minus;{{ real_pct }}%</span>{% endif %}
              <span class="real-size">{% unless variant.title == 'Default Title' %}{{ variant.title | escape }}{% else %}One Size{% endunless %}</span>
            </div>
            {% if real_sale %}<p class="psaving" dir="auto">{{ settings.promo_save_label | default: 'وفّر' }} <span dir="ltr">{{ variant.compare_at_price | minus: variant.price | money_without_trailing_zeros }}</span></p>{% endif %}
            {% if real_condition != blank %}<p class="pdelivery">{{ real_condition }}</p>{% endif %}
          </div>
        </a>
        {% render 'lbass-quick-add', product: product %}
        </div>
      {%- endfor -%}
    </div>
    <p class="lbx-more"><a class="lbx-link" href="/collections/new-in" data-cro-event="new_drop_click" data-cro-label="see_all">شوف كل الكولكسيون ←</a></p>
  </div>
</section>

{% render 'lbass-home-collections' %}

<!-- ═══ HOW WE CHECK ═══ -->
{%- comment -%}
  HOW WE CHECK (2026-09-30). One section instead of seven that repeated each
  other (inspection checklist, Germany→Marrakech journey, editorial "how we
  work", what-you-see strip, condition legend, "customer proof" — which held
  no customer proof — and a value band): about 6,100px at 390px.

  Each claim now sits next to its proof:
    • the six checks are the existing checklist; item 05 no longer says every
      piece is measured (15 of 55 in-stock pieces carry measurements on
      2026-09-30) and uses the site's own honest wording instead;
    • the condition labels are EXACTLY the six labels the product cards and
      product pages print, with the product page's own descriptions, so a
      label means one thing everywhere;
    • one real customer review, read live from Judge.me (the longest 4-5 star
      review), sits under the photo promise it confirms. It is not marked
      verified: Judge.me marks none of the store's reviews as verified buyers.
  PROOF PHOTOS (owner to supply, then list the files in proof_photos below):
    lbass-proof-tag.webp       a tag / label close-up taken while checking
    lbass-proof-stitching.webp an inside seam or stitching detail
    lbass-proof-measure.webp   a tape measure on a real piece
    lbass-proof-defect.webp    a defect photographed the way a PDP shows it
  Nothing renders until real files exist: never a placeholder on the store.
{%- endcomment -%}
{%- assign proof_photos = '' | split: ',' -%}
<section class="sec lbx-check" id="inspection" aria-labelledby="inspect-h">
  <div class="sec-in">
    <p class="kick">INSPECTION</p>
    <h2 class="h2" id="inspect-h">كنوثّقو <em>المعلومات المؤكدة</em> قبل العرض</h2>
    <p class="sec-sub">التّيكيت، الحالة، القياس، والصور كيبانو حسب الفحص المسجّل لكل قطعة.</p>

    <ol class="lbx-path" id="kif-khadmin" aria-label="من ألمانيا لمراكش، ومن مراكش لباب دارك">
      <li><b>ألمانيا</b><span>كنختارو القطع من دروب ألمانية مختارة</span></li>
      <li><b>مراكش</b><span>كنشيكو الحالة وكنصورو نفس القطعة</span></li>
      <li><b>كل المغرب</b><span>توصيل من مراكش لباب دارك</span></li>
    </ol>
    <p class="lbx-aeo" lang="fr" dir="ltr">Lbass Original sélectionne des pièces de marque second hand depuis l’Allemagne, les vérifie à Marrakech, puis les livre partout au Maroc.</p>

    <ol class="lbx-checks" aria-label="شنو كنشيكو فكل قطعة">
      <li><b>الإتيكيت</b><span>كنشوفو الإتيكيت الأصلي، الكود، وبلاد الصنع — كيتطابقو مع البراند.</span></li>
      <li><b>الخياطة</b><span>الخيوط، اللصاقات، والتفاصيل ديال الداخل كيبانو شغل البراند.</span></li>
      <li><b>الكود ديال البراند</b><span>كل براند عندو كود نموذج خاص — كنقارنوه مع موديلات حقيقية شفناهم قبل.</span></li>
      <li><b>الحالة</b><span>كنفحصو القطعة من القدام، الور، الداخل، والأماكن اللي كيبدا فيها الـ wear.</span></li>
      <li><b>القياس</b><span>القياس كيبان فصفحة المنتج، والقياسات بالسنتيمتر ملي تكون مسجلة.</span></li>
      <li><b>الصور</b><span>صور حقيقية ديال نفس القطعة — ماشي صور البراند. إلا بغيتي شي زاوية محددة سولنا فالواتساب.</span></li>
    </ol>

    {%- liquid
      assign jm_grid = shop.metafields.judgeme.reviews_grid.value
      assign best_rev = nil
      assign best_len = 0
      for r in jm_grid.all_reviews.reviews
        if r.rating >= 4
          assign r_len = r.body | size
          if r_len > best_len
            assign best_rev = r
            assign best_len = r_len
          endif
        endif
      endfor
    -%}
    {%- if best_rev -%}
      {%- assign best_initial = best_rev.reviewer_initial | default: best_rev.reviewer_name | slice: 0 -%}
      <figure class="lbx-quote" id="customer-proof">
        <blockquote dir="auto">{{ best_rev.body | strip_html | escape }}</blockquote>
        <figcaption><span aria-label="{{ best_rev.rating }} من 5">{% for i in (1..5) %}{% if i <= best_rev.rating %}★{% else %}☆{% endif %}{% endfor %}</span> {{ best_initial | escape }}. · <bdi>{{ best_rev.product_title | split: ' — ' | first | escape }}</bdi> · {{ best_rev.created_at | date: '%d/%m/%Y' }} · تقييم على Judge.me</figcaption>
      </figure>
    {%- endif -%}

    {%- if proof_photos.size > 0 -%}
      <div class="lbx-proof-photos">
        {%- for f in proof_photos -%}<img src="{{ f | asset_url }}" alt="" loading="lazy" decoding="async" width="600" height="750">{%- endfor -%}
      </div>
    {%- endif -%}

    <details class="lbx-grades">
