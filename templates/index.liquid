/* ════════════════ LUX POLISH LAYER (additive — no HTML/structure changes) ════════════════ */
/* 1 · Typographic rhythm — tighter editorial headings, calmer Latin micro-labels */
.h2,.hero-h{letter-spacing:-.018em}
.hero-h{line-height:1.0}
.kick,.pinfo-brand,.pdp-brand,.see-all,.fcol-t{letter-spacing:.2em}
.sec-sub,.story-p,.edit-p{max-width:60ch}
/* 2 · Section breathing + whisper-thin dividers between stacked blocks */
.sec{padding-block:clamp(76px,11vw,140px)}
.sec + .sec,.sec + .edit,.edit + .sec{border-top:1px solid color-mix(in srgb,var(--line) 60%,transparent)}
[id]{scroll-margin-top:84px}
/* 3 · Product cards — luxury lift, slow image push-in, refined focus */
.pcard{transition:transform .45s cubic-bezier(.2,.7,.2,1),box-shadow .45s cubic-bezier(.2,.7,.2,1),border-color .3s}
.pcard:hover{box-shadow:0 30px 70px -22px rgba(0,0,0,.72)}
.pviz img{transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.pcard:hover .pviz img{transform:scale(1.065)}
.drop-card:hover .pviz img{transform:scale(1.025)}
.pcard:focus-within{border-color:var(--gold-br)}
/* 4 · Quieter, more premium badges (one accent reads louder than five) */
.pb{font-size:9.5px;padding:4px 9px;letter-spacing:.04em;box-shadow:0 2px 10px rgba(0,0,0,.25)}
.pb-grade{background:rgba(10,10,11,.55);backdrop-filter:none}
/* 5 · Tactile buttons + animated see-all underline */
.btn,.pq-cart,.pq-view,.pdp-cart,.pdp-wa,.dr-wa,.nl-btn{transition:transform .2s cubic-bezier(.2,.7,.2,1),background .25s,box-shadow .25s}
.btn:active,.pdp-cart:active,.pdp-wa:active,.dr-wa:active,.nl-btn:active{transform:scale(.975)}
.see-all{position:relative}
.see-all::after{content:"";position:absolute;inset-inline:0;bottom:-1px;height:1px;background:var(--gold);transform:scaleX(0);transform-origin:right;transition:transform .4s cubic-bezier(.2,.7,.2,1)}
.see-all:hover::after{transform:scaleX(1)}
/* 6 · Cart bubble success pulse (fires on add via JS) */
@keyframes bubPulse{0%{transform:scale(1)}30%{transform:scale(1.5)}60%{transform:scale(.9)}100%{transform:scale(1)}}
.bub.pulse{animation:bubPulse .5s cubic-bezier(.2,.9,.24,1)}
.icon-b.cart-flash{box-shadow:0 0 0 3px var(--gold-br)}
/* 7 · Image fade-in to kill load flash (CLS-safe — dimensions already reserved) */
.pviz img,.story-visual img,.edit-img img,.look-it img{background:var(--ink2)}
@media (prefers-reduced-motion:reduce){.pcard:hover .pviz img{transform:none}.see-all::after{transition:none}}

/* ════════════════ INSPECTION CHECKLIST ════════════════ */
