function toggleWish(id){
  const i = wish.indexOf(id);
  if (i >= 0) wish.splice(i,1); else wish.push(id);
  localStorage.setItem('lbass_v2_wish', JSON.stringify(wish));
  $('#wishBub').textContent = wish.length; $('#wishBub').hidden = !wish.length;
  $$(`[data-wish="${id}"]`).forEach(b => { b.classList.toggle('on', i < 0); b.textContent = i < 0 ? '♥' : '♡'; });
  toast(i < 0 ? '♥ تزادت فالمفضلة' : 'تحيّدات من المفضلة');
}

