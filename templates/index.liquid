/* ════════════════ RENDER: DROP + GRID + CATS + SOCIAL ════════════════ */
function renderDrop(){
  const rail = $('#dropRail');
  if (!rail) return;
  if (rail && rail.querySelector('.pcard')) return;
  const picks = PRODUCTS.filter(p => (p.badges||[]).length).concat(PRODUCTS.filter(p=>!(p.badges||[]).length)).slice(0,8);
  rail.innerHTML = picks.map(p => cardHTML(p, 'drop-card')).join('');
}
function renderGrid(){
  const grid = $('#pgrid');
  if (!grid) return;
  if (grid && grid.querySelector('.pcard')) {
    const count = grid.querySelectorAll('.pcard').length;
    const counter = $('#fcount');
    if (counter) counter.textContent = count + ' قطعة';
    return;
  }
  let list = curFilter === 'all' ? [...PRODUCTS] : PRODUCTS.filter(p => p.cat === curFilter);
  if (curSort === 'cheap') list.sort((a,b)=>a.price-b.price);
  if (curSort === 'pricey') list.sort((a,b)=>b.price-a.price);
  if (curSort === 'save') list.sort((a,b)=>save(b)-save(a));
  grid.innerHTML = list.map(p => cardHTML(p)).join('');
  const counter = $('#fcount');
  if (counter) counter.textContent = list.length + ' قطعة';
  if (window.gsap) gsap.fromTo('#pgrid .pcard', {opacity:0, y:24}, {opacity:1, y:0, duration:.5, stagger:.05, ease:'power2.out', overwrite:true});
}
function renderCats(){
  const counts = {}; PRODUCTS.forEach(p => counts[p.cat] = (counts[p.cat]||0)+1);
  /* asymmetric layout: 1 dominant + 2 wide + 4 regular = 7 cards, 23 products covered */
  const ASSET = {
    jacket:'{{ 'cat-jackets-ed.webp' | asset_url }}',
    shoes :'{{ 'cat-shoes-ed.webp'   | asset_url }}',
    jeans :'{{ 'cat-jeans-ed.webp'   | asset_url }}',
    pants :'{{ 'cat-pants-ed.webp'   | asset_url }}',
    hoodie:'{{ 'cat-hoodies-ed.webp' | asset_url }}',
    tshirt:'{{ 'cat-tshirts-ed.webp' | asset_url }}',
    acc   :'{{ 'cat-acc-ed.webp'     | asset_url }}'
  };
  /* per-category focal point so the subject stays visible no matter how the cell crops */
  const FOCUS = {
    jacket:'72% 40%',  /* model right-of-center */
    shoes :'30% 55%',  /* shoes on the left ledge */
    jeans :'62% 62%',  /* denim across lower half */
    pants :'55% 45%',  /* leaning model, center */
    hoodie:'68% 40%',  /* hooded model right side */
    tshirt:'60% 38%',  /* model right-of-center, face area */
    acc   :'42% 60%'   /* flat-lay weighted left-bottom */
  };
  const DESC = {
    jacket:'قطع مميزة للبرد والستايل',
    shoes :'سنيكرز كلاسيك و موديلات راقية',
    jeans :'دنيم أصلي بقصات متنوعة',
    pants :'كارغو و سراويل عصرية',
    hoodie:'هوديات دافية بستايل الشارع',
    tshirt:'تيشرتات يومية و بولو أنيقة',
    acc   :'إكسسوارات كتكمّل اللوك'
  };
  const order = [['jacket','big'],['shoes','wide'],['hoodie','wide'],['pants',''],['jeans',''],['tshirt',''],['acc','']]
    /* never render a tile for an empty category: هوديات-و-سويت holds 0 products and its
       collection URL returns a hard 404. Filtering on the live count means any category
       that sells out drops off by itself instead of becoming a dead link. */
    .filter(([c]) => (counts[c] || 0) > 0);
  $('#catsGrid').innerHTML = order.map(([c,cls], i) => {
    const m = CAT_META[c];
    const n = counts[c] || 0;
    const href = m.col ? '/collections/' + encodeURI(m.col) : '#shop';
    const idx = String(i+1).padStart(2,'0');
    const countTxt = n + ' قطعة متوفرة';
    const fp = FOCUS[c] || 'center';
    return `<a class="cat ${cls}" href="${href}" aria-label="${esc(m.t)} — ${esc(countTxt)}">
      <span class="cat-bg" style="background-image:url('${ASSET[c]}');background-position:${fp}" role="presentation"></span>
      <span class="cat-idx">${idx} — ${esc(c).toUpperCase()}</span>
      <p class="cat-c">${esc(countTxt)}</p>
      <h3 class="cat-t">${esc(m.t)}</h3>
      <p class="cat-d">${esc(DESC[c]||'')}</p>
      <span class="cat-cta">تسوّق دابا ←</span>
    </a>`;
  }).join('');
}
