  <p style="max-width:820px;color:var(--txt2);line-height:1.9;margin:12px 0 20px">{{ ps_intro }}</p>

  {%- comment -%} Dynamic products — available only, no hard-coded IDs {%- endcomment -%}
  {%- assign ps_terms = ps_filter | split: ',' -%}
  {%- assign ps_shown = 0 -%}
  {%- if ps_mode == 'guide' -%}
  <h2 id="products" style="margin:8px 0 4px;scroll-margin-top:100px">ابدا من هنا — قطع متوفرة دابا 👇</h2>
  <p style="color:var(--txt3);font-size:13px;font-weight:800;margin:0 0 14px">طبّق النقط اللي فوق على هاد القطع — صور حقيقية، حالة حسب التأكيد، ومخزون Shopify.</p>
  {%- else -%}
  <h2 id="products" style="margin:8px 0 4px;scroll-margin-top:100px">المتوفر دابا 👇</h2>
  <p style="color:var(--txt3);font-size:13px;font-weight:800;margin:0 0 14px">المخزون وشارة 1/1 كيبانو حسب Shopify فصفحة كل قطعة.</p>
  {%- endif -%}
  <div class="grid" data-cro-list data-cro-list-name="pseo_{{ page.handle | escape }}">
    {%- for p in ps_avail -%}
      {%- if ps_shown >= 8 -%}{%- break -%}{%- endif -%}
      {%- if page.handle == 'comment-acheter-second-hand-original-maroc' and p.price < 19900 -%}{%- continue -%}{%- endif -%}
      {%- if page.handle == 'comment-acheter-second-hand-original-maroc' and p.price > 39900 -%}{%- continue -%}{%- endif -%}
      {%- assign ps_match = false -%}
      {%- if ps_mode == 'all' or ps_mode == 'guide' -%}
        {%- assign ps_match = true -%}
      {%- elsif ps_mode == 'vendor' -%}
        {%- assign p_vendor_dc = p.vendor | downcase -%}
        {%- assign p_tags_dc = p.tags | join: ',' | downcase -%}
        {%- assign ps_filter_dc = ps_filter | downcase -%}
        {%- if p_vendor_dc contains ps_filter_dc or p_tags_dc contains ps_filter_dc -%}{%- assign ps_match = true -%}{%- endif -%}
      {%- else -%}
        {%- assign p_tags = p.tags | join: ',' | downcase -%}
        {%- assign p_type = p.product_type | downcase -%}
        {%- for t in ps_terms -%}
          {%- if p_tags contains t or p_type contains t -%}{%- assign ps_match = true -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if ps_match -%}
        {%- assign ps_shown = ps_shown | plus: 1 -%}
        {% render 'lbass-look-card', rp: p %}
      {%- endif -%}
    {%- endfor -%}
    {%- if ps_shown == 0 -%}
      <div style="grid-column:1/-1;border:1px solid var(--line);border-radius:14px;padding:22px;background:var(--ink2)">
        <h3 style="margin-top:0">القطع ديال هاد القسم ما بقاوش متوفرين دابا.</h3>
        <p style="color:var(--txt2);margin:0 0 14px">الجديد كيجي مع كل Drop. شوف الباقي المتوفر أو سولنا فالواتساب على اللي كتقلب عليه.</p>
        <a class="btn btn-c" href="{{ routes.all_products_collection_url }}">شوف كل القطع المتوفرة</a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Trust block — proof, not adjectives {%- endcomment -%}
  <section id="proof" style="margin:26px 0;scroll-margin-top:100px" aria-label="معلومات الثقة">
    <div style="display:flex;flex-wrap:wrap;gap:8px">
      <span class="chip">📸 صور حقيقية ديال نفس القطعة</span>
      <span class="chip">🔍 الحالة والتّيكيت حسب التأكيد</span>
      <span class="chip">📝 الملاحظات كيبانو ملي تكون مسجلة</span>
      <span class="chip">📏 قياسات بالسنتيمتر حسب المتوفر</span>
      <span class="chip">💵 خلّص ملي توصلك (COD)</span>
      <span class="chip">🚚 مراكش 20 د · خارج مراكش 40 د</span>
    </div>
  </section>

  {%- comment -%} Size + condition + COD explainer {%- endcomment -%}
  <section id="buying-help" style="max-width:860px;margin:0 0 24px;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;scroll-margin-top:100px" aria-label="القياس والحالة والطلب">
    <div style="border:1px solid var(--line);border-radius:14px;padding:16px;background:var(--ink2)">
      <h3 style="margin:0 0 6px">📏 القياس قبل الطلب</h3>
      <p style="color:var(--txt2);font-size:13.5px;margin:0;line-height:1.8">قارن القياسات المكتوبة مع قطعة عندك كتجيك مزيانة — أضمن من label size، خصوصاً فالـ vintage. <a href="/pages/size-guide" style="color:var(--gold2);text-decoration:underline">دليل القياسات كامل</a>.</p>
    </div>
    <div style="border:1px solid var(--line);border-radius:14px;padding:16px;background:var(--ink2)">
      <h3 style="margin:0 0 6px">🔍 الحالة بلا تجميل</h3>
      <p style="color:var(--txt2);font-size:13.5px;margin:0;line-height:1.8">درجة الحالة وأي ملاحظة معروفة كيبانو ملي يكونو مؤكدين؛ وإذا بقات المعلومة ناقصة كنطلبو التأكيد. <a href="/pages/condition-guide" style="color:var(--gold2);text-decoration:underline">دليل الحالة</a>.</p>
    </div>
    <div style="border:1px solid var(--line);border-radius:14px;padding:16px;background:var(--ink2)">
      <h3 style="margin:0 0 6px">💵 كيفاش كيدوز الطلب</h3>
      <p style="color:var(--txt2);font-size:13.5px;margin:0;line-height:1.8">كتطلب → كنأكدو فالواتساب → كتخلص كاش ملي توصلك. التفاصيل فـ <a href="/pages/shipping-and-payment" style="color:var(--gold2);text-decoration:underline">التوصيل والخلاص</a>.</p>
    </div>
  </section>

  {%- comment -%} Page FAQ — visible, mirrored in schema below {%- endcomment -%}
  <section class="coll-faq" id="faq" aria-label="أسئلة" style="max-width:860px;display:grid;gap:8px;margin:0 0 24px;scroll-margin-top:100px">
    {% case page.handle %}
    {% when 'sneakers-second-hand-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نعرف قياس السنيكر الصحيح؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">قيس النعل الداخلي (insole) ديال صباط عندك مريح بالسنتيمتر وقارنو مع القياس المكتوب فصفحة المنتج — أرقام EU/US كيختلفو بين البراندات، السنتيمتر هو الحقيقة.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش السنيكرز أصلية؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">Lbass Original كيعرض سنيكرز branded second-hand أصلية. فصفحة كل منتج كنبيّنو صور الجوج نفسها، والتّيكيت والحالة وملاحظات الفحص غير ملي تكون مؤكدة.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش نقدر نشوف صور إضافية للنعل والتفاصيل؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">نعم — صيفط رابط المنتج فالواتساب وكنصورو ليك النعل، الخياطة، أو أي زاوية بغيتيها قبل ما تطلب.</p></details>
    {% when 'nike-second-hand-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش كتشيّكو واش قطعة Nike أصلية؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">كنقارنو الإتيكيت، كود النموذج، الخياطة الداخلية، اللصاقات، بلاد الصنع والكولور مع المعطيات الرسمية ديال Nike. أي قطعة فيها شك — ما كتتعرضش.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">شنو كاين من Nike دابا؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">التشكيلة كتبدل مع كل Drop، والمخزون الحقيقي كيبان فصفحة كل منتج. شوف القطع المعروضة فوق أو سولنا فالواتساب على موديل معين.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش الثمن ديال Nike second-hand يستاهل؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">كتاخد قطعة أصلية بثمن أقل بزاف من الجديد، والحالة مكتوبة بلا تجميل باش تعرف بالضبط شنو غادي توصلك — وكتخلص غير ملي تشوفها.</p></details>
    {% when 'friperie-en-ligne-paiement-a-la-livraison-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش خاصني نخلص شي حاجة قبل التوصيل؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">لا. بالدفع عند الاستلام (COD) ما كتخلص حتى درهم حتى توصلك القطعة وتشوفها. وإلا بغيتي تخلص أونلاين، PayPal متاح.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">شحال التوصيل وشحال المدة؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">20 درهم داخل مراكش و40 درهم لباقي المدن المغربية. المدة حسب المدينة وشركة التوصيل، وكنأكدو معاك فالواتساب قبل الإرسال.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">شنو الفرق بينكم وبين الفريب العادية؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">كل منتج عندو صور القطعة نفسها، والحالة والتّيكيت والقياسات كيبانو حسب المعلومات المؤكدة قبل الشراء.</p></details>
    {% when 'adidas-second-hand-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش قطع Adidas أصلية؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">Lbass Original كيعرض قطع Adidas second-hand أصلية. التّيكيت والحالة وملاحظات الفحص كيبانو غير ملي يكونو مؤكدين فصفحة المنتج.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">شنو الفرق بين Adidas و Adidas Originals؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">Adidas Originals هي الخط الكلاسيكي/lifestyle (Trefoil, Stan Smith)، وAdidas العادي أكثر رياضي. عندنا الجوج، وكل قطعة مكتوب فيها البراند بالضبط.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نعرف القياس ديال سروال تراك؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">قيس الوسط والطول والـ inseam بالسنتيمتر وقارنهم مع سروال عندك مريح — كنكتبو القياسات فصفحة المنتج ملي كيكونو متوفرين.</p></details>
    {% when 'jordan-second-hand-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش كتشيّكو واش قطعة Jordan أصلية؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">كنقارنو الإتيكيت، كود النموذج، الخياطة الداخلية، اللصاقات، بلاد الصنع والكولور مع المعطيات الرسمية. Jordan كيتقلّد بزاف، علاش الفحص صارم.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش عندكم صبابط Jordan ولا غير حوايج؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">التشكيلة كتبدل مع كل Drop. شوف القطع المعروضة فوق، وإلا كتقلب على موديل معين (صباط ولا حوايج) سولنا فالواتساب ونعلموك ملي يجي.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش القطعة اللي فالصورة هي اللي غادي توصلني؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">إيه — الصور ديال نفس القطعة المعروضة للبيع، والمخزون الحقيقي كيبان فصفحة المنتج.</p></details>
    {% when 'jackets-second-hand-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نعرف قياس الجاكيط؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">قيس الصدر (من إبط لإبط ×2)، الطول (من الكتف للحاشية)، والكم — وقارنهم مع جاكيط عندك مريح. القطع vintage غالباً كتجي أوسع.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نعرف حالة الجاكيط؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">شوف الحالة والتّيكيت والملاحظات المؤكدة فصفحة المنتج، وإذا بغيتي شي زاوية إضافية سولنا فالواتساب قبل الطلب.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش عندكم جاكيطات ديال الشتا؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">عندنا بوفر جاكيط وقطع دافية، وقطع خفيفة للـ mid-season. شوف المتوفر فوق أو سولنا فالواتساب على شنو كتقلب.</p></details>
    {% when 'cargo-pants-second-hand-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نعرف قياس السروال الصحيح؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">أهم قياس هو الـ inseam (من الملتقى ديال الرجلين حتى للكعب) والوسط. قيسهم على سروال عندك مريح وقارن مع القياسات المكتوبة فصفحة المنتج.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش السراويل أصلية وكيفاش كاتبان الحالة؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">Lbass Original كيعرض سراويل branded second-hand أصلية بصور القطعة نفسها. الحالة والتّيكيت والملاحظات كيبانو غير حسب التأكيد.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش كاين كارغو ولا حتى تراك؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">عندنا الجوج — كارغو (بجيوب) وتراك بانت رياضي. شوف المتوفر فوق، والمخزون فصفحة كل قطعة.</p></details>
    {% when 'streetwear-original-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">شنو معنى قطعة 1/1؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">1/1 يعني نسخة وحدة فقط فالمخزون — ملي كتباع، ما كتعاودش. اللوك ديالك ما كيتكررش.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">واش القطع أصلية؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">Lbass Original كيعرض streetwear branded second-hand أصلي بصور القطعة نفسها. معلومات الفحص كاتبان غير ملي تكون مؤكدة.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نلقى قطعة تناسب ستايلي؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">شوف المتوفر فوق، أو استعمل الـ VAULT للقطع النادرة، أو صيفط لينا الستايل اللي كتقلب عليه فالواتساب ونقترحو ليك.</p></details>
    {% when 'comment-acheter-second-hand-original-maroc' %}
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نعرف واش القطعة أصلية قبل ما نشري؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">شوف صور القطعة والتّيكيت وملاحظات الفحص المؤكدة. إلا بقات شي معلومة ناقصة، طلب صور قريبة فالواتساب قبل الشراء.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش نتأكد من الحالة والقياس؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">قرا درجة الحالة والعيوب المكتوبين، وقارن القياسات بالسنتيمتر مع قطعة عندك كتجيك مزيانة. هادشي كينقص المفاجآت بزاف.</p></details>
      <details style="border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.028);padding:0 14px"><summary style="cursor:pointer;padding:12px 0;font-weight:900;color:var(--cream)">كيفاش كيخدم الدفع عند الاستلام؟</summary><p style="color:var(--txt2);padding:0 0 13px;margin:0">كتوصلك الطلبية وكتخلص عند الاستلام حسب طريقة الطلب. راجع التوصيل وسياسة الإرجاع أو تواصل معنا قبل ما تكمل.</p></details>
    {% endcase %}
  </section>

