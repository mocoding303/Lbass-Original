{%- comment -%}
  ═══ GA4 KEY EVENT — generate_lead (2026-09-04) ═══
  This page is only reachable after a successful customer-form POST (the homepage
  form redirects here on form.posted_successfully?, the exit-intent popup via
  return_to), so a pageview here IS a completed signup. gtag is confirmed present
  in the main window (G-QJLBNF740S), so no Custom Pixel sandbox is needed.

  `generate_lead` is a GA4 RECOMMENDED event name — using it rather than an
  invented name is what lets GA4 report on it properly.

  Guarded two ways:
  - sessionStorage, so a refresh or a back-navigation cannot double-count. The
    guard is written only AFTER the event actually fires, so a slow gtag never
    silently swallows the signup.
  - a short poll, because gtag/js is async and may not exist at parse time.
{%- endcomment -%}
<script>
(function(){
  var KEY = 'lbass_nl_lead_sent';
  try { if (sessionStorage.getItem(KEY)) return; } catch (e) {}
  var tries = 0;
  (function wait(){
    if (typeof window.gtag === 'function'){
      window.gtag('event', 'generate_lead', {
        method: 'newsletter',
        form_location: 'newsletter_confirmation'
      });
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
      return;
    }
    if (tries++ < 40) setTimeout(wait, 150);
  })();
})();
</script>

