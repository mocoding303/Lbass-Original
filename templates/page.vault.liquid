<script>
/* ── Reveal-on-scroll ── */
(function(){
  if(matchMedia('(prefers-reduced-motion:reduce)').matches){document.querySelectorAll('.rev').forEach(e=>e.classList.add('in'));return}
  const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -50px 0px'});
  document.querySelectorAll('.rev').forEach(el=>io.observe(el));
})();

/* ── Filter + sort engine ── */
(function(){
  const grid=document.getElementById('vgrid');
  const empty=document.getElementById('vempty');
  const countEl=document.getElementById('vcountN');
  if(!grid) return;
  const cards=Array.from(grid.querySelectorAll('.vcard'));
  let activeCat='all',activeBrand='all',activeSort='manual';

  cards.forEach(card=>card.addEventListener('click',()=>{
    const attribution={source:'vault_collection',touch:'product',category:card.dataset.cat||'unknown',product_id:card.dataset.productId||'',product_name:card.dataset.title||'',destination:card.getAttribute('href')||'',ts:Date.now()};
    try{sessionStorage.setItem('lbass_vault_attribution_v1',JSON.stringify(attribution))}catch(e){}
    try{if(window.Shopify&&Shopify.analytics&&typeof Shopify.analytics.publish==='function')Shopify.analytics.publish('lbass_vault_product_click',{category:attribution.category,product_id:attribution.product_id,product_name:attribution.product_name})}catch(e){}
  }));

  function applyFilters(){
    grid.classList.add('busy');
    let shown=0;
    cards.forEach(c=>{
      const catOK=activeCat==='all'||c.dataset.cat===activeCat;
      const brandOK=activeBrand==='all'||c.dataset.brand===activeBrand;
      const visible=catOK&&brandOK;
      const cell=c.closest('.lbqa-wrap')||c;
      cell.classList.toggle('hidden',!visible);
      if(visible)shown++;
    });
    countEl.textContent=shown;
    empty.style.display=shown===0?'block':'none';

    /* Sort visible cards */
    const visibleCards=cards.filter(c=>!(c.closest('.lbqa-wrap')||c).classList.contains('hidden'));
    visibleCards.sort((a,b)=>{
      if(activeSort==='price-desc')return parseFloat(b.dataset.price)-parseFloat(a.dataset.price);
      if(activeSort==='price-asc')return parseFloat(a.dataset.price)-parseFloat(b.dataset.price);
      if(activeSort==='title')return a.dataset.title.localeCompare(b.dataset.title);
      const ta=parseInt(a.dataset.tagged)||0,tb=parseInt(b.dataset.tagged)||0;
      if(ta!==tb)return tb-ta;
      return 0;
    });
    visibleCards.forEach(c=>grid.appendChild(c.closest('.lbqa-wrap')||c));
    setTimeout(()=>grid.classList.remove('busy'),120);
  }

  document.querySelectorAll('[data-fcat]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('[data-fcat]').forEach(b=>b.classList.remove('on'));
      btn.classList.add('on');
      activeCat=btn.dataset.fcat;
      applyFilters();
    });
  });
  document.querySelectorAll('[data-fbrand]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('[data-fbrand]').forEach(b=>b.classList.remove('on'));
      btn.classList.add('on');
      activeBrand=btn.dataset.fbrand;
      applyFilters();
    });
  });
  const sortSel=document.getElementById('vsort');
  if(sortSel)sortSel.addEventListener('change',e=>{activeSort=e.target.value;applyFilters()});

  const urlCat=new URLSearchParams(location.search).get('cat');
  if(urlCat){
    const btn=document.querySelector(`[data-fcat="${urlCat}"]`);
    if(btn){
      document.querySelectorAll('[data-fcat]').forEach(b=>b.classList.remove('on'));
      btn.classList.add('on');
      activeCat=urlCat;
    }
  }

  applyFilters();
})();
</script>

