{%- comment -%}
  VAULT — REDESIGNED 2026-07-31 to the house identity.

  This page uses {% layout none %}, so it does NOT inherit snippets/lbass-stamp
  and gets none of the site tokens. It previously shipped its own DARK theme
  (#0A0A0B ground, #C89A0E gold, 10–50px radii, Space Grotesk) while the rest
  of the storefront is a LIGHT editorial system. Same brand, two identities.

  Tokens below are copied from the live site so the two match exactly:
     ink #0B0B0C · ink-2 #3A3A3C · bone #FFFFFF · bone-2 #F4F2ED
     rule-soft rgba(11,11,12,.14) · red #BF2E15
     display Anton · arabic Alexandria/Tajawal · latin Epilogue
  Radius is 0 everywhere — the house style is hard-edged.

  TWO THINGS THAT ONLY BITE BECAUSE OF {% layout none %} — do not remove:
  1. The logo filter. lbass-wordmark-horizontal.svg and lbass-monogram.svg
     hardcode cream (#F4EFE6) + gold (#C89A0E) for the OLD dark theme and expose
     no currentColor, so on a white ground they render invisible. The light site
     neutralises them in lbass-stamp with `filter:brightness(0)`. This page never
     inherits that rule, so it is repeated below — same property, same value.
  2. --red-lift. The brand red #BF2E15 on the ink CTA band measures only 3.39:1,
     which fails WCAG AA. #F2603F is the same hue lifted to ~6.1:1 and is used
     ONLY on ink grounds. Keep #BF2E15 everywhere on light grounds.
{%- endcomment -%}
<style>
:root{
  --ink:#0B0B0C; --ink-2:#3A3A3C; --ink-3:#6B6B6E;
  --bone:#FFFFFF; --bone-2:#F4F2ED; --bone-3:#EDEAE3;
  --rule:rgba(11,11,12,.14); --rule-hard:#0B0B0C;
  --red:#BF2E15; --red-dark:#8F1F0D;
  --red-lift:#F2603F;            /* red for use ON ink — AA-safe (~6.1:1) */
  --ar:'Alexandria','Tajawal',system-ui,sans-serif;
  --dp:'Anton',Impact,sans-serif;
  --lt:'Epilogue',system-ui,sans-serif;
  --pad:clamp(18px,5vw,64px); --max:1500px; --tr:.2s cubic-bezier(.4,0,.2,1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;overflow-x:hidden}
body{background:var(--bone);color:var(--ink);font-family:var(--ar);font-size:16px;line-height:1.7;overflow-x:hidden;min-height:100vh;display:flex;flex-direction:column}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer;font-size:inherit}
::selection{background:var(--ink);color:var(--bone)}
.num{font-family:var(--lt);direction:ltr;unicode-bidi:embed;font-variant-numeric:tabular-nums}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}

/* Wordmark/monogram assets are dark-theme artwork (see header comment). */
.brand-logo,.brand-monogram,.foot-logo{filter:brightness(0)}

/* ── NAV ── */
.nav{position:sticky;top:0;z-index:55;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px var(--pad);background:var(--bone);border-bottom:1px solid var(--rule-hard)}
.brand{display:flex;align-items:center;gap:12px}
.brand-logo{display:block;width:clamp(150px,15vw,190px);height:auto}
.brand-monogram{display:none;width:36px;height:36px}
.nav-back{display:inline-flex;align-items:center;height:40px;padding:0 16px;border:1px solid var(--rule-hard);color:var(--ink);font-weight:800;font-size:13.5px;transition:var(--tr)}
.nav-back:hover{background:var(--ink);color:var(--bone)}
@media(max-width:520px){.brand-logo{width:144px}}
@media(max-width:380px){.brand-logo{display:none}.brand-monogram{display:block}}

/* ── HERO ── */
.vault-hero{position:relative;padding:clamp(48px,8vw,104px) var(--pad) clamp(34px,5vw,64px);background:var(--bone-2);border-bottom:1px solid var(--rule-hard);overflow:hidden}
.vault-hero-in{max-width:var(--max);margin:0 auto;position:relative;z-index:2}
.vh-kick{font-family:var(--dp);font-weight:400;letter-spacing:.28em;color:var(--red);font-size:14px;margin-bottom:18px;display:inline-flex;align-items:center;gap:14px;direction:ltr}
.vh-kick::before,.vh-kick::after{content:"";width:34px;height:2px;background:var(--red)}
.vh-h{font-family:var(--ar);font-size:clamp(38px,7vw,84px);font-weight:900;line-height:1.05;color:var(--ink);margin-bottom:18px;letter-spacing:-.01em}
.vh-h em{font-style:normal;color:var(--red)}
.vh-sub{font-size:clamp(15px,1.7vw,18px);color:var(--ink-2);max-width:62ch;margin-bottom:26px;line-height:1.8;font-weight:500}
.vh-sub b{color:var(--ink);font-weight:900}
.vh-stats{display:flex;flex-wrap:wrap;gap:clamp(20px,3vw,44px);padding-top:20px;border-top:1px solid var(--rule-hard)}
.vh-stat b{font-family:var(--dp);font-weight:400;font-size:clamp(24px,3vw,34px);color:var(--ink);display:block;direction:ltr;line-height:1.1}
.vh-stat span{font-family:var(--lt);font-size:11.5px;color:var(--ink-3);font-weight:600;text-transform:uppercase;letter-spacing:.1em}

/* ── WHY VAULT ── */
.why{padding:clamp(40px,6vw,72px) var(--pad);background:var(--bone)}
.why-in{max-width:var(--max);margin:0 auto}
.why-kick{font-family:var(--lt);font-weight:700;letter-spacing:.16em;color:var(--red);font-size:12px;margin-bottom:10px;text-transform:uppercase}
.why-h{font-size:clamp(26px,4vw,40px);font-weight:900;line-height:1.15;color:var(--ink);margin-bottom:30px}
.why-h em{font-style:normal;color:var(--red)}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--rule-hard)}
.why-card{padding:26px 24px;border-inline-start:1px solid var(--rule-hard);transition:var(--tr)}
.why-card:first-child{border-inline-start:0}
.why-card:hover{background:var(--bone-2)}
.why-num{font-family:var(--dp);font-weight:400;color:var(--red);font-size:20px;direction:ltr;display:block;margin-bottom:12px}
.why-card b{display:block;color:var(--ink);font-size:18px;margin-bottom:8px;font-weight:900}
.why-card p{color:var(--ink-2);font-size:14px;line-height:1.75;font-weight:500}
@media(max-width:780px){.why-grid{grid-template-columns:1fr}.why-card{border-inline-start:0;border-top:1px solid var(--rule-hard)}.why-card:first-child{border-top:0}}

/* ── FILTER BAR ── */
.fbar{padding:clamp(16px,2.5vw,24px) var(--pad);background:var(--bone);border-block:1px solid var(--rule-hard);position:sticky;top:70px;z-index:50}
.fbar-in{max-width:var(--max);margin:0 auto;display:flex;flex-direction:column;gap:12px}
.fbar-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.fbar-lbl{font-family:var(--lt);font-weight:700;color:var(--ink-3);font-size:10.5px;text-transform:uppercase;letter-spacing:.14em;margin-inline-end:4px}
.fchip{display:inline-flex;align-items:center;height:38px;padding:0 15px;border:1px solid var(--rule-hard);color:var(--ink);font-weight:800;font-size:13px;background:var(--bone);cursor:pointer;transition:var(--tr);font-family:var(--ar)}
.fchip:hover{background:var(--bone-2)}
.fchip.on{background:var(--ink);border-color:var(--ink);color:var(--bone)}
.fsort{margin-inline-start:auto;display:flex;align-items:center;gap:10px}
.fsort select{appearance:none;background:var(--bone);border:1px solid var(--rule-hard);border-radius:0;height:38px;padding:0 34px 0 14px;color:var(--ink);font-family:var(--ar);font-weight:800;font-size:13px;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,var(--ink) 50%),linear-gradient(135deg,var(--ink) 50%,transparent 50%);background-position:calc(100% - 16px) 50%,calc(100% - 11px) 50%;background-size:5px 5px,5px 5px;background-repeat:no-repeat}
.fsort select:focus{outline:none;border-color:var(--red)}
@media(max-width:640px){.fbar{position:relative;top:0}.fsort{width:100%;justify-content:space-between}}

/* ── PRODUCT GRID ── */
.vault-main{padding:clamp(26px,4vw,44px) var(--pad) clamp(40px,6vw,76px);background:var(--bone);flex:1}
.vault-main-in{max-width:var(--max);margin:0 auto}
.vcount{font-size:13px;color:var(--ink-2);font-weight:700;margin-bottom:18px;font-family:var(--lt)}
.vcount b{color:var(--ink);font-family:var(--dp);font-weight:400;font-size:18px;direction:ltr;margin-inline-end:4px}
.vgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(258px,1fr));gap:clamp(14px,2vw,22px);transition:opacity .2s ease}
.vgrid.busy{opacity:.45;pointer-events:none}
.vcard{display:block;position:relative;border:1px solid var(--rule-hard);background:var(--bone);transition:transform .3s cubic-bezier(.7,0,.3,1),box-shadow var(--tr)}
.vcard:hover{transform:translateY(-3px);box-shadow:8px 8px 0 var(--ink)}
.vcard.hidden{display:none}
.vc-img{position:relative;aspect-ratio:4/5;background:var(--bone-2);overflow:hidden;border-bottom:1px solid var(--rule-hard)}
.vc-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.3,1)}
.vcard:hover .vc-img img{transform:scale(1.06)}
.vc-badges{position:absolute;top:10px;inset-inline-end:10px;display:flex;flex-direction:column;gap:5px;z-index:2;align-items:flex-end}
/* ═══ CONDITION BADGE — MUST CARRY ITS OWN PLATE (2026-08-27) ═══
   .vc-badges is position:absolute over the product PHOTO (see rule above), so a
   badge with no background inherits whatever the photograph happens to be. This
   rule used to declare no background and no shadow, only near-black type, so the
   condition label vanished on any dark or busy image — reported on the black
   North Face puffer, where it sat on a dark object and was unreadable.

   snippets/lbass-stamp.liquid:828 already tries to fix exactly this
   (`.vc-badge{background:rgba(255,255,255,.94)!important}`) and never applies:
   THIS TEMPLATE DOES NOT RENDER lbass-stamp — page.vault.liquid renders only
   lbass-cart-drawer. Do not "fix" this by loading the stamp snippet here; that
   pulls in a whole homepage stylesheet. The plate is declared locally instead,
   with the same values the stamp intended so the two can never disagree.

   The two modifier badges below (.vc-bvault, .vc-bnew) come LATER at equal
   specificity and set their own background/colour/border, so they still win.
   Keep them after this rule. */
.vc-badge{font-family:var(--ar);font-weight:800;font-size:11px;letter-spacing:normal;padding:6px 10px;border-radius:0;line-height:1.25;display:inline-block;background:rgba(255,255,255,.94);color:#0B0B0C;border:1px solid rgba(11,11,12,.22);box-shadow:0 1px 3px rgba(11,11,12,.18);backdrop-filter:saturate(140%) blur(2px);-webkit-backdrop-filter:saturate(140%) blur(2px)}
/* ink plate + bone type — identical to the site-wide badge system */
.vc-bvault{background:var(--ink);color:#F2F0EB;border:1px solid rgba(242,240,235,.28);font-family:var(--lt);letter-spacing:.12em;font-size:10px;font-weight:700}
/* red stays reserved for جديد, exactly as site-wide */
.vc-bnew{background:var(--red);color:#FFFFFF;border:1px solid rgba(255,255,255,.34)}
.vc-info{padding:15px 16px 18px}
.vc-vendor{font-family:var(--lt);font-weight:700;font-size:11px;letter-spacing:.14em;color:var(--red);text-transform:uppercase;direction:ltr}
.vc-title{font-size:15.5px;font-weight:900;color:var(--ink);margin:6px 0 12px;line-height:1.35;min-height:2.7em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.vc-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:11px;border-top:1px solid var(--rule)}
.vc-price{font-family:var(--dp);font-weight:400;font-size:22px;color:var(--ink);direction:ltr;line-height:1}
.vc-old{font-family:var(--lt);font-weight:500;font-size:13px;color:var(--ink-3);text-decoration:line-through;direction:ltr;margin-inline-start:6px}
.vc-uniq{font-family:var(--lt);font-size:10.5px;font-weight:700;color:var(--bone);background:var(--red);padding:4px 9px;letter-spacing:.08em;direction:ltr}

.vempty{text-align:center;padding:56px 20px;color:var(--ink-2);border:1px solid var(--rule-hard);background:var(--bone-2)}
.vempty b{display:block;color:var(--ink);font-size:20px;margin-bottom:10px;font-weight:900}
.vempty a{color:var(--red);font-weight:900;text-decoration:underline}

/* ── CTA STRIP ── (ink band — uses --red-lift, never --red) */
.vcta{padding:clamp(40px,6vw,72px) var(--pad);background:var(--ink);border-top:1px solid var(--rule-hard);text-align:center}
.vcta-in{max-width:760px;margin:0 auto}
.vcta h2{font-size:clamp(24px,3.5vw,36px);font-weight:900;color:var(--bone);line-height:1.2;margin-bottom:14px}
.vcta h2 em{font-style:normal;color:var(--red-lift)}
.vcta p{color:rgba(255,255,255,.78);font-size:15.5px;margin-bottom:24px;font-weight:500}
/* p.vcta-kick, not .vcta-kick: `.vcta p` is (0,1,1) and would otherwise win. */
.vcta p.vcta-kick{font-family:var(--lt);font-weight:700;letter-spacing:.16em;color:var(--red-lift);font-size:12px;margin-bottom:12px;text-transform:uppercase}
.vcta-btn{display:inline-flex;align-items:center;gap:10px;background:var(--red);color:#fff;font-weight:900;font-size:15px;padding:15px 30px;border-radius:0;transition:var(--tr);font-family:var(--ar)}
.vcta-btn:hover{background:var(--red-dark)}
.vcta-btn svg{width:20px;height:20px;fill:currentColor}

/* ── FOOTER ── */
.foot{border-top:1px solid var(--rule-hard);background:var(--bone);padding:30px var(--pad);text-align:center;color:var(--ink-2);font-size:13.5px}
.foot a{color:var(--ink);margin:0 8px;font-weight:800}
.foot a:hover{color:var(--red)}
.foot-logo{display:block;width:168px;height:auto;margin:0 auto 14px}

/* ── WHATSAPP FLOAT ── (circular: matches the float used site-wide) */
.wa-float{position:fixed;bottom:24px;right:24px;z-index:80;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 26px rgba(0,0,0,.22);transition:transform .25s ease,background .25s ease}
.wa-float:hover{transform:scale(1.1);background:#20c157}
.wa-float svg{width:27px;height:27px;fill:#fff}
@media(max-width:640px){.wa-float{bottom:18px;right:16px;width:52px;height:52px}}

/* ── REVEAL ── */
.rev{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.3,1)}
.rev.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.rev{opacity:1;transform:none;transition:none}.vcard:hover{transform:none;box-shadow:none}.vcard:hover .vc-img img{transform:none}}
</style>
{{ content_for_header }}
</head>
<body>

<!-- ═══ NAV ═══ -->
<nav class="nav" aria-label="القائمة">
  <a class="brand" href="/" aria-label="Lbass Original — الرئيسية">
