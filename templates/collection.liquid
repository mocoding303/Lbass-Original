  {% assign is_brand_coll = false %}
  {% assign coll_vendors = collection_product_source | map: 'vendor' | uniq %}
  {% if coll_vendors.size == 1 and coll_vendors.first == collection_display_title %}{% assign is_brand_coll = true %}{% endif %}

  {% render 'lbass-collection-filters', collection: collection, count_override: collection_display_count %}

  <div class="grid" id="lbfGrid">
    {% for product in collection_product_source %}
      {% assign cv = product.selected_or_first_available_variant %}
      {% assign card_ticket = product.metafields.lbass.ticket_status.value | default: 'unknown' %}
      {% assign card_status = product.metafields.lbass.condition_status.value | default: 'unknown' %}
      {% assign card_inspection = product.metafields.lbass.inspection_status.value %}
      {% assign card_has_ticket = product.metafields.lbass.has_original_ticket.value %}
      {% assign card_notes = product.metafields.lbass.condition_notes.value %}
      {% assign card_defects = product.metafields.lbass.visible_defects.value %}
      {% assign card_condition = '' %}
      {% assign card_confirmed = false %}
      {% if card_inspection == 'inspected_confirmed' %}
        {% if card_has_ticket == true and card_status == 'new_with_ticket' %}
          {% if card_ticket == 'ticket_attached' or card_ticket == 'ticket_included' %}{% assign card_condition = 'جديد بالتّيكيت' %}{% assign card_confirmed = true %}{% endif %}
        {% elsif card_has_ticket == false and card_ticket == 'no_ticket' and card_status == 'new_without_ticket' %}
          {% assign card_condition = 'جديد بلا تيكيت' %}{% assign card_confirmed = true %}
        {% elsif card_has_ticket == false and card_ticket == 'no_ticket' and card_status == 'excellent_almost_new' %}
          {% assign card_condition = 'بحالة ممتازة · شبه جديد' %}{% assign card_confirmed = true %}
        {% elsif card_status == 'very_good' %}
          {% assign card_condition = 'بحالة مزيانة بزاف' %}{% assign card_confirmed = true %}
        {% elsif card_status == 'good' %}
          {% assign card_condition = 'بحالة مزيانة' %}{% assign card_confirmed = true %}
        {% elsif card_status == 'needs_note' %}
          {% if card_notes != blank or card_defects != blank %}{% assign card_condition = 'بحالة مزيانة · شوف الملاحظات' %}{% assign card_confirmed = true %}{% endif %}
        {% endif %}
      {% endif %}
      {% capture card_one_s %}{% render 'lbass-one-of-one', product: product %}{% endcapture %}{% assign card_one_s = card_one_s | strip %}
      {% assign card_one = false %}{% if card_one_s == '1' %}{% assign card_one = true %}{% endif %}
      {% assign card_promo = false %}
      {% if cv.available and card_confirmed and product.metafields.lbass.promo_eligible.value == true %}
        {% if card_status == 'new_with_ticket' or card_status == 'new_without_ticket' or card_status == 'excellent_almost_new' %}{% assign card_promo = true %}{% endif %}
      {% endif %}
      {% capture card_alt %}{{ product.vendor }} {{ product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first }} second-hand original in Morocco{% unless product.has_only_default_variant %}, size {{ cv.title }}{% endunless %}{% if card_condition != blank %}, {{ card_condition }}{% endif %}, photographed by Lbass Original{% endcapture %}
      {% assign p_gender = '' %}
      {% for t in product.tags %}
        {% assign td = t | downcase %}
        {% if td == 'homme' or td == 'men' or td == 'رجال' %}{% assign p_gender = 'm' %}{% break %}{% endif %}
        {% if td == 'femme' or td == 'women' or td == 'نساء' %}{% assign p_gender = 'f' %}{% break %}{% endif %}
      {% endfor %}
      <div class="lbqa-wrap{% unless product.available %} lb-sold{% endunless %}"
           data-avail="{% if product.available %}1{% else %}0{% endif %}"
           data-brand="{{ product.vendor | escape }}"
           data-price="{{ product.price | divided_by: 100.0 }}"
           data-gender="{{ p_gender }}"
           data-sizes="{% for v in product.variants %}{{ v.title | escape }}|{% endfor %}">
      <a class="card" href="{{ product.url }}" data-collection-product data-cro-product-card data-cro-placement="collection" data-product-id="{{ product.id }}" data-product-name="{{ product.title | escape }}">
        <div class="card-img">
          {% if card_one %}<span class="lb-stamp" aria-hidden="true">1/1</span>{% elsif product.available %}<span class="lb-stamp" aria-hidden="true">LIVE</span>{% else %}<span class="lb-stamp lb-stamp--sold" aria-hidden="true">SOLD</span>{% endif %}
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.featured_image.alt | default: card_alt | strip | escape }}" loading="lazy" decoding="async" width="500" height="625">
          {% else %}
            <span style="font-size:64px;opacity:.4">{% case product.product_type %}{% when 'Jackets' %}🧥{% when 'Jeans' %}👖{% when 'T-Shirts' %}👕{% when 'Shoes' %}👟{% when 'Hoodies' %}🧣{% when 'Accessories' %}🕶{% else %}👕{% endcase %}</span>
          {% endif %}
        </div>
        <div class="card-body">
          {%- comment -%}
            ONE vendor + ONE title. Both were previously rendered TWICE — once
            plain, once with itemprop — so every card on every collection page
            showed the brand and product name doubled. The microdata pair is the
            one kept; the plain pair was the leftover.

            `dir="auto"` on the title matters here: these names mix Latin and
            Arabic ("Adidas Copa Black Football Boots - Size 44 | سبادري كورة
            أديداس"). Without it the browser applies the page's RTL direction to
            the whole string and the Latin half lands in the wrong visual order.
            `auto` lets each run resolve from its own first strong character.
          {%- endcomment -%}
          <div class="card-vendor" itemprop="brand">{{ product.vendor }}</div>
          <div class="card-title" itemprop="name" dir="auto">{{ product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first | split: ' — ' | first }}</div>
          <div class="card-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
            <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
            <meta itemprop="price" content="{{ product.price | divided_by: 100.0 }}">
            <span itemprop="availability" content="https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"></span>
            {{ product.price | money }}
          </div>
          {% if product.available %}<p style="margin:7px 0 0;color:var(--gold2);font-size:12px;font-weight:900">شوفها قبل ما تتباع ←</p>{% endif %}
          <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">
            {% unless product.has_only_default_variant %}<span class="chip chip-sz" style="font-size:11px;padding:3px 8px">{{ cv.title }}</span>{% endunless %}
            {% if card_confirmed %}<span class="chip chip-cond" style="font-size:11px;padding:3px 8px">{{ card_condition }}</span>{% endif %}
            {% if card_promo %}<span class="chip" style="font-size:11px;padding:3px 8px">عرض على منتجات مختارة</span>{% endif %}
            {% if card_one %}<span class="chip lb-uniq" dir="auto">Pièce unique <i>· قطعة وحدة</i></span>{% elsif product.available %}<span class="chip" style="font-size:11px;padding:3px 8px">متوفرة دابا</span>{% else %}
      {%- comment -%}
        No sold notice in the card body. The card keeps the SAME structure as an
        available product — image, brand, title, price, size, condition — and the
        only difference is the SOLD stamp on the image plus the muted sold button
        rendered by snippets/lbass-quick-add.liquid.

        Previously this spot held a full PDP sold-out <section> (h2 + paragraph +
        related links) repeated on every sold card, which is what made the grid
        look crowded. Replacing it with a one-line notice still left TWO sold
        messages per card once the quick-add link was added, so the line is gone
        entirely — one message, in the same place every card has its button.
      {%- endcomment -%}
          {% endif %}
          </div>
        </div>
      </a>
      {% render 'lbass-quick-add', product: product %}
      </div>
    {% else %}
      <div style="grid-column:1/-1;border:1px solid var(--line);border-radius:14px;padding:22px;background:var(--ink2)">
        <p class="coll-empty-msg" role="status" style="margin-top:0;font-weight:600">ما كاينش منتجات دابا فهاد القسم.</p>
        <p style="color:var(--txt2);margin:0 0 14px">حيت القطع second-hand غالبا كتكون نسخة وحدة، بعض الأقسام كيتبدلو بسرعة. شوف كل المنتجات أو سولنا على شنو كتقلب.</p>
        <a class="btn btn-c" href="{{ routes.all_products_collection_url }}">شوف كل القطع</a>
      </div>
    {% endfor %}
  </div>

  {% if _in_stock.size > 0 and _in_stock.size < 4 %}
    {% render 'lbass-live-products-rail',
      heading: 'قطع مشابهة متوفرة دابا',
      intro: 'هاد الكوليكشن فيها اختيارات قليلة، لذلك زدنا قطع حية من الدروب الحالي.',
      placement: 'low_stock_collection_alternatives',
      limit: 4,
      exclude_ids: collection_product_ids
    %}
  {% endif %}


  {% comment %}
    Pagination — see snippets/lbass-pagination.liquid.
    Replaces {{ paginate | default_pagination }}, which emitted unstyled English
    markup that rendered as "« Next 2 1" under RTL.
  {% endcomment %}
  {% render 'lbass-pagination', paginate: paginate %}

  {%- comment -%}
    Query-cluster H2 sections. Placed AFTER the product grid on purpose: the
    brief's rule is products above long text, and page-level GSC showed the
    problem is topical BREADTH, not depth of intro copy. Renders only on the
    handles it is written for.
  {%- endcomment -%}
  {% render 'lbass-collection-topics' %}

  <section class="coll-discovery" aria-labelledby="collDiscoveryTitle">
    <div class="coll-discovery__intro">
      <h2 id="collDiscoveryTitle">{{ collection_answer_title }}</h2>
      <p>{{ collection_answer | strip }}</p>
      {% if collection_display_description != blank %}
        <div class="coll-discovery__description">{{ collection_display_description }}</div>
      {% endif %}
    </div>
    <p class="coll-experience"><strong>من التجربة ديال Lbass:</strong> {{ collection_experience }}</p>

    <div class="coll-help-links" aria-label="أدلة مساعدة">
      <a class="chip" href="/pages/condition-guide">دليل الحالة</a>
      <a class="chip" href="/pages/size-guide">دليل القياسات</a>
      <a class="chip" href="/pages/shipping-and-payment">التوصيل والخلاص</a>
      <a class="chip" href="https://wa.me/491754264425?text={{ 'سلام Lbass Original! محتاج مساعدة نختار من ' | append: collection_display_title | url_encode }}" target="_blank" rel="noopener" data-cro-event="whatsapp_click" data-cro-label="collection_guide">سولنا فالواتساب</a>
    </div>

    <nav class="coll-help-links" aria-label="كوليكشنات وصفحات مرتبطة">
      {% case collection.handle %}
        {% when 'صبابط', 'sneakers', 'shoes', 'men-shoes', 'women-shoes' %}
          {% if collections['adidas-originals'] != blank and collections['adidas-originals'].products_count > 0 %}<a class="chip" href="{{ collections['adidas-originals'].url }}">Adidas second-hand Maroc</a>{% endif %}
          {% if collections['nike'] != blank and collections['nike'].products_count > 0 %}<a class="chip" href="{{ collections['nike'].url }}">Nike second-hand Maroc</a>{% endif %}
          <a class="chip" href="/pages/sneakers-second-hand-maroc">دليل Sneakers Second-Hand Maroc</a>
        {% when 'brand-adidas', 'adidas-originals', 'brand-nike', 'nike', 'brand-jordan', 'brand-converse', 'brand-new-balance' %}
          {% if collections['صبابط'] != blank and collections['صبابط'].products_count > 0 %}<a class="chip" href="{{ collections['صبابط'].url }}">صبابط أصلية فالمغرب</a>{% endif %}
          {% if collections['إكسسوارات'] != blank and collections['إكسسوارات'].products_count > 0 %}<a class="chip" href="{{ collections['إكسسوارات'].url }}">إكسسوارات</a>{% endif %}
          <a class="chip" href="/pages/how-we-check-items">كيفاش كنشيكو القطع</a>
        {% else %}
          {% if collections['صبابط'] != blank and collections['صبابط'].products_count > 0 %}<a class="chip" href="{{ collections['صبابط'].url }}">صبابط</a>{% endif %}
          {% if collections['إكسسوارات'] != blank and collections['إكسسوارات'].products_count > 0 %}<a class="chip" href="{{ collections['إكسسوارات'].url }}">إكسسوارات</a>{% endif %}
          <a class="chip" href="/pages/about">على Lbass Original</a>
      {% endcase %}
    </nav>

    <div class="coll-decision" aria-label="مساعدة قبل الاختيار">
      <p>ما عارفش شنو يجيك؟ قارن القياس والحالة بين القطع، أو سولنا قبل الطلب. أغلب القطع محدودة، والمخزون الحقيقي كيبان فصفحة كل منتج.</p>
      <a href="https://wa.me/491754264425?text={{ 'سلام، محتاج مساعدة نختار من ' | append: collection_display_title | url_encode }}" target="_blank" rel="noopener" data-cro-event="whatsapp_click" data-cro-label="collection_help">عاونّي نختار</a>
    </div>

    <section class="coll-intent" aria-label="دليل الشراء حسب نية الزبون">
      <article class="coll-intent-card">
        <i>KNOW</i>
        <b>شنو خاصني نعرف قبل ما نختار؟</b>
        <p>قرا الحالة، شوف الصور كاملة، وقارن القياس مع قطعة عندك قبل ما تدخل المنتج للسلة.</p>
      </article>
      <article class="coll-intent-card">
        <i>GO</i>
        <b>{{ collection_display_title }} فالمغرب</b>
        <p>هاد القسم كيعاونك تلقى قطع second-hand أصلية متوفرة دابا من Lbass Original أونلاين.</p>
      </article>
      <article class="coll-intent-card">
        <i>DO</i>
        <b>كيفاش نختار القياس؟</b>
        <p>استعمل القياس ديال variant، القياسات المكتوبة فالمنتج، أو سولنا فالواتساب على fit قبل الطلب.</p>
      </article>
      <article class="coll-intent-card">
        <i>BUY</i>
        <b>وجدتي القطعة؟</b>
        <p>دخل لصفحة المنتج، تأكد من الصورة والحالة والثمن، وكمل بـ COD أو PayPal حسب الطرق المتاحة.</p>
      </article>
    </section>

    <section class="coll-faq" id="collectionFaq" aria-label="أسئلة حول {{ collection_display_title | escape }}">
      <details>
        <summary>واش هاد المنتجات كاملة متوفرة؟</summary>
        <p>المنتجات اللي كيبان فيها زر الطلب كتكون متوفرة حسب Shopify. إلا تباعت قطعة، كتبدل الحالة ديالها وما خاصهاش تبقى قابلة للطلب.</p>
      </details>
      <details>
        <summary>واش كل قطعة عندها نفس الحالة؟</summary>
        <p>لا. كل قطعة second-hand كتكون بوحدها. شوف الحالة والصور فصفحة المنتج، وسولنا إلا بغيتي تفاصيل أكثر.</p>
      </details>
      <details>
        <summary>كيفاش نطلب من هاد الكوليكشن؟</summary>
        <p>اختار المنتج، راجع القياس والصور، ومن بعد كمل الطلب أو صيفط لينا فالواتساب باش نأكدو معاك قبل الإرسال.</p>
      </details>
      {%- for row in coll_extra_faq_rows -%}
        {%- assign qa = row | split: '||' -%}
        {%- if qa[1] != blank -%}
          <details>
            <summary>{{ qa[0] }}</summary>
            <p>{{ qa[1] }}</p>
          </details>
        {%- endif -%}
      {%- endfor -%}
      {% if is_brand_coll %}
        <details>
          <summary>واش حوايج {{ collection_display_title }} اللي كتبيعو أصلية؟</summary>
          <p>Lbass Original كيعرض قطع {{ collection_display_title }} بصور حقيقية ديال نفس القطعة. حالة التّيكيت والفحص والمخزون كيبانو حسب المعلومات المؤكدة فصفحة كل منتج، والخلاص عند الاستلام (COD) متاح فالمغرب حسب خيارات الطلب.</p>
        </details>
      {% endif %}
    </section>

    <nav aria-label="أقسام أخرى">
      <p style="color:var(--txt3);font-size:12.5px;font-weight:800;margin:0 0 8px">تصفح حسب البراند والفئة</p>
      {% for c in collections %}
        {% unless c.handle == 'frontpage' or c.handle == collection.handle or c.products_count == 0 %}
          <a class="chip" href="{{ c.url }}">{{ c.title }}</a>
        {% endunless %}
      {% endfor %}
      <a class="chip" href="/pages/vault" style="border-color:rgba(200,154,14,.4);color:var(--gold)">VAULT</a>
    </nav>
  </section>
</div>

<style>
.lbf{margin:0 0 18px;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.028)}
.lbf-row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.lbf-chip{cursor:pointer;background:var(--ink2);font-family:inherit;transition:border-color .2s,color .2s}
.lbf-chip.on{border-color:var(--gold);color:var(--gold);background:rgba(200,154,14,.1)}
.lbf-select{padding:8px 12px;border-radius:30px;border:1px solid var(--line);background:var(--ink2);color:var(--txt2);font-family:inherit;font-weight:700;font-size:13px;cursor:pointer}
.lbf-clear{cursor:pointer;background:transparent;font-family:inherit;color:#ff8a8a;border-color:rgba(255,107,107,.3)}
.lbf-count{margin:8px 0 0;color:var(--txt3);font-size:12.5px;font-weight:800}
.lbf-scope{margin:6px 0 0;color:var(--txt3);font-size:12px;font-weight:700;line-height:1.6}
.grid>.lbqa-wrap{order:1}
.grid>.lb-sold{order:9;opacity:.75}
.grid>.lbqa-wrap.lbf-hide{display:none}
</style>
<script>
(function(){
  'use strict';
  var grid = document.getElementById('lbfGrid');
  if (!grid) return;
  var wraps = Array.prototype.slice.call(grid.querySelectorAll('.lbqa-wrap'));
  if (!wraps.length) return;
  var state = { avail:false, gender:null, brand:null, size:null, price:null };

  grid.addEventListener('click', function(e){
    var card = e.target.closest('[data-collection-product]');
    if (!card) return;
    try {
      var vault = JSON.parse(sessionStorage.getItem('lbass_vault_attribution_v1') || 'null');
      if (!vault || !vault.ts || (Date.now() - vault.ts) > 86400000) return;
      vault.touch = 'product';
      vault.source = 'vault_collection';
      vault.product_id = card.getAttribute('data-product-id') || '';
      vault.product_name = card.getAttribute('data-product-name') || '';
      vault.destination = card.getAttribute('href') || '';
      vault.ts = Date.now();
      sessionStorage.setItem('lbass_vault_attribution_v1', JSON.stringify(vault));
      var params = { category: vault.category || 'unknown', product_id: vault.product_id, product_name: vault.product_name, collection: {{ collection.handle | json }} };
      if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') Shopify.analytics.publish('lbass_vault_product_click', params);
    } catch(err){}
  });


})();
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection_display_title | json }},
  "description": {{ collection_display_description | strip_html | json }},
  "url": "{{ shop.url }}{{ collection.url }}",
