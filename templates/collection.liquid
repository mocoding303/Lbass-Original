@media(max-width:520px){.coll-shop-head{align-items:start;flex-direction:column;padding-top:26px}.coll-shop-head__count{margin-top:0!important}.coll-discovery{margin-top:42px;padding-top:28px}.coll-intent{grid-template-columns:1fr}.coll-intent-card{min-height:auto}.coll-decision{align-items:stretch;flex-direction:column}.coll-decision a{text-align:center;min-height:44px;display:grid;place-items:center}}
