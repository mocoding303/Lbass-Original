      "acceptedAnswer": { "@type": "Answer", "text": {{ qa[1] | json }} }
    }
      {%- endif -%}
    {%- endfor -%}{% if is_brand_coll %},
    {
      "@type": "Question",
      "name": {{ 'واش حوايج ' | append: collection_display_title | append: ' اللي كتبيعو أصلية؟' | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ 'Lbass Original كيعرض قطع ' | append: collection_display_title | append: ' بصور حقيقية ديال نفس القطعة. حالة التّيكيت والفحص والمخزون كيبانو حسب المعلومات المؤكدة فصفحة كل منتج، والخلاص عند الاستلام متاح فالمغرب حسب خيارات الطلب.' | json }}
      }
    }{% endif %}
  ]
}
</script>
{% endpaginate %}
