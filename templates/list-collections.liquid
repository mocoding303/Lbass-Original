{% liquid
  assign lb_brand_handles = 'nike,adidas-originals,brand-jordan,brand-new-balance,brand-karl-kani,brand-tommy-hilfiger,brand-converse,brand-vans,brand-carhartt,brand-the-north-face,brand-levis,brand-puma,brand-zara,brand-h-m' | split: ','
%}

<style>
  .lb-brands{
    margin:30px 0 46px;
    padding:clamp(20px,3vw,34px);
    border:1px solid #24211f;
    border-radius:18px;
    background:#0a0a0b;
    box-shadow:0 18px 50px rgba(0,0,0,.2)
  }
  .lb-brands__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:20px}
  .lb-brands__head h2{margin:0;color:#f7f2e9;font-size:clamp(27px,4vw,46px);line-height:1.15}
  .lb-brands__head p{max-width:620px;margin:8px 0 0;color:#d8d1c6;font-size:14px;line-height:1.8}
  .lb-brands__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0;padding:0;list-style:none}
  .lb-brands__item{min-width:0}
  .lb-brand-card{
    position:relative;
    isolation:isolate;
    display:flex;
    min-height:188px;
    height:100%;
    overflow:hidden;
    flex-direction:column;
    border:1px solid #b9b1a6;
    border-radius:12px;
    background:#f5f0e7;
    color:#0a0a0b;
    box-shadow:0 8px 20px rgba(0,0,0,.14);
    text-decoration:none;
    opacity:1;
    mix-blend-mode:normal;
    transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease,background-color .2s ease
  }
  .lb-brand-card::before{
    content:"";
    position:absolute;
    inset:0 0 auto;
    z-index:2;
    height:4px;
    background:#b62b1d;
    transform:scaleX(0);
    transform-origin:left;
    transition:transform .2s ease
  }
  .lb-brand-card:hover,
  .lb-brand-card:focus-visible{
    border-color:#b62b1d;
    background:#fffaf2;
    box-shadow:0 14px 30px rgba(0,0,0,.22);
    transform:translateY(-3px)
  }
  .lb-brand-card:hover::before,
  .lb-brand-card:focus-visible::before{transform:scaleX(1)}
  .lb-brand-card:focus-visible{outline:3px solid #f2d060;outline-offset:4px}
  .lb-brand-card__media{
    display:grid;
    min-height:125px;
    flex:1 1 auto;
    place-items:center;
    padding:26px 22px 20px;
    border-bottom:1px solid #d8d0c5;
    background:#f5f0e7
  }
  .lb-brand-card:hover .lb-brand-card__media,
  .lb-brand-card:focus-visible .lb-brand-card__media{background:#fffaf2}
  .lb-brand-card__media img{
    display:block;
    width:min(100%,170px);
    height:68px;
    max-height:68px;
    object-fit:contain;
    object-position:center;
    filter:brightness(0);
    opacity:1;
    mix-blend-mode:normal
  }
  .lb-brand-card__fallback{
    display:flex;
    min-height:68px;
    align-items:center;
    justify-content:center;
    color:#0a0a0b;
    font-size:clamp(20px,2vw,28px);
    font-weight:950;
    letter-spacing:-.02em;
    line-height:1.05;
    text-align:center;
    opacity:1;
    mix-blend-mode:normal
  }
  .lb-brand-card__body{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 15px 15px}
  .lb-brand-card__copy{display:block;min-width:0}
  .lb-brand-card__title{
    display:block;
    overflow-wrap:anywhere;
    color:#0a0a0b;
    font-size:15px;
    font-weight:950;
    line-height:1.2;
    opacity:1;
    mix-blend-mode:normal
  }
  .lb-brand-card__count{display:block;margin-top:4px;color:#5d554c;font-size:11.5px;font-weight:800;line-height:1.35;opacity:1}
  .lb-brand-card__arrow{
    display:grid;
    width:32px;
    height:32px;
    flex:0 0 32px;
    place-items:center;
    border-radius:50%;
    background:#0a0a0b;
    color:#f7f2e9;
    font-size:17px;
    font-weight:900;
    line-height:1;
    transition:background-color .2s ease,transform .2s ease
  }
  .lb-brand-card:hover .lb-brand-card__arrow,
  .lb-brand-card:focus-visible .lb-brand-card__arrow{background:#b62b1d;transform:translateX(-2px)}
  @media(min-width:1200px){.lb-brands__grid{grid-template-columns:repeat(5,minmax(0,1fr))}}
  @media(max-width:749px){
    .lb-brands{margin:24px -4px 36px;padding:18px 12px;border-radius:14px}
    .lb-brands__head{display:block}
    .lb-brands__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
    .lb-brand-card{min-height:166px;border-radius:10px}
    .lb-brand-card__media{min-height:106px;padding:22px 16px 17px}
    .lb-brand-card__media img{width:min(100%,132px);height:56px;max-height:56px}
    .lb-brand-card__fallback{min-height:56px;font-size:clamp(18px,6vw,23px)}
    .lb-brand-card__body{padding:12px 11px}
    .lb-brand-card__title{font-size:13.5px}
    .lb-brand-card__count{font-size:10.5px}
    .lb-brand-card__arrow{width:28px;height:28px;flex-basis:28px;font-size:15px}
  }
  @media(max-width:360px){
    .lb-brand-card__arrow{display:none}
    .lb-brand-card__body{padding-inline:10px}
  }
  @media(prefers-reduced-motion:reduce){
    .lb-brand-card,.lb-brand-card::before,.lb-brand-card__arrow{transition:none}
    .lb-brand-card:hover,.lb-brand-card:focus-visible{transform:none}
  }
</style>

<div class="wrap">
  <div class="crumb"><a href="{{ routes.root_url }}">الرئيسية</a> › <span>المتجر</span></div>
  <h1>المتجر — كل الأقسام</h1>
  <p style="color:var(--txt2);margin:10px 0 8px">حوايج براند أصلية مستعملة فالمغرب — جاكيطات، جينز، صبابط، تيشرتات، هوديات و إكسسوارات.</p>

  <section style="max-width:820px;margin:0 0 22px;padding:16px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.035)">
    <h2 style="font-size:17px;margin:0 0 8px">شنو هو Lbass Original؟</h2>
    <p style="color:var(--txt2);margin:0;line-height:1.85">
      Lbass Original متجر مغربي أونلاين متخصص فالحوايج البراند الأصلية second-hand. كل منتج مصور بصور حقيقية ديال نفس القطعة، والحالة والتّيكيت والمخزون كيبانو حسب المعلومات المؤكدة. الخلاص <strong>عند الاستلام (COD)</strong> حسب خيارات الطلب، والتوصيل متاح فالمغرب. اختار القسم اللي كيهمك — حسب الفئة أو حسب البراند.
    </p>
  </section>

  <section class="lb-brands" id="brands" aria-labelledby="lbBrandsTitle">
    <div class="lb-brands__head">
      <div>
        <h2 id="lbBrandsTitle">البراندات المتوفرة دابا</h2>
        <p>اختار البراند وشوف غير القطع المتوفرة بصورها الحقيقية. صور هاد الدليل هي شعارات البراندات، ماشي صور مأخوذة من المنتجات.</p>
      </div>
    </div>
    <ul class="lb-brands__grid" role="list">
      {% for brand_handle in lb_brand_handles %}
        {% assign brand_collection = collections[brand_handle] %}
        {% liquid
          assign brand_available_count = 0
          if brand_collection != blank and brand_collection.products_count > 0
            for brand_product in brand_collection.products
              if brand_product.available
                assign brand_available_count = brand_available_count | plus: 1
              endif
            endfor
          endif
        %}
        {% if brand_available_count > 0 %}
          {% liquid
            assign brand_asset = blank
            case brand_handle
              when 'nike'
                assign brand_asset = 'brand-nike.svg'
              when 'adidas-originals'
                assign brand_asset = 'brand-adidas.svg'
              when 'brand-jordan'
                assign brand_asset = 'brand-jordan.svg'
              when 'brand-new-balance'
                assign brand_asset = 'brand-newbalance.svg'
              when 'brand-karl-kani'
                assign brand_asset = 'brand-karlkani.svg'
              when 'brand-tommy-hilfiger'
                assign brand_asset = 'brand-tommyhilfiger.svg'
              when 'brand-converse'
                assign brand_asset = 'brand-converse.svg'
              when 'brand-vans'
                assign brand_asset = 'brand-vans.svg'
              when 'brand-carhartt'
                assign brand_asset = 'brand-carhartt.svg'
              when 'brand-the-north-face'
                assign brand_asset = 'brand-thenorthface.svg'
              when 'brand-levis'
                assign brand_asset = 'brand-levis.svg'
              when 'brand-puma'
                assign brand_asset = 'brand-puma.svg'
            endcase
          %}
          <li class="lb-brands__item">
            <a class="lb-brand-card" href="{{ brand_collection.url }}" aria-label="شوف {{ brand_available_count }} من قطع {{ brand_collection.title | escape }} المتوفرة">
              <span class="lb-brand-card__media">
                {% if brand_asset != blank %}
                  <img src="{{ brand_asset | asset_url }}" alt="شعار {{ brand_collection.title | escape }}" loading="lazy" decoding="async" width="520" height="220">
                {% else %}
                  <bdi class="lb-brand-card__fallback" dir="ltr">{{ brand_collection.title }}</bdi>
                {% endif %}
              </span>
              <span class="lb-brand-card__body">
                <span class="lb-brand-card__copy">
                  <bdi class="lb-brand-card__title" dir="ltr">{{ brand_collection.title }}</bdi>
                  <span class="lb-brand-card__count">{{ brand_available_count }} قطعة متوفرة</span>
                </span>
                <span class="lb-brand-card__arrow" aria-hidden="true">←</span>
              </span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>

  <h2 style="font-size:clamp(24px,3vw,38px);margin:0 0 16px">الأقسام</h2>
  <div class="grid">
    {% for c in collections %}
      {% liquid
        assign lc_is_brand = false
        if lb_brand_handles contains c.handle or c.handle == 'nike' or c.handle == 'adidas-originals'
          assign lc_is_brand = true
        endif
      %}
      {% unless c.handle == 'frontpage' or lc_is_brand %}
        <a class="card" href="{{ c.url }}">
          {% if c.image %}
            <div class="card-img">
              <img src="{{ c.image | image_url: width: 500 }}" alt="{{ c.title | escape }}" loading="lazy" width="500" height="625">
            </div>
          {% endif %}
          <div class="card-body">
            <div class="card-title">{{ c.title }}</div>
            <div class="card-vendor">{{ c.products_count }} منتج</div>
            {% if c.description != blank %}<p style="margin-top:8px;font-size:13px;color:var(--txt2)">{{ c.description | strip_html | truncate: 100 }}</p>{% endif %}
          </div>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "{{ shop.url }}/collections#page",
  "name": "المتجر — Lbass Original",
  "description": "كل أقسام Lbass Original: حوايج براند أصلية second-hand فالمغرب، صور حقيقية، حالة ومخزون حسب كل منتج، وخلاص عند الاستلام حسب خيارات الطلب.",
  "url": "{{ shop.url }}/collections",
  "inLanguage": "ar-MA",
  "isPartOf": {"@id": "{{ shop.url }}/#website"},
  "about": {"@id": "{{ shop.url }}/#organization"}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "{{ shop.url }}/collections#list",
  "name": "أقسام Lbass Original",
  "itemListElement": [
    {%- assign lc_pos = 0 -%}
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' -%}
        {%- assign lc_pos = lc_pos | plus: 1 -%}
        {%- if lc_pos > 1 %},{% endif -%}
        {"@type": "ListItem", "position": {{ lc_pos }}, "url": "{{ shop.url }}{{ c.url }}", "name": {{ c.title | json }}}
      {%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "الرئيسية", "item": {{ shop.url | json }}},
    {"@type": "ListItem", "position": 2, "name": "المتجر"}
  ]
}
</script>
