{% paginate search.results by 24 %}
<div class="wrap">
  <div class="crumb"><a href="{{ routes.root_url }}">الرئيسية</a> › <span>البحث</span></div>

  {% if search.performed %}
    <h1>نتائج البحث: "{{ search.terms | escape }}"</h1>
    <p style="color:var(--txt2);margin:6px 0 18px">{{ search.results_count }} نتيجة</p>
  {% else %}
    <h1>قلّب على قطعتك</h1>
    <p style="color:var(--txt2);margin:6px 0 18px">قلّب بالبراند، النوع، القياس أو الحالة — أغلب القطع كتكون 1/1 حسب المخزون.</p>
  {% endif %}

  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:8px;max-width:560px;margin:0 0 24px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="قلّب: Nike, جاكيط, جينز…" aria-label="البحث"
      style="flex:1;padding:14px 16px;border-radius:12px;border:1px solid var(--line);background:var(--ink2);color:var(--cream);font-family:inherit;font-size:15px">
    <button type="submit" class="btn btn-c" style="font-family:inherit">قلّب</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <div style="border:1px solid var(--line);border-radius:14px;padding:22px;background:var(--ink2);max-width:640px">
        <h2 style="margin-top:0">ما لقينا والو على "{{ search.terms | escape }}"</h2>
        <p style="color:var(--txt2);margin:0 0 14px">جرّب كلمة أخرى، أو شوف الأقسام — التوفر كيتبدل حسب مخزون Shopify.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn btn-c" href="{{ routes.all_products_collection_url }}">شوف كل القطع</a>
          <a class="chip" href="/collections/nike">Nike</a>
          <a class="chip" href="/collections/adidas-originals">Adidas</a>
          <a class="chip" href="/pages/vault">✦ VAULT</a>
        </div>
      </div>
    {% else %}
      {%- comment -%} Same filter bar as the collection pages. Colour/Gender are
          path-tag filters and have no equivalent on /search, so they self-hide
          here; sort, availability, price, brand and size all work. {%- endcomment -%}
      {% render 'lbass-collection-filters', mode: 'search' %}

      <div class="grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% assign sv = item.selected_or_first_available_variant %}
            {% assign s_title = item.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first %}
            {% assign s_ticket = item.metafields.lbass.ticket_status.value | default: 'unknown' %}
            {% assign s_status = item.metafields.lbass.condition_status.value | default: 'unknown' %}
            {% assign s_inspection = item.metafields.lbass.inspection_status.value %}
            {% assign s_has_ticket = item.metafields.lbass.has_original_ticket.value %}
            {% assign s_notes = item.metafields.lbass.condition_notes.value %}
            {% assign s_defects = item.metafields.lbass.visible_defects.value %}
            {% assign s_condition = '' %}
            {% if s_inspection == 'inspected_confirmed' %}
              {% if s_has_ticket == true and s_status == 'new_with_ticket' %}
                {% if s_ticket == 'ticket_attached' or s_ticket == 'ticket_included' %}{% assign s_condition = 'جديد بالتّيكيت' %}{% endif %}
              {% elsif s_has_ticket == false and s_ticket == 'no_ticket' and s_status == 'new_without_ticket' %}
                {% assign s_condition = 'جديد بلا تيكيت' %}
              {% elsif s_has_ticket == false and s_ticket == 'no_ticket' and s_status == 'excellent_almost_new' %}
                {% assign s_condition = 'بحالة ممتازة · شبه جديد' %}
              {% elsif s_status == 'very_good' %}
                {% assign s_condition = 'بحالة مزيانة بزاف' %}
              {% elsif s_status == 'good' %}
                {% assign s_condition = 'بحالة مزيانة' %}
              {% elsif s_status == 'needs_note' %}
                {% if s_notes != blank or s_defects != blank %}{% assign s_condition = 'بحالة مزيانة · شوف الملاحظات' %}{% endif %}
              {% endif %}
            {% endif %}
            {% capture s_one_s %}{% render 'lbass-one-of-one', product: item %}{% endcapture %}{% assign s_one_s = s_one_s | strip %}{% assign s_one = false %}{% if s_one_s == '1' %}{% assign s_one = true %}{% endif %}
            <div class="lbqa-wrap">
            <a class="card" href="{{ item.url }}">
              <div class="card-img">
                {% if item.featured_image %}
                  <img src="{{ item.featured_image | image_url: width: 500 }}" alt="{{ item.featured_image.alt | default: s_title | escape }} — {% assign it_cs = item.metafields.lbass.condition_status.value %}{% if it_cs == 'new_with_ticket' or it_cs == 'new_without_ticket' %}new{% else %}second-hand{% endif %} original in Morocco, photographed by Lbass Original" loading="lazy" decoding="async" width="500" height="625">
                {% else %}
                  <span style="font-size:64px;opacity:.4">👕</span>
                {% endif %}
              </div>
              <div class="card-body">
                <div class="card-vendor">{{ item.vendor }}</div>
                <div class="card-title">{{ s_title }}</div>
                <div class="card-price">{{ item.price | money }}</div>
                <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">
                  {% unless item.has_only_default_variant %}<span class="chip chip-sz" style="font-size:11px;padding:3px 8px">{{ sv.title }}</span>{% endunless %}
                  <span class="chip" style="font-size:11px;padding:3px 8px">{{ s_condition }}</span>
                  {% if s_one %}<span class="chip lb-uniq" dir="auto">Pièce unique <i>· قطعة وحدة</i></span>{% elsif item.available %}<span class="chip" style="font-size:11px;padding:3px 8px;background:rgba(66,216,121,.12);border-color:rgba(66,216,121,.32);color:#37c97a">🟢 متوفرة دابا</span>{% else %}<span class="chip" style="font-size:11px;padding:3px 8px;background:rgba(255,107,107,.10);border-color:rgba(255,107,107,.30);color:#ff8a8a">مباعة</span>{% endif %}
                </div>
              </div>
            </a>
            {% render 'lbass-quick-add', product: item %}
            </div>
          {% else %}
            <a class="card" href="{{ item.url }}">
              <div class="card-body">
                <div class="card-vendor">صفحة</div>
                <div class="card-title">{{ item.title }}</div>
                {% if item.content %}<p style="margin-top:8px;font-size:13px;color:var(--txt2)">{{ item.content | strip_html | truncate: 110 }}</p>{% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div style="text-align:center;margin:30px 0;color:var(--txt2)">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endif %}
  {% else %}
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <a class="chip" href="/collections/nike">Nike</a>
      <a class="chip" href="/collections/adidas-originals">Adidas</a>
      <a class="chip" href="/collections/صبابط">صبابط</a>
      <a class="chip" href="/collections/جاكيطات-و-معاطف">جاكيطات</a>
      <a class="chip" href="/collections/جينز-مستعمل">جينز</a>
      <a class="chip" href="{{ routes.all_products_collection_url }}">كل القطع</a>
      <a class="chip" href="/pages/vault" style="border-color:rgba(200,154,14,.4);color:var(--gold)">✦ VAULT</a>
    </div>
  {% endif %}
</div>
{% endpaginate %}
