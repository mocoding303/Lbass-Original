<style>
:root{
  --line2:#34343B; --gold-dim:rgba(200,154,14,.14); --gold-br:rgba(200,154,14,.35);
  --clay:#B4502A; --clay2:#D4683E; --green2:#27C063;
  --r-sm:10px; --r-md:16px; --r-lg:24px;
  --tr:.28s cubic-bezier(.4,0,.2,1);
  --pad:clamp(18px,5vw,64px);
  --lt:'Space Grotesk','Tajawal',sans-serif;
}
.pdp-wrap{max-width:1320px;margin:0 auto;padding:clamp(20px,4vw,48px) var(--pad) 140px;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr);gap:clamp(24px,5vw,72px);align-items:start}
.pdp-crumb{grid-column:1/-1;display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;font-weight:700;color:var(--txt3);margin-bottom:4px;direction:rtl}
.pdp-crumb a{color:var(--txt2);font-weight:700}
.pdp-crumb a:hover{color:var(--gold)}
.pdp-crumb .sep{opacity:.5}
.pdp-crumb .cur{color:var(--txt)}
.pdp-gal{position:relative;align-self:start}
.pdp-main-viz{position:relative;height:clamp(420px,72vh,760px);border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;background:var(--ink2);cursor:zoom-in;touch-action:pan-y}
.pdp-main-viz img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:clamp(8px,1.4vw,18px);background:var(--ink2);transition:transform .35s cubic-bezier(.2,.7,.2,1);transform-origin:center center;will-change:transform}
@media (hover:hover) and (pointer:fine){
  .pdp-main-viz:hover img{transform:scale(1.85);padding:0}
}
.pdp-nav{position:absolute;top:50%;z-index:3;width:54px;height:54px;border-radius:50%;border:1px solid rgba(244,239,230,.34);background:linear-gradient(180deg,rgba(31,31,34,.92),rgba(10,10,11,.82));color:var(--cream);display:flex;align-items:center;justify-content:center;font-size:0;line-height:1;cursor:pointer;transform:translateY(-50%);transition:background .18s,border-color .18s,box-shadow .18s,transform .18s;box-shadow:0 14px 32px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.08);backdrop-filter:blur(10px);touch-action:manipulation;direction:ltr;unicode-bidi:isolate}
.pdp-nav::before{content:"";width:13px;height:13px;border-top:3px solid currentColor;border-right:3px solid currentColor;display:block}
.pdp-nav::after{content:"";position:absolute;inset:-10px;border-radius:50%}
.pdp-nav.prev{left:18px}
.pdp-nav.next{right:18px}
.pdp-nav.prev::before{transform:rotate(225deg)}
.pdp-nav.next::before{transform:rotate(45deg)}
.pdp-nav:hover,.pdp-nav:focus-visible{background:linear-gradient(180deg,var(--gold2),var(--gold));border-color:var(--gold);color:var(--ink);box-shadow:0 18px 42px rgba(200,154,14,.24),0 12px 28px rgba(0,0,0,.36);transform:translateY(-50%) scale(1.05);outline:none}
.pdp-nav:active{transform:translateY(-50%) scale(.96)}
.pdp-count{position:absolute;right:14px;bottom:14px;z-index:3;border:1px solid rgba(244,239,230,.26);border-radius:999px;background:rgba(10,10,11,.72);color:var(--cream);font-family:var(--lt);font-size:12px;font-weight:800;direction:ltr;padding:6px 11px}
.pdp-thumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:4px;scrollbar-width:none}
.pdp-thumbs::-webkit-scrollbar{display:none}
.pdp-thumb{padding:0;background:var(--ink2);border:2px solid var(--line);border-radius:var(--r-sm);overflow:hidden;cursor:pointer;aspect-ratio:4/5;transition:border-color .15s,transform .15s}
.pdp-thumb:hover{border-color:var(--gold2);transform:translateY(-2px)}
.pdp-thumb.on{border-color:var(--gold)}
.pdp-thumb{flex:0 0 clamp(70px,13vw,96px);scroll-snap-align:start}
.pdp-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.pdp-gal-note{display:flex;align-items:center;gap:10px;margin-top:12px;padding:11px 14px;border:1px dashed var(--line2);border-radius:var(--r-sm);font-size:13px;font-weight:700;color:var(--txt2);background:var(--ink2)}
.pdp-gal-note a{color:var(--green2);text-decoration:underline;white-space:nowrap}
.pdp-info-col{min-width:0;align-self:start}
.pdp-buy-panel{position:sticky;top:94px;z-index:4;margin-bottom:22px;padding:22px;border:1px solid var(--line2);border-radius:var(--r-lg);background:linear-gradient(180deg,#121214,#0A0A0B);box-shadow:0 24px 70px rgba(0,0,0,.34);isolation:isolate;overflow:hidden}
.pdp-buy-panel::before{content:"";display:block;height:3px;border-radius:999px;background:linear-gradient(90deg,var(--gold),transparent);margin:-2px 0 18px}
.pdp-brand{font-family:var(--lt);font-size:12px;font-weight:700;letter-spacing:.3em;color:var(--gold);text-transform:uppercase;direction:ltr;text-align:right;margin:0 0 8px}
.pdp-name{font-size:clamp(26px,3.6vw,40px);font-weight:900;color:var(--cream);line-height:1.18;margin:8px 0 14px}
.pdp-meta{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.pdp-grade{font-size:12px;font-weight:900;padding:7px 14px;border-radius:30px;background:var(--gold-dim);border:1px solid var(--gold-br);color:var(--gold2)}
.pdp-stock{font-size:12.5px;font-weight:800;color:var(--clay2)}
.pdp-price-wrap{margin-bottom:18px;padding-bottom:16px;border-bottom:1px solid var(--line)}
.pdp-price-kicker{margin:0 0 6px;color:var(--txt3);font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
/* Retail reference: deliberately NOT struck through, not red, not larger than
   the price. It states a fact about the model, not a discount. */
.pdp-retail{display:block;margin-top:5px}
.pdp-retail-m{display:block;font-size:13px;font-weight:800;color:var(--txt2);text-decoration:none}
.pdp-retail-s{display:block;font-size:11px;font-weight:700;color:var(--txt3);margin-top:1px}
.pdp-ship-line{margin:10px 0 0;font-size:12.5px;font-weight:700;color:var(--txt2);line-height:1.7}
.pdp-ship-line b{color:var(--cream)}
/* payment choice — neutral surface, no "recommended" badge on either option */
/* Arabic support line under the H1 — clearly secondary to the title, never a
   competing heading. */
.pdp-name-ar{margin:4px 0 0;font-size:15px;font-weight:700;color:var(--txt2);
  line-height:1.7;letter-spacing:normal}
/* Sold-out block: same information, calmer.
   The live block is .pdp-soldout (h2 + p + .pdp-block-actions) — NOT .pdp-sold,
   which is a leftover class that no longer renders. The h2 was inheriting the
   global heading scale, so "هاد القطعة تباعت" was set larger than the product
   title on a page where the next useful action is a RELATED product, not the
   sold-out notice. Scoped down here rather than touching the global h2 rule. */
.pdp-soldout{padding:14px 16px!important;margin:14px 0!important}
.pdp-soldout h2{font-size:15.5px!important;line-height:1.45!important;
  margin:0 0 5px!important;letter-spacing:normal!important}
.pdp-soldout p{font-size:13.2px!important;line-height:1.8!important;margin:0 0 11px!important}
.pdp-block-actions{display:flex;flex-wrap:wrap;gap:7px}
.pdp-block-actions a{font-size:12.5px!important;padding:7px 13px!important;
  border:1px solid var(--line);border-radius:30px;white-space:nowrap}
@media(max-width:520px){
  .pdp-name-ar{font-size:14px}
  .pdp-sold-h{font-size:14.5px!important}
}
.pdp-pay{margin:14px 0 0;padding:14px 16px;border:1px solid var(--line);border-radius:13px;
  background:rgba(255,255,255,.028)}
.pdp-pay-h{margin:0 0 6px;font-size:14px;font-weight:900;color:var(--cream)}
.pdp-pay-b{margin:0 0 9px;font-size:13.2px;line-height:1.85;color:var(--txt2)}
.pdp-pay-b b{color:var(--cream)}
.pdp-pay-note{display:block;margin-top:3px;font-size:12px;color:var(--txt3)}
.pdp-pay-link{font-size:12.8px;font-weight:800;color:var(--gold2);text-decoration:underline;
  text-underline-offset:3px}
.pdp-prices{display:flex;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:4px}
.pdp-price{font-family:var(--lt);font-weight:700;font-size:clamp(22px,3vw,30px);color:var(--gold);direction:ltr;white-space:nowrap;line-height:1.1}
.pdp-old{font-family:var(--lt);font-size:15px;color:var(--txt3);text-decoration:line-through;direction:ltr}
/* THE DISCOUNT. Was 11px in a pill at the end of the price row, which is
   smaller than the 15px strikethrough it is supposed to outrank and easy to
   miss entirely. Now a solid clay block on its own line above the price:
   second in the hierarchy behind the price itself, ahead of everything else.

   `display:inline-flex` would defeat the `hidden` attribute the size-switch
   handler toggles, so [hidden] is restated below. Without it, choosing a
   full-price size would leave an empty clay block on the page. */
.pdp-save{display:inline-flex;align-items:center;
  margin:0 0 9px;padding:7px 15px;border-radius:10px;
  background:var(--clay);color:#fff;
  font-family:var(--lt);font-weight:900;font-size:21px;line-height:1;
  letter-spacing:.01em;font-variant-numeric:tabular-nums;direction:ltr}
.pdp-save[hidden]{display:none}
/* The dirham saving. Clay, matching the .pdp-save pill, so the two read as one
   statement; smaller than both prices so it never competes with the number the
   customer actually pays. */
.pdp-saved{margin:4px 0 0;font-size:14px;font-weight:900;color:var(--clay);text-align:start;letter-spacing:.01em}
.pdp-saved [dir=ltr]{font-variant-numeric:tabular-nums}
/* Mobile keeps the discount large. It shrinks less than the price does
   (21 -> 19 against 30 -> 22), because a phone is where it has to be caught in
   about a second and where the price row is narrowest. */
@media(max-width:600px){
  .pdp-save{font-size:19px;padding:6px 13px;margin-bottom:8px}
  .pdp-old{font-size:14px}
  .pdp-saved{font-size:13.5px}
}
.pdp-price-helper{margin:6px 0 0;color:var(--txt3);font-size:12px;font-weight:750;line-height:1.65}
.pdp-price-helper strong{color:var(--txt2)}
.pdp-condition-card{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0 0 18px}
.pdp-mini{border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.035);padding:12px}
