    {% if product.available and condition_confirmed %}
    <form id="pdpForm" action="{{ routes.cart_add_url }}" method="post" novalidate>
      {% unless product.has_only_default_variant %}
        <p class="pdp-lbl">اختار القياس <button type="button" data-szguide style="background:none;border:0;font-size:12px;color:var(--gold);font-weight:700;text-decoration:underline;cursor:pointer">دليل القياسات</button></p>
        <div class="pdp-selected"><span>القياس المختار</span><b id="pdpSelectedSize">مازال ما تختارش</b></div>
        <div class="pdp-sizes" id="pdpSizes" role="group" aria-label="اختيار القياس">
          {% for variant in product.variants %}
            {%- comment -%}
              Each size carries its OWN compare-at, percentage and saving.
              Before 2026-09-10 only data-price was carried, so switching size
              repriced the headline and left the struck price, the percentage
              and the saving showing the previous variant's numbers. Latent
              while every product is one-of-one; wrong the moment one is not.
            {%- endcomment -%}
            {%- capture vpct %}{% render 'lbass-sale', product: product, variant: variant %}{% endcapture -%}
            {%- assign vpct = vpct | strip -%}
            {%- assign vsale = false -%}
            {%- if variant.compare_at_price and variant.compare_at_price > variant.price -%}{%- assign vsale = true -%}{%- endif -%}
            <button class="sz" type="button" data-vid="{{ variant.id }}" data-price="{{ variant.price | money }}" data-title="{{ variant.title | escape }}"
              data-cap="{% if vsale %}{{ variant.compare_at_price | money }}{% endif %}"
              data-pct="{% if vsale %}&minus;{{ vpct }}%{% endif %}"
              data-save="{% if vsale %}{{ variant.compare_at_price | minus: variant.price | money }}{% endif %}"
              {% unless variant.available %}disabled aria-disabled="true"{% endunless %} aria-pressed="false">{{ variant.title }}</button>
          {% endfor %}
        </div>
        <input type="hidden" name="id" id="pdpVariantId" value="">
      {% else %}
        <input type="hidden" name="id" id="pdpVariantId" value="{{ product.variants.first.id }}">
        <div class="pdp-selected"><span>القياس</span><b id="pdpSelectedSize">{% if product.variants.first.title == 'Default Title' %}One Size{% else %}{{ product.variants.first.title }}{% endif %}</b></div>
