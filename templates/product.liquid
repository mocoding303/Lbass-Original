  <a class="pdp-sticky-wa" href="https://wa.me/{{ wa_number }}?text={{ wa_msg_buy }}" target="_blank" rel="noopener" data-cro-event="whatsapp_click" data-cro-label="pdp_mobile_sticky" aria-label="سولنا فـ WhatsApp على {{ display_title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.04 2a9.84 9.84 0 0 0-8.4 14.96L2.2 22l5.17-1.36A9.9 9.9 0 1 0 12.04 2Zm0 17.98a8.03 8.03 0 0 1-4.1-1.12l-.3-.18-3.07.81.82-2.99-.2-.31a8.06 8.06 0 1 1 6.85 3.79Zm4.42-6.03c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2a7.28 7.28 0 0 1-1.34-1.67c-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"/></svg></a>
