    {% endif %}

    <div class="ptrust-passport" aria-label="Product Trust Passport">
      <div class="tp-title">
        <span class="tp-title-main"><img class="tp-seal" src="{{ 'lbass-authenticity-seal.svg' | asset_url }}" alt="" width="240" height="240">Trust Passport</span>
