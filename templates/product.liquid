<!-- product lightbox — no width/height attributes on the image, see .zoomlb CSS -->
<div class="zoomlb" id="zoomlb" role="dialog" aria-modal="true" aria-label="صور المنتج" aria-hidden="true">
  <button type="button" class="x" id="zoomX" aria-label="سدّ الصور">✕</button>
  <button type="button" class="zoomlb__nav zoomlb__nav--prev" data-lb-prev aria-label="الصورة السابقة" hidden>‹</button>
  <figure class="zoomlb__stage">
    {%- comment -%}
      theme-check ImgWidthAndHeight is disabled for this one tag on purpose.
      The rule prevents layout shift by pinning intrinsic size — but ONE element
      here displays every product photo in turn, and they do not share a ratio.
      Hardcoding 1200x1500 is exactly what distorted every non-4:5 image before.
      There is no CLS to prevent either: the modal is display:none until opened.
      Correct per-image width/height are set from data-w/data-h in JS instead.
    {%- endcomment -%}
    {% # theme-check-disable ImgWidthAndHeight %}
    <img class="zoomlb__img" id="zoomImg" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" decoding="async">
    {% # theme-check-enable ImgWidthAndHeight %}
  </figure>
  <button type="button" class="zoomlb__nav zoomlb__nav--next" data-lb-next aria-label="الصورة الموالية" hidden>›</button>
  <p class="zoomlb__count" id="zoomCount" aria-live="polite" hidden></p>
</div>

{% assign schema_sku = selv.sku %}
{% if schema_sku == blank and product.metafields.lbass.product_code.value != blank %}{% assign schema_sku = product.metafields.lbass.product_code.value %}{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ display_title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  {% if schema_sku != blank %}"sku": {{ schema_sku | json }},{% endif %}
  "productID": "shopify:{{ product.id }}",
  "description": {{ product_summary | strip | json }},
  "image": [{% for image in product.images %}"https:{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
  "category": {{ product.type | default: product.product_type | default: 'Apparel' | json }},
  "brand": {"@type": "Brand", "name": {{ product.vendor | json }}},
  {% if condition_confirmed %}"itemCondition": "{% if is_new_condition %}https://schema.org/NewCondition{% else %}https://schema.org/UsedCondition{% endif %}",{% endif %}
  {% if color_note != blank %}"color": {{ color_note | json }},{% endif %}
  {% if material_note != blank %}"material": {{ material_note | json }},{% endif %}
  {% if product.metafields.lbass.label_size.value != blank %}"size": {{ product.metafields.lbass.label_size.value | json }},{% elsif selv.title != 'Default Title' %}"size": {{ selv.title | json }},{% endif %}
  "additionalProperty": [
    {%- comment -%}
      NEW vs SECOND-HAND (re-applied 2026-08-22). This asserted "second-hand"
      unconditionally; for a new-with-tags item that is a false statement in
      structured data. is_new_condition already drives itemCondition — it now
      drives the wording too.
    {%- endcomment -%}
    {"@type": "PropertyValue", "name": "Photos", "value": "{% if is_new_condition %}Photos show the exact item offered for sale{% else %}Photos show the exact second-hand item offered for sale{% endif %}"}
    {% if is_one_of_one %},{"@type": "PropertyValue", "name": "Inventory status", "value": "One-of-one item; one unit is currently offered"}{% endif %}
    {% if condition_confirmed %},{"@type": "PropertyValue", "name": "Condition grade", "value": {{ condition_label | json }}}{% endif %}
    {% if ticket_confirmed %},{"@type": "PropertyValue", "name": "Original retail ticket", "value": {{ ticket_status | json }}}{% endif %}
    {% if fit_note != blank %},{"@type": "PropertyValue", "name": "Fit guidance", "value": {{ fit_note | json }}}{% endif %}
    {% if measurement_note != blank %},{"@type": "PropertyValue", "name": "Measurements", "value": {{ measurement_note | json }}}{% endif %}
    {% if flaw_note != blank %},{"@type": "PropertyValue", "name": "Visible defects", "value": {{ flaw_note | json }}}{% endif %}
    {% if condition_notes != blank %},{"@type": "PropertyValue", "name": "Inspection notes", "value": {{ condition_notes | strip_newlines | json }}}{% endif %}
    {% if product.metafields.lbass.meas_length != blank %},{"@type": "PropertyValue", "name": "Length", "value": "{{ product.metafields.lbass.meas_length }} cm"}{% endif %}
    {% if product.metafields.lbass.meas_chest != blank %},{"@type": "PropertyValue", "name": "Chest", "value": "{{ product.metafields.lbass.meas_chest }} cm"}{% endif %}
    {% if product.metafields.lbass.meas_waist != blank %},{"@type": "PropertyValue", "name": "Waist", "value": "{{ product.metafields.lbass.meas_waist }} cm"}{% endif %}
    {% if product.metafields.lbass.meas_sleeve != blank %},{"@type": "PropertyValue", "name": "Sleeve", "value": "{{ product.metafields.lbass.meas_sleeve }} cm"}{% endif %}
    {% if product.metafields.lbass.meas_inseam != blank %},{"@type": "PropertyValue", "name": "Inseam", "value": "{{ product.metafields.lbass.meas_inseam }} cm"}{% endif %}
    {% if product.metafields.lbass.meas_insole != blank %},{"@type": "PropertyValue", "name": "Insole", "value": "{{ product.metafields.lbass.meas_insole }} cm"}{% endif %}
  ],
  {%- comment -%}
    ═══ AGGREGATE RATING — re-applied 2026-08-19, GATED ON REAL REVIEWS ═══
    Originally added 2026-08-10; lost when this branch forked before that push.
    Same pattern the shipping block above records.

    Placed BEFORE "offers" with a trailing comma: "additionalProperty" always
    renders above and "offers" always renders below, so both commas are safe.

    WHY IT MATTERS: the theme hand-builds its own Product node. Judge.me is
    installed and renders its widget, but this schema had NO rating field — so
    reviews could be collected forever and never become stars in search.

    THE GATE IS THE POINT. Reads the Shopify-standard `reviews` metafields that
    Judge.me syncs and emits NOTHING until rating_count > 0. Report §14: "Do not
    add AggregateRating. You have one order and no reviews — there is nothing
    truthful to declare, and fabricated ratings are a manual-action risk."
    Never replace the gate with a default value.
  {%- endcomment -%}
  {%- assign rating_obj = product.metafields.reviews.rating.value -%}
  {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
  {%- if rating_count > 0 and rating_obj != blank and rating_obj.rating != blank -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating_obj.rating }},
    "reviewCount": {{ rating_count }},
    "bestRating": {{ rating_obj.scale_max | default: 5 }},
    "worstRating": {{ rating_obj.scale_min | default: 1 }}
  },
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ shop.currency | json }},
    "price": {{ selv.price | divided_by: 100.0 | json }},
    "availability": "{% if selv.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"{% if condition_confirmed %},
    "itemCondition": "{% if is_new_condition %}https://schema.org/NewCondition{% else %}https://schema.org/UsedCondition{% endif %}"{% endif %},
    "inventoryLevel": {"@type": "QuantitativeValue", "value": {{ selv.inventory_quantity | at_least: 0 }}}{% if is_one_of_one %},
    "eligibleQuantity": {"@type": "QuantitativeValue", "value": 1, "unitText": "One-of-One"}{% endif %},
    {%- comment -%}
      MERCHANT LISTING SHIPPING (re-added 2026-08-09).
      Lost when this branch forked before the shipping work; re-applied onto the
      newer offers block rather than overwriting it.

      Declares 40 MAD deliberately — the HIGHER of the two Morocco rates
      (Marrakech 20 / elsewhere 40). Google shows one figure, and under-promising
      means a Marrakech buyer is never charged more than advertised. Free over
      500 MAD depends on CART TOTAL, which a per-product offer cannot express.

      deliveryTime is omitted on purpose: /pages/shipping-and-payment states the
      duration varies by city and courier, so no transit figure is verified.
    {%- endcomment -%}
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {"@type": "MonetaryAmount", "value": "40", "currency": "MAD"},
      "shippingDestination": {"@type": "DefinedRegion", "addressCountry": "MA"},
      "shippingSettingsLink": "{{ shop.url }}/pages/shipping-and-payment",
      "description": "Delivery from Marrakech: 20 MAD within Marrakech, 40 MAD elsewhere in Morocco, free for orders of 500 MAD or more. Cash on delivery available."
    },
    "seller": {"@id": "{{ shop.url }}/#store"}
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "الرئيسية", "item": {{ shop.url | json }}}{% if first_collection %},
    {"@type": "ListItem", "position": 2, "name": {{ first_collection.title | json }}, "item": "{{ shop.url }}{{ first_collection.url }}"},
    {"@type": "ListItem", "position": 3, "name": {{ display_title | json }}}{% else %},
    {"@type": "ListItem", "position": 2, "name": {{ display_title | json }}}{% endif %}
  ]
}
</script>
{% comment %}
  ═══ LEGACY STORE-LEVEL FAQPage — REMOVED 2026-08-10 ═══

  A second FAQPage block used to sit here with five questions hardcoded in this
  file ("واش الصور ديال نفس القطعة…", "شنو معنى 1/1؟", "Où acheter…" and two more).
  Measured on the live storefront before removal:

      /products/adidas-track-pants-black-red   → 2 FAQPage blocks, 5 questions each
      /products/lbass-p004-adidas-black-crossbody-bag → 1 FAQPage block (this one)

      all five questions:  present in JSON-LD, NOT present in the rendered page

  Two defects, one cause:
    1. On products carrying lbass.faq it duplicated the per-item block below,
       and Google may discard both when a URL declares FAQPage twice.
    2. On products WITHOUT lbass.faq it was the only FAQPage — and since its
       questions never render, it described content that does not exist. Same
       visible-Q&A violation already documented and fixed in the block below.

  The per-item block (search "PER-ITEM FAQ SCHEMA") is the single source now. It
  is gated on lbass.faq having >= 2 entries AND condition_confirmed, so products
  without a real, visible FAQ correctly emit no FAQPage at all.

  Do not reinstate a store-level FAQ here. If these general questions should
  carry schema, they belong on /pages/faq — which already has them, visible,
  driven by that page's lbass.faq metafield via snippets/lbass-page-faq-schema.
{% endcomment %}

<script>
(function(){
  function stripProductCodes(root){
    if (!root) return;
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: function(node){
        return node.nodeValue && /LBO-[A-Z0-9-]+/i.test(node.nodeValue)
          ? NodeFilter.FILTER_ACCEPT
          : NodeFilter.FILTER_REJECT;
      }
    });
    var nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(function(node){
      node.nodeValue = node.nodeValue
        .replace(/\s*[—–-]\s*LBO-[A-Z0-9-]+/gi, '')
        .replace(/(?:Product\s*code|Code produit|الكود)\s*:?\s*LBO-[A-Z0-9-]+/gi, '')
        .replace(/\bLBO-[A-Z0-9-]+\b/gi, '')
        .replace(/\s{2,}/g, ' ')
        .trim();
    });
  }
  stripProductCodes(document.body);

  var main = document.getElementById('pdpMainImg');
  var viz  = document.getElementById('pdpMainViz');
  var lb   = document.getElementById('zoomlb');
  var lbI  = document.getElementById('zoomImg');

  var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-pdp-thumb]'));
  var count = document.getElementById('pdpImgCount');
  var currentImage = 0;

  function setGalleryImage(index){
    if (!thumbs.length || !main) return;
    currentImage = (index + thumbs.length) % thumbs.length;
    var btn = thumbs[currentImage];
    var src = btn.dataset.src;
    var zoom = btn.dataset.zoom;
    var alt = btn.dataset.alt;
    if (src) main.src = src;
    if (alt) main.alt = alt;
    if (viz && zoom) viz.dataset.zoom = zoom;
    thumbs.forEach(function(b, i){
      var active = i === currentImage;
      b.classList.toggle('on', active);
      b.setAttribute('aria-current', active ? 'true' : 'false');
    });
    if (count) count.textContent = (currentImage + 1) + ' / ' + thumbs.length;
    btn.scrollIntoView({block:'nearest', inline:'nearest'});
  }

  thumbs.forEach(function(btn){
    btn.addEventListener('click', function(){
      setGalleryImage(Number(btn.dataset.index || 0));
    });
  });
  document.querySelector('[data-pdp-prev]')?.addEventListener('click', function(e){
    e.stopPropagation();
    setGalleryImage(currentImage - 1);
  });
  document.querySelector('[data-pdp-next]')?.addEventListener('click', function(e){
    e.stopPropagation();
    setGalleryImage(currentImage + 1);
  });
  if (viz && thumbs.length > 1){
    var touchStartX = 0;
    var touchStartY = 0;
    viz.addEventListener('touchstart', function(e){
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, {passive:true});
    viz.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - touchStartX;
      var dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4){
        setGalleryImage(currentImage + (dx < 0 ? 1 : -1));
      }
    }, {passive:true});
  }

  // hover-zoom: pan the scaled image toward cursor (desktop only)
  var canHover = window.matchMedia('(hover:hover) and (pointer:fine)').matches;
  if (canHover && viz && main){
    viz.addEventListener('mousemove', function(e){
      var r = viz.getBoundingClientRect();
      var x = ((e.clientX - r.left) / r.width)  * 100;
      var y = ((e.clientY - r.top)  / r.height) * 100;
      main.style.transformOrigin = x + '% ' + y + '%';
    });
    viz.addEventListener('mouseleave', function(){ main.style.transformOrigin = ''; });
  }

  /* ═══ PRODUCT LIGHTBOX ═══ rebuilt 2026-08-10
     Was: a single-image viewer that read viz.dataset.zoom, so there was no way
     to move between photos once open. Now a real gallery — every product image,
     opened at the one the customer clicked, with arrows, swipe, keys, counter. */
  var lbCount = document.getElementById('zoomCount');
  var lbPrevB = lb ? lb.querySelector('[data-lb-prev]') : null;
  var lbNextB = lb ? lb.querySelector('[data-lb-next]') : null;
  var lbIndex = 0, lbIsOpen = false, lbScrollY = 0, lbLastFocus = null;

  /* Thumbs exist only when the product has >1 image, so single-image products
     fall back to the main image. Both cases must work. */
  var lbSlides = thumbs.length
    ? thumbs.map(function(b){ return { src: b.dataset.zoom || b.dataset.src, alt: b.dataset.alt || '', w: b.dataset.w, h: b.dataset.h }; })
    : (viz && viz.dataset.zoom ? [{ src: viz.dataset.zoom, alt: (main && main.alt) || '', w: viz.dataset.zoomW, h: viz.dataset.zoomH }] : []);

  function lbPreload(i){
    if (lbSlides.length < 2) return;
    var s = lbSlides[(i + lbSlides.length) % lbSlides.length];
    if (s && s.src){ var im = new Image(); im.src = s.src; }
  }

  function lbShow(i){
    if (!lbSlides.length || !lbI) return;
    lbIndex = (i + lbSlides.length) % lbSlides.length;
    var s = lbSlides[lbIndex];
    /* Real dimensions per image — a correct ratio hint instead of a fixed lie.
       Set before src so the browser reserves the right box immediately. */
    if (s.w && s.h){ lbI.width = s.w; lbI.height = s.h; }
    else { lbI.removeAttribute('width'); lbI.removeAttribute('height'); }
    lbI.src = s.src;
    lbI.alt = s.alt;
    var multi = lbSlides.length > 1;
    if (lbCount){ lbCount.textContent = (lbIndex + 1) + ' / ' + lbSlides.length; lbCount.hidden = !multi; }
    if (lbPrevB) lbPrevB.hidden = !multi;
    if (lbNextB) lbNextB.hidden = !multi;
    if (multi){ lbPreload(lbIndex + 1); lbPreload(lbIndex - 1); }
  }

  function openZoom(i){
    if (!lb || !lbSlides.length) return;
    lbLastFocus = document.activeElement;
    lbScrollY = window.scrollY || window.pageYOffset || 0;
    lbShow(typeof i === 'number' ? i : currentImage);
    lb.classList.add('show');
    lb.setAttribute('aria-hidden', 'false');
    lbIsOpen = true;
    /* Position-fixed lock, not just overflow:hidden — iOS Safari keeps scrolling
       the body behind an overlay otherwise. Scroll position restored on close. */
    document.body.style.position = 'fixed';
    document.body.style.top = (-lbScrollY) + 'px';
    document.body.style.insetInlineStart = '0';
    document.body.style.width = '100%';
    document.body.style.overflow = 'hidden';
    var closeBtn = document.getElementById('zoomX');
    if (closeBtn) closeBtn.focus();
  }

  function closeZoom(){
    if (!lb || !lbIsOpen) return;
    lb.classList.remove('show');
    lb.setAttribute('aria-hidden', 'true');
    lbIsOpen = false;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.insetInlineStart = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
    window.scrollTo(0, lbScrollY);
    /* Leave the inline gallery on whatever photo they ended on. */
    if (thumbs.length && lbIndex !== currentImage) setGalleryImage(lbIndex);
    if (lbLastFocus && lbLastFocus.focus) lbLastFocus.focus();
  }

  viz?.addEventListener('click', function(){ openZoom(currentImage); });
  viz?.addEventListener('keydown', function(e){
    if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openZoom(currentImage); }
    if (thumbs.length > 1 && e.key === 'ArrowLeft'){ e.preventDefault(); setGalleryImage(currentImage - 1); }
    if (thumbs.length > 1 && e.key === 'ArrowRight'){ e.preventDefault(); setGalleryImage(currentImage + 1); }
  });

  document.getElementById('zoomX')?.addEventListener('click', function(e){ e.stopPropagation(); closeZoom(); });
  lbPrevB?.addEventListener('click', function(e){ e.stopPropagation(); lbShow(lbIndex - 1); });
  lbNextB?.addEventListener('click', function(e){ e.stopPropagation(); lbShow(lbIndex + 1); });

  /* Backdrop / letterbox area closes; the photo and controls do not. */
  lb?.addEventListener('click', function(e){
    if (e.target === lb || e.target.classList.contains('zoomlb__stage')) closeZoom();
  });

  document.addEventListener('keydown', function(e){
    if (!lbIsOpen) return;
    if (e.key === 'Escape'){ e.preventDefault(); closeZoom(); }
    else if (e.key === 'ArrowLeft'){ e.preventDefault(); lbShow(lbIndex - 1); }
    else if (e.key === 'ArrowRight'){ e.preventDefault(); lbShow(lbIndex + 1); }
    else if (e.key === 'Tab'){
      /* Keep focus inside the dialog. */
      var f = [document.getElementById('zoomX'), lbPrevB, lbNextB].filter(function(el){ return el && !el.hidden; });
      if (!f.length) return;
      var i = f.indexOf(document.activeElement);
      e.preventDefault();
      f[(i + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
    }
  });

  if (lb){
    var lbX = 0, lbY = 0, lbT = 0;
    lb.addEventListener('touchstart', function(e){
      lbX = e.touches[0].clientX; lbY = e.touches[0].clientY; lbT = Date.now();
    }, {passive:true});
    lb.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - lbX;
      var dy = e.changedTouches[0].clientY - lbY;
      var dt = Date.now() - lbT;
      if (lbSlides.length > 1 && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2 && dt < 700){
        lbShow(lbIndex + (dx < 0 ? 1 : -1));
      } else if (Math.abs(dy) > 110 && Math.abs(dy) > Math.abs(dx) * 1.3){
        closeZoom();
      }
    }, {passive:true});
  }

  // size selection
  var vidInput = document.getElementById('pdpVariantId');
  var priceEl  = document.querySelector('[data-price]');
  var priceMob = document.querySelector('[data-price-mobile]');
  var oldEl    = document.querySelector('[data-old]');
  var pctEl    = document.querySelector('[data-savepct]');
  var savedEl  = document.querySelector('[data-saved]');
  var saveSum  = document.querySelector('[data-savesum]');

  // Repricing the headline without repricing the strikethrough, the percentage
  // and the saving leaves three elements describing the PREVIOUS variant, which
  // is a false discount claim on the page. All four move together or none do.
  function applySale(d){
    var on = !!(d && d.cap);
    if (oldEl)   { oldEl.textContent   = on ? d.cap  : ''; oldEl.hidden   = !on; }
    if (pctEl)   { pctEl.textContent   = on ? d.pct  : ''; pctEl.hidden   = !on; }
    if (saveSum) { saveSum.textContent = on ? d.save : ''; }
    if (savedEl) { savedEl.hidden = !on; }
  }
  var sizeMob  = document.getElementById('pdpStickySize');
  var selectedSize = document.getElementById('pdpSelectedSize');
  var addBtn = document.getElementById('pdpAdd');
  var stickyAdd = document.getElementById('pdpStickyAdd');
  var sizeErr = document.getElementById('pdpSizeErr');
  document.querySelectorAll('#pdpSizes .sz').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (btn.hasAttribute('disabled')) return;
      document.querySelectorAll('#pdpSizes .sz').forEach(function(b){ b.classList.remove('on'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('on'); btn.setAttribute('aria-pressed','true');
      if (vidInput) vidInput.value = btn.dataset.vid;
      if (priceEl  && btn.dataset.price) priceEl.textContent  = btn.dataset.price;
      if (priceMob && btn.dataset.price) priceMob.textContent = btn.dataset.price;
      applySale(btn.dataset);
      if (sizeMob) sizeMob.textContent = 'القياس ' + btn.textContent.trim();
      if (selectedSize) selectedSize.textContent = btn.dataset.title || btn.textContent.trim();
      if (addBtn){ addBtn.disabled = false; addBtn.textContent = 'زيد للسلة'; addBtn.dataset.idleLabel = 'زيد للسلة'; }
      if (stickyAdd){ stickyAdd.disabled = false; stickyAdd.textContent = 'زيد للسلة'; stickyAdd.dataset.idleLabel = 'زيد للسلة'; }
      if (sizeErr) sizeErr.classList.remove('show');
    });
  });

  // Auto-select when there is only one size to choose (added 2026-08-31).
  // Stock here is one-of-one, so `product.has_only_default_variant` is false
  // (the products DO have a Size option, with a single value) and the Liquid
  // rendered the primary CTA `disabled` with the label "اختار القياس أولاً".
  // GA4 showed the cost: the most-viewed product had 37 views and 0 add-to-carts,
  // and 7 of the top 10 viewed items had zero. Reuses the chip click handler
  // above so the hidden variant id, price, labels and both CTAs stay in sync.
  // Multi-size products keep the manual gate untouched.
  (function(){
    var choosable = document.querySelectorAll('#pdpSizes .sz:not([disabled])');
    if (choosable.length === 1) choosable[0].click();
  })();

  function currentVaultAttribution(){
    try {
      var value = JSON.parse(sessionStorage.getItem('lbass_vault_attribution_v1') || 'null');
      if (!value || !value.ts || (Date.now() - value.ts) > 86400000) return null;
      return value;
    } catch(e){ return null; }
  }
  function persistVaultCart(vault){
    if (!vault) return;
    var rootUrl = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    fetch(rootUrl + 'cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ attributes: { '__lbass_vault_source': vault.source || 'vault', '__lbass_vault_category': vault.category || 'unknown', '__lbass_vault_touch': vault.touch || 'product' } }),
      keepalive: true
    }).catch(function(){});
  }
  function publishVault(name, params){
    try { if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') Shopify.analytics.publish(name, params); } catch(e){}
  }

  document.getElementById('pdpForm')?.addEventListener('submit', function(e){
    var idInput = this.querySelector('[name="id"]');
    if (idInput && !idInput.value){
      e.preventDefault();
      e.stopImmediatePropagation();
      if (sizeErr) sizeErr.classList.add('show');
      document.getElementById('pdpSizes')?.scrollIntoView({block:'center', behavior:'smooth'});
    }
  }, true);
  document.getElementById('pdpForm')?.addEventListener('submit', function(e){
    if (e.defaultPrevented) return;
    var idInput = this.querySelector('[name="id"]');
    if (!idInput || !idInput.value) return;
    var vault = currentVaultAttribution();
    if (!vault) return;
    var params = { currency: 'MAD', value: {{ product.price | divided_by: 100.0 | json }}, items_count: 1, source: vault.source || 'vault', category: vault.category || 'unknown', product_id: {{ product.id | json }}, product_name: {{ display_title | json }} };
    persistVaultCart(vault);
    publishVault('lbass_vault_add_to_cart', params);
  });

  // mobile sticky add — submits the form
  document.getElementById('pdpStickyAdd')?.addEventListener('click', function(){
    var form = document.getElementById('pdpForm');
    if (!form) return;
    form._lbassTrigger = this;
    form.requestSubmit();
  });

  document.querySelectorAll('[data-pdp-desc-add],[data-promo-add]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var form = document.getElementById('pdpForm');
      if (!form) return;
      form._lbassTrigger = btn;
      if (typeof form.requestSubmit === 'function') form.requestSubmit();
      else form.submit();
    });
  });

  // hide sticky bar while main CTA is in viewport
  var sticky = document.getElementById('pdpSticky');
  if ('IntersectionObserver' in window && addBtn && sticky){
    new IntersectionObserver(function(es){
      var tucked = es[0].isIntersecting;
      sticky.classList.toggle('tuck', tucked);
      sticky.setAttribute('aria-hidden', tucked ? 'true' : 'false');
      if ('inert' in sticky) sticky.inert = tucked;
    }, {threshold:.05}).observe(addBtn);
  }

  // ── Express COD order: validate, then send to Shopify checkout with address prefilled ──
  var xForm = document.getElementById('pdpExpressForm');
  if (xForm){
    xForm.addEventListener('submit', function(e){
      e.preventDefault();
      var err = document.getElementById('pdpxErr');
      var name = xForm.xname.value.trim();
      var phone = xForm.xphone.value.replace(/[\s.-]/g, '');
      var city = xForm.xcity.value.trim();
      var vid = document.getElementById('pdpVariantId')?.value;
      xForm.querySelectorAll('.pdpx-in').forEach(function(i){ i.classList.remove('bad'); });
      function fail(msg, field){
        err.textContent = msg; err.hidden = false;
        if (field){ field.classList.add('bad'); field.focus(); }
      }
      if (!vid){
        var se = document.getElementById('pdpSizeErr'); if (se) se.classList.add('show');
        document.getElementById('pdpSizes')?.scrollIntoView({behavior:'smooth', block:'center'});
        fail('اختار القياس أولاً من الفوق.', null); return;
      }
      if (name.length < 3) return fail('كتب الاسم الكامل ديالك.', xForm.xname);
      if (!/^(?:\+212[5-7]\d{8}|0[5-7]\d{8})$/.test(phone)) return fail('كتب رقم هاتف مغربي صحيح — كيبدا بـ 06 أو 07 (10 أرقام).', xForm.xphone);
      if (city.length < 2) return fail('كتب المدينة ديالك.', xForm.xcity);
      err.hidden = true;
      var parts = name.split(/\s+/);
      var first = parts.shift();
      var last = parts.join(' ') || first;
      var qs = 'checkout[shipping_address][first_name]=' + encodeURIComponent(first)
        + '&checkout[shipping_address][last_name]=' + encodeURIComponent(last)
        + '&checkout[shipping_address][phone]=' + encodeURIComponent(phone)
        + '&checkout[shipping_address][city]=' + encodeURIComponent(city)
        + '&checkout[shipping_address][country]=Morocco';
      try {
        if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') Shopify.analytics.publish('lbass_express_checkout', { city: city });
        var vault = currentVaultAttribution();
        if (vault){
          var vaultParams = { channel: 'express_cod', payment_hint: 'cod', source: vault.source || 'vault', category: vault.category || 'unknown', product_id: {{ product.id | json }}, product_name: {{ display_title | json }} };
          persistVaultCart(vault);
          publishVault('lbass_vault_cod_checkout_start', vaultParams);
        }
      } catch(e2){}
      
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'InitiateCheckout', {
            content_ids: [{{ product.id | json }}],
            content_type: 'product',
            value: {{ product.price | divided_by: 100.0 | json }},
            currency: 'MAD',
            num_items: 1
          });
        }
      window.location.href = '/cart/' + vid + ':1?' + qs;
    });
  }

  // size guide button (placeholder — opens WhatsApp for now)
  document.querySelector('[data-szguide]')?.addEventListener('click', function(){
    window.open('https://wa.me/{{ wa_number }}?text={{ wa_msg_fit }}', '_blank', 'noopener');
  });
  document.addEventListener('click', function(e){
    var lookAll = e.target.closest('#lookAddAll');
    if (!lookAll) return;
    var idInput = document.querySelector('#pdpForm [name="id"]');
    if (idInput && !idInput.value){
      e.preventDefault();
      e.stopImmediatePropagation();
      if (sizeErr) sizeErr.classList.add('show');
      document.getElementById('pdpSizes')?.scrollIntoView({block:'center', behavior:'smooth'});
    }
  }, true);
})();
</script>

{% comment %}
  ═══ PER-ITEM FAQ SCHEMA ═══ rewritten 2026-08-05

  SOURCE IS NOW lbass.faq ONLY, and that is a correctness fix, not a preference.

  This block used to build FAQPage from four metafields — inspection_notes,
  fits_for/fits_against, styling and occasion — pairing each with a question
  string written *inside this file*. The ANSWERS render on the page, but the
  QUESTIONS never did. Measured on the live PDP 2026-08-05, searching the
  rendered innerText for each of the four:

      "شنو شيّكتو فهاد القطعة قبل ما تعرضوها؟"   → not present
      "واش هاد القطعة كتناسبني؟"                → not present
      "كيفاش تنسق هاد القطعة؟"                  → not present
      "فاش تلبس هاد القطعة؟"                    → not present

  The visible accordions are labelled "الحالة بصراحة", "القياسات والفِت" and so
  on. Google requires the full question AND answer to be visible on the page,
  so that markup described content that did not exist in that form — the exact
  mismatch this project refuses everywhere else. Removed.

  lbass.faq (json, list of {q,a}) is rendered as visible <details> blocks inside
  the product description, so schema and page now agree one-for-one. Verified
  on this product: 5 in schema, the same 5 visible verbatim.

  The four metafields still render in the accordions — nothing was hidden or
  deleted. They simply stopped claiming to be a FAQ.

  Do NOT generate FAQ schema from the .acc accordions: they are section labels,
  identical on all 40 products, and the first is a checkout CTA.

  To give another product a FAQ: set lbass.faq AND put the same Q&A in its
  description as <details>. If the two ever disagree, the schema is wrong.
{% endcomment %}
{%- assign faq_json = product.metafields.lbass.faq.value -%}
{%- assign faq_count = 0 -%}
{%- if faq_json != blank -%}{%- assign faq_count = faq_json.size -%}{%- endif -%}
{%- if faq_count >= 2 and condition_confirmed -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "{{ shop.url }}{{ product.url }}#faq",
  "mainEntity": [
    {%- for qa in faq_json -%}
    {%- assign faq_answer = qa.a -%}
    {%- if product.handle == 'adidas-track-pants-black-red' or product.handle == 'jordan-23-engineered-pants' -%}{%- assign faq_answer = faq_answer | replace: 'مستعمل — حالة ممتازة', 'بحالة مزيانة بزاف' -%}{%- endif -%}
    {%- if product.handle == 'uniqlo-beige-open-collar-shirt' -%}{%- assign faq_answer = faq_answer | replace: 'حالة مزيانة بزاف - تحتاج تأكيد نهائي', 'بحالة ممتازة · شبه جديد' -%}{%- endif -%}
    {%- unless forloop.first %},{% endunless %}{"@type":"Question","name":{{ qa.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_answer | strip_newlines | json }}}}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% endif %}

{% if is_vault %}
<script>
  (function(){
    var params = {
      content_ids: [{{ product.id | json }}],
      content_type: 'product',
      value: {{ product.price | divided_by: 100.0 | json }},
      currency: 'MAD'
    };
    try {
      if(window.Shopify&&Shopify.analytics&&typeof Shopify.analytics.publish==='function') {
        Shopify.analytics.publish('lbass_vault_view', params);
      }
      if(typeof window.fbq === 'function') {
        window.fbq('trackCustom', 'lbass_vault_view', params);
      } else {
        var fbqInterval2 = setInterval(function(){
          if(typeof window.fbq === 'function') {
            window.fbq('trackCustom', 'lbass_vault_view', params);
            clearInterval(fbqInterval2);
          }
        }, 300);
        setTimeout(function(){ clearInterval(fbqInterval2); }, 5000);
      }
    } catch(e) {}
  })();
</script>
{% endif %}
