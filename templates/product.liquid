        {% if product.metafields.lbass.meas_chest != blank %}<div class="pm-i"><span class="k">الصدر</span><span class="v">{{ product.metafields.lbass.meas_chest }} cm</span></div>{% endif %}
        {% if product.metafields.lbass.meas_waist != blank %}<div class="pm-i"><span class="k">الوسط</span><span class="v">{{ product.metafields.lbass.meas_waist }} cm</span></div>{% endif %}
        {% if product.metafields.lbass.meas_sleeve != blank %}<div class="pm-i"><span class="k">الكمّ</span><span class="v">{{ product.metafields.lbass.meas_sleeve }} cm</span></div>{% endif %}
        {% if product.metafields.lbass.meas_inseam != blank %}<div class="pm-i"><span class="k">داخل الرجل</span><span class="v">{{ product.metafields.lbass.meas_inseam }} cm</span></div>{% endif %}
        {% if product.metafields.lbass.meas_insole != blank %}<div class="pm-i"><span class="k">النعل</span><span class="v">{{ product.metafields.lbass.meas_insole }} cm</span></div>{% endif %}
      </div>
      <p class="pm-note">📷 بغيتي صورة ديال القياس بالمتر؟ <a href="https://wa.me/{{ wa_number }}?text={{ wa_msg_fit }}" target="_blank" rel="noopener" style="color:var(--green2);text-decoration:underline">سول فالواتساب</a></p>
    </div>
    {% endif %}

    {% if product.available and condition_confirmed %}
    <!-- ═══ 5-STEP ORDER FLOW ═══ -->
    <div class="pdp-steps">
      <p class="ps-h">كيفاش يخدم الطلب — ٥ خطوات صافيين</p>
      <ol class="ps-list">
        <li><span class="ps-n">1</span><span class="ps-t">تختار القطعة وتزيدها للسلة</span></li>
        <li><span class="ps-n">2</span><span class="ps-t">تدخل العنوان ديالك</span></li>
        <li><span class="ps-n">3</span><span class="ps-t">نأكدو معاك فالواتساب</span></li>
        <li><span class="ps-n">4</span><span class="ps-t">نصيفطو ليك القطعة مغلّفة</span></li>
        <li><span class="ps-n">5</span><span class="ps-t">تخلّص COD ملي توصلك أو ادفع بـ PayPal</span></li>
      </ol>
