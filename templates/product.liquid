<script>
(function(){
  if(window.__lbassJudgeMeLocalized) return;
  window.__lbassJudgeMeLocalized = true;
  var copy = {
    'Customer Reviews':'آراء الزبناء',
    'Be the first to write a review':'باقي ما كاين حتى رأي على هاد المنتج. كون أول واحد يشارك التجربة ديالو.',
    'Write a review':'كتب رأيك',
    'Verified':'شراء مؤكد',
    'Filters':'فلتر',
    'Most recent':'الأحدث',
    'Highest rating':'أعلى تقييم',
    'Lowest rating':'أقل تقييم',
    'Only pictures':'غير بالصور',
    'Pictures first':'الصور اللولة',
    'Videos first':'الفيديوهات اللولة',
    'Most helpful':'الأكثر إفادة',
    'How would you rate this product?':'شحال كتعطي لهاد القطعة؟',
    'We would love it if you would share a bit about your experience.':'شاركنا تجربتك بصراحة باش تعاون ناس آخرين.',
    'Review content (Required)':'رأيك (ضروري)',
    'About you':'معلومات عليك',
    'Please tell us more about you.':'هاد المعلومات كتعاوننا نتحققو من الرأي.',
    'Email address (Required)':'الإيميل (ضروري)',
    'Display name (Required)':'الاسم اللي يبان (ضروري)',
    'Post review as anonymous':'نشر الرأي بلا اسم'
  };
  var placeholders = {
    'Start writing here...':'كتب تجربتك هنا...',
    'Your email address':'الإيميل ديالك',
    'Display name':'الاسم اللي يبان'
  };
  var scheduled = false;
  function translate(){
    scheduled = false;
    var scope = document.querySelector('.lbass-reviews');
    if(scope){
      scope.setAttribute('dir','rtl');
      scope.querySelectorAll('#judgeme_product_reviews,.jm-review-widget').forEach(function(el){el.setAttribute('dir','rtl');});
    }
    document.querySelectorAll('.jdgm-write-review-modal').forEach(function(el){el.setAttribute('dir','rtl');});
    var roots = [];
    if(scope) roots.push(scope);
    document.querySelectorAll('.jdgm-write-review-modal').forEach(function(el){roots.push(el);});
    roots.forEach(function(root){
      var walker = document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
      var nodes = [];
      while(walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(function(node){
        var parent = node.parentElement;
        if(!parent || parent.closest('script,style')) return;
        var value = node.nodeValue.trim();
        var translated = copy[value];
        if(!translated){
          var match = value.match(/^(\d+) reviews?$/i);
          if(match){
            var count = Number(match[1]);
            translated = count === 1 ? 'رأي واحد' : count === 2 ? 'جوج آراء' : count + ' آراء';
          }
        }
        if(translated) node.nodeValue = node.nodeValue.replace(value,translated);
      });
      root.querySelectorAll('input[placeholder],textarea[placeholder]').forEach(function(field){
        var translated = placeholders[field.getAttribute('placeholder')];
        if(translated) field.setAttribute('placeholder',translated);
      });
    });
    document.querySelectorAll('.lbass-reviews [data-testid="write-review-button"]').forEach(function(button){
      button.setAttribute('aria-label','كتب رأيك');
    });
  }
  function schedule(){
    if(scheduled) return;
    scheduled = true;
    window.requestAnimationFrame(translate);
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded',translate,{once:true});
  else translate();
  new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>

