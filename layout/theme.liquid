{% capture default_description %}Lbass Original: حوايج براند أصلية second-hand فالمغرب، قطع مختارة بصور حقيقية، حالة واضحة، وخلاص بـ COD أو PayPal.{% endcapture %}

{% comment %}
  Admin "Search engine listing" fields, whatever the resource type.
  Shopify stores them as global.title_tag / global.description_tag.
  Rationale: a {% render %} would drop the assigns (isolated scope), so this
  logic must remain inline. See snippets/lbass-canonical-map.liquid for detail.
{% endcomment %}
{%- assign seo_title = nil -%}
{%- assign seo_desc = nil -%}
{%- if product -%}
  {%- assign seo_title = product.metafields.global.title_tag -%}
  {%- assign seo_desc = product.metafields.global.description_tag -%}
{%- elsif collection -%}
  {%- assign seo_title = collection.metafields.global.title_tag -%}
  {%- assign seo_desc = collection.metafields.global.description_tag -%}
{%- elsif article -%}
  {%- assign seo_title = article.metafields.global.title_tag -%}
  {%- assign seo_desc = article.metafields.global.description_tag -%}
{%- elsif blog -%}
  {%- assign seo_title = blog.metafields.global.title_tag -%}
  {%- assign seo_desc = blog.metafields.global.description_tag -%}
{%- elsif page -%}
  {%- assign seo_title = page.metafields.global.title_tag -%}
  {%- assign seo_desc = page.metafields.global.description_tag -%}
{%- endif -%}

{% comment %}
  ⚠ THE index BRANCHES BELOW DO NOT CURRENTLY RUN. READ THIS BEFORE EDITING.

  templates/index.liquid declares {% layout none %} and emits its own complete
  HTML document — its own <html>, <head>, <title>, robots meta and footer.
  Verified on the live homepage 2026-08-05: none of this file's output appears
  there (no og:locale:alternate, no .lbent footer block, and a robots value
  this file never emits). So THIS LAYOUT NEVER RUNS ON "/".

  The `template == 'index'` branches are kept as a correct fallback: the day
  index.liquid drops {% layout none %}, the homepage inherits sane multilingual
  metadata instead of falling through to the generic `page_title`. They are
  cheap and harmless. They are NOT the fix.

  THE HOMEPAGE TITLE IS STILL WRONG AND IS FIXED IN index.liquid, NOWHERE ELSE:
      current: "Lbass Original | براند أصلي بثمن يناسبك 🇲🇦"
      no category noun, no "Maroc", no "friperie", no "second-hand"
  Admin → Online Store → Preferences will NOT fix it either: shop.description
  is empty and index.liquid hardcodes both tags. Replacement strings are in the
  owner-action list; see snippets/lbass-cro-tracking-hook.liquid for the full
  structural write-up.

  Darija still leads the visible page — this is metadata, the discovery layer.
{% endcomment %}
{% if seo_title != blank %}
  {% assign safe_page_title = seo_title %}
  {% assign title_is_explicit = true %}
{% elsif product %}
  {% assign safe_product_title = product.title | split: ' — LBO-' | first | split: ' - LBO-' | first | split: ' – LBO-' | first %}
  {% assign safe_product_condition = blank %}
  {% assign seo_ticket_status = product.metafields.lbass.ticket_status.value | default: 'unknown' %}
  {% assign seo_condition_status = product.metafields.lbass.condition_status.value | default: 'unknown' %}
  {% assign seo_inspection_status = product.metafields.lbass.inspection_status.value %}
  {% assign seo_has_ticket = product.metafields.lbass.has_original_ticket.value %}
  {% assign seo_condition_notes = product.metafields.lbass.condition_notes.value %}
  {% assign seo_visible_defects = product.metafields.lbass.visible_defects.value %}
  {% if seo_inspection_status == 'inspected_confirmed' %}
    {% if seo_has_ticket == true and seo_condition_status == 'new_with_ticket' %}
      {% if seo_ticket_status == 'ticket_attached' or seo_ticket_status == 'ticket_included' %}{% assign safe_product_condition = 'جديد بالتّيكيت' %}{% endif %}
    {% elsif seo_has_ticket == false and seo_ticket_status == 'no_ticket' and seo_condition_status == 'new_without_ticket' %}
      {% assign safe_product_condition = 'جديد بلا تيكيت' %}
    {% elsif seo_has_ticket == false and seo_ticket_status == 'no_ticket' and seo_condition_status == 'excellent_almost_new' %}
      {% assign safe_product_condition = 'بحالة ممتازة شبه جديد' %}
    {% elsif seo_condition_status == 'very_good' %}
