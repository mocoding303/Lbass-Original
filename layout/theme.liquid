.product-info{display:flex;flex-direction:column;gap:8px}
.form{display:flex;flex-direction:column;gap:10px;margin-top:18px}
select,button.btn{padding:14px;border-radius:10px;border:1px solid var(--line);background:var(--ink2);color:var(--cream);font-weight:700;font-family:inherit;font-size:15px}
button.btn-g{border-color:var(--green);background:var(--green);color:#fff}
button.btn-c{border-color:var(--cream);background:var(--cream);color:var(--ink)}
strong{color:var(--cream)}
.lb-catnav{display:flex;gap:6px;overflow-x:auto;padding:10px 24px;border-bottom:1px solid var(--line);background:rgba(9,9,10,.9);scrollbar-width:none;-webkit-overflow-scrolling:touch}
