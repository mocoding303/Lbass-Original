<script>
/* ── WhatsApp click tracking — GA4 2026-08-22 ──────────────────
   Fires whatsapp_click on every wa.me link site-wide.
   GA4 showed 0 events before this fix; WA is primary sales channel.
─────────────────────────────────────────────────────────────── */
(function(){
  function trackWa(e){
    var el = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"]') : null;
    if(!el) return;
    if(typeof gtag === 'function'){
      gtag('event','whatsapp_click',{
        event_category:'engagement',
        event_label: window.location.pathname + ' | ' + (el.getAttribute('aria-label') || el.getAttribute('data-cro-label') || 'wa'),
        value:1
      });
    }
  }
  document.addEventListener('click', trackWa, {passive:true});
})();
</script>
