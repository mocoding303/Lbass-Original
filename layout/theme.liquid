<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--ink:#0A0A0B;--ink2:#121214;--ink3:#1A1A1E;--line:#26262B;--gold:#C89A0E;--gold2:#E0B52A;--green:#1FA855;--txt:#D8D4CC;--txt2:#97928A;--txt3:#5E5A55;--cream:#F4EFE6}
html{scroll-behavior:smooth}
body{background:var(--ink);color:var(--txt);font-family:'Tajawal',system-ui,sans-serif;line-height:1.7;font-size:16px;min-height:100vh;display:flex;flex-direction:column}
a{color:inherit;text-decoration:none}
.wrap{max-width:1100px;margin:0 auto;padding:24px;width:100%}
.top{display:flex;align-items:center;justify-content:flex-start;padding:18px 24px;border-bottom:1px solid var(--line);background:rgba(9,9,10,.94);backdrop-filter:saturate(140%) blur(14px);position:sticky;top:0;z-index:50}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand-logo{display:block;width:clamp(154px,16vw,196px);height:auto;transition:transform .35s ease,filter .35s ease}
.brand-monogram{display:none;width:38px;height:38px;transition:transform .35s ease,filter .35s ease}
.brand:hover .brand-logo,.brand:hover .brand-monogram{transform:translateY(-1px);filter:drop-shadow(0 0 10px rgba(200,154,14,.22))}
@media (max-width:520px){
  .top{padding:14px 16px}
  .brand-logo{width:154px}
}
@media (max-width:340px){
  .brand-logo{display:none}
  .brand-monogram{display:block}
}
h1{font-size:clamp(24px,4vw,36px);font-weight:900;color:var(--cream);line-height:1.2;margin:14px 0 8px}
h2{font-size:clamp(18px,3vw,22px);color:var(--cream);margin:24px 0 8px;font-weight:800}
h3{font-size:16px;color:var(--cream);margin:18px 0 6px;font-weight:700}
.crumb{font-size:13px;color:var(--txt3);padding:14px 0}
.crumb a{color:var(--txt2)}.crumb a:hover{color:var(--gold)}
.price{font-size:32px;font-weight:900;color:var(--gold);direction:ltr;display:inline-block}
.chip{display:inline-block;border:1px solid var(--line);border-radius:30px;padding:6px 14px;font-size:13px;font-weight:700;color:var(--txt2);margin:3px}
.btn{display:inline-block;padding:14px 22px;border-radius:12px;font-weight:800;text-decoration:none;text-align:center;border:0;cursor:pointer}
.btn-g{background:var(--green);color:#fff}
.btn-c{background:var(--cream);color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;margin:18px 0}
.card{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--ink2);transition:transform .2s,border-color .2s;display:block}
.card:hover{transform:translateY(-3px);border-color:var(--gold)}
.card-img{aspect-ratio:4/5;background:linear-gradient(135deg,#1a1a1e,#0a0a0b);display:flex;align-items:center;justify-content:center;overflow:hidden}
.card-img img{width:100%;height:100%;object-fit:cover}
.card-body{padding:14px}
.card-title{font-weight:800;color:var(--cream);font-size:15px;margin:4px 0}
.card-vendor{color:var(--gold);font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
.card-price{font-weight:800;color:var(--gold);font-size:18px;direction:ltr;margin-top:6px}
.foot{border-top:1px solid var(--line);background:var(--ink2);padding:clamp(36px,5vw,60px) clamp(16px,3vw,32px) 24px;margin-top:auto;text-align:right;color:var(--txt2);font-size:14px;direction:rtl}
.foot-in{max-width:1280px;margin:0 auto}
.foot-grid{display:grid;grid-template-columns:1.4fr repeat(3,minmax(0,1fr));gap:clamp(24px,3.5vw,48px);padding-bottom:28px}
.fcol-brand{display:flex;flex-direction:column;align-items:flex-start}
.foot-logo{display:block;width:180px;height:auto;margin:0 0 12px;opacity:.95}
.foot-desc{font-size:13.5px;line-height:1.7;color:var(--txt2);margin:0 0 14px;max-width:320px}
.foot-desc-sub{display:block;font-size:12px;color:var(--txt3);margin-top:4px}
.foot-soc{display:flex;gap:8px;margin-top:4px}
.fs-b{width:38px;height:38px;border-radius:50%;border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--txt)!important;text-decoration:none!important;transition:all .2s ease}
.fs-b:hover{border-color:var(--gold);background:var(--gold-dim);transform:translateY(-2px)}
.fcol-t{font-size:12px;font-weight:900;letter-spacing:.08em;color:var(--cream);text-transform:uppercase;margin:0 0 14px}
.fcol a{display:block;padding:5px 0;color:var(--txt2)!important;font-size:13.5px;font-weight:600;text-decoration:none!important;transition:color .2s ease,transform .2s ease}
.fcol a:hover{color:var(--gold2)!important;transform:translateX(-3px)}
.foot-bot{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:20px;border-top:1px solid var(--line);font-size:12.5px;color:var(--txt3)}
