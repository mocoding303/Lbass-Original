          endcase
          if lbl != blank
            assign needle = lbl | prepend: '|' | append: '|'
            unless ad_types contains needle
              assign ad_types = ad_types | append: needle
            endunless
          endif
        endfor

        assign ad_type_arr = ad_types | remove_first: '|' | replace: '||', '|' | split: '|'
