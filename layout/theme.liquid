        assign ad_min = 0
        assign ad_types = ''
        for p in collections['adidas-originals'].products limit: 60
          unless p.available
            continue
          endunless
          if ad_min == 0 or p.price < ad_min
            assign ad_min = p.price
          endif
          comment
            p.type, NOT p.product_type. Measured on the live storefront
            2026-08-29: every in-stock product returned product_type='' from
            collections[handle].products, while p.type is populated. The theme's
            own Adidas block in lbass-collection-topics.liquid already reads
            `p.type | default: p.product_type` for this reason. Same class of
            trap as collection.all_tags returning [] (see lbass-colour-nav.liquid).
          endcomment
          assign pt = p.type | default: p.product_type | strip
          case pt
            when 'Shoes'
              assign lbl = 'صبابط'
            when 'Jackets'
              assign lbl = 'جاكيطات'
            when 'Pants'
